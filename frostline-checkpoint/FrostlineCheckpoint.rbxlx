        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">Audio</string>
            <string name="Source"><![CDATA[-- Sounds: one-shots, 3D sounds, music layers and the heartbeat.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local Audio = {}

local loops = {}

local function make(name: string, parent: Instance?): Sound?
	local info = Config.Sounds[name]
	if not info or info.Id == 0 then
		return nil
	end
	local sound = Instance.new("Sound")
	sound.Name = name
	sound.SoundId = "rbxassetid://" .. info.Id
	sound.Volume = info.Volume
	sound.Parent = parent or SoundService
	return sound
end

-- Play once. With a position, the sound comes from that spot in the world.
function Audio.Play(name: string, position: Vector3?, pitch: number?)
	if position then
		local holder = Instance.new("Part")
		holder.Anchored = true
		holder.CanCollide = false
		holder.CanQuery = false
		holder.Transparency = 1
		holder.Size = Vector3.one
		holder.Position = position
		holder.Parent = workspace
		local sound = make(name, holder)
		if not sound then
			holder:Destroy()
			return
		end
		sound.RollOffMaxDistance = 140
		sound.PlaybackSpeed = pitch or 1
		sound:Play()
		sound.Ended:Once(function()
			holder:Destroy()
		end)
		task.delay(30, function()
			if holder.Parent then
				holder:Destroy()
			end
		end)
		return
	end
	local sound = make(name)
	if sound then
		sound.PlaybackSpeed = pitch or 1
		sound:Play()
		sound.Ended:Once(function()
			sound:Destroy()
		end)
	end
end

-- Looping layer (music, ambience, heartbeat). Volume 0 stops it.
function Audio.Loop(name: string, volume: number?)
	local sound = loops[name]
	if not sound then
		sound = make(name)
		if not sound then
			return nil
		end
		sound.Looped = true
		loops[name] = sound
	end
	local base = Config.Sounds[name].Volume
	local target = base * (volume or 1)
	if target <= 0.001 then
		sound:Stop()
	else
		sound.Volume = target
		if not sound.IsPlaying then
			sound:Play()
		end
	end
	return sound
end

-- 3D loop attached to a part (monster growl / breathing).
function Audio.Attach(name: string, part: BasePart): Sound?
	local sound = make(name, part)
	if sound then
		sound.Looped = true
		sound.RollOffMaxDistance = 90
		sound.RollOffMinDistance = 6
		sound:Play()
	end
	return sound
end

return Audio
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">Effects</string>
            <string name="Source"><![CDATA[-- World effects: custom prompts, speech bubbles, bouncing arrows, blackout, stress, jumpscares,
-- taser, interrogation waypoint and the soundtrack.
local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Remotes)

local Audio = require(script.Parent.Audio)
local UI = require(script.Parent.UI)

local player = Players.LocalPlayer
local C = UI.Colors
local Effects = {}

local blackout = false

-- ===== Custom prompt: pink tag "[E] Take ID" like the screenshot =====
local function allowed(prompt: ProximityPrompt): boolean
	local list = prompt:GetAttribute("ForUsers")
	return list == nil or string.find(list, "," .. player.UserId .. ",", 1, true) ~= nil
end

local function showPrompt(prompt: ProximityPrompt, inputType: Enum.ProximityPromptInputType)
	if prompt.Style ~= Enum.ProximityPromptStyle.Custom or not allowed(prompt) then
		return
	end
	local gui = UI.new("BillboardGui", {
		Name = "PromptUI",
		Size = UDim2.fromOffset(250, 64),
		AlwaysOnTop = true,
		LightInfluence = 0,
		Adornee = prompt.Parent,
		Parent = player:WaitForChild("PlayerGui"),
	})
	local key = UI.new(
		"Frame",
		{ Size = UDim2.fromOffset(56, 56), Position = UDim2.fromOffset(0, 4), BackgroundColor3 = Color3.fromRGB(70, 70, 80), Parent = gui }
	)
	UI.corner(key, 28)
	UI.stroke(key, 3, C.White)
	local keyText = if inputType == Enum.ProximityPromptInputType.Touch
		then "👆"
		elseif inputType == Enum.ProximityPromptInputType.Gamepad then "X"
		else UserInputService:GetStringForKeyCode(prompt.KeyboardKeyCode)
	UI.text(key, keyText, { Size = UDim2.fromScale(0.6, 0.6), Position = UDim2.fromScale(0.2, 0.2), FontFace = UI.Bold })
	local ring = UI.new("Frame", {
		Size = UDim2.fromScale(1, 0),
		Position = UDim2.fromScale(0, 1),
		AnchorPoint = Vector2.new(0, 1),
		BackgroundColor3 = C.White,
		BackgroundTransparency = 0.5,
		Parent = key,
	})
	UI.corner(ring, 28)
	local tag = UI.new(
		"Frame",
		{ Size = UDim2.fromOffset(180, 50), Position = UDim2.fromOffset(62, 7), BackgroundColor3 = C.Pink, Rotation = -4, Parent = gui }
	)
	UI.corner(tag, 6)
	UI.new("UIGradient", { Color = ColorSequence.new(Color3.fromRGB(250, 190, 250), Color3.fromRGB(220, 120, 230)), Parent = tag })
	local label = UI.text(tag, prompt.ActionText, { Size = UDim2.fromScale(0.9, 0.8), Position = UDim2.fromScale(0.05, 0.1) })
	UI.outlined(label, 2.5)
	UI.pop(gui:FindFirstChildOfClass("Frame") :: Frame)
	local holding = false
	local c1 = prompt.PromptButtonHoldBegan:Connect(function()
		holding = true
		if prompt.HoldDuration > 0 then
			ring.Size = UDim2.fromScale(1, 0)
			UI.tween(ring, prompt.HoldDuration, { Size = UDim2.fromScale(1, 1) }, Enum.EasingStyle.Linear)
		end
	end)
	local c2 = prompt.PromptButtonHoldEnded:Connect(function()
		holding = false
		ring.Size = UDim2.fromScale(1, 0)
	end)
	local _ = holding
	-- Tap / click support
	local button = UI.new("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", Parent = gui })
	gui.Active = true
	button.MouseButton1Down:Connect(function()
		prompt:InputHoldBegin()
	end)
	button.MouseButton1Up:Connect(function()
		prompt:InputHoldEnd()
	end)
	button.MouseLeave:Connect(function()
		prompt:InputHoldEnd()
	end)
	prompt.PromptHidden:Once(function()
		c1:Disconnect()
		c2:Disconnect()
		gui:Destroy()
	end)
end

-- ===== Speech bubbles =====
local function speech(head: BasePart, text: string)
	if not head or not head.Parent then
		return
	end
	local old = head:FindFirstChild("Speech")
	if old then
		old:Destroy()
	end
	local gui = UI.new("BillboardGui", {
		Name = "Speech",
		Size = UDim2.fromOffset(420, 60),
		StudsOffset = Vector3.new(0, 3.2, 0),
		MaxDistance = 60,
		LightInfluence = 0,
		Adornee = head,
		Parent = head,
	})
	local bubble = UI.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(235, 236, 240),
		BackgroundTransparency = 0.05,
		AutomaticSize = Enum.AutomaticSize.None,
		Parent = gui,
	})
	UI.corner(bubble, 16)
	local label = UI.text(bubble, "", {
		Size = UDim2.new(1, -24, 1, -12),
		Position = UDim2.fromOffset(12, 6),
		TextColor3 = Color3.fromRGB(40, 40, 50),
		FontFace = UI.Bold,
		TextScaled = true,
	})
	local tail = UI.new("Frame", {
		Size = UDim2.fromOffset(16, 16),
		Position = UDim2.new(0.5, -8, 1, -8),
		Rotation = 45,
		BackgroundColor3 = Color3.fromRGB(235, 236, 240),
		Parent = bubble,
	})
	local _ = tail
	-- Typewriter
	task.spawn(function()
		for i = 1, #text do
			if not label.Parent then
				return
			end
			label.Text = string.sub(text, 1, i)
			task.wait(0.025)
		end
		task.wait(math.clamp(#text * 0.06, 2.5, 6))
		if gui.Parent then
			gui:Destroy()
		end
	end)
end

-- ===== Blackout visuals =====
local blackoutCC: ColorCorrectionEffect
local stressCC: ColorCorrectionEffect
local blur: BlurEffect

local function setBlackout(data)
	blackout = data and data.Active == true
	if blackout then
		UI.tween(blackoutCC, 1.5, { Brightness = -0.18, Contrast = 0.25, Saturation = -0.4, TintColor = Color3.fromRGB(255, 190, 190) })
		Audio.Loop("Ambience", 0)
		Audio.Loop("ChaseMusic", 1)
	else
		UI.tween(blackoutCC, 1.5, { Brightness = 0, Contrast = 0, Saturation = 0, TintColor = Color3.new(1, 1, 1) })
		Audio.Loop("ChaseMusic", 0)
		Audio.Loop("Heartbeat", 0)
		if player:GetAttribute("InShift") then
			Audio.Loop("Ambience", 1)
		end
	end
end

-- Monster sounds (growl + breathing) attached when one appears near us
local function onDescendant(inst: Instance)
	if inst:IsA("Model") and inst:GetAttribute("Monster") then
		local head = inst:WaitForChild("Head", 5) :: BasePart?
		if head then
			Audio.Attach("MonsterGrowl", head)
			Audio.Attach("MonsterBreath", head)
			Audio.Attach("MonsterSteps", head)
		end
	end
end

local function nearestMonster(): (Model?, number)
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not hrp then
		return nil, math.huge
	end
	local best, dist = nil, math.huge
	for _, d in CollectionService:GetTagged("Monster") do
		if d:IsA("Model") then
			local root = d:FindFirstChild("HumanoidRootPart") :: BasePart?
			if root then
				local m = (root.Position - hrp.Position).Magnitude
				if m < dist then
					best, dist = d, m
				end
			end
		end
	end
	return best, dist
end

-- ===== Jumpscare =====
local scareGui: ScreenGui
local function jumpscare(monster: Model?)
	Audio.Play("Jumpscare")
	Audio.Play("MonsterScreech", nil, 0.85)
	local frame = UI.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = C.Black, Parent = scareGui })
	local vp = UI.new("ViewportFrame", {
		Size = UDim2.fromScale(1.2, 1.2),
		Position = UDim2.fromScale(-0.1, -0.1),
		BackgroundColor3 = Color3.fromRGB(20, 0, 0),
		Ambient = Color3.fromRGB(255, 160, 160),
		LightColor = Color3.fromRGB(255, 80, 60),
		Parent = frame,
	})
	if monster and monster.Parent then
		monster.Archivable = true
		local clone = monster:Clone()
		if clone then
			clone.Parent = vp
			local head = clone:FindFirstChild("Head") :: BasePart?
			local camera = UI.new("Camera", { FieldOfView = 50, Parent = vp })
			if head then
				camera.CFrame = CFrame.lookAt((head.CFrame * CFrame.new(0, 0, -2.2)).Position, head.Position)
			end
			vp.CurrentCamera = camera
		end
	end
	local flash = UI.new(
		"Frame",
		{ Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0, Parent = frame }
	)
	UI.tween(flash, 0.25, { BackgroundTransparency = 1 })
	local t0 = os.clock()
	local conn = RunService.RenderStepped:Connect(function()
		local k = math.max(0, 1 - (os.clock() - t0) / 1.4)
		vp.Position = UDim2.fromScale(-0.1 + (math.random() - 0.5) * 0.06 * k, -0.1 + (math.random() - 0.5) * 0.06 * k)
		vp.Size = UDim2.fromScale(1.2 + (os.clock() - t0) * 0.4, 1.2 + (os.clock() - t0) * 0.4)
	end)
	task.wait(1.3)
	conn:Disconnect()
	vp:Destroy()
	local text = UI.text(
		frame,
		"You were knocked out...",
		{ Size = UDim2.new(0.6, 0, 0, 60), Position = UDim2.fromScale(0.2, 0.45), TextColor3 = Color3.fromRGB(200, 40, 40) }
	)
	local _ = text
	task.wait(1.5)
	UI.tween(frame, 1, { BackgroundTransparency = 1 })
	task.wait(1)
	frame:Destroy()
end

-- ===== Taser =====
local function bolt(from: Vector3, to: Vector3)
	local segments = 8
	local last = from
	local parts = {}
	for i = 1, segments do
		local p = from:Lerp(to, i / segments)
		if i < segments then
			p += Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * 1.2
		end
		local part = Instance.new("Part")
		part.Anchored = true
		part.CanCollide = false
		part.CanQuery = false
		part.Material = Enum.Material.Neon
		part.Color = Color3.fromRGB(140, 220, 255)
		local len = (p - last).Magnitude
		part.Size = Vector3.new(0.15, 0.15, len)
		part.CFrame = CFrame.lookAt((last + p) / 2, p)
		part.Parent = workspace
		table.insert(parts, part)
		last = p
	end
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(140, 220, 255)
	light.Range = 16
	light.Brightness = 4
	light.Parent = parts[#parts]
	task.delay(0.15, function()
		for _, p in parts do
			p:Destroy()
		end
	end)
end

local function hookTaser(char: Model)
	char.ChildAdded:Connect(function(child)
		if child:IsA("Tool") and child.Name == "Taser" and not child:GetAttribute("Hooked") then
			child:SetAttribute("Hooked", true)
			child.Activated:Connect(function()
				local mouse = player:GetMouse()
				Remotes.Taser:FireServer(mouse.Hit.Position)
			end)
		end
	end)
end

-- ===== Waypoint to the interrogation room =====
local waypointPart: Part?
local function updateWaypoint()
	local pos = player:GetAttribute("Waypoint")
	if waypointPart then
		waypointPart:Destroy()
		waypointPart = nil
	end
	if typeof(pos) ~= "Vector3" then
		return
	end
	local part = Instance.new("Part")
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.Transparency = 1
	part.Position = pos + Vector3.new(0, 4, 0)
	part.Parent = workspace
	waypointPart = part
	local gui = UI.new("BillboardGui", { Size = UDim2.fromOffset(160, 80), AlwaysOnTop = true, LightInfluence = 0, Parent = part })
	UI.outlined(UI.text(gui, "⬇ ROOM", { Size = UDim2.new(1, 0, 0.6, 0), TextColor3 = Color3.fromRGB(255, 90, 90) }), 2)
	local dist = UI.text(gui, "", { Size = UDim2.new(1, 0, 0.4, 0), Position = UDim2.fromScale(0, 0.6) })
	UI.outlined(dist, 2)
	task.spawn(function()
		while waypointPart == part do
			local char = player.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
			if hrp then
				dist.Text = math.floor((hrp.Position - pos).Magnitude) .. " studs"
			end
			task.wait(0.2)
		end
	end)
end

function Effects.Init()
	ProximityPromptService.PromptShown:Connect(showPrompt)
	Remotes.Speech.OnClientEvent:Connect(speech)

	-- Bouncing arrows over the party pads
	local arrows = {}
	local function addArrow(part)
		arrows[part] = part.CFrame
	end
	for _, part in CollectionService:GetTagged("BounceArrow") do
		addArrow(part)
	end
	CollectionService:GetInstanceAddedSignal("BounceArrow"):Connect(addArrow)

	blackoutCC = UI.new("ColorCorrectionEffect", { Name = "BlackoutCC", Parent = Lighting })
	stressCC = UI.new("ColorCorrectionEffect", { Name = "StressCC", Parent = Lighting })
	blur = UI.new("BlurEffect", { Name = "StressBlur", Size = 0, Parent = Lighting })
	scareGui = UI.new(
		"ScreenGui",
		{ Name = "Scare", IgnoreGuiInset = true, DisplayOrder = 50, ResetOnSpawn = false, Parent = player:WaitForChild("PlayerGui") }
	)

	Remotes.Blackout.OnClientEvent:Connect(setBlackout)
	Remotes.Scare.OnClientEvent:Connect(function(monster)
		task.spawn(jumpscare, monster)
	end)
	Remotes.Sfx.OnClientEvent:Connect(function(name, position, origin)
		if name == "Taser" and typeof(position) == "Vector3" and typeof(origin) == "Vector3" then
			bolt(origin, position)
		end
		Audio.Play(name, position)
	end)
	workspace.DescendantAdded:Connect(onDescendant)
	if player.Character then
		hookTaser(player.Character)
	end
	player.CharacterAdded:Connect(hookTaser)
	player:GetAttributeChangedSignal("Waypoint"):Connect(updateWaypoint)
	player:GetAttributeChangedSignal("InShift"):Connect(function()
		if player:GetAttribute("InShift") then
			Audio.Loop("LobbyMusic", 0)
			Audio.Loop("Ambience", 1)
		else
			Audio.Loop("Ambience", 0)
			Audio.Loop("ChaseMusic", 0)
			Audio.Loop("Heartbeat", 0)
			Audio.Loop("LobbyMusic", 1)
		end
	end)
	Audio.Loop("LobbyMusic", 1)

	local whisperAt = 0
	RunService.RenderStepped:Connect(function()
		local t = os.clock()
		for part, base in arrows do
			if part.Parent then
				part.CFrame = base * CFrame.new(0, math.sin(t * 3) * 0.8, 0)
			else
				arrows[part] = nil
			end
		end
		-- Blackout: flicker + heartbeat by distance
		if blackout then
			local _, dist = nearestMonster()
			local closeness = math.clamp(1 - dist / 70, 0, 1)
			local hb = Audio.Loop("Heartbeat", 0.2 + closeness * 0.8)
			if hb then
				hb.PlaybackSpeed = 0.9 + closeness * 0.7
			end
			blackoutCC.Brightness = -0.18 + (if math.random() < 0.03 then 0.15 else 0)
			local camera = workspace.CurrentCamera
			if camera and closeness > 0.6 then
				camera.CFrame *= CFrame.new((math.random() - 0.5) * 0.06 * closeness, (math.random() - 0.5) * 0.06 * closeness, 0)
			end
		end
		-- Stress: colors drain, the view swims, whispers start
		local stress = (player:GetAttribute("Stress") or 0) / 100
		local k = math.clamp((stress - 0.5) / 0.5, 0, 1)
		stressCC.Saturation = -0.6 * k
		stressCC.Contrast = 0.2 * k
		blur.Size = if stress >= 1 then 6 + math.sin(t * 2) * 4 else 0
		local camera = workspace.CurrentCamera
		if camera then
			camera.FieldOfView = 70 + (if stress >= 1 then math.sin(t * 1.3) * 6 else 0)
		end
		if k > 0.6 and t > whisperAt then
			whisperAt = t + 12 + math.random() * 10
			Audio.Play("Whispers")
		end
	end)
end

return Effects
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">HUD</string>
            <string name="Source"><![CDATA[-- All 2D UI: lobby buttons, currencies, shift banner, objective card, rank card,
-- party/shop/skins/rewards menus, toasts, verdicts and results.
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SocialService = game:GetService("SocialService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Format = require(Shared.Format)
local Remotes = require(Shared.Remotes)

local UI = require(script.Parent.UI)

local player = Players.LocalPlayer
local C = UI.Colors

local HUD = {}

local gui: ScreenGui
local menuLayer: Frame
local lobbyLayer: Frame
local shiftLayer: Frame
local openMenu: GuiObject? = nil
local state = { InShift = false, Shift = nil }

local function closeMenu()
	if openMenu then
		openMenu:Destroy()
		openMenu = nil
	end
end
HUD.CloseMenu = closeMenu

-- Black strip toast like "Daily reward: $25 starting cash"
local toastHolder: Frame
function HUD.Toast(text: string, kind: string?)
	local color = if kind == "success" then C.Yellow elseif kind == "warn" then Color3.fromRGB(255, 120, 100) else C.White
	local strip = UI.new("Frame", {
		Size = UDim2.new(0.6, 0, 0, 44),
		BackgroundColor3 = C.Black,
		BackgroundTransparency = 0.15,
		Parent = toastHolder,
	})
	UI.new("UIGradient", {
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.15, 0),
			NumberSequenceKeypoint.new(0.85, 0),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Parent = strip,
	})
	UI.text(strip, text, { TextColor3 = color, Size = UDim2.fromScale(0.8, 0.8), Position = UDim2.fromScale(0.1, 0.1) })
	task.delay(3.5, function()
		UI.tween(strip, 0.4, { BackgroundTransparency = 1 })
		local label = strip:FindFirstChildOfClass("TextLabel")
		if label then
			UI.tween(label, 0.4, { TextTransparency = 1 })
		end
		task.wait(0.45)
		strip:Destroy()
	end)
end

-- Big centered banner
local bannerLabel: TextLabel
function HUD.Announce(text: string, hex: string?)
	if text == "" then
		return
	end
	bannerLabel.Text = text
	bannerLabel.TextColor3 = if hex then Color3.fromHex(hex) else C.White
	bannerLabel.TextTransparency = 0
	local stroke = bannerLabel:FindFirstChildOfClass("UIStroke")
	if stroke then
		stroke.Transparency = 0
	end
	local scale = bannerLabel:FindFirstChildOfClass("UIScale") or UI.new("UIScale", { Parent = bannerLabel })
	scale.Scale = 1.6
	UI.tween(scale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
	task.delay(2.6, function()
		if bannerLabel.Text == text then
			UI.tween(bannerLabel, 0.6, { TextTransparency = 1 })
			if stroke then
				UI.tween(stroke, 0.6, { Transparency = 1 })
			end
		end
	end)
end

-- ===== Lobby HUD =====
local function sideButton(parent: Instance, order: number, icon: string, label: string, color: Color3, textColor: Color3, onClick: () -> ())
	local button = UI.new("TextButton", {
		Size = UDim2.fromOffset(104, 104),
		BackgroundColor3 = color,
		Text = "",
		LayoutOrder = order,
		AutoButtonColor = true,
		Parent = parent,
	})
	UI.corner(button, 14)
	UI.stroke(button, 4, C.NavyDark)
	UI.text(
		button,
		icon,
		{ Size = UDim2.new(1, 0, 0.58, 0), Position = UDim2.fromScale(0, 0.06), FontFace = UI.Bold, TextColor3 = textColor }
	)
	UI.text(button, label, { Size = UDim2.new(0.9, 0, 0.24, 0), Position = UDim2.fromScale(0.05, 0.68), TextColor3 = textColor })
	button.MouseButton1Click:Connect(onClick)
	return button
end

local function currencyPill(parent: Instance, order: number, icon: string, attribute: string, color: Color3)
	local frame = UI.new("Frame", { Size = UDim2.fromOffset(200, 58), BackgroundTransparency = 1, LayoutOrder = order, Parent = parent })
	local pill = UI.new(
		"Frame",
		{ Size = UDim2.fromOffset(130, 48), Position = UDim2.fromOffset(30, 5), BackgroundColor3 = C.White, Parent = frame }
	)
	UI.corner(pill, 8)
	UI.stroke(pill, 3, C.NavyDark)
	local amount = UI.text(pill, "0", { Size = UDim2.new(1, -40, 0.75, 0), Position = UDim2.fromScale(0.28, 0.12), TextColor3 = C.Ink })
	UI.text(frame, icon, { Size = UDim2.fromOffset(58, 58), FontFace = UI.Bold })
	UI.button(frame, "+", C.Green, function()
		HUD.OpenShop("Currency")
	end, { Size = UDim2.fromOffset(48, 48), Position = UDim2.fromOffset(150, 5), FontFace = UI.Bold })
	local function update()
		amount.Text = Format.Abbrev(player:GetAttribute(attribute) or 0)
		amount.TextColor3 = C.Ink
	end
	player:GetAttributeChangedSignal(attribute):Connect(update)
	update()
	local _ = color
	return frame
end

local function buildLobby()
	lobbyLayer = UI.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = gui })
	local side = UI.new("Frame", {
		Size = UDim2.fromOffset(110, 460),
		Position = UDim2.new(1, -16, 0.5, 0),
		AnchorPoint = Vector2.new(1, 0.5),
		BackgroundTransparency = 1,
		Parent = lobbyLayer,
	})
	UI.list(side, 14, false, Enum.HorizontalAlignment.Right)
	local rewards = sideButton(side, 1, "🎁", "REWARDS", C.White, C.Ink, function()
		HUD.OpenRewards()
	end)
	local dot = UI.new(
		"Frame",
		{ Size = UDim2.fromOffset(22, 22), Position = UDim2.new(1, -16, 0, -6), BackgroundColor3 = C.Red, Parent = rewards }
	)
	UI.corner(dot, 11)
	local function updateDot()
		dot.Visible = player:GetAttribute("DailyReady") == true
	end
	player:GetAttributeChangedSignal("DailyReady"):Connect(updateDot)
	updateDot()
	sideButton(side, 2, "👤+", "INVITE", C.Green, C.White, function()
		pcall(function()
			SocialService:PromptGameInvite(player)
		end)
	end)
	sideButton(side, 3, "🛒", "SHOP", C.White, C.Ink, function()
		HUD.OpenShop("Passes")
	end)
	sideButton(side, 4, "👔", "SKINS", C.White, C.Ink, function()
		HUD.OpenSkins()
	end)

	-- LIMITED HALLOWEEN button
	local halloween = UI.new("TextButton", {
		Size = UDim2.fromOffset(120, 120),
		Position = UDim2.new(0, 22, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		BackgroundColor3 = Color3.fromRGB(255, 120, 20),
		Text = "",
		Parent = lobbyLayer,
	})
	UI.corner(halloween, 14)
	UI.stroke(halloween, 4, Color3.fromRGB(120, 40, 0))
	UI.text(halloween, "🎃", { Size = UDim2.fromScale(1, 0.62), Position = UDim2.fromScale(0, 0.05), FontFace = UI.Bold })
	UI.text(halloween, "HALLOWEEN", { Size = UDim2.fromScale(0.9, 0.2), Position = UDim2.fromScale(0.05, 0.72) })
	local limited = UI.new("Frame", {
		Size = UDim2.fromOffset(90, 28),
		Position = UDim2.fromOffset(-12, -14),
		Rotation = -10,
		BackgroundColor3 = Color3.fromRGB(120, 50, 200),
		Parent = halloween,
	})
	UI.corner(limited, 14)
	UI.text(limited, "LIMITED", { Size = UDim2.fromScale(0.9, 0.8), Position = UDim2.fromScale(0.05, 0.1) })
	halloween.MouseButton1Click:Connect(function()
		HUD.OpenSkins(true)
	end)
	task.spawn(function()
		local t = 0
		while halloween.Parent do
			t += RunService.Heartbeat:Wait()
			halloween.Rotation = math.sin(t * 2.4) * 3
		end
	end)

	-- Currencies (bottom left)
	local money = UI.new("Frame", {
		Size = UDim2.fromOffset(210, 130),
		Position = UDim2.new(0, 20, 1, -20),
		AnchorPoint = Vector2.new(0, 1),
		BackgroundTransparency = 1,
		Parent = lobbyLayer,
	})
	UI.list(money, 10)
	currencyPill(money, 1, "🍬", "Candy", C.Candy)
	currencyPill(money, 2, "💵", "Cash", C.Cash)

	-- STEP INTO A ZONE TO START A SHIFT
	local hint = UI.new("TextLabel", {
		Size = UDim2.new(0.6, 0, 0, 40),
		Position = UDim2.new(0.5, 0, 1, -70),
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundTransparency = 1,
		RichText = true,
		Text = 'STEP INTO A <font color="#3CDCFF">ZONE</font> TO START A SHIFT',
		FontFace = UI.Title,
		TextScaled = true,
		TextColor3 = C.White,
		Parent = lobbyLayer,
	})
	UI.outlined(hint, 2)
end

-- ===== Shift HUD =====
local shiftBanner: TextLabel
local objectiveCard: Frame
local objTitle: TextLabel
local objText: TextLabel
local objStep: TextLabel
local statusLabel: TextLabel
local blackoutLabel: TextLabel
local rankLabel: TextLabel
local stressFill: Frame
local stressText: TextLabel

local function buildShift()
	shiftLayer = UI.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Visible = false, Parent = gui })
	-- Top banner "Shift 1"
	local top = UI.new("Frame", {
		Size = UDim2.new(0.5, 0, 0, 66),
		Position = UDim2.new(0.5, 0, 0, 0),
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundColor3 = C.Black,
		Parent = shiftLayer,
	})
	UI.new("UIGradient", {
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.2, 0),
			NumberSequenceKeypoint.new(0.8, 0),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Parent = top,
	})
	shiftBanner = UI.text(top, "Shift 1", { Size = UDim2.fromScale(0.5, 0.82), Position = UDim2.fromScale(0.25, 0.08) })

	-- NEXT OBJECTIVE card (top right)
	objectiveCard = UI.new("Frame", {
		Size = UDim2.fromOffset(440, 220),
		Position = UDim2.new(1, -16, 0, 84),
		AnchorPoint = Vector2.new(1, 0),
		BackgroundColor3 = C.Paper,
		Parent = shiftLayer,
	})
	UI.stroke(objectiveCard, 4, C.NavyDark)
	local header = UI.new("Frame", { Size = UDim2.new(1, 0, 0, 56), BackgroundColor3 = C.Navy, Parent = objectiveCard })
	UI.new("UIGradient", { Color = ColorSequence.new(C.Navy, C.NavyDark), Rotation = 90, Parent = header })
	UI.text(header, "🚆", { Size = UDim2.fromOffset(46, 46), Position = UDim2.fromOffset(10, 5), FontFace = UI.Bold })
	UI.text(
		header,
		"NEXT OBJECTIVE",
		{ Size = UDim2.new(1, -80, 0, 44), Position = UDim2.fromOffset(66, 6), TextXAlignment = Enum.TextXAlignment.Left }
	)
	local portrait = UI.new("ViewportFrame", {
		Size = UDim2.fromOffset(150, 150),
		Position = UDim2.fromOffset(12, 64),
		BackgroundColor3 = Color3.fromRGB(150, 196, 240),
		Ambient = Color3.fromRGB(200, 200, 200),
		LightColor = Color3.new(1, 1, 1),
		Parent = objectiveCard,
	})
	UI.stroke(portrait, 3, C.NavyDark)
	UI.new(
		"UIGradient",
		{ Color = ColorSequence.new(Color3.fromRGB(200, 230, 255), Color3.fromRGB(120, 170, 230)), Rotation = 90, Parent = portrait }
	)
	task.spawn(function()
		local folder = ReplicatedStorage:WaitForChild("Portraits", 20)
		local source = folder and folder:WaitForChild("Supervisor", 20)
		if source then
			local model = source:Clone()
			model.Parent = portrait
			local head = model:FindFirstChild("Head") :: BasePart?
			local camera = UI.new("Camera", { FieldOfView = 30, Parent = portrait })
			if head then
				camera.CFrame = CFrame.lookAt((head.CFrame * CFrame.new(0, 0.1, -4.4)).Position, head.Position - Vector3.new(0, 0.2, 0))
			end
			portrait.CurrentCamera = camera
		end
	end)
	objTitle = UI.text(objectiveCard, "Check in the passenger", {
		Size = UDim2.new(1, -186, 0, 38),
		Position = UDim2.fromOffset(176, 64),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = C.Ink,
	})
	objText = UI.text(objectiveCard, "", {
		Size = UDim2.new(1, -186, 0, 70),
		Position = UDim2.fromOffset(176, 104),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextScaled = false,
		TextSize = 21,
		TextWrapped = true,
		FontFace = UI.Hand,
		TextColor3 = Color3.fromRGB(70, 74, 90),
	})
	local stepBox = UI.new(
		"Frame",
		{ Size = UDim2.fromOffset(124, 40), Position = UDim2.new(1, -136, 1, -50), BackgroundColor3 = C.White, Parent = objectiveCard }
	)
	UI.corner(stepBox, 4)
	UI.stroke(stepBox, 3, C.NavyDark)
	objStep =
		UI.text(stepBox, "Step 1/6", { Size = UDim2.fromScale(0.9, 0.85), Position = UDim2.fromScale(0.05, 0.08), TextColor3 = C.Ink })

	-- Status line under the card: strikes and check-ins left
	statusLabel = UI.text(shiftLayer, "", {
		Size = UDim2.fromOffset(440, 30),
		Position = UDim2.new(1, -16, 0, 312),
		AnchorPoint = Vector2.new(1, 0),
		TextXAlignment = Enum.TextXAlignment.Right,
		RichText = true,
	})
	UI.outlined(statusLabel, 2)

	-- Blackout timer
	blackoutLabel = UI.text(
		shiftLayer,
		"",
		{ Size = UDim2.new(0.5, 0, 0, 44), Position = UDim2.new(0.25, 0, 0, 74), TextColor3 = Color3.fromRGB(255, 70, 60), Visible = false }
	)
	UI.outlined(blackoutLabel, 3)

	-- Rank card (bottom left): portrait, rank, cash, CRASH OUT bar, candy
	local card = UI.new("Frame", {
		Size = UDim2.fromOffset(400, 150),
		Position = UDim2.new(0, 20, 1, -20),
		AnchorPoint = Vector2.new(0, 1),
		BackgroundTransparency = 1,
		Parent = shiftLayer,
	})
	local barBack = UI.new(
		"Frame",
		{ Size = UDim2.fromOffset(300, 60), Position = UDim2.fromOffset(96, 46), BackgroundColor3 = C.Black, Parent = card }
	)
	UI.corner(barBack, 6)
	UI.stroke(barBack, 4, Color3.fromRGB(70, 74, 84))
	stressFill = UI.new("Frame", {
		Size = UDim2.new(0.15, -8, 1, -8),
		Position = UDim2.fromOffset(4, 4),
		BackgroundColor3 = Color3.fromRGB(110, 240, 60),
		Parent = barBack,
	})
	UI.corner(stressFill, 4)
	stressText = UI.text(
		barBack,
		"15%",
		{ Size = UDim2.new(0.3, 0, 0.7, 0), Position = UDim2.new(0.66, 0, 0.15, 0), TextXAlignment = Enum.TextXAlignment.Right }
	)
	UI.outlined(stressText, 2)
	local frame = UI.new("Frame", {
		Size = UDim2.fromOffset(120, 120),
		Position = UDim2.fromOffset(0, 16),
		BackgroundColor3 = Color3.fromRGB(70, 74, 84),
		Rotation = 0,
		Parent = card,
	})
	UI.corner(frame, 30)
	UI.stroke(frame, 4, C.Black)
	local headshot = UI.new("ImageLabel", {
		Size = UDim2.new(1, -16, 1, -16),
		Position = UDim2.fromOffset(8, 8),
		BackgroundColor3 = Color3.fromRGB(150, 196, 240),
		Image = "rbxthumb://type=AvatarHeadShot&id=" .. player.UserId .. "&w=150&h=150",
		Parent = frame,
	})
	UI.corner(headshot, 26)
	rankLabel = UI.text(
		card,
		"Trainee",
		{ Size = UDim2.fromOffset(200, 36), Position = UDim2.fromOffset(130, 6), TextXAlignment = Enum.TextXAlignment.Left }
	)
	UI.outlined(rankLabel, 2)
	local cash = UI.text(card, "$0", {
		Size = UDim2.fromOffset(110, 34),
		Position = UDim2.fromOffset(282, 8),
		TextXAlignment = Enum.TextXAlignment.Right,
		TextColor3 = C.Cash,
	})
	UI.outlined(cash, 2)
	local crash = UI.text(
		card,
		"CRASH OUT",
		{ Size = UDim2.fromOffset(150, 30), Position = UDim2.fromOffset(134, 112), TextXAlignment = Enum.TextXAlignment.Left }
	)
	UI.outlined(crash, 2)
	local candy = UI.text(card, "🍬 0", {
		Size = UDim2.fromOffset(110, 30),
		Position = UDim2.fromOffset(282, 112),
		TextXAlignment = Enum.TextXAlignment.Right,
		TextColor3 = C.Candy,
	})
	UI.outlined(candy, 2)
	local function update()
		rankLabel.Text = player:GetAttribute("Rank") or "Trainee"
		cash.Text = "$" .. Format.Abbrev(player:GetAttribute("Cash") or 0)
		candy.Text = "🍬 " .. Format.Abbrev(player:GetAttribute("Candy") or 0)
		local stress = player:GetAttribute("Stress") or 0
		UI.tween(stressFill, 0.4, { Size = UDim2.new(math.max(stress / 100, 0.03), -8, 1, -8) })
		stressFill.BackgroundColor3 = Color3.fromRGB(110, 240, 60):Lerp(Color3.fromRGB(240, 40, 30), stress / 100)
		stressText.Text = math.floor(stress) .. "%"
	end
	for _, attr in { "Rank", "Cash", "Candy", "Stress" } do
		player:GetAttributeChangedSignal(attr):Connect(update)
	end
	update()

	-- Quick buttons (bottom right): rules, radar, hint
	local quick = UI.new("Frame", {
		Size = UDim2.fromOffset(170, 220),
		Position = UDim2.new(1, -16, 1, -20),
		AnchorPoint = Vector2.new(1, 1),
		BackgroundTransparency = 1,
		Parent = shiftLayer,
	})
	UI.new("UIListLayout", {
		Padding = UDim.new(0, 8),
		VerticalAlignment = Enum.VerticalAlignment.Bottom,
		HorizontalAlignment = Enum.HorizontalAlignment.Right,
		Parent = quick,
	})
	UI.button(quick, "📋 RULES", C.Navy, function()
		HUD.OnRules()
	end, { Size = UDim2.fromOffset(170, 50) })
	local radar = UI.button(quick, "📡 RADAR", Color3.fromRGB(110, 50, 190), function()
		local ok, text = Remotes.UseRadar:InvokeServer()
		HUD.Toast(text, if ok then "success" else "warn")
	end, { Size = UDim2.fromOffset(170, 50) })
	HUD.RadarButton = radar
	UI.button(quick, "🔍 HINT", Color3.fromRGB(230, 140, 20), function()
		if (player:GetAttribute("StoredHints") or 0) > 0 then
			local ok, text = Remotes.UseHint:InvokeServer()
			HUD.Toast(text, if ok then "success" else "warn")
		else
			HUD.Buy("Product", "Hint")
		end
	end, { Size = UDim2.fromOffset(170, 50) })
end

function HUD.SetObjective(data)
	if not data then
		return
	end
	objTitle.Text = data.Title
	objText.Text = data.Text
	objStep.Text = "Step " .. data.Step .. "/" .. data.Steps
	local scale = objectiveCard:FindFirstChildOfClass("UIScale") or UI.new("UIScale", { Parent = objectiveCard })
	scale.Scale = 1.06
	UI.tween(scale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
end

function HUD.State()
	return state
end

function HUD.SetShiftState(data)
	state.InShift = data ~= nil
	lobbyLayer.Visible = not state.InShift
	shiftLayer.Visible = state.InShift
	if not data then
		blackoutLabel.Visible = false
		return
	end
	state.Shift = data
	shiftBanner.Text = "Shift " .. data.Shift
	local strikes = string.rep("✖ ", data.Strikes) .. string.rep("○ ", math.max(data.MaxStrikes - data.Strikes, 0))
	statusLabel.Text = '<font color="#FF6A5A">' .. strikes .. "</font>  ·  " .. string.format("%02d", data.Remaining) .. " CHECK-INS LEFT"
	HUD.RadarButton.Visible = player:GetAttribute("Pass_AnomalyRadar") == true
	HUD.RadarButton.Text = "📡 RADAR (" .. (data.RadarLeft or 0) .. ")"
end

function HUD.SetBlackout(data)
	if not data or not data.Active then
		blackoutLabel.Visible = false
		HUD.BlackoutDeadline = nil
		if data and data.Won ~= nil then
			HUD.Announce(if data.Won then "POWER RESTORED" else "THE STATION IS LOST", if data.Won then "#7CFF6A" else "#FF3B30")
		end
		return
	end
	if data.Count then
		HUD.Announce("⚠ POWER FAILURE", "#FF3B30")
	end
	HUD.BlackoutDeadline = data.Deadline
	HUD.Breakers = data.Breakers .. "/" .. data.Total
	blackoutLabel.Visible = true
end

-- ===== Verdict stamp =====
function HUD.Verdict(data)
	local stampFrame = UI.new("Frame", {
		Size = UDim2.fromOffset(420, 120),
		Position = UDim2.fromScale(0.5, 0.42),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Rotation = -8,
		BackgroundTransparency = 1,
		Parent = gui,
	})
	local color = if data.Approved then C.Green else C.Red
	UI.stroke(stampFrame, 8, color)
	UI.corner(stampFrame, 10)
	local word = UI.text(
		stampFrame,
		if data.Approved then "APPROVED" else "DENIED",
		{ TextColor3 = color, FontFace = UI.Bold, Size = UDim2.fromScale(0.9, 0.8), Position = UDim2.fromScale(0.05, 0.1) }
	)
	local scale = UI.new("UIScale", { Scale = 2.2, Parent = stampFrame })
	UI.tween(scale, 0.18, { Scale = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	HUD.Toast(data.Text, if data.Correct then "success" else "warn")
	if not data.Correct then
		local flash =
			UI.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = C.Red, BackgroundTransparency = 0.6, Parent = gui })
		UI.tween(flash, 0.8, { BackgroundTransparency = 1 })
		task.delay(0.9, function()
			flash:Destroy()
		end)
	end
	task.delay(1.4, function()
		UI.tween(word, 0.4, { TextTransparency = 1 })
		local s = stampFrame:FindFirstChildOfClass("UIStroke")
		if s then
			UI.tween(s, 0.4, { Transparency = 1 })
		end
		task.wait(0.45)
		stampFrame:Destroy()
	end)
end

-- ===== Results =====
function HUD.Results(data)
	closeMenu()
	local title = if data.Survived
		then "SHIFT " .. data.Shift .. " COMPLETE"
		elseif data.Why == "fired" then "YOU'RE FIRED"
		else "THE STATION IS LOST"
	local frame, body = UI.modal(
		menuLayer,
		"FROSTLINE CENTRAL · SHIFT REPORT",
		title,
		if data.Survived then "✅" else "💀",
		UDim2.fromOffset(620, 560),
		closeMenu
	)
	openMenu = frame
	UI.list(body, 8, false, Enum.HorizontalAlignment.Center)
	local summary = (if data.Perfect then "⭐ PERFECT SHIFT ⭐\n" else "") .. "Correct: " .. data.Correct .. "   Mistakes: " .. data.Wrong
	UI.text(body, summary, { Size = UDim2.new(1, 0, 0, if data.Perfect then 70 else 36), TextColor3 = C.Ink, LayoutOrder = 1 })
	UI.text(
		body,
		"+$" .. data.Cash .. "    +" .. data.Candy .. " 🍬",
		{ Size = UDim2.new(1, 0, 0, 44), TextColor3 = C.GreenDark, LayoutOrder = 2 }
	)
	if data.Escaped > 0 then
		UI.text(
			body,
			data.Escaped .. " of them boarded the train...",
			{ Size = UDim2.new(1, 0, 0, 30), TextColor3 = C.Red, LayoutOrder = 3 }
		)
	end
	local list = UI.new("ScrollingFrame", {
		Size = UDim2.new(1, 0, 0, 240),
		BackgroundColor3 = C.PaperDark,
		ScrollBarThickness = 8,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		LayoutOrder = 4,
		Parent = body,
	})
	UI.corner(list, 8)
	UI.pad(list, 8)
	UI.list(list, 4)
	for i, entry in data.Log do
		local mark = if entry.Correct then "✅" else "❌"
		local action = if entry.Approved then "approved" else "denied"
		local extra = if entry.Anomaly
			then " — it was NOT human (" .. entry.Anomaly .. ")"
			elseif not entry.Correct then " — " .. entry.Reason
			else ""
		UI.text(list, mark .. " " .. entry.Name .. " " .. action .. extra, {
			Size = UDim2.new(1, 0, 0, 26),
			TextScaled = false,
			TextSize = 20,
			FontFace = UI.Hand,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextColor3 = if entry.Correct then C.Ink else C.Red,
			LayoutOrder = i,
		})
	end
	UI.button(
		body,
		if data.Survived then "NEXT: SHIFT " .. data.NextShift .. " →" else "TRY AGAIN →",
		C.Green,
		closeMenu,
		{ Size = UDim2.fromOffset(320, 60), LayoutOrder = 5 }
	)
end

-- ===== Menus =====
function HUD.OpenParty(padIndex: number)
	closeMenu()
	local size, friendsOnly = 1, false
	local frame, body = UI.modal(menuLayer, "FROSTLINE CENTRAL", "CREATE PARTY", "🚆", UDim2.fromOffset(820, 520), closeMenu)
	openMenu = frame
	UI.text(body, "PARTY SIZE", { Size = UDim2.new(1, 0, 0, 74), TextColor3 = C.Ink })
	UI.text(
		body,
		"Maximum players, including you",
		{ Size = UDim2.new(1, 0, 0, 34), Position = UDim2.fromOffset(0, 74), TextColor3 = C.Navy }
	)
	local row =
		UI.new("Frame", { Size = UDim2.new(1, 0, 0, 130), Position = UDim2.fromOffset(0, 124), BackgroundTransparency = 1, Parent = body })
	UI.list(row, 22, true, Enum.HorizontalAlignment.Center)
	local buttons = {}
	local function paint()
		for i, b in buttons do
			b.BackgroundColor3 = if i == size then C.NavyDark else Color3.fromRGB(220, 232, 252)
			b.TextColor3 = if i == size then C.White else Color3.fromRGB(30, 60, 200)
		end
	end
	for i = 1, Config.Party.MaxSize do
		local b = UI.new(
			"TextButton",
			{ Size = UDim2.fromOffset(126, 126), Text = tostring(i), FontFace = UI.Title, TextScaled = true, LayoutOrder = i, Parent = row }
		)
		UI.corner(b, 6)
		UI.stroke(b, 3, C.NavyDark)
		UI.pad(b, 14)
		b.MouseButton1Click:Connect(function()
			size = i
			paint()
		end)
		buttons[i] = b
	end
	paint()
	UI.new("Frame", { Size = UDim2.new(1, -20, 0, 3), Position = UDim2.fromOffset(10, 272), BackgroundColor3 = C.NavyDark, Parent = body })
	local friends
	friends = UI.button(body, "👥 FRIENDS ONLY", Color3.fromRGB(200, 204, 214), function()
		friendsOnly = not friendsOnly
		friends.BackgroundColor3 = if friendsOnly then C.Navy else Color3.fromRGB(200, 204, 214)
		friends.TextColor3 = if friendsOnly then C.White else C.Ink
	end, { Size = UDim2.fromOffset(320, 78), Position = UDim2.new(0.5, -340, 0, 296), TextColor3 = C.Ink })
	UI.button(body, "CREATE PARTY →", C.Green, function()
		local ok, msg = Remotes.CreateParty:InvokeServer(padIndex, size, friendsOnly)
		HUD.Toast(msg, if ok then "success" else "warn")
		if ok then
			closeMenu()
		end
	end, { Size = UDim2.fromOffset(320, 78), Position = UDim2.new(0.5, 20, 0, 296) })
end

function HUD.Buy(kind: string, key: string)
	local info = if kind == "Pass" then Config.GamePasses[key] else Config.Products[key]
	if not info or info.Id == 0 then
		HUD.Toast("This item isn't set up yet (add its ID in Config).", "warn")
		return
	end
	if kind == "Pass" then
		MarketplaceService:PromptGamePassPurchase(player, info.Id)
	else
		MarketplaceService:PromptProductPurchase(player, info.Id)
	end
end

local function shopCard(parent: Instance, order: number, info, owned: boolean, onBuy: () -> ())
	local card = UI.new("Frame", { Size = UDim2.new(1, -12, 0, 92), BackgroundColor3 = C.White, LayoutOrder = order, Parent = parent })
	UI.corner(card, 10)
	UI.stroke(card, 3, C.NavyDark)
	UI.text(card, info.Name, {
		Size = UDim2.new(0.62, 0, 0, 40),
		Position = UDim2.fromOffset(14, 6),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = C.Ink,
	})
	UI.text(card, info.Description, {
		Size = UDim2.new(0.62, 0, 0, 36),
		Position = UDim2.fromOffset(14, 48),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Color3.fromRGB(80, 86, 100),
		FontFace = UI.Hand,
	})
	UI.button(
		card,
		if owned then "OWNED" else " " .. info.Price .. " R$",
		if owned then Color3.fromRGB(150, 150, 160) else C.Green,
		function()
			if not owned then
				onBuy()
			end
		end,
		{ Size = UDim2.fromOffset(170, 62), Position = UDim2.new(1, -184, 0, 15) }
	)
end

function HUD.OpenShop(tab: string?)
	closeMenu()
	local frame, body = UI.modal(menuLayer, "FROSTLINE CENTRAL", "STATION SHOP", "🛒", UDim2.fromOffset(760, 600), closeMenu)
	openMenu = frame
	local tabs = UI.new("Frame", { Size = UDim2.new(1, 0, 0, 54), BackgroundTransparency = 1, Parent = body })
	UI.list(tabs, 10, true)
	local list = UI.new("ScrollingFrame", {
		Size = UDim2.new(1, 0, 1, -66),
		Position = UDim2.fromOffset(0, 66),
		BackgroundTransparency = 1,
		ScrollBarThickness = 8,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Parent = body,
	})
	UI.list(list, 10)
	local function show(name)
		for _, child in list:GetChildren() do
			if child:IsA("GuiObject") then
				child:Destroy()
			end
		end
		if name == "Passes" then
			for i, key in Config.PassOrder do
				shopCard(list, i, Config.GamePasses[key], player:GetAttribute("Pass_" .. key) == true, function()
					HUD.Buy("Pass", key)
				end)
			end
		else
			local keys = if name == "Currency"
				then { "CandySmall", "CandyLarge", "CashSmall", "CashLarge" }
				else { "Hint", "Revive", "PowerSurge" }
			for i, key in keys do
				shopCard(list, i, Config.Products[key], false, function()
					HUD.Buy("Product", key)
				end)
			end
		end
	end
	for i, entry in { { "Passes", "⭐ PASSES" }, { "Items", "⚡ ITEMS" }, { "Currency", "🍬 CANDY & CASH" } } do
		UI.button(tabs, entry[2], C.Navy, function()
			show(entry[1])
		end, { Size = UDim2.fromOffset(220, 50), LayoutOrder = i })
	end
	show(tab or "Passes")
end

function HUD.OpenSkins(halloweenFirst: boolean?)
	closeMenu()
	local frame, body = UI.modal(menuLayer, "FROSTLINE CENTRAL", "SKINS", "👔", UDim2.fromOffset(820, 620), closeMenu)
	openMenu = frame
	local grid = UI.new("ScrollingFrame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ScrollBarThickness = 8,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Parent = body,
	})
	UI.new("UIGridLayout", {
		CellSize = UDim2.fromOffset(240, 230),
		CellPadding = UDim2.fromOffset(12, 12),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = grid,
	})
	local function render()
		for _, child in grid:GetChildren() do
			if child:IsA("GuiObject") then
				child:Destroy()
			end
		end
		for i, skin in Config.Skins do
			local owned = player:GetAttribute("OwnedSkin_" .. skin.Key) == true
			local equipped = player:GetAttribute("Skin") == skin.Key
			local card = UI.new(
				"Frame",
				{ BackgroundColor3 = C.White, LayoutOrder = if halloweenFirst and skin.Halloween then i - 100 else i, Parent = grid }
			)
			UI.corner(card, 10)
			UI.stroke(card, 3, if skin.Halloween then Color3.fromRGB(230, 110, 10) else C.NavyDark)
			local swatch = UI.new(
				"Frame",
				{ Size = UDim2.new(1, -20, 0, 100), Position = UDim2.fromOffset(10, 10), BackgroundColor3 = skin.Coat, Parent = card }
			)
			UI.corner(swatch, 8)
			UI.new("Frame", {
				Size = UDim2.new(0, 14, 1, 0),
				Position = UDim2.new(0.5, -7, 0, 0),
				BackgroundColor3 = skin.Trim,
				BorderSizePixel = 0,
				Parent = swatch,
			})
			if skin.Halloween then
				UI.text(swatch, "🎃", { Size = UDim2.fromOffset(40, 40), Position = UDim2.new(1, -44, 0, 4), FontFace = UI.Bold })
			end
			UI.text(card, skin.Name, { Size = UDim2.new(1, -16, 0, 34), Position = UDim2.fromOffset(8, 114), TextColor3 = C.Ink })
			local label = if equipped
				then "EQUIPPED"
				elseif owned then "EQUIP"
				else (if skin.Currency == "Candy" then "🍬 " else "$") .. Format.Abbrev(skin.Price)
			local color = if equipped then Color3.fromRGB(150, 150, 160) elseif owned then C.Navy else C.Green
			UI.button(card, label, color, function()
				if equipped then
					return
				end
				local ok, msg
				if owned then
					ok, msg = Remotes.EquipSkin:InvokeServer(skin.Key)
				else
					ok, msg = Remotes.BuySkin:InvokeServer(skin.Key)
				end
				HUD.Toast(msg, if ok then "success" else "warn")
				if not ok and not owned then
					HUD.OpenShop("Currency")
					return
				end
				render()
			end, { Size = UDim2.new(1, -20, 0, 60), Position = UDim2.fromOffset(10, 156) })
		end
	end
	render()
end

function HUD.OpenRewards()
	closeMenu()
	local frame, body = UI.modal(menuLayer, "FROSTLINE CENTRAL", "DAILY REWARDS", "🎁", UDim2.fromOffset(860, 420), closeMenu)
	openMenu = frame
	local row = UI.new("Frame", { Size = UDim2.new(1, 0, 0, 170), BackgroundTransparency = 1, Parent = body })
	UI.list(row, 8, true, Enum.HorizontalAlignment.Center)
	local streak = player:GetAttribute("DailyStreak") or 0
	local ready = player:GetAttribute("DailyReady") == true
	local nextDay = (if ready then streak else streak - 1) % #Config.DailyRewards + 1
	for day, reward in Config.DailyRewards do
		local isNext = day == nextDay
		local card = UI.new(
			"Frame",
			{ Size = UDim2.fromOffset(104, 160), BackgroundColor3 = if isNext then C.Yellow else C.White, LayoutOrder = day, Parent = row }
		)
		UI.corner(card, 10)
		UI.stroke(card, 3, C.NavyDark)
		UI.text(card, "DAY " .. day, { Size = UDim2.new(1, -10, 0, 30), Position = UDim2.fromOffset(5, 6), TextColor3 = C.Ink })
		UI.text(
			card,
			if reward.Candy and not reward.Cash then "🍬" elseif reward.Cash and reward.Candy then "🎁" else "💵",
			{ Size = UDim2.new(1, 0, 0, 56), Position = UDim2.fromOffset(0, 40), FontFace = UI.Bold }
		)
		local text = {}
		if reward.Cash then
			table.insert(text, "$" .. reward.Cash)
		end
		if reward.Candy then
			table.insert(text, reward.Candy .. " 🍬")
		end
		UI.text(
			card,
			table.concat(text, "\n"),
			{ Size = UDim2.new(1, -10, 0, 50), Position = UDim2.fromOffset(5, 100), TextColor3 = C.Ink }
		)
	end
	UI.button(
		body,
		if ready then "CLAIM DAY " .. nextDay .. "!" else "COME BACK TOMORROW",
		if ready then C.Green else Color3.fromRGB(150, 150, 160),
		function()
			if not ready then
				return
			end
			local ok, msg = Remotes.ClaimDaily:InvokeServer()
			HUD.Toast(msg, if ok then "success" else "warn")
			closeMenu()
		end,
		{ Size = UDim2.fromOffset(360, 66), Position = UDim2.new(0.5, -180, 0, 196) }
	)
	if player:GetAttribute("Pass_VIP") then
		UI.text(
			body,
			"👑 VIP: rewards doubled",
			{ Size = UDim2.new(1, 0, 0, 28), Position = UDim2.fromOffset(0, 270), TextColor3 = Color3.fromRGB(200, 150, 20) }
		)
	end
end

function HUD.Init()
	gui = UI.new("ScreenGui", {
		Name = "FrostlineHUD",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = player:WaitForChild("PlayerGui"),
	})
	HUD.Gui = gui
	buildLobby()
	buildShift()
	menuLayer = UI.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 5, Parent = gui })
	toastHolder =
		UI.new("Frame", { Size = UDim2.new(1, 0, 0, 200), Position = UDim2.fromScale(0, 0.3), BackgroundTransparency = 1, Parent = gui })
	UI.list(toastHolder, 6, false, Enum.HorizontalAlignment.Center)
	bannerLabel = UI.text(gui, "", { Size = UDim2.new(0.7, 0, 0, 110), Position = UDim2.new(0.15, 0, 0.16, 0), TextTransparency = 1 })
	UI.outlined(bannerLabel, 4)
	-- Scale the layers down on small screens (phones)
	for _, layer in { lobbyLayer, shiftLayer, menuLayer } do
		local s = UI.new("UIScale", { Parent = layer })
		local function apply()
			local camera = workspace.CurrentCamera
			local size = camera and camera.ViewportSize or Vector2.new(1920, 1080)
			s.Scale = math.clamp(math.min(size.X / 1600, size.Y / 900), 0.5, 1.1)
			layer.Size = UDim2.fromScale(1 / s.Scale, 1 / s.Scale)
		end
		apply()
		if workspace.CurrentCamera then
			workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(apply)
		end
	end

	Remotes.Notify.OnClientEvent:Connect(HUD.Toast)
	Remotes.Announce.OnClientEvent:Connect(HUD.Announce)
	Remotes.Objective.OnClientEvent:Connect(HUD.SetObjective)
	Remotes.ShiftState.OnClientEvent:Connect(HUD.SetShiftState)
	Remotes.Verdict.OnClientEvent:Connect(HUD.Verdict)
	Remotes.Results.OnClientEvent:Connect(HUD.Results)
	Remotes.Blackout.OnClientEvent:Connect(HUD.SetBlackout)
	Remotes.PartyPrompt.OnClientEvent:Connect(HUD.OpenParty)
	Remotes.OpenMenu.OnClientEvent:Connect(function(name, arg)
		if name == "Shop" then
			HUD.OpenShop()
		elseif name == "Skins" then
			HUD.OpenSkins(arg ~= nil and arg ~= "Standard")
		elseif name == "Rewards" then
			HUD.OpenRewards()
		end
	end)
	RunService.Heartbeat:Connect(function()
		if HUD.BlackoutDeadline then
			local left = math.max(0, math.floor(HUD.BlackoutDeadline - workspace:GetServerTimeNow()))
			blackoutLabel.Text = "⚡ RESTORE POWER  " .. (HUD.Breakers or "") .. "   ·   " .. Format.Time(left)
		end
	end)
	HUD.SetShiftState(nil)
end

HUD.OnRules = function() end

return HUD
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">Inspect</string>
            <string name="Source"><![CDATA[-- The inspection tool panels (passport, X-ray, body scan, CCTV, thermal, lie detector,
-- fingerprints, eye exam, brain scan, rulebook).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Remotes)

local UI = require(script.Parent.UI)

local C = UI.Colors
local Inspect = {}

local layer: Frame
local current: Frame? = nil
local cleanup: { RBXScriptConnection } = {}

local function close()
	for _, conn in cleanup do
		conn:Disconnect()
	end
	cleanup = {}
	if current then
		current:Destroy()
		current = nil
	end
end
Inspect.Close = close

-- A panel shell: dark frame with a title bar and close button.
local function panel(title: string, color: Color3, size: Vector2): Frame
	close()
	local frame = UI.new("Frame", {
		Size = UDim2.fromOffset(size.X, size.Y),
		Position = UDim2.new(0.34, 0, 0.52, 0),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = Color3.fromRGB(24, 26, 32),
		Parent = layer,
	})
	UI.corner(frame, 12)
	UI.stroke(frame, 4, C.Black)
	local bar = UI.new("Frame", { Size = UDim2.new(1, 0, 0, 50), BackgroundColor3 = color, Parent = frame })
	UI.corner(bar, 12)
	UI.new(
		"Frame",
		{ Size = UDim2.new(1, 0, 0, 12), Position = UDim2.new(0, 0, 1, -12), BackgroundColor3 = color, BorderSizePixel = 0, Parent = bar }
	)
	UI.text(
		bar,
		title,
		{ Size = UDim2.new(1, -80, 0.8, 0), Position = UDim2.fromScale(0.03, 0.1), TextXAlignment = Enum.TextXAlignment.Left }
	)
	UI.button(bar, "X", C.Red, close, { Size = UDim2.fromOffset(42, 42), Position = UDim2.new(1, -46, 0, 4), FontFace = UI.Bold })
	local body = UI.new(
		"Frame",
		{ Name = "Body", Size = UDim2.new(1, -24, 1, -64), Position = UDim2.fromOffset(12, 58), BackgroundTransparency = 1, Parent = frame }
	)
	current = frame
	UI.pop(frame)
	return body
end

-- Clone a character into a viewport, framed on the head (portrait) or full body.
local function viewport(parent: Instance, model: Model?, framing: string, mutate: ((Model) -> ())?): ViewportFrame
	local vp = UI.new("ViewportFrame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(190, 200, 214),
		Ambient = Color3.fromRGB(170, 170, 170),
		LightColor = Color3.new(1, 1, 1),
		LightDirection = Vector3.new(-0.4, -1, -0.6),
		Parent = parent,
	})
	if not model or not model.Parent then
		UI.text(vp, "NO SIGNAL", { Size = UDim2.fromScale(0.8, 0.3), Position = UDim2.fromScale(0.1, 0.35), TextColor3 = C.Red })
		return vp
	end
	local was = model.Archivable
	model.Archivable = true
	local clone = model:Clone()
	model.Archivable = was
	if not clone then
		return vp
	end
	for _, d in clone:GetDescendants() do
		if d:IsA("Script") or d:IsA("LocalScript") or d:IsA("Sound") then
			d:Destroy()
		end
	end
	local suitcase = clone:FindFirstChild("Suitcase")
	if suitcase then
		suitcase:Destroy()
	end
	if mutate then
		mutate(clone)
	end
	clone.Parent = vp
	local camera = UI.new("Camera", { FieldOfView = 26, Parent = vp })
	local head = clone:FindFirstChild("Head") :: BasePart?
	local root = clone:FindFirstChild("HumanoidRootPart") :: BasePart?
	if framing == "Portrait" and head then
		local front = head.CFrame
		camera.CFrame = CFrame.lookAt((front * CFrame.new(0, 0.05, -5.2)).Position, front.Position)
	elseif root then
		local front = root.CFrame
		camera.FieldOfView = 40
		camera.CFrame = CFrame.lookAt((front * CFrame.new(1.5, 3.5, -10)).Position, front.Position + Vector3.new(0, 0.5, 0))
	end
	vp.CurrentCamera = camera
	return vp
end

local function addFacePart(head: BasePart, size: Vector3, offset: CFrame, color: Color3, material: Enum.Material?)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.Size = size
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.CFrame = head.CFrame * offset
	p.Parent = head.Parent
	return p
end

local function field(parent: Instance, y: number, label: string, value: string, x: number?, width: number?)
	UI.text(parent, label, {
		Size = UDim2.fromOffset(width or 220, 18),
		Position = UDim2.fromOffset(x or 0, y),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Color3.fromRGB(110, 70, 70),
		FontFace = UI.Bold,
	})
	UI.text(parent, value, {
		Size = UDim2.fromOffset(width or 220, 28),
		Position = UDim2.fromOffset(x or 0, y + 17),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = C.Ink,
		FontFace = UI.Mono,
	})
end

local tools = {}

function tools.Passport(data)
	local body = panel("🛂 PASSPORT & TICKET", Color3.fromRGB(120, 24, 36), Vector2.new(720, 520))
	-- Passport booklet
	local book = UI.new("Frame", { Size = UDim2.fromOffset(420, 330), BackgroundColor3 = Color3.fromRGB(246, 236, 220), Parent = body })
	UI.corner(book, 8)
	UI.stroke(book, 3, Color3.fromRGB(120, 24, 36))
	UI.text(book, "REPUBLIC OF " .. string.upper(data.Country) .. "  ·  PASSPORT", {
		Size = UDim2.new(1, -20, 0, 26),
		Position = UDim2.fromOffset(10, 6),
		TextColor3 = Color3.fromRGB(120, 24, 36),
		FontFace = UI.Bold,
	})
	local photoFrame = UI.new(
		"Frame",
		{ Size = UDim2.fromOffset(150, 186), Position = UDim2.fromOffset(12, 40), BackgroundColor3 = C.White, Parent = book }
	)
	UI.stroke(photoFrame, 2, Color3.fromRGB(80, 80, 80))
	viewport(photoFrame, data.Model, "Portrait", function(clone)
		local head = clone:FindFirstChild("Head") :: BasePart?
		if not head or not data.Photo then
			return
		end
		if data.Photo == "BlackEyes" then
			for _, x in { -0.2, 0.2 } do
				addFacePart(head, Vector3.new(0.22, 0.26, 0.05), CFrame.new(x, 0.12, -0.6), Color3.new(0, 0, 0))
			end
		elseif data.Photo == "WrongHair" then
			local hair = clone:FindFirstChild("Hair")
			local recolored = false
			if hair then
				for _, p in hair:GetDescendants() do
					if p:IsA("BasePart") then
						p.Color = Color3.fromRGB(250, 250, 250)
						recolored = true
					end
				end
			end
			if not recolored then
				addFacePart(head, Vector3.new(1.3, 0.5, 1.3), CFrame.new(0, 0.62, 0.05), Color3.fromRGB(240, 120, 20))
			end
		elseif data.Photo == "WideSmile" then
			addFacePart(head, Vector3.new(1.05, 0.12, 0.05), CFrame.new(0, -0.22, -0.6), Color3.fromRGB(30, 0, 0))
			for i = -4, 4 do
				addFacePart(head, Vector3.new(0.05, 0.08, 0.05), CFrame.new(i * 0.11, -0.17, -0.62), Color3.new(1, 1, 1))
			end
		end
	end)
	local info = UI.new(
		"Frame",
		{ Size = UDim2.fromOffset(240, 280), Position = UDim2.fromOffset(176, 40), BackgroundTransparency = 1, Parent = book }
	)
	field(info, 0, "SURNAME", string.upper(data.Last))
	field(info, 46, "GIVEN NAME", string.upper(data.First))
	field(info, 92, "DATE OF BIRTH", data.Birth)
	field(info, 138, "PASSPORT NO.", data.PassportNo)
	field(info, 184, "EXPIRES", data.Expiry)
	if data.Print then
		field(info, 230, "FINGERPRINT", string.upper(data.Print))
	end
	UI.text(book, "<<" .. string.upper(data.Last) .. "<<" .. string.upper(data.First) .. "<<<<<<<<<" .. data.PassportNo, {
		Size = UDim2.new(1, -20, 0, 22),
		Position = UDim2.new(0, 10, 1, -30),
		TextColor3 = Color3.fromRGB(80, 80, 90),
		FontFace = UI.Mono,
	})
	-- Ticket
	local ticket = UI.new("Frame", {
		Size = UDim2.fromOffset(260, 330),
		Position = UDim2.fromOffset(436, 0),
		BackgroundColor3 = Color3.fromRGB(250, 248, 240),
		Parent = body,
	})
	UI.corner(ticket, 8)
	UI.stroke(ticket, 3, C.Navy)
	local band = UI.new("Frame", { Size = UDim2.new(1, 0, 0, 44), BackgroundColor3 = C.Navy, Parent = ticket })
	UI.corner(band, 8)
	UI.text(band, "🚆 FROSTLINE NIGHT TRAIN", { Size = UDim2.fromScale(0.92, 0.7), Position = UDim2.fromScale(0.04, 0.15) })
	local tinfo = UI.new(
		"Frame",
		{ Size = UDim2.new(1, -24, 1, -60), Position = UDim2.fromOffset(12, 54), BackgroundTransparency = 1, Parent = ticket }
	)
	field(tinfo, 0, "PASSENGER", string.upper(data.Ticket.Name), 0, 236)
	field(tinfo, 52, "DESTINATION", string.upper(data.Ticket.Destination), 0, 236)
	field(tinfo, 104, "VALID FOR", "NIGHT " .. data.Ticket.Night, 0, 236)
	field(tinfo, 156, "CLASS", "SLEEPER · CAR 3", 0, 236)
	UI.text(tinfo, "TODAY: " .. data.Today, {
		Size = UDim2.fromOffset(236, 24),
		Position = UDim2.fromOffset(0, 220),
		TextColor3 = C.Red,
		FontFace = UI.Bold,
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	-- Stamp buttons
	UI.button(body, "✔ APPROVE (F)", C.Green, function()
		Remotes.Decide:InvokeServer(true)
	end, { Size = UDim2.fromOffset(330, 70), Position = UDim2.fromOffset(10, 352) })
	UI.button(body, "✖ DENY (G)", C.Red, function()
		Remotes.Decide:InvokeServer(false)
	end, { Size = UDim2.fromOffset(330, 70), Position = UDim2.fromOffset(356, 352) })
end

function tools.Rulebook(data)
	local body = panel("📋 TONIGHT'S RULES · SHIFT " .. (data.Shift or "?"), C.Navy, Vector2.new(620, 560))
	local paper = UI.new("ScrollingFrame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(250, 248, 236),
		ScrollBarThickness = 8,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Parent = body,
	})
	UI.corner(paper, 8)
	UI.pad(paper, 14)
	UI.list(paper, 10)
	for i, line in data.Lines do
		local label = UI.text(paper, i .. ". " .. line, {
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			TextScaled = false,
			TextSize = 23,
			TextWrapped = true,
			FontFace = UI.Hand,
			TextColor3 = if string.find(line, "NOT human") then C.Red else C.Ink,
			TextXAlignment = Enum.TextXAlignment.Left,
			LayoutOrder = i,
		})
		local _ = label
	end
end

function tools.XRay(data)
	local body = panel("☢ X-RAY · LUGGAGE", Color3.fromRGB(40, 70, 160), Vector2.new(620, 460))
	local screen = UI.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(10, 26, 60), Parent = body })
	UI.corner(screen, 8)
	UI.new(
		"UIGradient",
		{ Color = ColorSequence.new(Color3.fromRGB(20, 50, 110), Color3.fromRGB(6, 14, 40)), Rotation = 90, Parent = screen }
	)
	-- Suitcase outline
	local case = UI.new(
		"Frame",
		{ Size = UDim2.new(1, -40, 1, -40), Position = UDim2.fromOffset(20, 20), BackgroundTransparency = 1, Parent = screen }
	)
	UI.stroke(case, 4, Color3.fromRGB(120, 200, 255))
	UI.corner(case, 16)
	UI.pad(case, 16)
	UI.new("UIGridLayout", {
		CellSize = UDim2.fromOffset(170, 150),
		CellPadding = UDim2.fromOffset(12, 12),
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		Parent = case,
	})
	for _, item in data.Items do
		local cell = UI.new("Frame", { BackgroundTransparency = 1, Parent = case })
		local icon = UI.text(cell, item.Icon, { Size = UDim2.new(1, 0, 0.72, 0), FontFace = UI.Bold, TextTransparency = 0.15 })
		local _ = icon
		UI.text(cell, item.Name, {
			Size = UDim2.new(1, 0, 0.24, 0),
			Position = UDim2.fromScale(0, 0.74),
			TextColor3 = Color3.fromRGB(170, 220, 255),
			FontFace = UI.Mono,
		})
		if item.Category == "Anomalous" then
			task.spawn(function()
				while cell.Parent do
					icon.Rotation = math.random(-4, 4)
					task.wait(0.08)
				end
			end)
		end
	end
end

function tools.Skeleton(data)
	local body = panel("🦴 BODY SCAN", Color3.fromRGB(30, 120, 140), Vector2.new(480, 560))
	local screen = UI.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(6, 30, 36), Parent = body })
	UI.corner(screen, 8)
	local s = data.Skeleton
	local bone = Color3.fromRGB(220, 250, 255)
	local function line(x, y, w, h, rot)
		local f = UI.new("Frame", {
			Size = UDim2.fromOffset(w, h),
			Position = UDim2.fromOffset(x, y),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Rotation = rot or 0,
			BackgroundColor3 = bone,
			Parent = screen,
		})
		UI.corner(f, math.min(w, h) // 2)
		return f
	end
	local cx = 228
	local stretch = if s.LongArms then 1.5 else 1
	if s.Skull > 0 then
		local skull = line(cx, 64, 62, 72)
		UI.corner(skull, 30)
		for _, dx in { -12, 12 } do
			local eye = UI.new("Frame", {
				Size = UDim2.fromOffset(14, 16),
				Position = UDim2.fromOffset(31 + dx - 7, 28),
				BackgroundColor3 = Color3.fromRGB(6, 30, 36),
				Parent = skull,
			})
			UI.corner(eye, 7)
		end
	end
	if s.Ribs ~= "None" then
		line(cx, 230, 10, 200) -- spine
		local pairs_ = if s.Ribs == "Extra" then 10 else 6
		for i = 1, pairs_ do
			local y = 130 + i * (120 / pairs_)
			line(cx - 34, y, 60, 6, 12)
			line(cx + 34, y, 60, 6, -12)
		end
		line(cx, 336, 90, 16) -- pelvis
	end
	for side = -1, 1, 2 do
		if s.Arms > 0 then
			line(cx + side * 80, 160 + 40 * stretch, 10, 110 * stretch, side * -12)
			line(cx + side * 98, 160 + 80 * stretch + 60 * stretch, 9, 100 * stretch, side * -4)
		end
		if s.Legs > 0 then
			line(cx + side * 28, 400, 12, 120, side * 4)
			line(cx + side * 34, 486, 11, 100, 0)
		end
	end
	local height = math.floor(data.Height * 175) / 100
	UI.text(screen, "HEIGHT " .. height .. " m", {
		Size = UDim2.fromOffset(200, 26),
		Position = UDim2.fromOffset(10, 8),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = C.Cyan,
		FontFace = UI.Mono,
	})
	-- Scan sweep
	local sweep = UI.new(
		"Frame",
		{ Size = UDim2.new(1, 0, 0, 4), BackgroundColor3 = C.Cyan, BackgroundTransparency = 0.3, BorderSizePixel = 0, Parent = screen }
	)
	table.insert(
		cleanup,
		RunService.RenderStepped:Connect(function()
			sweep.Position = UDim2.fromScale(0, (os.clock() * 0.4) % 1)
		end)
	)
end

function tools.Camera(data)
	local body = panel("📹 CCTV · CAM 0" .. (data.Lane or 1), Color3.fromRGB(30, 30, 34), Vector2.new(640, 480))
	local holder = UI.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ClipsDescendants = true, Parent = body })
	local vp = viewport(holder, data.Model, "Full", function(clone)
		if not data.TrueForm then
			return
		end
		-- The camera sees what it really is
		for _, p in clone:GetDescendants() do
			if p:IsA("BasePart") then
				p.Color = Color3.fromRGB(12, 12, 14)
				p.Material = Enum.Material.SmoothPlastic
			elseif p:IsA("Decal") then
				p:Destroy()
			end
		end
		local head = clone:FindFirstChild("Head") :: BasePart?
		if head then
			head.Size *= Vector3.new(1, 1.35, 1)
			for _, x in { -0.24, 0.24 } do
				addFacePart(head, Vector3.new(0.26, 0.36, 0.05), CFrame.new(x, 0.18, -0.62), Color3.new(1, 1, 1), Enum.Material.Neon)
			end
			addFacePart(head, Vector3.new(0.9, 0.5, 0.05), CFrame.new(0, -0.35, -0.62), Color3.fromRGB(120, 0, 0), Enum.Material.Neon)
		end
	end)
	vp.BackgroundColor3 = Color3.fromRGB(40, 50, 44)
	vp.ImageColor3 = Color3.fromRGB(170, 255, 190)
	vp.Ambient = Color3.fromRGB(120, 140, 120)
	-- Scanlines + noise + timestamp
	for i = 0, 40 do
		UI.new("Frame", {
			Size = UDim2.new(1, 0, 0, 1),
			Position = UDim2.fromScale(0, i / 40),
			BackgroundColor3 = C.Black,
			BackgroundTransparency = 0.75,
			BorderSizePixel = 0,
			Parent = holder,
		})
	end
	local rec = UI.text(holder, "● REC", {
		Size = UDim2.fromOffset(100, 30),
		Position = UDim2.fromOffset(12, 10),
		TextColor3 = C.Red,
		FontFace = UI.Mono,
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	local clock = UI.text(holder, "", {
		Size = UDim2.fromOffset(240, 26),
		Position = UDim2.new(1, -252, 1, -36),
		TextColor3 = C.White,
		FontFace = UI.Mono,
		TextXAlignment = Enum.TextXAlignment.Right,
	})
	local noise = UI.new(
		"Frame",
		{ Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.95, Parent = holder }
	)
	table.insert(
		cleanup,
		RunService.RenderStepped:Connect(function()
			rec.Visible = os.clock() % 1 < 0.6
			clock.Text = os.date("!%H:%M:%S", 4380 + math.floor(os.clock())) .. "  12/2026"
			noise.BackgroundTransparency = 0.9 + math.random() * 0.08
			if data.TrueForm and math.random() < 0.04 then
				vp.Position = UDim2.fromOffset(math.random(-8, 8), 0)
			else
				vp.Position = UDim2.new()
			end
		end)
	)
end

function tools.Thermal(data)
	local body = panel("🌡 THERMAL CAMERA", Color3.fromRGB(190, 80, 20), Vector2.new(460, 480))
	local screen = UI.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(10, 0, 40), Parent = body })
	UI.corner(screen, 8)
	local t = data.Temperature
	local heat = math.clamp((t - 5) / 35, 0, 1)
	local hot = Color3.fromRGB(40, 60, 255):Lerp(Color3.fromRGB(255, 220, 40), heat)
	if t >= 38 then
		hot = Color3.fromRGB(255, 70, 20)
	end
	-- Silhouette
	local head =
		UI.new("Frame", { Size = UDim2.fromOffset(80, 96), Position = UDim2.new(0.5, -40, 0, 40), BackgroundColor3 = hot, Parent = screen })
	UI.corner(head, 40)
	local torso = UI.new(
		"Frame",
		{ Size = UDim2.fromOffset(170, 220), Position = UDim2.new(0.5, -85, 0, 140), BackgroundColor3 = hot, Parent = screen }
	)
	UI.corner(torso, 30)
	UI.new("UIGradient", { Color = ColorSequence.new(hot, hot:Lerp(Color3.fromRGB(80, 0, 160), 0.6)), Rotation = 90, Parent = torso })
	UI.new("UIGradient", { Color = ColorSequence.new(hot, hot:Lerp(Color3.fromRGB(80, 0, 160), 0.4)), Rotation = 90, Parent = head })
	local reading = UI.text(
		screen,
		string.format("%.1f °C", t),
		{ Size = UDim2.new(1, 0, 0, 56), Position = UDim2.new(0, 0, 1, -64), TextColor3 = C.White, FontFace = UI.Mono }
	)
	UI.outlined(reading, 2)
end

function tools.Interview(data)
	local body = panel("🎙 LIE DETECTOR · INTERROGATION", Color3.fromRGB(150, 30, 30), Vector2.new(680, 560))
	local graph = UI.new(
		"Frame",
		{ Size = UDim2.new(1, 0, 0, 170), BackgroundColor3 = Color3.fromRGB(246, 244, 232), ClipsDescendants = true, Parent = body }
	)
	UI.corner(graph, 8)
	for i = 1, 4 do
		UI.new("Frame", {
			Size = UDim2.new(1, 0, 0, 1),
			Position = UDim2.fromScale(0, i / 5),
			BackgroundColor3 = Color3.fromRGB(200, 170, 170),
			BorderSizePixel = 0,
			Parent = graph,
		})
	end
	local bars = {}
	local N = 90
	for i = 1, N do
		bars[i] = UI.new("Frame", {
			Size = UDim2.new(1 / N, 1, 0, 2),
			Position = UDim2.fromScale((i - 1) / N, 0.5),
			AnchorPoint = Vector2.new(0, 0.5),
			BackgroundColor3 = Color3.fromRGB(30, 30, 30),
			BorderSizePixel = 0,
			Parent = graph,
		})
	end
	local spikeUntil = 0
	local values = table.create(N, 0)
	local acc = 0
	table.insert(
		cleanup,
		RunService.RenderStepped:Connect(function(dt)
			acc += dt
			if acc < 0.03 then
				return
			end
			acc = 0
			table.remove(values, 1)
			local amp = if os.clock() < spikeUntil then 0.85 else 0.12
			table.insert(values, (math.random() * 2 - 1) * amp)
			for i, v in values do
				bars[i].Size = UDim2.new(1 / N, 1, math.abs(v), 2)
				bars[i].BackgroundColor3 = if math.abs(v) > 0.5 then C.Red else Color3.fromRGB(30, 30, 30)
			end
		end)
	)
	local transcript = UI.new("ScrollingFrame", {
		Size = UDim2.new(1, 0, 0, 170),
		Position = UDim2.fromOffset(0, 180),
		BackgroundColor3 = Color3.fromRGB(34, 36, 44),
		ScrollBarThickness = 6,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Parent = body,
	})
	UI.corner(transcript, 8)
	UI.pad(transcript, 10)
	UI.list(transcript, 6)
	local order = 0
	local function say(who: string, text: string, color: Color3)
		order += 1
		UI.text(transcript, who .. ": " .. text, {
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			TextScaled = false,
			TextSize = 21,
			TextWrapped = true,
			FontFace = UI.Hand,
			TextColor3 = color,
			TextXAlignment = Enum.TextXAlignment.Left,
			LayoutOrder = order,
		})
		transcript.CanvasPosition = Vector2.new(0, 10000)
	end
	local buttons =
		UI.new("Frame", { Size = UDim2.new(1, 0, 0, 130), Position = UDim2.fromOffset(0, 360), BackgroundTransparency = 1, Parent = body })
	UI.list(buttons, 6)
	for i, q in data.Questions do
		UI.button(buttons, "❓ " .. q, C.Navy, function()
			say("YOU", q, C.Cyan)
			local result = Remotes.Ask:InvokeServer(i)
			if result then
				task.wait(0.6)
				say(string.upper(data.Name or "SUSPECT"), result.Answer, if result.Spike then Color3.fromRGB(255, 120, 120) else C.White)
				if result.Spike then
					spikeUntil = os.clock() + 2.5
				end
			end
		end, { Size = UDim2.new(1, 0, 0, 38), LayoutOrder = i, TextXAlignment = Enum.TextXAlignment.Left })
	end
end

local PRINT_GLYPH = {
	Whorl = "🌀",
	Loop = "➰",
	Arch = "⌒",
	["Double Loop"] = "➿",
	["Tented Arch"] = "⛛",
	Spiral = "@",
	Smudged = "▒",
	None = "",
}

function tools.Fingerprint(data)
	local body = panel("🖐 FINGERPRINT SCANNER", Color3.fromRGB(30, 110, 170), Vector2.new(560, 380))
	local function card(x, title, pattern)
		local f = UI.new("Frame", {
			Size = UDim2.fromOffset(250, 290),
			Position = UDim2.fromOffset(x, 0),
			BackgroundColor3 = Color3.fromRGB(230, 244, 255),
			Parent = body,
		})
		UI.corner(f, 10)
		UI.stroke(f, 3, C.Navy)
		UI.text(f, title, { Size = UDim2.new(1, -10, 0, 30), Position = UDim2.fromOffset(5, 6), TextColor3 = C.Ink })
		local pad = UI.new("Frame", {
			Size = UDim2.fromOffset(160, 180),
			Position = UDim2.new(0.5, -80, 0, 44),
			BackgroundColor3 = Color3.fromRGB(250, 250, 250),
			Parent = f,
		})
		UI.corner(pad, 70)
		UI.text(pad, if pattern then PRINT_GLYPH[pattern] or "?" else "—", {
			Size = UDim2.fromScale(0.8, 0.8),
			Position = UDim2.fromScale(0.1, 0.1),
			TextColor3 = Color3.fromRGB(40, 40, 60),
			FontFace = UI.Bold,
		})
		UI.text(f, if pattern == "None" then "NO PRINT DETECTED" else string.upper(pattern or "NOT ON FILE"), {
			Size = UDim2.new(1, -10, 0, 30),
			Position = UDim2.new(0, 5, 1, -40),
			TextColor3 = if pattern == "None" then C.Red else C.Ink,
			FontFace = UI.Mono,
		})
	end
	card(0, "SCANNED NOW", data.Scanned)
	card(276, "PRINTED IN PASSPORT", data.Printed)
end

function tools.Eyes(data)
	local body = panel("👁 EYE EXAM", Color3.fromRGB(90, 60, 150), Vector2.new(560, 380))
	local light = false
	local eyes = {}
	for i, x in { 70, 290 } do
		local white = UI.new("Frame", {
			Size = UDim2.fromOffset(180, 120),
			Position = UDim2.fromOffset(x - 30, 30),
			BackgroundColor3 = Color3.fromRGB(245, 240, 236),
			Parent = body,
		})
		UI.corner(white, 60)
		local iris = UI.new("Frame", {
			Size = UDim2.fromOffset(84, 84),
			Position = UDim2.new(0.5, -42, 0.5, -42),
			BackgroundColor3 = Color3.fromRGB(70, 110, 160),
			Parent = white,
		})
		UI.corner(iris, 42)
		local pupil = UI.new("Frame", {
			Size = UDim2.fromOffset(38, 38),
			Position = UDim2.new(0.5, 0, 0.5, 0),
			AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundColor3 = C.Black,
			Parent = iris,
		})
		UI.corner(pupil, 19)
		if data.Eyes == "NoPupils" then
			pupil.Visible = false
			iris.BackgroundColor3 = Color3.fromRGB(235, 235, 240)
		elseif data.Eyes == "Slit" then
			pupil.Size = UDim2.fromOffset(10, 70)
			iris.BackgroundColor3 = Color3.fromRGB(200, 170, 40)
		elseif data.Eyes == "Glowing" then
			iris.BackgroundColor3 = Color3.fromRGB(120, 230, 255)
			pupil.BackgroundColor3 = Color3.fromRGB(220, 250, 255)
		end
		eyes[i] = pupil
	end
	UI.button(body, "🔦 SHINE LIGHT", Color3.fromRGB(200, 160, 20), function()
		light = not light
		for _, pupil in eyes do
			if data.Eyes == "Normal" then
				UI.tween(pupil, 0.3, { Size = if light then UDim2.fromOffset(16, 16) else UDim2.fromOffset(38, 38) })
			end
		end
	end, { Size = UDim2.fromOffset(300, 64), Position = UDim2.new(0.5, -150, 0, 200) })
end

function tools.Brain(data)
	local body = panel("🧠 NEURO-SCAN", Color3.fromRGB(150, 40, 150), Vector2.new(560, 440))
	local screen = UI.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(14, 10, 26), Parent = body })
	UI.corner(screen, 8)
	local dots = { {}, {} }
	for side = 1, 2 do
		local half = UI.new("Frame", {
			Size = UDim2.fromOffset(210, 260),
			Position = UDim2.fromOffset(if side == 1 then 50 else 276, 40),
			BackgroundColor3 = Color3.fromRGB(60, 40, 80),
			Parent = screen,
		})
		UI.corner(half, 100)
		for i = 1, 24 do
			local d = UI.new("Frame", {
				Size = UDim2.fromOffset(18, 18),
				Position = UDim2.fromScale(0.15 + ((i - 1) % 4) * 0.2, 0.1 + math.floor((i - 1) / 4) * 0.14),
				BackgroundColor3 = Color3.fromRGB(255, 80, 200),
				BackgroundTransparency = 1,
				Parent = half,
			})
			UI.corner(d, 9)
			dots[side][i] = d
		end
	end
	UI.text(screen, "SCANNING...", {
		Size = UDim2.new(1, 0, 0, 30),
		Position = UDim2.new(0, 0, 1, -40),
		TextColor3 = Color3.fromRGB(255, 160, 230),
		FontFace = UI.Mono,
	})
	local acc = 0
	table.insert(
		cleanup,
		RunService.RenderStepped:Connect(function(dt)
			acc += dt
			if acc < 0.12 then
				return
			end
			acc = 0
			for i = 1, 24 do
				local a, b
				if data.Brain == "Flat" then
					a, b = 1, 1
				elseif data.Brain == "Mirror" then
					a = if math.random() < 0.3 then 0 else 1
					b = a
				elseif data.Brain == "Static" then
					a, b = math.random() * 0.6, math.random() * 0.6
					dots[1][i].BackgroundColor3 = Color3.fromRGB(200, 200, 200)
					dots[2][i].BackgroundColor3 = Color3.fromRGB(200, 200, 200)
				else
					a = if math.random() < 0.25 then 0 else 1
					b = if math.random() < 0.25 then 0 else 1
				end
				dots[1][i].BackgroundTransparency = a
				dots[2][i].BackgroundTransparency = b
			end
		end)
	)
end

function Inspect.Open(key: string, data)
	local builder = tools[key]
	if builder and data then
		builder(data)
	end
end

function Inspect.Init(gui: ScreenGui)
	layer = UI.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = gui })
	local s = UI.new("UIScale", { Parent = layer })
	local function apply()
		local camera = workspace.CurrentCamera
		local size = camera and camera.ViewportSize or Vector2.new(1920, 1080)
		s.Scale = math.clamp(math.min(size.X / 1600, size.Y / 900), 0.5, 1.1)
		layer.Size = UDim2.fromScale(1 / s.Scale, 1 / s.Scale)
	end
	apply()
	if workspace.CurrentCamera then
		workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(apply)
	end
	Remotes.OpenTool.OnClientEvent:Connect(Inspect.Open)
	Remotes.CloseTools.OnClientEvent:Connect(close)
end

return Inspect
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="29">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[-- Frostline Checkpoint client entry point.
local HUD = require(script.Parent.HUD)
local Inspect = require(script.Parent.Inspect)
local Effects = require(script.Parent.Effects)

HUD.Init()
Inspect.Init(HUD.Gui)
Effects.Init()

-- The RULES button opens the rulebook from the latest shift state
HUD.OnRules = function()
	local state = HUD.State()
	if state.Shift then
		Inspect.Open("Rulebook", { Lines = state.Shift.Rules, Shift = state.Shift.Shift })
	end
end
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">UI</string>
            <string name="Source"><![CDATA[-- UI building helpers and the game's visual style.
local TweenService = game:GetService("TweenService")

local UI = {}

UI.Colors = {
	Navy = Color3.fromRGB(20, 32, 72),
	NavyDark = Color3.fromRGB(12, 20, 48),
	Paper = Color3.fromRGB(236, 238, 244),
	PaperDark = Color3.fromRGB(214, 218, 230),
	Ink = Color3.fromRGB(16, 22, 48),
	Green = Color3.fromRGB(34, 168, 60),
	GreenDark = Color3.fromRGB(20, 110, 36),
	Red = Color3.fromRGB(205, 30, 30),
	Yellow = Color3.fromRGB(255, 214, 60),
	Cyan = Color3.fromRGB(60, 220, 255),
	Pink = Color3.fromRGB(236, 150, 236),
	Black = Color3.fromRGB(10, 10, 12),
	White = Color3.new(1, 1, 1),
	Cash = Color3.fromRGB(110, 230, 90),
	Candy = Color3.fromRGB(255, 190, 60),
}

-- Hand-drawn look like the screenshots: Kalam for titles, Patrick Hand for body text.
UI.Title = Font.new("rbxasset://fonts/families/Kalam.json", Enum.FontWeight.Bold)
UI.Hand = Font.new("rbxasset://fonts/families/PatrickHand.json")
UI.Bold = Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Bold)
UI.Mono = Font.new("rbxasset://fonts/families/RobotoMono.json", Enum.FontWeight.Bold)

function UI.new(className: string, props: { [string]: any }?, children: { Instance }?): any
	local inst = Instance.new(className)
	if props then
		local parent = props.Parent
		for key, value in props do
			if key ~= "Parent" then
				(inst :: any)[key] = value
			end
		end
		if children then
			for _, child in children do
				child.Parent = inst
			end
		end
		if parent then
			inst.Parent = parent
		end
	end
	return inst
end

function UI.corner(parent: Instance, radius: number?): UICorner
	return UI.new("UICorner", { CornerRadius = UDim.new(0, radius or 12), Parent = parent })
end

function UI.stroke(parent: Instance, thickness: number?, color: Color3?, mode: Enum.ApplyStrokeMode?): UIStroke
	return UI.new("UIStroke", {
		Thickness = thickness or 3,
		Color = color or UI.Colors.Ink,
		ApplyStrokeMode = mode or Enum.ApplyStrokeMode.Border,
		Parent = parent,
	})
end

function UI.pad(parent: Instance, px: number)
	return UI.new("UIPadding", {
		PaddingLeft = UDim.new(0, px),
		PaddingRight = UDim.new(0, px),
		PaddingTop = UDim.new(0, px),
		PaddingBottom = UDim.new(0, px),
		Parent = parent,
	})
end

function UI.list(parent: Instance, padding: number?, horizontal: boolean?, align: Enum.HorizontalAlignment?): UIListLayout
	return UI.new("UIListLayout", {
		Padding = UDim.new(0, padding or 6),
		FillDirection = if horizontal then Enum.FillDirection.Horizontal else Enum.FillDirection.Vertical,
		HorizontalAlignment = align or Enum.HorizontalAlignment.Left,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = parent,
	})
end

-- Text with a dark outline (the cartoony HUD look).
function UI.text(parent: Instance, text: string, props: { [string]: any }?): TextLabel
	local label = UI.new("TextLabel", {
		BackgroundTransparency = 1,
		Text = text,
		FontFace = UI.Title,
		TextColor3 = UI.Colors.White,
		TextScaled = true,
		Size = UDim2.fromScale(1, 1),
		Parent = parent,
	})
	if props then
		for key, value in props do
			(label :: any)[key] = value
		end
	end
	return label
end

function UI.outlined(label: TextLabel, thickness: number?)
	UI.new(
		"UIStroke",
		{ Thickness = thickness or 2.5, Color = UI.Colors.Black, ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual, Parent = label }
	)
	return label
end

function UI.button(parent: Instance, text: string, color: Color3, onClick: () -> (), props: { [string]: any }?): TextButton
	local button = UI.new("TextButton", {
		BackgroundColor3 = color,
		Text = text,
		FontFace = UI.Title,
		TextColor3 = UI.Colors.White,
		TextScaled = true,
		AutoButtonColor = true,
		Parent = parent,
	})
	UI.corner(button, 10)
	UI.stroke(button, 3, color:Lerp(Color3.new(), 0.45))
	UI.new("UIPadding", {
		PaddingTop = UDim.new(0.12, 0),
		PaddingBottom = UDim.new(0.12, 0),
		PaddingLeft = UDim.new(0, 10),
		PaddingRight = UDim.new(0, 10),
		Parent = button,
	})
	if props then
		for key, value in props do
			(button :: any)[key] = value
		end
	end
	button.MouseButton1Click:Connect(onClick)
	-- Little press animation
	local scale = UI.new("UIScale", { Parent = button })
	button.MouseButton1Down:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.06), { Scale = 0.94 }):Play()
	end)
	button.MouseButton1Up:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.1), { Scale = 1 }):Play()
	end)
	button.MouseLeave:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.1), { Scale = 1 }):Play()
	end)
	return button
end

function UI.tween(inst: Instance, time: number, props: { [string]: any }, style: Enum.EasingStyle?, dir: Enum.EasingDirection?): Tween
	local tween = TweenService:Create(inst, TweenInfo.new(time, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
	tween:Play()
	return tween
end

-- Pop-in animation for panels.
function UI.pop(frame: GuiObject)
	local scale = frame:FindFirstChildOfClass("UIScale") or UI.new("UIScale", { Parent = frame })
	scale.Scale = 0.7
	UI.tween(scale, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
end

-- A modal window like the "CREATE PARTY" panel: navy header, subtitle, title, red X.
function UI.modal(parent: Instance, subtitle: string, title: string, icon: string, size: UDim2, onClose: () -> ()): (Frame, Frame)
	local frame = UI.new("Frame", {
		Size = size,
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = UI.Colors.Paper,
		Parent = parent,
	})
	UI.corner(frame, 14)
	UI.stroke(frame, 4, UI.Colors.NavyDark)
	UI.new(
		"UISizeConstraint",
		{ MaxSize = Vector2.new(size.X.Offset > 0 and size.X.Offset or 1000, size.Y.Offset > 0 and size.Y.Offset or 700), Parent = frame }
	)
	local header = UI.new("Frame", { Size = UDim2.new(1, 0, 0, 82), BackgroundColor3 = UI.Colors.Navy, Parent = frame })
	UI.corner(header, 14)
	UI.new("Frame", {
		Size = UDim2.new(1, 0, 0, 16),
		Position = UDim2.new(0, 0, 1, -16),
		BackgroundColor3 = UI.Colors.Navy,
		BorderSizePixel = 0,
		Parent = header,
	})
	UI.new("UIGradient", {
		Color = ColorSequence.new(UI.Colors.Navy, UI.Colors.NavyDark),
		Rotation = 90,
		Parent = header,
	})
	UI.text(header, icon, { Size = UDim2.fromOffset(64, 64), Position = UDim2.fromOffset(12, 9), FontFace = UI.Bold })
	UI.text(header, subtitle, {
		Size = UDim2.new(1, -170, 0, 24),
		Position = UDim2.fromOffset(86, 8),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Color3.fromRGB(170, 190, 240),
	})
	UI.text(
		header,
		title,
		{ Size = UDim2.new(1, -170, 0, 44), Position = UDim2.fromOffset(84, 30), TextXAlignment = Enum.TextXAlignment.Left }
	)
	local close = UI.button(header, "X", UI.Colors.Red, onClose, {
		Size = UDim2.fromOffset(64, 64),
		Position = UDim2.new(1, -74, 0, 9),
		FontFace = UI.Bold,
	})
	local _ = close
	local body = UI.new("Frame", {
		Size = UDim2.new(1, 0, 1, -82),
		Position = UDim2.fromOffset(0, 82),
		BackgroundTransparency = 1,
		Parent = frame,
	})
	UI.pad(body, 16)
	UI.pop(frame)
	return frame, body
end

return UI
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
</roblox>