      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">BotKiller</string>
          <string name="Source"><![CDATA[-- The AI killer: plays The Ringmaster when only one person is in the server, so a solo player can always play.
-- It hunts the nearest survivor it can see, investigates noises (failed skill checks, lit pumpkins),
-- downs survivors, carries them to Crow Cages, and can be stunned with pallets.
local PathfindingService = game:GetService("PathfindingService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)

local DataService = require(script.Parent.DataService)
local HideService = require(script.Parent.HideService)
local KillerLook = require(script.Parent.KillerLook)
local KillerService = require(script.Parent.KillerService)
local Match = require(script.Parent.Match)
local SurvivorService = require(script.Parent.SurvivorService)

local BotKiller = {}

local SPEED = 16.5 -- a little faster than survivors (16), slower than a real killer (18)
local CARRY_SPEED = 14
local SIGHT = 75
local rng = Random.new()

local bot = nil -- { Model, Humanoid, Root, ... }

local function now()
	return Match.Now()
end

local function flat(v: Vector3)
	return Vector3.new(v.X, 0, v.Z)
end

local function buildBody(spawnCFrame: CFrame, killerType: string)
	local description = Instance.new("HumanoidDescription")
	description.HeadColor = Color3.fromRGB(230, 225, 215)
	description.TorsoColor = Color3.fromRGB(30, 10, 18)
	description.LeftArmColor = Color3.fromRGB(30, 10, 18)
	description.RightArmColor = Color3.fromRGB(30, 10, 18)
	description.LeftLegColor = Color3.fromRGB(20, 15, 20)
	description.RightLegColor = Color3.fromRGB(20, 15, 20)
	KillerLook.Fill(description, killerType)
	local model = Players:CreateHumanoidModelFromDescription(description, Enum.HumanoidRigType.R15)
	model.Name = Config.Killers[killerType].Name
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.WalkSpeed = SPEED
	humanoid.BreakJointsOnDeath = false
	model:PivotTo(spawnCFrame)
	model.Parent = workspace
	Match.SetCollisionGroup(model, "Players")
	local root = model:FindFirstChild("HumanoidRootPart")
	root:SetNetworkOwner(nil) -- the server drives it
	KillerService.Dress(model, killerType)
	if KillerLook.Has(killerType) then
		KillerService.StripMask(model)
	end
	CollectionService:AddTag(model, "KillerBot")

	-- Walk / run / idle animations (Roblox defaults), switched by speed in think()
	local animator = humanoid:FindFirstChildOfClass("Animator") or Instance.new("Animator")
	animator.Parent = humanoid
	local tracks = {}
	for name, id in KillerLook.AnimationsForBot() do
		local animation = Instance.new("Animation")
		animation.AnimationId = "rbxassetid://" .. id
		local ok, track = pcall(animator.LoadAnimation, animator, animation)
		if ok then
			track.Looped = true
			track.Priority = Enum.AnimationPriority.Movement
			tracks[name] = track
		end
	end
	return model, humanoid, root, tracks
end

local function canSee(from: Vector3, to: Vector3, ignore)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = ignore
	return workspace:Raycast(from, to - from, params) == nil
end

local function pickTarget()
	local best, bestScore = nil, math.huge
	for _, survivor in Match.Survivors() do
		local root = Match.Root(survivor)
		if root and Match.IsStandingSurvivor(survivor) then
			local distance = (root.Position - bot.Root.Position).Magnitude
			local visible = distance < 25
				or (distance < SIGHT and canSee(bot.Root.Position + Vector3.new(0, 2, 0), root.Position, { bot.Model, survivor.Character }))
			if visible and distance < bestScore then
				best, bestScore = survivor, distance
			end
		end
	end
	return best
end

local function downedSurvivor()
	local best, bestDistance = nil, math.huge
	for _, survivor in Match.Survivors() do
		local root = Match.Root(survivor)
		if root and Match.Health(survivor) == "Downed" then
			local distance = (root.Position - bot.Root.Position).Magnitude
			if distance < bestDistance then
				best, bestDistance = survivor, distance
			end
		end
	end
	return best
end

local function nearestFreeCage()
	local best, bestDistance = nil, math.huge
	for _, cage in Match.Map.Cages do
		if not cage.Occupant then
			local distance = (cage.Position - bot.Root.Position).Magnitude
			if distance < bestDistance then
				best, bestDistance = cage, distance
			end
		end
	end
	return best
end

-- Walks toward a goal using pathfinding (recomputed every half second), or straight when close.
local function moveTo(goal: Vector3)
	local t = os.clock()
	if (flat(goal) - flat(bot.Root.Position)).Magnitude < 14 then
		bot.Humanoid:MoveTo(goal)
		bot.Path = nil
		return
	end
	if not bot.Path or t - bot.PathTime > 0.5 or (bot.PathGoal - goal).Magnitude > 8 then
		bot.PathTime = t
		bot.PathGoal = goal
		local path = PathfindingService:CreatePath({ AgentRadius = 2, AgentHeight = 5, AgentCanJump = true })
		local ok = pcall(function()
			path:ComputeAsync(bot.Root.Position, goal)
		end)
		if ok and path.Status == Enum.PathStatus.Success then
			bot.Path = path:GetWaypoints()
			bot.PathIndex = 2
		else
			bot.Path = nil
		end
	end
	if bot.Path and bot.Path[bot.PathIndex] then
		local waypoint = bot.Path[bot.PathIndex]
		if (flat(waypoint.Position) - flat(bot.Root.Position)).Magnitude < 3 then
			bot.PathIndex += 1
			waypoint = bot.Path[bot.PathIndex] or waypoint
		end
		if waypoint.Action == Enum.PathWaypointAction.Jump then
			bot.Humanoid.Jump = true
		end
		bot.Humanoid:MoveTo(waypoint.Position)
	else
		bot.Humanoid:MoveTo(goal)
	end
end

local function attack(target: Player)
	local t = now()
	if t < bot.AttackReadyAt then
		return
	end
	bot.AttackReadyAt = t + Config.Attack.Cooldown + 0.3
	Remotes.Swing:FireAllClients(bot.Model)
	local result = SurvivorService.Hit(target)
	if result then
		bot.SlowedUntil = t + Config.Speeds.KillerAfterHitTime
	end
end

local function stun(seconds: number)
	bot.StunnedUntil = now() + seconds
	local survivor = SurvivorService.CarriedBy(bot)
	if survivor then
		SurvivorService.Drop(survivor, "Injured")
		Remotes.notify(survivor, "You fell free! RUN!", "success")
	end
end

local function think()
	if not bot or not bot.Model.Parent then
		return
	end
	local t = now()
	local humanoid = bot.Humanoid

	-- Animate: idle when standing, walk when slow, run when fast
	local velocity = bot.Root.AssemblyLinearVelocity
	local speed = Vector3.new(velocity.X, 0, velocity.Z).Magnitude
	local wanted = if speed < 1 then "Idle" elseif speed < 12 then "Walk" else "Run"
	if wanted ~= bot.Playing and bot.Tracks[wanted] then
		if bot.Playing and bot.Tracks[bot.Playing] then
			bot.Tracks[bot.Playing]:Stop(0.2)
		end
		bot.Tracks[wanted]:Play(0.2)
		bot.Playing = wanted
	end

	if t < bot.FrozenUntil or t < bot.StunnedUntil then
		humanoid.WalkSpeed = 0
		humanoid:MoveTo(bot.Root.Position)
		return
	end

	local carrying = SurvivorService.CarriedBy(bot)
	humanoid.WalkSpeed = if carrying then CARRY_SPEED elseif t < bot.SlowedUntil then Config.Speeds.KillerAfterHit else SPEED

	-- 1. Carrying someone: take them to the nearest empty cage
	if carrying then
		local cage = nearestFreeCage()
		if cage then
			if (cage.Position - bot.Root.Position).Magnitude < 7 then
				SurvivorService.CageSurvivor(bot, cage)
				bot.WanderGoal = nil
			else
				moveTo(cage.Position)
			end
		end
		return
	end

	-- 2. Someone is downed: go pick them up
	local downed = downedSurvivor()
	if downed then
		local root = Match.Root(downed)
		if root then
			if (root.Position - bot.Root.Position).Magnitude < 6 then
				SurvivorService.Pickup(bot, downed)
			else
				moveTo(root.Position)
			end
			return
		end
	end

	-- 3. Chase a survivor it can see
	local target = pickTarget()
	if target then
		bot.LastSeen = Match.Root(target).Position
		bot.SearchQueue = nil
		local root = Match.Root(target)
		local distance = (root.Position - bot.Root.Position).Magnitude
		-- The Banshee blinks through the air when it spots someone at mid range
		local info = Config.Killers[bot.Type]
		if bot.Type == "Banshee" and t > bot.BlinkReadyAt and distance > 10 and distance < info.BlinkDistance + 3 then
			bot.BlinkReadyAt = t + info.Cooldown + 2
			bot.SlowedUntil = t + info.BlinkFatigue
			KillerService.Blink(bot.Model, bot.Root, info, function(victim)
				bot.AttackReadyAt = 0
				attack(victim)
			end, root.Position)
			return
		end
		if distance < Config.Attack.Range - 1.5 then
			attack(target)
		end
		moveTo(root.Position)
		return
	end

	-- Lost them? Check the lockers around where they were last seen
	if bot.SearchQueue and #bot.SearchQueue > 0 then
		local locker = bot.SearchQueue[1]
		if (locker.Position - bot.Root.Position).Magnitude < 5.5 then
			table.remove(bot.SearchQueue, 1)
			HideService.Search(bot, locker)
			bot.SlowedUntil = t + 1.2
		else
			moveTo(locker.Position)
		end
		return
	end

	-- 4. Investigate the last sighting or noise, then patrol between unlit pumpkins
	local goal = bot.LastSeen or bot.Noise
	if goal and (flat(goal) - flat(bot.Root.Position)).Magnitude < 6 then
		if bot.LastSeen then
			bot.SearchQueue = { table.unpack(HideService.OccupiedNear(bot.LastSeen, 22), 1, 2) }
		end
		bot.LastSeen, bot.Noise = nil, nil
		goal = nil
	end
	if not goal then
		if not bot.WanderGoal or (flat(bot.WanderGoal) - flat(bot.Root.Position)).Magnitude < 8 then
			local options = {}
			for _, pumpkin in Match.Map.Pumpkins do
				if not pumpkin.Lit then
					table.insert(options, pumpkin.Position)
				end
			end
			for _, gate in Match.Map.Gates do
				if workspace:GetAttribute("GatesPowered") then
					table.insert(options, gate.Switch.Position)
				end
			end
			bot.WanderGoal = if #options > 0 then options[rng:NextInteger(1, #options)] else Match.Map.KillerSpawn.Position
		end
		goal = bot.WanderGoal
	end
	moveTo(goal)
end

-- Starts the AI killer and returns which killer it is (it alternates between the Ringmaster and the Banshee).
function BotKiller.Start(): string
	BotKiller.Stop()
	local killerType = if rng:NextNumber() < 0.5 then "Ringmaster" else "Banshee"
	local model, humanoid, root, tracks = buildBody(Match.Map.KillerSpawn, killerType)
	bot = {
		Type = killerType,
		BlinkReadyAt = 0,
		Tracks = tracks,
		Playing = nil,
		Model = model,
		Humanoid = humanoid,
		Root = root,
		AttackReadyAt = 0,
		SlowedUntil = 0,
		StunnedUntil = 0,
		FrozenUntil = now() + 10,
		PathTime = 0,
		PathGoal = Vector3.zero,
	}
	Match.BotModel = model
	return killerType
end

function BotKiller.Stop()
	if bot then
		local survivor = SurvivorService.CarriedBy(bot)
		if survivor then
			SurvivorService.Drop(survivor)
		end
		bot.Model:Destroy()
		bot = nil
	end
	Match.BotModel = nil
end

function BotKiller.IsActive(): boolean
	return bot ~= nil
end

function BotKiller.Init()
	KillerService.OnPalletDropped = function(position: Vector3, survivor: Player)
		if bot and (bot.Root.Position - position).Magnitude < Config.Pallet.StunRadius then
			stun(Config.Pallet.StunTime)
			local earned = DataService.AddTickets(survivor, Config.Rewards.PalletStun, true)
			Remotes.notify(survivor, "💥 PALLET STUN! +" .. earned .. " 🎟️", "success")
		end
	end
	Match.OnNoise = function(position: Vector3)
		if bot then
			bot.Noise = position
		end
	end
	task.spawn(function()
		while true do
			task.wait(0.15)
			if bot and Match.Active then
				local ok, err = pcall(think)
				if not ok then
					warn("[BotKiller] think error:", err)
				end
			end
		end
	end)
end

return BotKiller
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">CosmeticService</string>
          <string name="Source"><![CDATA[-- Cosmetics: builds hats/masks and trails on characters, sells them for tickets,
-- opens Mystery Crates and grants Robux bundles.
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Cosmetics = require(Shared.Cosmetics)
local Remotes = require(Shared.Remotes)

local DataService = require(script.Parent.DataService)
local Match = require(script.Parent.Match)

local CosmeticService = {}

local rng = Random.new()
local rgb = Color3.fromRGB

local function newPart(props)
	local part = Instance.new("Part")
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Anchored = false
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Massless = true
	for key, value in props do
		part[key] = value
	end
	return part
end

local function attach(folder: Instance, to: BasePart, props, offset: CFrame)
	local part = newPart(props)
	part.CFrame = to.CFrame * offset
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = to
	weld.Part1 = part
	weld.Parent = part
	part.Parent = folder
	return part
end

local function glow(part: BasePart, color: Color3, range: number)
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = range
	light.Brightness = 1.2
	light.Parent = part
end

-- Each builder gets (folder, head, torso)
local HATS = {
	CatEars = function(f, head)
		for _, x in { -0.45, 0.45 } do
			attach(
				f,
				head,
				{ Size = Vector3.new(0.45, 0.6, 0.2), Color = rgb(20, 20, 25) },
				CFrame.new(x, 0.75, 0) * CFrame.Angles(0, 0, x * -0.6)
			)
			attach(
				f,
				head,
				{ Size = Vector3.new(0.25, 0.35, 0.21), Color = rgb(255, 150, 180) },
				CFrame.new(x, 0.72, -0.02) * CFrame.Angles(0, 0, x * -0.6)
			)
		end
	end,
	TopHat = function(f, head)
		attach(
			f,
			head,
			{ Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.15, 2.1, 2.1), Color = rgb(15, 15, 20) },
			CFrame.new(0, 0.65, 0) * CFrame.Angles(0, 0, math.rad(90))
		)
		attach(
			f,
			head,
			{ Shape = Enum.PartType.Cylinder, Size = Vector3.new(1.4, 1.3, 1.3), Color = rgb(15, 15, 20) },
			CFrame.new(0, 1.35, 0) * CFrame.Angles(0, 0, math.rad(90))
		)
		attach(
			f,
			head,
			{ Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.25, 1.35, 1.35), Color = rgb(140, 20, 30) },
			CFrame.new(0, 0.85, 0) * CFrame.Angles(0, 0, math.rad(90))
		)
	end,
	CandleHat = function(f, head)
		attach(
			f,
			head,
			{ Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.2, 1.4, 1.4), Color = rgb(90, 70, 50) },
			CFrame.new(0, 0.65, 0) * CFrame.Angles(0, 0, math.rad(90))
		)
		attach(f, head, { Size = Vector3.new(0.4, 1, 0.4), Color = rgb(240, 230, 200) }, CFrame.new(0, 1.2, 0))
		local flame = attach(
			f,
			head,
			{ Shape = Enum.PartType.Ball, Size = Vector3.new(0.35, 0.5, 0.35), Color = rgb(255, 180, 60), Material = Enum.Material.Neon },
			CFrame.new(0, 1.9, 0)
		)
		glow(flame, rgb(255, 170, 70), 12)
	end,
	DevilHorns = function(f, head)
		for _, x in { -0.45, 0.45 } do
			attach(
				f,
				head,
				{ Size = Vector3.new(0.25, 0.7, 0.25), Color = rgb(200, 20, 30), Material = Enum.Material.Neon },
				CFrame.new(x, 0.8, -0.1) * CFrame.Angles(0, 0, x * -0.7)
			)
		end
	end,
	WitchHat = function(f, head)
		attach(
			f,
			head,
			{ Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.15, 2.8, 2.8), Color = rgb(40, 20, 60) },
			CFrame.new(0, 0.6, 0) * CFrame.Angles(0, 0, math.rad(90))
		)
		for i, s in { 1.4, 1.05, 0.7, 0.4 } do
			attach(
				f,
				head,
				{ Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.55, s, s), Color = rgb(40, 20, 60) },
				CFrame.new(0.05 * i, 0.6 + i * 0.5, 0.05 * i) * CFrame.Angles(0, 0, math.rad(90))
			)
		end
		attach(f, head, {
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.2, 1.45, 1.45),
			Color = rgb(150, 255, 90),
			Material = Enum.Material.Neon,
		}, CFrame.new(0, 0.9, 0) * CFrame.Angles(0, 0, math.rad(90)))
	end,
	SkullMask = function(f, head)
		local mask = attach(
			f,
			head,
			{ Shape = Enum.PartType.Ball, Size = Vector3.new(1.3, 1.45, 1.1), Color = rgb(240, 235, 220) },
			CFrame.new(0, 0.05, -0.25)
		)
		for _, x in { -0.27, 0.27 } do
			attach(
				f,
				mask,
				{ Shape = Enum.PartType.Ball, Size = Vector3.new(0.35, 0.35, 0.2), Color = rgb(10, 10, 10) },
				CFrame.new(x, 0.12, -0.5)
			)
		end
		attach(f, mask, { Size = Vector3.new(0.6, 0.12, 0.1), Color = rgb(10, 10, 10) }, CFrame.new(0, -0.38, -0.52))
	end,
	PumpkinHead = function(f, head)
		local pumpkin =
			attach(f, head, { Shape = Enum.PartType.Ball, Size = Vector3.new(2, 1.8, 2), Color = rgb(240, 120, 20) }, CFrame.new(0, 0.1, 0))
		for _, x in { -0.35, 0.35 } do
			attach(
				f,
				pumpkin,
				{ Size = Vector3.new(0.3, 0.3, 0.1), Color = rgb(255, 220, 90), Material = Enum.Material.Neon },
				CFrame.new(x, 0.2, -0.95)
			)
		end
		attach(
			f,
			pumpkin,
			{ Size = Vector3.new(0.9, 0.2, 0.1), Color = rgb(255, 220, 90), Material = Enum.Material.Neon },
			CFrame.new(0, -0.3, -0.92)
		)
		attach(f, pumpkin, { Size = Vector3.new(0.25, 0.5, 0.25), Color = rgb(60, 90, 30) }, CFrame.new(0, 1.05, 0))
		glow(pumpkin, rgb(255, 150, 40), 10)
	end,
	BatWings = function(f, _, torso)
		for _, x in { -1, 1 } do
			attach(
				f,
				torso,
				{ Size = Vector3.new(2.6, 1.6, 0.1), Color = rgb(25, 15, 30) },
				CFrame.new(x * 1.5, 0.5, 0.7) * CFrame.Angles(0, x * -0.5, x * 0.35)
			)
		end
	end,
	Halo = function(f, head)
		local ring = attach(f, head, {
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.15, 1.6, 1.6),
			Color = rgb(255, 240, 150),
			Material = Enum.Material.Neon,
		}, CFrame.new(0, 1.4, 0) * CFrame.Angles(0, 0, math.rad(90)))
		glow(ring, rgb(255, 240, 160), 10)
	end,
	Crown = function(f, head)
		attach(
			f,
			head,
			{ Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.45, 1.3, 1.3), Color = rgb(255, 200, 50), Material = Enum.Material.Foil },
			CFrame.new(0, 0.75, 0) * CFrame.Angles(0, 0, math.rad(90))
		)
		for i = 0, 5 do
			local a = i / 6 * math.pi * 2
			attach(
				f,
				head,
				{ Size = Vector3.new(0.2, 0.45, 0.2), Color = rgb(255, 200, 50), Material = Enum.Material.Foil },
				CFrame.new(math.cos(a) * 0.55, 1.1, math.sin(a) * 0.55)
			)
		end
		local gem = attach(
			f,
			head,
			{ Shape = Enum.PartType.Ball, Size = Vector3.one * 0.3, Color = rgb(255, 30, 60), Material = Enum.Material.Neon },
			CFrame.new(0, 0.8, -0.65)
		)
		glow(gem, rgb(255, 60, 80), 8)
	end,
}

function CosmeticService.Apply(player: Player)
	local character = player.Character
	local head = character and character:FindFirstChild("Head")
	local torso = character and (character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso"))
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not head or not torso or not root then
		return
	end
	local old = character:FindFirstChild("Cosmetics")
	if old then
		old:Destroy()
	end
	local folder = Instance.new("Folder")
	folder.Name = "Cosmetics"
	folder.Parent = character

	local hat = player:GetAttribute("Equip_Hat")
	if hat and HATS[hat] and Match.Role(player) ~= "Killer" then
		HATS[hat](folder, head, torso)
	end
	local trailId = player:GetAttribute("Equip_Trail")
	local item = trailId and Cosmetics.ById[trailId]
	if item then
		local a0 = Instance.new("Attachment")
		a0.Position = Vector3.new(0, 0.8, 0.5)
		a0.Parent = root
		local a1 = Instance.new("Attachment")
		a1.Position = Vector3.new(0, -1.2, 0.5)
		a1.Parent = root
		local trail = Instance.new("Trail")
		trail.Attachment0 = a0
		trail.Attachment1 = a1
		trail.Lifetime = 0.6
		trail.LightEmission = 0.8
		trail.Color = ColorSequence.new(item.Colors[1], item.Colors[2])
		trail.Transparency = NumberSequence.new(0.2, 1)
		trail.Parent = folder
		if item.Rainbow then
			CollectionService:AddTag(trail, "RainbowTrail")
		end
		for _, attachment in { a0, a1 } do
			attachment.Name = "TrailAttachment"
		end
	end
end

function CosmeticService.Grant(player: Player, id: string): boolean
	local data = DataService.Get(player)
	if not data or not Cosmetics.ById[id] then
		return false
	end
	local isNew = not data.Owned[id]
	data.Owned[id] = true
	return isNew
end

function CosmeticService.GrantBundle(player: Player, key: string)
	local bundle = Cosmetics.Bundles[key]
	local data = DataService.Get(player)
	if not bundle or not data then
		return
	end
	if bundle.OneTime and data.StarterBought then
		-- Already bought once: give the tickets value of the items instead so nothing is wasted
		DataService.AddTickets(player, bundle.Tickets * 2, false)
		Remotes.notify(player, "You already own the Starter Pack, so you got " .. bundle.Tickets * 2 .. " 🎟️ instead!", "info")
		return
	end
	for _, id in bundle.Items do
		CosmeticService.Grant(player, id)
	end
	if bundle.OneTime then
		data.StarterBought = true
	end
	data.Tickets += bundle.Tickets or 0
	data.KillerChance += bundle.KillerChance or 0
	DataService.Sync(player)
	Remotes.notify(player, bundle.Name .. " unlocked! Check your Wardrobe.", "success")
end

local function equip(player: Player, id: string?)
	local data = DataService.Get(player)
	if not data then
		return false, "Not loaded yet."
	end
	local item = type(id) == "string" and Cosmetics.ById[id]
	if not item then
		return false, "Unknown item."
	end
	if not data.Owned[id] then
		return false, "You don't own that yet."
	end
	local slot = if item.Type == "Skin" then "Skin_" .. item.Killer else item.Type
	if data.Equipped[slot] == id then
		data.Equipped[slot] = nil -- clicking an equipped item takes it off
	else
		data.Equipped[slot] = id
	end
	DataService.Sync(player)
	if Match.Role(player) ~= "Killer" then
		CosmeticService.Apply(player)
	end
	return true, if data.Equipped[slot] then item.Name .. " equipped!" else item.Name .. " removed."
end

local function buy(player: Player, id: string?)
	local item = type(id) == "string" and Cosmetics.ById[id]
	local data = DataService.Get(player)
	if not item or not data then
		return false, "Unknown item."
	end
	if data.Owned[id] then
		return false, "You already own it."
	end
	if not item.Price then
		return false, "This item only comes in bundles and crates."
	end
	if not DataService.SpendTickets(player, item.Price) then
		return false, "You need " .. item.Price .. " 🎟️"
	end
	CosmeticService.Grant(player, id)
	DataService.Sync(player)
	equip(player, id)
	return true, "Bought " .. item.Name .. "!"
end

local function openCrate(player: Player)
	local data = DataService.Get(player)
	if not data then
		return false, "Not loaded yet."
	end
	if not DataService.SpendTickets(player, Cosmetics.Crate.Price) then
		return false, "You need " .. Cosmetics.Crate.Price .. " 🎟️"
	end
	local id = Cosmetics.RollCrate(rng)
	local item = Cosmetics.ById[id]
	local isNew = CosmeticService.Grant(player, id)
	if not isNew then
		data.Tickets += Cosmetics.Crate.DuplicateRefund
	end
	DataService.Sync(player)
	if item.Rarity == "Legendary" then
		Remotes.announce("✨ " .. player.DisplayName .. " unboxed a LEGENDARY " .. item.Name .. "!", Cosmetics.Rarities.Legendary.Color)
	end
	return true,
		if isNew
			then "You got: " .. item.Name .. " (" .. item.Rarity .. ")!"
			else "Duplicate " .. item.Name .. ": +" .. Cosmetics.Crate.DuplicateRefund .. " 🎟️ back",
		id
end

function CosmeticService.Init()
	Remotes.Equip.OnServerInvoke = equip
	Remotes.BuyCosmetic.OnServerInvoke = buy
	Remotes.OpenCrate.OnServerInvoke = openCrate
end

return CosmeticService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">DataService</string>
          <string name="Source"><![CDATA[-- Loads/saves player data with retries, session locking and autosave.
local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Cosmetics = require(Shared.Cosmetics)

local DataService = {}

local SESSION_TIMEOUT = 300 -- a lock older than this is considered stale
local profiles = {} -- [Player] = { Data = table, CanSave = boolean }

local store
pcall(function()
	store = DataStoreService:GetDataStore(Config.DataStoreName)
end)

local function defaultData()
	return {
		Tickets = 0,
		KillerChance = Config.KillerChance.Start,
		Unlocked = { Ringmaster = true },
		PreferredKiller = "Ringmaster",
		Escapes = 0,
		Eliminations = 0,
		KillerWins = 0,
		PumpkinsLit = 0,
		Rescues = 0,
		BreakOuts = 0,
		Owned = {},
		Equipped = {},
		StarterBought = false,
		ReceiptIds = {},
	}
end

local function reconcile(data)
	for key, value in defaultData() do
		if data[key] == nil then
			data[key] = value
		end
	end
	data.Unlocked.Ringmaster = true
	return data
end

local function keyFor(player: Player)
	return "Player_" .. player.UserId
end

local function setupLeaderstats(player: Player)
	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	for _, name in { "Tickets", "Escapes", "Kills" } do
		local value = Instance.new("IntValue")
		value.Name = name
		value.Parent = stats
	end
	stats.Parent = player
end

function DataService.Load(player: Player)
	local data, canSave = nil, false
	if store then
		for attempt = 1, 8 do
			local lockedElsewhere = false
			local ok, err = pcall(function()
				data = store:UpdateAsync(keyFor(player), function(old)
					old = old or defaultData()
					local session = old.Session
					if session and session.Job ~= game.JobId and os.time() - session.Time < SESSION_TIMEOUT and attempt < 8 then
						lockedElsewhere = true
						return nil -- cancel the write, another server still owns this data
					end
					old.Session = { Job = game.JobId, Time = os.time() }
					return old
				end)
			end)
			if ok and not lockedElsewhere and data then
				canSave = true
				break
			end
			if not ok then
				warn("[DataService] Load failed for", player.Name, err)
			end
			if not player.Parent then
				return nil
			end
			task.wait(if lockedElsewhere then 5 else attempt)
		end
	end

	if not canSave then
		warn("[DataService] Could not load data for " .. player.Name .. "; progress will NOT be saved this session.")
		data = nil
	end
	data = reconcile(if type(data) == "table" then data else defaultData())

	if not player.Parent then
		if canSave then
			pcall(function()
				store:UpdateAsync(keyFor(player), function(old)
					if old then
						old.Session = nil
					end
					return old
				end)
			end)
		end
		return nil
	end

	profiles[player] = { Data = data, CanSave = canSave }
	setupLeaderstats(player)
	DataService.Sync(player)
	return data
end

function DataService.Get(player: Player)
	local profile = profiles[player]
	return if profile then profile.Data else nil
end

function DataService.Save(player: Player, release: boolean?): boolean
	local profile = profiles[player]
	if not profile then
		return false
	end
	if not profile.CanSave then
		-- In Studio without API access we can't save; treat as success so purchases still work.
		return RunService:IsStudio()
	end
	local data = profile.Data
	data.Session = if release then nil else { Job = game.JobId, Time = os.time() }
	for attempt = 1, 3 do
		local ok, err = pcall(function()
			store:UpdateAsync(keyFor(player), function()
				return data
			end)
		end)
		if ok then
			return true
		end
		warn("[DataService] Save failed for", player.Name, err)
		task.wait(attempt)
	end
	return false
end

function DataService.Release(player: Player)
	if profiles[player] then
		DataService.Save(player, true)
		profiles[player] = nil
	end
end

function DataService.Sync(player: Player)
	local data = DataService.Get(player)
	if not data then
		return
	end
	player:SetAttribute("Tickets", data.Tickets)
	player:SetAttribute("KillerChance", data.KillerChance)
	player:SetAttribute("PreferredKiller", data.PreferredKiller)
	player:SetAttribute("BreakOuts", data.BreakOuts)
	player:SetAttribute("StarterBought", data.StarterBought)
	for _, item in Cosmetics.Items do
		player:SetAttribute("Owned_" .. item.Id, data.Owned[item.Id] == true)
	end
	player:SetAttribute("Equip_Hat", data.Equipped.Hat)
	player:SetAttribute("Equip_Trail", data.Equipped.Trail)
	for _, killer in Config.KillerOrder do
		player:SetAttribute("Skin_" .. killer, data.Equipped["Skin_" .. killer])
	end
	for _, killer in Config.KillerOrder do
		local passKey = Config.Killers[killer].PassKey
		local unlocked = data.Unlocked[killer] == true or (passKey ~= nil and player:GetAttribute("Pass_" .. passKey) == true)
		player:SetAttribute("Unlocked_" .. killer, unlocked)
	end
	local stats = player:FindFirstChild("leaderstats")
	if stats then
		stats.Tickets.Value = data.Tickets
		stats.Escapes.Value = data.Escapes
		stats.Kills.Value = data.Eliminations
	end
end

function DataService.TicketMultiplier(player: Player): number
	local mult = 1
	if player:GetAttribute("Pass_DoubleTickets") then
		mult *= Config.Multipliers.DoubleTickets
	end
	if player:GetAttribute("Pass_VIP") then
		mult *= Config.Multipliers.VIP
	end
	return mult
end

-- Gives tickets. `boosted` applies pass multipliers (use it for gameplay rewards, not purchases).
function DataService.AddTickets(player: Player, amount: number, boosted: boolean?): number
	local data = DataService.Get(player)
	if not data then
		return 0
	end
	if boosted then
		amount *= DataService.TicketMultiplier(player)
	end
	amount = math.floor(amount)
	data.Tickets += amount
	DataService.Sync(player)
	return amount
end

function DataService.SpendTickets(player: Player, amount: number): boolean
	local data = DataService.Get(player)
	if not data or data.Tickets < amount then
		return false
	end
	data.Tickets -= amount
	DataService.Sync(player)
	return true
end

-- Adds to a saved stat counter (Escapes, Eliminations, ...).
function DataService.Increment(player: Player, key: string, amount: number?)
	local data = DataService.Get(player)
	if data and type(data[key]) == "number" then
		data[key] += amount or 1
		DataService.Sync(player)
	end
end

function DataService.Init()
	task.spawn(function()
		while true do
			task.wait(Config.AutoSaveInterval)
			for player in profiles do
				task.spawn(DataService.Save, player)
			end
		end
	end)

	game:BindToClose(function()
		local pending = 0
		for player in profiles do
			pending += 1
			task.spawn(function()
				DataService.Save(player, true)
				pending -= 1
			end)
		end
		local started = os.clock()
		while pending > 0 and os.clock() - started < 25 do
			task.wait(0.1)
		end
	end)
end

return DataService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">HideService</string>
          <string name="Source"><![CDATA[-- Lockers & wardrobes, DBD-style: survivors hide inside (first-person view through the vents),
-- the killer can search them. Finding someone grabs them straight out onto the killer's shoulder.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Remotes)

local KillerService = require(script.Parent.KillerService)
local Match = require(script.Parent.Match)
local SurvivorService = require(script.Parent.SurvivorService)

local HideService = {}

local occupantOf = {} -- [locker] = Player
local lockerOf = {} -- [Player] = locker

local function now()
	return Match.Now()
end

local function swingDoor(locker)
	TweenService:Create(locker.Door, TweenInfo.new(0.15), { CFrame = locker.DoorOpen }):Play()
	task.delay(0.45, function()
		TweenService:Create(locker.Door, TweenInfo.new(0.2), { CFrame = locker.DoorClosed }):Play()
	end)
end

local function refreshPrompts(locker)
	local occupant = occupantOf[locker]
	locker.HidePrompt.Enabled = occupant == nil
	locker.LeavePrompt.Enabled = occupant ~= nil
	locker.LeavePrompt:SetAttribute("OnlyUserId", if occupant then occupant.UserId else nil)
end

function HideService.IsHiding(player: Player): boolean
	return lockerOf[player] ~= nil
end

function HideService.Hide(player: Player, locker)
	if occupantOf[locker] or lockerOf[player] or not Match.Active or not Match.IsStandingSurvivor(player) then
		return
	end
	if (player:GetAttribute("TrappedUntil") or 0) > now() then
		return
	end
	local root = Match.Root(player)
	if not root then
		return
	end
	player:SetAttribute("WorkingOn", nil)
	occupantOf[locker] = player
	lockerOf[player] = locker
	swingDoor(locker)
	root.CFrame = locker.Inside
	root.Anchored = true
	player:SetAttribute("Hiding", true)
	refreshPrompts(locker)
end

function HideService.Leave(player: Player)
	local locker = lockerOf[player]
	if not locker then
		return
	end
	lockerOf[player] = nil
	occupantOf[locker] = nil
	player:SetAttribute("Hiding", nil)
	local root = Match.Root(player)
	if root then
		root.Anchored = false
		root.CFrame = locker.Outside
	end
	swingDoor(locker)
	refreshPrompts(locker)
end

-- The killer (a Player, or the AI killer table) opens a locker. Returns true if someone was inside.
function HideService.Search(searcher, locker): boolean
	swingDoor(locker)
	Remotes.Sfx:FireAllClients("Pallet", locker.Position)
	local found = occupantOf[locker]
	if not found then
		return false
	end
	HideService.Leave(found)
	SurvivorService.SetHealth(found, "Downed")
	SurvivorService.Pickup(searcher, found)
	Remotes.Scare:FireClient(found, "down")
	Remotes.notify(found, "😱 The killer found you in the locker!", "error")
	if typeof(searcher) == "Instance" then
		Remotes.notify(searcher, "Found one! Take them to a Crow Cage.", "success")
	end
	return true
end

function HideService.OccupiedNear(position: Vector3, radius: number)
	local list = {}
	for _, locker in Match.Map.Lockers do
		if (locker.Position - position).Magnitude < radius then
			table.insert(list, locker)
		end
	end
	table.sort(list, function(a, b)
		return (a.Position - position).Magnitude < (b.Position - position).Magnitude
	end)
	return list
end

function HideService.Reset()
	for player in lockerOf do
		HideService.Leave(player)
	end
end

function HideService.Init()
	for _, locker in Match.Map.Lockers do
		locker.HidePrompt = Match.Prompt(locker.Door, "HidePrompt", "Survivor", "Hide", "Locker", 0.4, 7)
		locker.LeavePrompt = Match.Prompt(locker.Door, "LeavePrompt", "Survivor", "Leave", "Locker", 0, 7)
		local search = Match.Prompt(locker.Door, "SearchPrompt", "Killer", "Search", "Locker", 0.8, 8)
		locker.HidePrompt.Triggered:Connect(function(player)
			HideService.Hide(player, locker)
		end)
		locker.LeavePrompt.Triggered:Connect(function(player)
			if occupantOf[locker] == player then
				HideService.Leave(player)
			end
		end)
		search.Triggered:Connect(function(killer)
			if killer == Match.Killer and Match.Active and not SurvivorService.CarriedBy(killer) then
				if not HideService.Search(killer, locker) then
					KillerService.SlowFor(1.4)
					Remotes.notify(killer, "Empty...", "info")
				end
			end
		end)
		refreshPrompts(locker)
	end
	game:GetService("Players").PlayerRemoving:Connect(function(player)
		local locker = lockerOf[player]
		if locker then
			lockerOf[player] = nil
			occupantOf[locker] = nil
			refreshPrompts(locker)
		end
	end)
end

return HideService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">KillerLook</string>
          <string name="Source"><![CDATA[-- Real 3D killer looks built from Roblox Marketplace items (set in Config.KillerLooks),
-- plus default Roblox R15 animations for the AI killer.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)

local KillerLook = {}

local SLOTS = {
	Hat = "HatAccessory",
	Face = "FaceAccessory",
	Back = "BackAccessory",
	Front = "FrontAccessory",
	Neck = "NeckAccessory",
	Shoulder = "ShouldersAccessory",
	Waist = "WaistAccessory",
}

-- Roblox's own default R15 animations (usable by every game).
KillerLook.DefaultAnimations = {
	Run = 507767714,
	Walk = 507777826,
	Idle = 507766388,
}

function KillerLook.Has(killerType: string): boolean
	local look = Config.KillerLooks[killerType]
	if not look then
		return false
	end
	for key in SLOTS do
		if look[key] and look[key] ~= "" then
			return true
		end
	end
	return (look.Shirt or 0) ~= 0 or (look.Pants or 0) ~= 0 or (look.FaceDecal or 0) ~= 0
end

-- Fills a HumanoidDescription with the killer's Marketplace items.
function KillerLook.Fill(description: HumanoidDescription, killerType: string)
	local look = Config.KillerLooks[killerType]
	if not look then
		return description
	end
	for key, property in SLOTS do
		description[property] = look[key] or ""
	end
	if (look.Shirt or 0) ~= 0 then
		description.Shirt = look.Shirt
	end
	if (look.Pants or 0) ~= 0 then
		description.Pants = look.Pants
	end
	if (look.FaceDecal or 0) ~= 0 then
		description.Face = look.FaceDecal
	end
	local animations = look.Animations or {}
	if (animations.Run or 0) ~= 0 then
		description.RunAnimation = animations.Run
	end
	if (animations.Walk or 0) ~= 0 then
		description.WalkAnimation = animations.Walk
	end
	if (animations.Idle or 0) ~= 0 then
		description.IdleAnimation = animations.Idle
	end
	return description
end

-- Puts the Marketplace look on a player who is the killer this round. Returns true if a look was applied.
function KillerLook.ApplyToPlayer(player: Player, killerType: string): boolean
	if not KillerLook.Has(killerType) then
		return false
	end
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return false
	end
	local ok, err = pcall(function()
		local description = humanoid:GetAppliedDescription()
		humanoid:ApplyDescription(KillerLook.Fill(description, killerType))
	end)
	if not ok then
		warn("[KillerLook] Could not apply look for " .. killerType .. ": " .. tostring(err))
	end
	return ok
end

-- The animation IDs the AI killer uses (Roblox's default R15 run/walk/idle).
-- Marketplace animation packs only apply to player killers, through their HumanoidDescription.
function KillerLook.AnimationsForBot()
	return KillerLook.DefaultAnimations
end

return KillerLook
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">KillerService</string>
          <string name="Source"><![CDATA[-- The killer: costume, attacks, the three killer powers, pallets and stuns.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Cosmetics = require(Shared.Cosmetics)
local Remotes = require(Shared.Remotes)

local DataService = require(script.Parent.DataService)
local KillerLook = require(script.Parent.KillerLook)
local Match = require(script.Parent.Match)
local SurvivorService = require(script.Parent.SurvivorService)

local KillerService = {}
KillerService.OnPalletDropped = nil -- set by BotKiller: function(position, survivor)
KillerService.Dress = nil -- assigned below

local state = {
	StunnedUntil = 0,
	FrozenUntil = 0,
	SlowedUntil = 0,
	ChargeUntil = 0,
	VanishUntil = 0,
	ChargeHit = false,
	Traps = {},
	Saved = {},
}

local function now()
	return Match.Now()
end

local function isKiller(player: Player)
	return player == Match.Killer and Match.Role(player) == "Killer"
end

-- Costumes ---------------------------------------------------------------

local dressBanshee
local function weld(part: BasePart, to: BasePart, offset: CFrame, parent: Instance)
	part.Anchored = false
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Massless = true
	part.CFrame = to.CFrame * offset
	local w = Instance.new("WeldConstraint")
	w.Part0 = to
	w.Part1 = part
	w.Parent = part
	part.Parent = parent
	return part
end

local function newPart(props)
	local part = Instance.new("Part")
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in props do
		part[key] = value
	end
	return part
end

-- The Banshee: a floating figure in a tattered dress and veil, no feet, glowing white eyes.
dressBanshee = function(character: Model, head: BasePart, costume: Folder, info)
	local torso = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
	local lower = character:FindFirstChild("LowerTorso") or torso
	local cloth = Color3.fromRGB(46, 44, 50)
	-- Veil over the head and down the back
	weld(
		newPart({
			Name = "Veil",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(1.9, 2.3, 1.9),
			Color = cloth,
			Material = Enum.Material.Fabric,
			Transparency = 0.15,
		}),
		head,
		CFrame.new(0, 0.2, 0.15),
		costume
	)
	weld(
		newPart({ Name = "VeilTail", Size = Vector3.new(2, 4.5, 0.15), Color = cloth, Material = Enum.Material.Fabric, Transparency = 0.25 }),
		head,
		CFrame.new(0, -1.6, 0.95) * CFrame.Angles(math.rad(-8), 0, 0),
		costume
	)
	-- Pale, hollow face
	local face = weld(
		newPart({ Name = "Face", Shape = Enum.PartType.Ball, Size = Vector3.new(1.15, 1.45, 0.9), Color = Color3.fromRGB(214, 214, 206) }),
		head,
		CFrame.new(0, -0.05, -0.35),
		costume
	)
	for _, x in { -0.25, 0.25 } do
		weld(
			newPart({ Name = "Eye", Size = Vector3.new(0.24, 0.16, 0.1), Color = info.Color, Material = Enum.Material.Neon }),
			face,
			CFrame.new(x, 0.15, -0.43),
			costume
		)
	end
	weld(
		newPart({ Name = "Mouth", Shape = Enum.PartType.Ball, Size = Vector3.new(0.35, 0.6, 0.2), Color = Color3.fromRGB(10, 8, 10) }),
		face,
		CFrame.new(0, -0.35, -0.4),
		costume
	)
	-- Long tattered dress that hides the legs (she floats)
	if lower then
		for i, size in { 2.4, 3.0, 3.6 } do
			weld(
				newPart({
					Name = "Dress",
					Shape = Enum.PartType.Cylinder,
					Size = Vector3.new(1.6, size, size),
					Color = cloth:Lerp(Color3.new(0, 0, 0), i * 0.08),
					Material = Enum.Material.Fabric,
				}),
				lower,
				CFrame.new(0, -0.6 - i * 1.3, 0) * CFrame.Angles(0, 0, math.rad(90)),
				costume
			)
		end
		for i = 0, 7 do
			local a = i / 8 * math.pi * 2
			weld(
				newPart({ Name = "Tatter", Size = Vector3.new(0.6, 1.6, 0.1), Color = cloth, Material = Enum.Material.Fabric }),
				lower,
				CFrame.new(math.cos(a) * 1.7, -5.3, math.sin(a) * 1.7) * CFrame.Angles(0, -a + math.pi / 2, math.rad(8)),
				costume
			)
		end
	end
	for _, part in character:GetDescendants() do
		if part:IsA("BasePart") and (string.find(part.Name, "Leg") or string.find(part.Name, "Foot")) then
			part.Transparency = 1
		end
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid and not character:GetAttribute("Floating") then
		character:SetAttribute("Floating", true)
		humanoid.HipHeight += 1.6
	end
end

-- Dresses a killer body. `player` (optional) is whose equipped skin to use; the AI killer has none.
local function dressKiller(character: Model?, killerType: string, player: Player?)
	local head = character and character:FindFirstChild("Head")
	local hand = character and (character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm"))
	if not head or not hand then
		return
	end
	local old = character:FindFirstChild("KillerCostume")
	if old then
		old:Destroy()
	end
	local costume = Instance.new("Folder")
	costume.Name = "KillerCostume"
	costume.Parent = character

	local info = Config.Killers[killerType]
	if killerType == "Ringmaster" then
		local mask = weld(
			newPart({ Name = "Mask", Shape = Enum.PartType.Ball, Size = Vector3.new(1.4, 1.6, 1.3), Color = Color3.fromRGB(240, 235, 230) }),
			head,
			CFrame.new(0, 0.05, -0.2),
			costume
		)
		weld(
			newPart({
				Name = "Smile",
				Size = Vector3.new(0.9, 0.15, 0.1),
				Color = Color3.fromRGB(200, 20, 30),
				Material = Enum.Material.Neon,
			}),
			mask,
			CFrame.new(0, -0.35, -0.62),
			costume
		)
		weld(
			newPart({
				Name = "HatBrim",
				Shape = Enum.PartType.Cylinder,
				Size = Vector3.new(0.2, 2.4, 2.4),
				Color = Color3.fromRGB(20, 15, 20),
			}),
			head,
			CFrame.new(0, 0.75, 0) * CFrame.Angles(0, 0, math.rad(90)),
			costume
		)
		weld(
			newPart({ Name = "Hat", Shape = Enum.PartType.Cylinder, Size = Vector3.new(1.8, 1.5, 1.5), Color = Color3.fromRGB(20, 15, 20) }),
			head,
			CFrame.new(0, 1.7, 0) * CFrame.Angles(0, 0, math.rad(90)),
			costume
		)
		weld(
			newPart({ Name = "HatBand", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.3, 1.55, 1.55), Color = info.Color }),
			head,
			CFrame.new(0, 1.05, 0) * CFrame.Angles(0, 0, math.rad(90)),
			costume
		)
		weld(
			newPart({ Name = "Whip", Size = Vector3.new(0.25, 0.25, 4.5), Color = Color3.fromRGB(60, 35, 25) }),
			hand,
			CFrame.new(0, -0.6, -2),
			costume
		)
	elseif killerType == "Butcher" then
		local mask = weld(
			newPart({
				Name = "Sack",
				Shape = Enum.PartType.Ball,
				Size = Vector3.new(1.6, 1.8, 1.6),
				Color = Color3.fromRGB(150, 115, 75),
				Material = Enum.Material.Fabric,
			}),
			head,
			CFrame.new(0, 0.1, 0),
			costume
		)
		for _, x in { -0.28, 0.28 } do
			weld(
				newPart({
					Name = "EyeHole",
					Size = Vector3.new(0.22, 0.22, 0.1),
					Color = Color3.fromRGB(255, 50, 30),
					Material = Enum.Material.Neon,
				}),
				mask,
				CFrame.new(x, 0.15, -0.78),
				costume
			)
		end
		weld(
			newPart({ Name = "Stitch", Size = Vector3.new(0.8, 0.08, 0.1), Color = Color3.fromRGB(40, 25, 20) }),
			mask,
			CFrame.new(0, -0.35, -0.78),
			costume
		)
		weld(
			newPart({ Name = "Handle", Size = Vector3.new(0.3, 1.2, 0.3), Color = Color3.fromRGB(60, 35, 25) }),
			hand,
			CFrame.new(0, -1, -0.3),
			costume
		)
		weld(
			newPart({
				Name = "Cleaver",
				Size = Vector3.new(0.12, 1.4, 2.2),
				Color = Color3.fromRGB(180, 180, 190),
				Material = Enum.Material.Metal,
				Reflectance = 0.2,
			}),
			hand,
			CFrame.new(0, -1.9, -0.9),
			costume
		)
	elseif killerType == "Banshee" then
		dressBanshee(character, head, costume, info)
	else
		local mask = weld(
			newPart({
				Name = "Porcelain",
				Shape = Enum.PartType.Ball,
				Size = Vector3.new(1.35, 1.6, 1.2),
				Color = Color3.fromRGB(245, 245, 255),
				Material = Enum.Material.Glass,
			}),
			head,
			CFrame.new(0, 0.05, -0.25),
			costume
		)
		for _, x in { -0.28, 0.28 } do
			weld(
				newPart({ Name = "Eye", Size = Vector3.new(0.25, 0.12, 0.1), Color = info.Color, Material = Enum.Material.Neon }),
				mask,
				CFrame.new(x, 0.15, -0.6),
				costume
			)
		end
		weld(
			newPart({
				Name = "Hood",
				Shape = Enum.PartType.Ball,
				Size = Vector3.new(2, 2.2, 2),
				Color = Color3.fromRGB(20, 20, 30),
				Material = Enum.Material.Fabric,
			}),
			head,
			CFrame.new(0, 0.25, 0.35),
			costume
		)
		weld(
			newPart({ Name = "Shaft", Size = Vector3.new(0.25, 6, 0.25), Color = Color3.fromRGB(40, 40, 50) }),
			hand,
			CFrame.new(0, 1.5, -0.3),
			costume
		)
		weld(
			newPart({ Name = "Blade", Size = Vector3.new(0.12, 0.8, 3), Color = info.Color, Material = Enum.Material.Neon }),
			hand,
			CFrame.new(0, 4.3, -1.6),
			costume
		)
	end
	-- Equipped killer skin recolors the mask and glowing accents
	local skinId = player and player:GetAttribute("Skin_" .. killerType)
	local skin = skinId and player:GetAttribute("Owned_" .. skinId) and Cosmetics.ById[skinId]
	local accent = if skin then skin.Accent else info.Color
	if skin then
		for _, part in costume:GetChildren() do
			if part.Name == "Mask" or part.Name == "Sack" or part.Name == "Porcelain" then
				part.Color = skin.Mask
				part.Material = skin.Material
			elseif
				part.Name == "HatBand"
				or part.Name == "Smile"
				or part.Name == "EyeHole"
				or part.Name == "Eye"
				or part.Name == "Blade"
			then
				part.Color = accent
			end
		end
	end
	local eyesLight = Instance.new("PointLight")
	eyesLight.Color = accent
	eyesLight.Range = 10
	eyesLight.Brightness = 1.5
	eyesLight.Parent = head

	local reveal = Instance.new("Highlight")
	reveal.Name = "RevealHighlight"
	reveal.FillColor = Color3.fromRGB(255, 40, 40)
	reveal.OutlineColor = Color3.fromRGB(255, 120, 120)
	reveal.FillTransparency = 0.5
	reveal.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	reveal.Enabled = false
	reveal.Parent = character
end

KillerService.Dress = dressKiller

-- Removes the built-in mask/hat when a Marketplace look is used (the weapon and glowing eyes stay).
local WEAPON_PARTS = { Whip = true, Handle = true, Cleaver = true, Shaft = true, Blade = true }
function KillerService.StripMask(character: Model)
	local costume = character:FindFirstChild("KillerCostume")
	if not costume then
		return
	end
	for _, part in costume:GetChildren() do
		if not WEAPON_PARTS[part.Name] then
			part:Destroy()
		end
	end
end

-- Phantom invisibility ---------------------------------------------------

local function setVanished(player: Player, vanished: boolean)
	local character = player.Character
	if not character then
		return
	end
	for _, d in character:GetDescendants() do
		if d:IsA("BasePart") or d:IsA("Decal") then
			if vanished then
				state.Saved[d] = d.Transparency
				d.Transparency = 1
			elseif state.Saved[d] ~= nil then
				d.Transparency = state.Saved[d]
			end
		elseif d:IsA("PointLight") then
			d.Enabled = not vanished
		end
	end
	if not vanished then
		table.clear(state.Saved)
	end
	player:SetAttribute("Vanished", vanished or nil)
end

-- Core actions ------------------------------------------------------------

function KillerService.Stun(seconds: number, reason: string)
	local killer = Match.Killer
	if not killer then
		return
	end
	state.StunnedUntil = math.max(state.StunnedUntil, now() + seconds)
	state.ChargeUntil = 0
	if state.VanishUntil > now() then
		state.VanishUntil = 0
		setVanished(killer, false)
	end
	local survivor = SurvivorService.CarriedBy(killer)
	if survivor then
		SurvivorService.Drop(survivor, "Injured")
		Remotes.notify(survivor, "You fell free! RUN!", "success")
	end
	Remotes.notify(killer, "💫 Stunned by " .. reason .. "!", "error")
end

-- Slows the player killer for a moment (e.g. after searching an empty locker).
function KillerService.SlowFor(seconds: number)
	state.SlowedUntil = math.max(state.SlowedUntil, now() + seconds)
end

-- Teleports a killer body forward through the air (stops before walls). If it lands right next to a
-- standing survivor, onHit(survivor) is called. Shared by the player Banshee and the AI.
function KillerService.Blink(character: Model?, root: BasePart, info, onHit, towards: Vector3?)
	local look = if towards then (towards - root.Position) else root.CFrame.LookVector
	local direction = Vector3.new(look.X, 0, look.Z)
	if direction.Magnitude < 0.01 then
		return
	end
	direction = direction.Unit
	local distance = info.BlinkDistance
	if towards then
		distance = math.min(distance, (towards - root.Position).Magnitude - 3)
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { character }
	params.RespectCanCollide = true -- corn and other non-solid things don't stop a blink
	local hit = workspace:Raycast(root.Position, direction * distance, params)
	if hit then
		distance = math.max(0, hit.Distance - 2.5)
	end
	local from = root.Position
	local target = from + direction * distance
	Remotes.Sfx:FireAllClients("Blink", from)
	root.CFrame = CFrame.lookAt(target, target + direction)
	Remotes.Sfx:FireAllClients("Blink", target)
	for _, survivor in Match.Survivors() do
		local sroot = Match.Root(survivor)
		if sroot and Match.IsStandingSurvivor(survivor) and (sroot.Position - target).Magnitude < 5 then
			onHit(survivor)
			break
		end
	end
end

function KillerService.Freeze(seconds: number)
	state.FrozenUntil = now() + seconds
end

local function landHit(killer: Player, victim: Player)
	local result = SurvivorService.Hit(victim)
	if not result then
		return
	end
	state.SlowedUntil = now() + Config.Speeds.KillerAfterHitTime
	local reward = if result == "Downed" then Config.Rewards.KillerDown else Config.Rewards.KillerHit
	local earned = DataService.AddTickets(killer, reward, true)
	Remotes.notify(
		killer,
		(if result == "Downed" then "🩸 Downed " else "🔪 Hit ") .. victim.DisplayName .. "! +" .. earned .. " 🎟️",
		"success"
	)
end

local function attack(killer: Player)
	if not isKiller(killer) or not Match.Active then
		return
	end
	local t = now()
	if t < (killer:GetAttribute("AttackReadyAt") or 0) or t < state.StunnedUntil or t < state.FrozenUntil then
		return
	end
	if SurvivorService.CarriedBy(killer) then
		return
	end
	if state.VanishUntil > t then
		-- Attacking ends the vanish (reveal first, then you can swing)
		state.VanishUntil = 0
		setVanished(killer, false)
		killer:SetAttribute("AttackReadyAt", t + 0.4)
		return
	end
	killer:SetAttribute("AttackReadyAt", t + Config.Attack.Cooldown)
	local root = Match.Root(killer)
	if not root then
		return
	end
	Remotes.Swing:FireAllClients(killer.UserId)

	local best, bestDistance = nil, math.huge
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.RespectCanCollide = true -- you can swing through corn
	for _, survivor in Match.Survivors() do
		local health = Match.Health(survivor)
		local sroot = Match.Root(survivor)
		if sroot and (health == "Healthy" or health == "Injured") and not survivor:GetAttribute("Hiding") then
			local offset = sroot.Position - root.Position
			local flat = Vector3.new(offset.X, 0, offset.Z)
			local distance = flat.Magnitude
			if
				distance < Config.Attack.Range
				and math.abs(offset.Y) < 6
				and (distance < 2 or flat.Unit:Dot(root.CFrame.LookVector) > Config.Attack.ArcDot)
			then
				params.FilterDescendantsInstances = { killer.Character, survivor.Character }
				if not workspace:Raycast(root.Position, offset, params) and distance < bestDistance then
					best, bestDistance = survivor, distance
				end
			end
		end
	end
	if best then
		landHit(killer, best)
	else
		state.SlowedUntil = now() + 0.6 -- a whiff is punished a little
	end
end

local function placeTrap(killer: Player, info)
	local root = Match.Root(killer)
	if not root then
		return false
	end
	local ground = root.Position - Vector3.new(0, 2.9, 0)
	local trap = Instance.new("Model")
	trap.Name = "BearTrap"
	local base = newPart({
		Name = "Base",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.3, 3.2, 3.2),
		CFrame = CFrame.new(ground) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(60, 55, 55),
		Material = Enum.Material.CorrodedMetal,
		Anchored = true,
		CanCollide = false,
	})
	base.Parent = trap
	for _, side in { -1, 1 } do
		local jaw = newPart({
			Name = "Jaw",
			Size = Vector3.new(3, 0.6, 0.2),
			CFrame = CFrame.new(ground + Vector3.new(0, 0.4, side * 1.2)) * CFrame.Angles(math.rad(side * 40), 0, 0),
			Color = Color3.fromRGB(120, 115, 110),
			Material = Enum.Material.Metal,
			Anchored = true,
			CanCollide = false,
			CanTouch = false,
		})
		jaw.Parent = trap
	end
	trap.Parent = workspace
	table.insert(state.Traps, trap)
	if #state.Traps > info.MaxTraps then
		table.remove(state.Traps, 1):Destroy()
	end
	local sprung = false
	base.Touched:Connect(function(hit)
		local survivor = Match.PlayerFromHit(hit)
		if sprung or not survivor or not Match.IsStandingSurvivor(survivor) then
			return
		end
		sprung = true
		local index = table.find(state.Traps, trap)
		if index then
			table.remove(state.Traps, index)
		end
		trap:Destroy()
		local untilTime = now() + info.TrapTime
		survivor:SetAttribute("TrappedUntil", untilTime)
		survivor:SetAttribute("WorkingOn", nil)
		Match.SetSpeed(survivor, 0)
		Remotes.Scare:FireClient(survivor, "trap")
		Remotes.notify(survivor, "🪤 You stepped in a bear trap!", "error")
		if Match.Killer then
			Remotes.notify(Match.Killer, "🪤 " .. survivor.DisplayName .. " is caught in a trap!", "success")
			local sroot = Match.Root(survivor)
			if sroot then
				Remotes.Ping:FireClient(Match.Killer, sroot.Position, "trap")
			end
		end
		task.delay(info.TrapTime, function()
			if survivor:GetAttribute("TrappedUntil") == untilTime then
				survivor:SetAttribute("TrappedUntil", nil)
				if Match.IsStandingSurvivor(survivor) then
					SurvivorService.SetHealth(survivor, Match.Health(survivor))
				end
			end
		end)
	end)
	return true
end

local function useAbility(killer: Player)
	if not isKiller(killer) or not Match.Active then
		return
	end
	local t = now()
	if t < (killer:GetAttribute("AbilityReadyAt") or 0) or t < state.StunnedUntil or t < state.FrozenUntil then
		return
	end
	local killerType = Match.KillerType
	local info = Config.Killers[killerType]
	local used = false
	if killerType == "Ringmaster" then
		used = placeTrap(killer, info)
	elseif killerType == "Butcher" then
		if not SurvivorService.CarriedBy(killer) then
			state.ChargeUntil = t + info.ChargeTime
			state.ChargeHit = false
			used = true
		end
	elseif killerType == "Banshee" then
		local root = Match.Root(killer)
		if root then
			KillerService.Blink(killer.Character, root, info, function(victim)
				landHit(killer, victim)
			end)
			state.SlowedUntil = t + info.BlinkFatigue
			used = true
		end
	elseif killerType == "Phantom" then
		if not SurvivorService.CarriedBy(killer) then
			state.VanishUntil = t + info.VanishTime
			setVanished(killer, true)
			used = true
		end
	end
	if used then
		killer:SetAttribute("AbilityReadyAt", t + info.Cooldown)
	end
end

-- Pallets -----------------------------------------------------------------

local function setupPallets()
	for _, spot in Match.Map.Pallets do
		spot.State = "Standing"
		local pallet = spot.Pallet
		spot.SlatOffsets = {}
		for _, slat in spot.Model:GetChildren() do
			if slat.Name == "Slat" then
				spot.SlatOffsets[slat] = spot.Standing:ToObjectSpace(slat.CFrame)
			end
		end
		spot.DropPrompt = Match.Prompt(pallet, "DropPrompt", "Survivor", "Drop pallet", "", 0, 9)
		spot.BreakPrompt = Match.Prompt(pallet, "BreakPrompt", "Killer", "Break pallet", "", Config.Pallet.BreakTime, 9)
		spot.BreakPrompt.Enabled = false
		spot.DropPrompt.Triggered:Connect(function(survivor)
			if spot.State ~= "Standing" or not Match.IsStandingSurvivor(survivor) then
				return
			end
			spot.State = "Dropped"
			spot.DropPrompt.Enabled = false
			Remotes.Sfx:FireAllClients("Pallet", spot.Dropped.Position)
			spot.BreakPrompt.Enabled = true
			TweenService:Create(pallet, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { CFrame = spot.Dropped })
				:Play()
			for slat, offset in spot.SlatOffsets do
				TweenService:Create(slat, TweenInfo.new(0.25), { CFrame = spot.Dropped * offset }):Play()
			end
			task.delay(0.2, function()
				pallet.CanCollide = true
			end)
			local killerRoot = Match.Killer and Match.Root(Match.Killer)
			if killerRoot and (killerRoot.Position - spot.Dropped.Position).Magnitude < Config.Pallet.StunRadius then
				KillerService.Stun(Config.Pallet.StunTime, "a pallet")
				local earned = DataService.AddTickets(survivor, Config.Rewards.PalletStun, true)
				Remotes.notify(survivor, "💥 PALLET STUN! +" .. earned .. " 🎟️", "success")
			elseif KillerService.OnPalletDropped then
				KillerService.OnPalletDropped(spot.Dropped.Position, survivor)
			end
		end)
		spot.BreakPrompt.Triggered:Connect(function(killer)
			if spot.State ~= "Dropped" or not isKiller(killer) then
				return
			end
			spot.State = "Broken"
			spot.BreakPrompt.Enabled = false
			pallet.CanCollide = false
			pallet.Transparency = 1
			for _, slat in spot.Model:GetChildren() do
				if slat.Name == "Slat" then
					slat.Transparency = 1
				end
			end
		end)
	end
end

local function resetPallets()
	for _, spot in Match.Map.Pallets do
		spot.State = "Standing"
		spot.Pallet.CFrame = spot.Standing
		spot.Pallet.CanCollide = false
		spot.Pallet.Transparency = 0
		for slat, offset in spot.SlatOffsets do
			slat.CFrame = spot.Standing * offset
			slat.Transparency = 0
		end
		spot.DropPrompt.Enabled = true
		spot.BreakPrompt.Enabled = false
	end
end

-- Match lifecycle ---------------------------------------------------------

function KillerService.Setup(player: Player, killerType: string)
	player:SetAttribute("Role", "Killer")
	player:SetAttribute("KillerType", killerType)
	player:SetAttribute("AttackReadyAt", 0)
	player:SetAttribute("AbilityReadyAt", 0)
	local character = player.Character
	if character then
		Match.SetCollisionGroup(character, "Players")
	end
	local hasLook = KillerLook.ApplyToPlayer(player, killerType)
	dressKiller(player.Character, killerType, player)
	if hasLook then
		KillerService.StripMask(player.Character)
	end
end

function KillerService.Reveal(seconds: number)
	local killer = Match.Killer
	local character = if killer then killer.Character else Match.BotModel
	local highlight = character and character:FindFirstChild("RevealHighlight")
	if highlight then
		highlight.Enabled = true
		task.delay(seconds, function()
			if highlight.Parent then
				highlight.Enabled = false
			end
		end)
	end
end

function KillerService.Reset()
	for _, trap in state.Traps do
		trap:Destroy()
	end
	table.clear(state.Traps)
	if Match.Killer and state.VanishUntil > now() then
		setVanished(Match.Killer, false)
	end
	state.StunnedUntil, state.FrozenUntil, state.SlowedUntil, state.ChargeUntil, state.VanishUntil = 0, 0, 0, 0, 0
	if Match.Map then
		resetPallets()
	end
end

local function tick()
	local killer = Match.Killer
	if not killer or not Match.Active or not isKiller(killer) then
		return
	end
	local t = now()
	local info = Config.Killers[Match.KillerType]
	local speed = Config.Speeds.Killer
	if state.VanishUntil > 0 and t >= state.VanishUntil then
		state.VanishUntil = 0
		setVanished(killer, false)
	end
	if t < state.StunnedUntil or t < state.FrozenUntil then
		speed = 0
	elseif t < state.ChargeUntil then
		speed = info.ChargeSpeed
		local root = Match.Root(killer)
		if root and not state.ChargeHit then
			for _, survivor in Match.Survivors() do
				local sroot = Match.Root(survivor)
				if sroot and Match.IsStandingSurvivor(survivor) and (sroot.Position - root.Position).Magnitude < 5 then
					state.ChargeHit = true
					state.ChargeUntil = 0
					landHit(killer, survivor)
					break
				end
			end
		end
	elseif t < state.VanishUntil then
		speed = info.VanishSpeed
	elseif t < state.SlowedUntil then
		speed = Config.Speeds.KillerAfterHit
	elseif SurvivorService.CarriedBy(killer) then
		speed = Config.Speeds.KillerCarrying
	end
	Match.SetSpeed(killer, speed)
	killer:SetAttribute("StunnedUntil", state.StunnedUntil)
end

function KillerService.Init()
	setupPallets()
	Remotes.Attack.OnServerEvent:Connect(attack)
	Remotes.Ability.OnServerEvent:Connect(useAbility)
	task.spawn(function()
		while true do
			task.wait(0.1)
			local ok, err = pcall(tick)
			if not ok then
				warn("[KillerService] tick error:", err)
			end
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		if player == Match.Killer then
			KillerService.Reset()
		end
	end)
end

return KillerService
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="15">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- Entry point: builds the fair, starts every service, handles players joining/leaving.
local Players = game:GetService("Players")

local Server = script.Parent
local BotKiller = require(Server.BotKiller)
local CosmeticService = require(Server.CosmeticService)
local DataService = require(Server.DataService)
local HideService = require(Server.HideService)
local MapBuilder = require(Server.MapBuilder)
local Match = require(Server.Match)
local SurvivorService = require(Server.SurvivorService)
local KillerService = require(Server.KillerService)
local ObjectiveService = require(Server.ObjectiveService)
local RoundService = require(Server.RoundService)
local MonetizationService = require(Server.MonetizationService)

Match.SetupCollisionGroups()
Match.Map = MapBuilder.Build()

DataService.Init()
SurvivorService.Init()
SurvivorService.SetupCages()
KillerService.Init()
ObjectiveService.Init()
HideService.Init()
MonetizationService.Init()
CosmeticService.Init()
BotKiller.Init()
RoundService.Init()

local function onPlayerAdded(player: Player)
	player:SetAttribute("Role", "Lobby")
	player.CharacterAdded:Connect(function(character)
		local role = Match.Role(player)
		if role ~= "Ghost" then
			task.defer(Match.SetCollisionGroup, character, "Players")
		end
		task.delay(0.5, CosmeticService.Apply, player)
		RoundService.OnCharacterAdded(player, character)
	end)
	local data = DataService.Load(player)
	if not data then
		return
	end
	MonetizationService.LoadPasses(player)
	player:SetAttribute("Loaded", true)
end

Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(function(player)
	DataService.Release(player)
end)
for _, player in Players:GetPlayers() do
	task.spawn(onPlayerAdded, player)
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">MapBuilder</string>
          <string name="Source"><![CDATA[-- Lays out Hollow Acres: a rotting cornfield farm at sunset (400 x 400 studs), DBD Rotten Fields style.
--   center: two-story farmhouse · NW: barn + grain silos · SE: second barn · NE: windmill
--   N: abandoned combine harvester · SW: killer shack · everywhere else: tall walk-through corn
local Props = require(script.Parent.Props)

local MapBuilder = {}

local HALF = 200 -- the map spans -200..200 on X and Z
local rng = Random.new(66613)
local rgb = Color3.fromRGB

local reserved = {} -- { position: Vector3, radius: number } spots corn and props must not overlap

local function at(x: number, z: number, yawDeg: number?)
	return CFrame.new(x, 0, z) * CFrame.Angles(0, math.rad(yawDeg or 0), 0)
end

local function reserve(x: number, z: number, radius: number)
	table.insert(reserved, { position = Vector3.new(x, 0, z), radius = radius })
end

local function isFree(x: number, z: number, radius: number)
	if math.abs(x) > HALF - 6 or math.abs(z) > HALF - 6 then
		return false
	end
	local p = Vector3.new(x, 0, z)
	for _, r in reserved do
		if (r.position - p).Magnitude < r.radius + radius then
			return false
		end
	end
	return true
end

local function tryPlace(x: number, z: number, radius: number, build)
	if isFree(x, z, radius) then
		build(at(x, z, rng:NextNumber(0, 360)))
		reserve(x, z, radius)
		return true
	end
	return false
end

local terrain = workspace.Terrain

local function paintStrip(from: Vector2, to: Vector2, width: number, material: Enum.Material)
	local a, b = Vector3.new(from.X, -1, from.Y), Vector3.new(to.X, -1, to.Y)
	terrain:FillBlock(CFrame.lookAt((a + b) / 2, b), Vector3.new(width, 2, (b - a).Magnitude + width), material)
end

local function paintCircle(x: number, z: number, radius: number, material: Enum.Material)
	terrain:FillCylinder(CFrame.new(x, -1, z), 2, radius, material)
end

-- A dirt lane: painted mud, kept clear of corn
local function lane(from: Vector2, to: Vector2, width: number)
	paintStrip(from, to, width, Enum.Material.Mud)
	local length = (to - from).Magnitude
	for d = 0, length, width * 0.6 do
		local p = from:Lerp(to, d / length)
		reserve(p.X, p.Y, width * 0.5)
	end
end

local function buildTerrain()
	terrain:Clear()
	terrain:FillBlock(CFrame.new(0, -6, 0), Vector3.new(HALF * 2 + 260, 12, HALF * 2 + 260), Enum.Material.Grass)
	-- Tilled soil under the whole field, with patchy grass
	terrain:FillBlock(CFrame.new(0, -1, 0), Vector3.new(HALF * 2, 2, HALF * 2), Enum.Material.Ground)
	for _ = 1, 60 do
		paintCircle(
			rng:NextNumber(-HALF, HALF),
			rng:NextNumber(-HALF, HALF),
			rng:NextNumber(5, 14),
			if rng:NextNumber() < 0.6 then Enum.Material.LeafyGrass else Enum.Material.Mud
		)
	end
	paintCircle(0, 0, 48, Enum.Material.Grass) -- farmhouse yard
	-- Hills beyond the fence (exit corridors stay open)
	for i = 0, 47 do
		local angle = i / 48 * math.pi * 2
		local dist = HALF + rng:NextNumber(55, 85)
		local x = math.clamp(math.cos(angle) * dist * 1.25, -HALF - 85, HALF + 85)
		local z = math.clamp(math.sin(angle) * dist * 1.25, -HALF - 85, HALF + 85)
		if math.abs(x) > 50 or math.abs(z) < HALF then
			terrain:FillBall(
				Vector3.new(x, -12, z),
				rng:NextNumber(38, 52),
				if rng:NextNumber() < 0.25 then Enum.Material.Rock else Enum.Material.Grass
			)
		end
	end
	pcall(function()
		terrain.Decoration = true
	end)
end

local function buildBoundary(parent)
	local boundary = Props.Model("Boundary", parent)
	local gap = 12
	-- North and south walls have a gap in the middle for the exit gates
	for _, z in { -HALF, HALF } do
		Props.Fence(Vector3.new(-HALF, 0, z), Vector3.new(-gap, 0, z), boundary)
		Props.Fence(Vector3.new(gap, 0, z), Vector3.new(HALF, 0, z), boundary)
	end
	Props.Fence(Vector3.new(-HALF, 0, -HALF), Vector3.new(-HALF, 0, HALF), boundary)
	Props.Fence(Vector3.new(HALF, 0, -HALF), Vector3.new(HALF, 0, HALF), boundary)
	-- Fog-covered forest outside the fence
	local forest = Props.Model("Forest", parent)
	for _ = 1, 120 do
		local angle = rng:NextNumber(0, math.pi * 2)
		local dist = rng:NextNumber(HALF + 15, HALF + 70)
		local x = math.clamp(math.cos(angle) * dist * 1.3, -HALF - 70, HALF + 70)
		local z = math.clamp(math.sin(angle) * dist * 1.3, -HALF - 70, HALF + 70)
		if math.abs(x) > HALF + 10 or math.abs(z) > HALF + 10 then
			Props.DeadTree(at(x, z), forest)
		end
	end
	-- Walls around the escape area beyond each gate so players can't wander off
	for _, z in { -HALF, HALF } do
		local s = math.sign(z)
		Props.Fence(Vector3.new(-gap, 0, z), Vector3.new(-gap, 0, z + s * 24), boundary)
		Props.Fence(Vector3.new(gap, 0, z), Vector3.new(gap, 0, z + s * 24), boundary)
		Props.Fence(Vector3.new(-gap, 0, z + s * 24), Vector3.new(gap, 0, z + s * 24), boundary)
	end
end

local function buildLobby(parent)
	local lobby = Props.Model("Lobby", parent)
	local origin = CFrame.new(0, 0, -900)
	Props.Part({
		Name = "Floor",
		Size = Vector3.new(90, 2, 90),
		CFrame = origin * CFrame.new(0, -1, 0),
		Color = rgb(45, 30, 50),
		Material = Enum.Material.Slate,
	}, lobby)
	for _, spec in { { 0, -45, 0 }, { 0, 45, 0 }, { -45, 0, 90 }, { 45, 0, 90 } } do
		Props.Part({
			Name = "Wall",
			Size = Vector3.new(90, 14, 2),
			CFrame = origin * CFrame.new(spec[1], 7, spec[2]) * CFrame.Angles(0, math.rad(spec[3]), 0),
			Color = rgb(70, 40, 60),
			Material = Enum.Material.WoodPlanks,
		}, lobby)
	end
	Props.EntranceArch(origin * CFrame.new(0, 0, 30), lobby, "NIGHTMARE FAIR")
	Props.Carousel(origin * CFrame.new(0, 0, -14), lobby)
	for _, x in { -32, 32 } do
		Props.TicketBooth(origin * CFrame.new(x, 0, 30), lobby)
		Props.PumpkinPile(origin * CFrame.new(x, 0, -32), lobby)
		Props.LampPost(origin * CFrame.new(x, 0, 0), lobby)
	end
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "LobbySpawn"
	spawn.Anchored = true
	spawn.Size = Vector3.new(12, 0.4, 12)
	spawn.CFrame = origin * CFrame.new(0, 0.2, 18)
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Color = rgb(150, 60, 160)
	spawn.Material = Enum.Material.Neon
	spawn.Parent = lobby
	return origin * CFrame.new(0, 3, 18)
end

function MapBuilder.Build()
	local existing = workspace:FindFirstChild("Baseplate")
	if existing then
		existing:Destroy()
	end
	table.clear(reserved)

	local map = Instance.new("Folder")
	map.Name = "Map"
	map.Parent = workspace
	buildTerrain()

	local result = { Pumpkins = {}, Cages = {}, Pallets = {}, Bells = {}, Gates = {}, Lockers = {} }
	local objectives = Instance.new("Folder")
	objectives.Name = "Objectives"
	objectives.Parent = map
	local buildings = Instance.new("Folder")
	buildings.Name = "Buildings"
	buildings.Parent = map

	local function addLocker(cf: CFrame, style: string?)
		table.insert(result.Lockers, Props.Locker(cf, objectives, style))
	end
	local function addPumpkin(cf: CFrame)
		table.insert(result.Pumpkins, Props.RitualPumpkin(cf, objectives))
		reserve(cf.X, cf.Z, 7)
	end

	-- Lanes through the corn: they wander like real tractor paths instead of running ruler-straight
	local function wander(points, width)
		for i = 1, #points - 1 do
			local a, b = points[i], points[i + 1]
			local mid = (a + b) / 2 + Vector2.new(rng:NextNumber(-10, 10), rng:NextNumber(-10, 10))
			lane(a, mid, width)
			lane(mid, b, width)
		end
	end
	wander({ Vector2.new(0, -HALF), Vector2.new(-8, -110), Vector2.new(0, -45) }, 12)
	wander({ Vector2.new(0, 45), Vector2.new(10, 120), Vector2.new(0, HALF) }, 12)
	wander({ Vector2.new(-HALF + 10, 18), Vector2.new(-110, 6), Vector2.new(-48, 0) }, 9)
	wander({ Vector2.new(48, 0), Vector2.new(110, -14), Vector2.new(HALF - 10, -6) }, 9)
	wander({ Vector2.new(-120, -100), Vector2.new(-75, -70), Vector2.new(-30, -40) }, 9)
	wander({ Vector2.new(125, 95), Vector2.new(85, 70), Vector2.new(38, 40) }, 9)
	wander({ Vector2.new(115, -110), Vector2.new(70, -75), Vector2.new(30, -40) }, 8)
	wander({ Vector2.new(-125, 120), Vector2.new(-80, 80), Vector2.new(-36, 38) }, 8)
	wander({ Vector2.new(-170, -150), Vector2.new(-90, -160), Vector2.new(-45, -150) }, 7)
	wander({ Vector2.new(60, 150), Vector2.new(120, 160), Vector2.new(175, 150) }, 7)

	-- The farmhouse (main building), porch facing the south gate
	local house = Props.Farmhouse(at(0, 0, 180), buildings)
	reserve(0, 0, 42)
	for _, cf in house.Lockers do
		addLocker(cf, "wood")
	end
	addPumpkin(house.Pumpkin)

	-- Barns
	local barnA, barnB = at(-120, -100, 90), at(125, 95, 0)
	Props.Barn(barnA, buildings)
	Props.Barn(barnB, buildings)
	reserve(-120, -100, 26)
	reserve(125, 95, 26)
	addPumpkin(barnA * CFrame.new(6, 0, 0))
	addPumpkin(barnB * CFrame.new(6, 0, 0))
	for _, barn in { barnA, barnB } do
		addLocker(barn * CFrame.new(11, 0.5, 10.5), "metal")
		addLocker(barn * CFrame.new(-11, 0.5, -10.5) * CFrame.Angles(0, math.pi, 0), "metal")
	end
	for _, s in { { -160, -55 }, { -178, -62 }, { -165, -78 } } do
		Props.Silo(at(s[1], s[2], rng:NextNumber(0, 360)), buildings)
		reserve(s[1], s[2], 9)
	end
	addLocker(at(-150, -66, 120), "metal")
	reserve(-150, -66, 4)

	-- Windmill, combine, killer shack, outhouse, tractors
	Props.Windmill(at(115, -110, 200), buildings)
	reserve(115, -110, 9)
	addLocker(at(106, -102, 135), "metal")
	reserve(106, -102, 4)
	Props.Combine(at(-45, -160, 25), buildings)
	reserve(-45, -160, 17)
	addLocker(at(-26, -170, 200), "metal")
	reserve(-26, -170, 4)
	local shack = at(-125, 120, 20)
	Props.Shack(shack, buildings)
	reserve(-125, 120, 13)
	addPumpkin(shack * CFrame.new(1, 0, 1))
	addLocker(shack * CFrame.new(-5.2, 0.5, 5.4), "metal")
	Props.Outhouse(at(48, 55, 200), buildings)
	reserve(48, 55, 5)
	Props.Tractor(at(62, -42, 70), buildings)
	reserve(62, -42, 7)
	Props.Tractor(at(-68, 44, 250), buildings)
	reserve(-68, 44, 7)

	-- Corn clearings with Ritual Pumpkins
	for _, s in { { 78, -92 }, { -70, 95 }, { 150, 12 } } do
		reserve(s[1], s[2], 14)
		addPumpkin(at(s[1], s[2], rng:NextNumber(0, 360)))
		paintCircle(s[1], s[2], 13, Enum.Material.Mud)
	end

	-- Crow Cages
	for _, s in { { -40, -62 }, { 40, -72 }, { -92, -18 }, { 92, 26 }, { -40, 132 }, { 42, 140 }, { -160, 30 }, { 165, -60 } } do
		table.insert(result.Cages, Props.CrowCage(at(s[1], s[2], rng:NextNumber(0, 360)), objectives))
		reserve(s[1], s[2], 7)
	end

	-- Ghost bells in the four corners
	for _, s in { { -172, -172 }, { 172, -172 }, { -172, 172 }, { 172, 172 } } do
		table.insert(result.Bells, Props.Bell(at(s[1], s[2], rng:NextNumber(0, 360)), objectives))
		reserve(s[1], s[2], 5)
	end

	-- Exit gates north and south
	for _, z in { -HALF, HALF } do
		table.insert(result.Gates, Props.ExitGate(at(0, z, if z < 0 then 180 else 0), objectives))
	end

	-- Pallets at the edge of lanes and around buildings (chase loops)
	local loops = Instance.new("Folder")
	loops.Name = "Loops"
	loops.Parent = map
	for _, s in
		{
			{ 22, -40, 90 },
			{ -24, 42, 90 },
			{ -60, 0, 0 },
			{ 60, 0, 0 },
			{ -95, -70, 45 },
			{ 98, 68, 45 },
			{ -150, -120, 0 },
			{ 150, 125, 0 },
			{ 85, -135, 90 },
			{ -85, 150, 90 },
			{ 0, -75, 0 },
			{ 0, 80, 0 },
			{ -175, -10, 90 },
			{ 178, -15, 90 },
			{ -110, 165, 0 },
			{ 120, -165, 0 },
		}
	do
		table.insert(result.Pallets, Props.PalletSpot(at(s[1], s[2], s[3]), loops))
		reserve(s[1], s[2], 11)
	end
	for _, s in { { 30, 110, 0 }, { -38, -112, 90 }, { 140, -30, 180 }, { -140, 60, 270 } } do
		if isFree(s[1], s[2], 9) then
			Props.LWall(at(s[1], s[2], s[3]), loops)
			reserve(s[1], s[2], 10)
		end
	end

	-- Set dressing around the buildings
	local dressing = Instance.new("Folder")
	dressing.Name = "SetDressing"
	dressing.Parent = map
	for _, s in { { -100, -125 }, { -140, -80 }, { 145, 75 }, { 105, 120 } } do
		tryPlace(s[1], s[2], 7, function(cf)
			Props.HayStack(cf, dressing)
		end)
	end
	for _, s in { { -60, -150 }, { -30, -145 }, { 75, -50 }, { -82, 50 } } do
		tryPlace(s[1], s[2], 2.5, function(cf)
			Props.TireStack(cf, dressing)
		end)
	end
	for _, s in { { 25, 38 }, { -28, -36 }, { 30, -38 }, { -30, 30 } } do
		tryPlace(s[1], s[2], 3, function(cf)
			Props.CrateStack(cf, dressing)
		end)
	end
	for _, cage in result.Cages do
		tryPlace(cage.Position.X + 6, cage.Position.Z - 5, 2, function(cf)
			Props.Barrel(cf, dressing)
		end)
	end
	for _, pumpkin in result.Pumpkins do
		tryPlace(pumpkin.Position.X + 8, pumpkin.Position.Z + 5, 3, function(cf)
			Props.PumpkinPile(cf, dressing)
		end)
	end
	Props.LowFence(Vector3.new(-48, 0, 48), Vector3.new(-48, 0, -48), dressing)
	Props.LowFence(Vector3.new(48, 0, -48), Vector3.new(48, 0, 20), dressing)

	-- Work lights by the barn doors and the farmhouse yard
	for _, cf in { barnA * CFrame.new(-8, 0, -16), barnB * CFrame.new(-8, 0, -16), at(-30, 34, 0), at(30, -34, 180), at(-112, 112, 45) } do
		Props.LampPost(cf, dressing)
	end

	-- Scarecrows standing in the corn
	for _ = 1, 14 do
		tryPlace(rng:NextNumber(-HALF + 20, HALF - 20), rng:NextNumber(-HALF + 20, HALF - 20), 3, function(cf)
			Props.Scarecrow(cf, dressing)
		end)
	end

	buildBoundary(map)

	-- Finally, plant the corn in everything that's left
	local corn = Instance.new("Folder")
	corn.Name = "Cornfield"
	corn.Parent = map
	Props.CornField(-HALF + 6, -HALF + 6, HALF - 6, HALF - 6, corn, isFree)

	result.SurvivorSpawns = {
		CFrame.new(-150, 4, -150),
		CFrame.new(150, 4, 150),
		CFrame.new(-160, 4, 150),
		CFrame.new(160, 4, -150),
		CFrame.new(-175, 4, 60),
		CFrame.new(175, 4, -100),
	}
	result.KillerSpawn = CFrame.new(0, 4, -58)
	result.LobbySpawn = buildLobby(map)
	result.Half = HALF
	return result
end

return MapBuilder
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">Match</string>
          <string name="Source"><![CDATA[-- Shared state for the current match, plus small helpers every service uses.
local CollectionService = game:GetService("CollectionService")
local PhysicsService = game:GetService("PhysicsService")
local Players = game:GetService("Players")

local Match = {}

Match.Active = false
Match.Killer = nil :: Player?
Match.KillerType = nil :: string?
Match.Map = nil -- result of MapBuilder.Build()
Match.BotModel = nil :: Model? -- the AI killer's body, in solo games
Match.OnNoise = nil -- set by BotKiller: function(position) for noises the AI should investigate

function Match.Now(): number
	return workspace:GetServerTimeNow()
end

function Match.Role(player: Player): string
	return player:GetAttribute("Role") or "Lobby"
end

function Match.Health(player: Player): string?
	return player:GetAttribute("Health")
end

function Match.Root(player: Player): BasePart?
	local character = player.Character
	return character and character:FindFirstChild("HumanoidRootPart")
end

function Match.Humanoid(player: Player): Humanoid?
	local character = player.Character
	return character and character:FindFirstChildOfClass("Humanoid")
end

-- A survivor who is still in the fight (not downed, carried, caged, eliminated or escaped).
function Match.IsStandingSurvivor(player: Player): boolean
	if Match.Role(player) ~= "Survivor" then
		return false
	end
	if player:GetAttribute("Hiding") then
		return false
	end
	local health = Match.Health(player)
	return health == "Healthy" or health == "Injured"
end

function Match.Survivors(): { Player }
	local list = {}
	for _, player in Players:GetPlayers() do
		if Match.Role(player) == "Survivor" then
			table.insert(list, player)
		end
	end
	return list
end

function Match.PlayerFromHit(hit: BasePart): Player?
	local model = hit:FindFirstAncestorOfClass("Model")
	while model do
		local player = Players:GetPlayerFromCharacter(model)
		if player then
			return player
		end
		model = model:FindFirstAncestorOfClass("Model")
	end
	return nil
end

function Match.SetSpeed(player: Player, speed: number)
	local humanoid = Match.Humanoid(player)
	if humanoid then
		humanoid.WalkSpeed = speed
	end
end

-- A proximity prompt that only players with the given role can see (the client hides the rest).
function Match.Prompt(parent: Instance, name: string, forRole: string, action: string, objectText: string?, hold: number?, range: number?)
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = name
	prompt.ActionText = action
	prompt.ObjectText = objectText or ""
	prompt.HoldDuration = hold or 0
	prompt.MaxActivationDistance = range or 8
	prompt.RequiresLineOfSight = false
	prompt:SetAttribute("For", forRole)
	prompt:SetAttribute("Range", range or 8)
	CollectionService:AddTag(prompt, "RolePrompt")
	prompt.Parent = parent
	return prompt
end

-- Collision groups: ghosts walk through living players.
function Match.SetupCollisionGroups()
	for _, group in { "Players", "Ghosts" } do
		pcall(function()
			PhysicsService:RegisterCollisionGroup(group)
		end)
	end
	PhysicsService:CollisionGroupSetCollidable("Ghosts", "Players", false)
	PhysicsService:CollisionGroupSetCollidable("Ghosts", "Ghosts", false)
end

function Match.SetCollisionGroup(character: Model, group: string)
	for _, part in character:GetDescendants() do
		if part:IsA("BasePart") then
			part.CollisionGroup = group
		end
	end
end

return Match
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">MonetizationService</string>
          <string name="Source"><![CDATA[-- Game passes, developer products, killer unlocks and the lobby killer picker.
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)

local DataService = require(script.Parent.DataService)
local CosmeticService = require(script.Parent.CosmeticService)
local SurvivorService = require(script.Parent.SurvivorService)

local MonetizationService = {}

local MAX_RECEIPTS = 100

function MonetizationService.LoadPasses(player: Player)
	for key, pass in Config.GamePasses do
		local owned = false
		if pass.Id ~= 0 then
			local ok, result = pcall(MarketplaceService.UserOwnsGamePassAsync, MarketplaceService, player.UserId, pass.Id)
			owned = ok and result == true
		end
		if RunService:IsStudio() and Config.StudioGrantAllPasses then
			owned = true
		end
		player:SetAttribute("Pass_" .. key, owned)
	end
	DataService.Sync(player)
end

local function breakOut(player: Player): boolean
	if SurvivorService.IsCaged(player) and SurvivorService.FreeFromCage(player) then
		Remotes.announce("🗝️ " .. player.DisplayName .. " broke out of a Crow Cage!", Color3.fromRGB(255, 210, 90))
		return true
	end
	return false
end

local productHandlers = {
	KillerChance = function(player: Player, data)
		data.KillerChance += Config.KillerChancePack
		DataService.Sync(player)
		Remotes.notify(
			player,
			"🔪 +" .. Config.KillerChancePack .. " Killer Chance! You now have " .. data.KillerChance .. ".",
			"success"
		)
	end,
	SelfRescue = function(player: Player, data)
		if not breakOut(player) then
			data.BreakOuts += 1
			DataService.Sync(player)
			Remotes.notify(player, "🗝️ Break Out saved! Use it next time you're caged.", "success")
		end
	end,
	TicketsSmall = function(player: Player)
		local amount = DataService.AddTickets(player, Config.TicketPacks.TicketsSmall, false)
		Remotes.notify(player, "🎟️ +" .. amount .. " tickets! Thanks for your support!", "success")
	end,
	TicketsLarge = function(player: Player)
		local amount = DataService.AddTickets(player, Config.TicketPacks.TicketsLarge, false)
		Remotes.notify(player, "🎟️ +" .. amount .. " tickets! Thanks for your support!", "success")
	end,
	TicketsHuge = function(player: Player)
		local amount = DataService.AddTickets(player, Config.TicketPacks.TicketsHuge, false)
		Remotes.notify(player, "🎟️ +" .. amount .. " tickets! Thanks for your support!", "success")
	end,
}
for _, key in { "PackStarter", "PackHalloween", "PackKiller", "PackLegendary" } do
	productHandlers[key] = function(player: Player)
		CosmeticService.GrantBundle(player, key)
	end
end

local handlerById = {}
for key, product in Config.Products do
	if product.Id ~= 0 and productHandlers[key] then
		handlerById[product.Id] = productHandlers[key]
	end
end

local function processReceipt(info)
	local player = Players:GetPlayerByUserId(info.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local data = DataService.Get(player)
	if not data then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if data.ReceiptIds[info.PurchaseId] then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	local handler = handlerById[info.ProductId]
	if not handler then
		warn("[Monetization] No handler for product", info.ProductId)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local ok, err = pcall(handler, player, data)
	if not ok then
		warn("[Monetization] Handler error:", err)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	data.ReceiptIds[info.PurchaseId] = os.time()
	local count, oldestId, oldestTime = 0, nil, math.huge
	for id, time in data.ReceiptIds do
		count += 1
		if time < oldestTime then
			oldestId, oldestTime = id, time
		end
	end
	if count > MAX_RECEIPTS and oldestId then
		data.ReceiptIds[oldestId] = nil
	end

	if not DataService.Save(player) then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

function MonetizationService.Init()
	MarketplaceService.ProcessReceipt = processReceipt

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		if not purchased then
			return
		end
		for key, pass in Config.GamePasses do
			if pass.Id ~= 0 and pass.Id == passId then
				player:SetAttribute("Pass_" .. key, true)
				DataService.Sync(player)
				Remotes.notify(player, "Thanks for buying " .. pass.Name .. "!", "success")
			end
		end
	end)

	Remotes.SelectKiller.OnServerInvoke = function(player, killer)
		local data = DataService.Get(player)
		if not data or type(killer) ~= "string" or not Config.Killers[killer] then
			return false, "Unknown killer."
		end
		if not player:GetAttribute("Unlocked_" .. killer) then
			return false, "Unlock " .. Config.Killers[killer].Name .. " first."
		end
		data.PreferredKiller = killer
		DataService.Sync(player)
		return true, "You'll play as " .. Config.Killers[killer].Name .. " when you're the killer."
	end

	Remotes.BuyKiller.OnServerInvoke = function(player, killer)
		local data = DataService.Get(player)
		local info = type(killer) == "string" and Config.Killers[killer]
		if not data or not info then
			return false, "Unknown killer."
		end
		if player:GetAttribute("Unlocked_" .. killer) then
			return false, "Already unlocked!"
		end
		if not DataService.SpendTickets(player, info.Price) then
			return false, "You need " .. info.Price .. " 🎟️"
		end
		data.Unlocked[killer] = true
		data.PreferredKiller = killer
		DataService.Sync(player)
		return true, "🔓 " .. info.Name .. " unlocked!"
	end

	Remotes.UseSelfRescue.OnServerInvoke = function(player)
		local data = DataService.Get(player)
		if not data or data.BreakOuts <= 0 then
			return false, "You have no Break Outs."
		end
		if not breakOut(player) then
			return false, "You're not in a cage."
		end
		data.BreakOuts -= 1
		DataService.Sync(player)
		return true, "🗝️ You broke out! RUN!"
	end
end

return MonetizationService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">ObjectiveService</string>
          <string name="Source"><![CDATA[-- Survivor objectives: light Ritual Pumpkins (with skill checks), power and open the exit gates, escape.
-- Ghosts ring bells to reveal the killer.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)

local DataService = require(script.Parent.DataService)
local KillerService = require(script.Parent.KillerService)
local Match = require(script.Parent.Match)
local SurvivorService = require(script.Parent.SurvivorService)

local ObjectiveService = {}

local rng = Random.new()
local nextCheck = {} -- [Player] = time of the next skill check
local pending = {} -- [Player] = { Id, Deadline, Pumpkin }
local checkCounter = 0

local DARK_FACE = Color3.fromRGB(30, 20, 15)
local LIT_FACE = Color3.fromRGB(255, 220, 90)

local function now()
	return Match.Now()
end

local function litCount(): number
	local count = 0
	for _, pumpkin in Match.Map.Pumpkins do
		if pumpkin.Lit then
			count += 1
		end
	end
	return count
end

local function setPumpkinVisual(pumpkin)
	local fraction = pumpkin.Progress
	pumpkin.Label.Text = if pumpkin.Lit then "🎃 LIT" else "🎃 " .. math.floor(fraction * 100) .. "%"
	pumpkin.Light.Brightness = if pumpkin.Lit then 3 else fraction * 1.2
	pumpkin.Pumpkin.Color = Color3.fromRGB(150, 75, 25):Lerp(Color3.fromRGB(255, 130, 20), if pumpkin.Lit then 1 else fraction)
	for _, part in pumpkin.Face do
		part.Color = if pumpkin.Lit then LIT_FACE else DARK_FACE
		part.Material = if pumpkin.Lit then Enum.Material.Neon else Enum.Material.SmoothPlastic
	end
end

local function powerGates()
	workspace:SetAttribute("GatesPowered", true)
	Remotes.Sfx:FireAllClients("GateAlarm")
	workspace:SetAttribute("CollapseEndsAt", now() + Config.EndGameCollapse)
	for _, gate in Match.Map.Gates do
		gate.Lamp.Color = Color3.fromRGB(255, 200, 40)
		gate.Light.Color = Color3.fromRGB(255, 200, 40)
		gate.Prompt.Enabled = true
	end
	for _, pumpkin in Match.Map.Pumpkins do
		pumpkin.Prompt.Enabled = false
	end
	Remotes.announce(
		"⚡ The exit gates have power! Open them and ESCAPE! The fair collapses in " .. Config.EndGameCollapse .. "s.",
		Color3.fromRGB(255, 210, 60)
	)
end

local function lightPumpkin(pumpkin, workers)
	pumpkin.Lit = true
	pumpkin.Progress = 1
	Remotes.Sfx:FireAllClients("PumpkinLit", pumpkin.Position)
	pumpkin.Prompt.Enabled = false
	setPumpkinVisual(pumpkin)
	for _, worker in workers do
		worker:SetAttribute("WorkingOn", nil)
		DataService.Increment(worker, "PumpkinsLit")
		local earned = DataService.AddTickets(worker, Config.Rewards.PumpkinLit, true)
		Remotes.notify(worker, "🎃 Pumpkin lit! +" .. earned .. " 🎟️", "success")
	end
	local count = litCount()
	workspace:SetAttribute("PumpkinsLit", math.min(count, Config.Pumpkins.Needed))
	if Match.Killer then
		Remotes.Ping:FireClient(Match.Killer, pumpkin.Position, "pumpkin")
	end
	if Match.OnNoise then
		Match.OnNoise(pumpkin.Position)
	end
	if count >= Config.Pumpkins.Needed and not workspace:GetAttribute("GatesPowered") then
		powerGates()
	else
		Remotes.announce("🎃 A Ritual Pumpkin is lit! " .. count .. " / " .. Config.Pumpkins.Needed, Color3.fromRGB(255, 160, 50))
	end
end

local function resolveSkillCheck(player: Player, result: string)
	local check = pending[player]
	if not check then
		return
	end
	pending[player] = nil
	local pumpkin = check.Pumpkin
	if pumpkin.Lit then
		return
	end
	if result == "great" then
		pumpkin.Progress = math.min(0.999, pumpkin.Progress + Config.Pumpkins.GreatBonus / Config.Pumpkins.WorkSeconds)
		DataService.AddTickets(player, Config.Rewards.GreatSkillCheck, true)
	elseif result == "miss" then
		pumpkin.Progress = math.max(0, pumpkin.Progress - Config.Pumpkins.MissPenalty / Config.Pumpkins.WorkSeconds)
		Remotes.notify(player, "💥 The pumpkin sputtered! The killer heard that...", "error")
		if Match.Killer then
			Remotes.Ping:FireClient(Match.Killer, pumpkin.Position, "noise")
			Remotes.notify(Match.Killer, "💥 A survivor botched a pumpkin!", "info")
		end
		if Match.OnNoise then
			Match.OnNoise(pumpkin.Position)
		end
	end
	setPumpkinVisual(pumpkin)
end

local function tick(dt: number)
	if not Match.Active then
		return
	end
	local t = now()
	local workersByPumpkin = {}
	for _, survivor in Match.Survivors() do
		local index = survivor:GetAttribute("WorkingOn")
		if index then
			local pumpkin = Match.Map.Pumpkins[index]
			local root = Match.Root(survivor)
			local trapped = (survivor:GetAttribute("TrappedUntil") or 0) > t
			if
				not pumpkin
				or pumpkin.Lit
				or not root
				or trapped
				or not Match.IsStandingSurvivor(survivor)
				or (root.Position - pumpkin.Position).Magnitude > Config.Pumpkins.WorkRange + 3
			then
				survivor:SetAttribute("WorkingOn", nil)
				pending[survivor] = nil
			else
				workersByPumpkin[pumpkin] = workersByPumpkin[pumpkin] or {}
				table.insert(workersByPumpkin[pumpkin], survivor)
			end
		end
	end
	for pumpkin, workers in workersByPumpkin do
		local speed = 1 + Config.Pumpkins.CoopBonus * (#workers - 1)
		pumpkin.Progress = math.min(1, pumpkin.Progress + dt / Config.Pumpkins.WorkSeconds * speed)
		if pumpkin.Progress >= 1 then
			lightPumpkin(pumpkin, workers)
		else
			setPumpkinVisual(pumpkin)
			for _, worker in workers do
				worker:SetAttribute("WorkProgress", pumpkin.Progress)
				if not pending[worker] and t >= (nextCheck[worker] or 0) then
					checkCounter += 1
					pending[worker] = { Id = checkCounter, Deadline = t + 3, Pumpkin = pumpkin }
					nextCheck[worker] = t + rng:NextNumber(Config.Pumpkins.SkillCheckMin, Config.Pumpkins.SkillCheckMax)
					Remotes.SkillCheck:FireClient(worker, checkCounter)
				end
			end
		end
	end
	for player, check in pending do
		if t > check.Deadline then
			resolveSkillCheck(player, "miss")
		end
	end
end

local function setupPumpkins()
	for index, pumpkin in Match.Map.Pumpkins do
		pumpkin.Progress = 0
		pumpkin.Lit = false
		local gui = Instance.new("BillboardGui")
		gui.Size = UDim2.fromOffset(120, 30)
		gui.StudsOffsetWorldSpace = Vector3.new(0, 4.5, 0)
		gui.MaxDistance = 45
		gui.LightInfluence = 0
		local label = Instance.new("TextLabel")
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundTransparency = 1
		label.Font = Enum.Font.Oswald
		label.TextScaled = true
		label.TextColor3 = Color3.fromRGB(255, 190, 90)
		label.Text = "🎃 0%"
		local stroke = Instance.new("UIStroke")
		stroke.Thickness = 2
		stroke.Parent = label
		label.Parent = gui
		gui.Parent = pumpkin.Pumpkin
		pumpkin.Label = label

		pumpkin.Prompt =
			Match.Prompt(pumpkin.Pumpkin, "WorkPrompt", "Survivor", "Light", "Ritual Pumpkin", 0, Config.Pumpkins.WorkRange + 2)
		pumpkin.Prompt.Triggered:Connect(function(player)
			if not Match.Active or pumpkin.Lit or not Match.IsStandingSurvivor(player) then
				return
			end
			if (player:GetAttribute("TrappedUntil") or 0) > now() then
				return
			end
			player:SetAttribute("WorkingOn", index)
			nextCheck[player] = now() + rng:NextNumber(2, Config.Pumpkins.SkillCheckMax)
		end)
		setPumpkinVisual(pumpkin)
	end
end

local function openGate(gate)
	gate.Open = true
	gate.Prompt.Enabled = false
	gate.Lamp.Color = Color3.fromRGB(60, 255, 90)
	gate.Light.Color = Color3.fromRGB(60, 255, 90)
	for _, door in gate.Doors do
		TweenService:Create(door.Part, TweenInfo.new(2, Enum.EasingStyle.Quad), { CFrame = door.Open }):Play()
		door.Part.CanCollide = false
	end
	Remotes.announce("🚪 An exit gate is OPEN! Get out!", Color3.fromRGB(90, 255, 120))
end

local function setupGates()
	for _, gate in Match.Map.Gates do
		gate.Open = false
		gate.Prompt = Match.Prompt(gate.Switch, "GatePrompt", "Survivor", "Open gate", "Exit Gate", Config.Gates.OpenTime, 9)
		gate.Prompt.Enabled = false
		gate.Prompt.Triggered:Connect(function(player)
			if workspace:GetAttribute("GatesPowered") and not gate.Open and Match.IsStandingSurvivor(player) then
				openGate(gate)
			end
		end)
		gate.Escape.Touched:Connect(function(hit)
			local player = Match.PlayerFromHit(hit)
			if player and gate.Open and Match.Active and Match.IsStandingSurvivor(player) then
				SurvivorService.Escape(player)
			end
		end)
	end
end

local function setupBells()
	for _, bell in Match.Map.Bells do
		bell.ReadyAt = 0
		local prompt = Match.Prompt(bell.Bell, "BellPrompt", "Ghost", "Ring bell", "Ghost Bell", 1, 10)
		prompt.Triggered:Connect(function(ghost)
			if not Match.Active or Match.Role(ghost) ~= "Ghost" or now() < bell.ReadyAt then
				if now() < bell.ReadyAt then
					Remotes.notify(ghost, "🔔 This bell is still ringing. Try another one!", "error")
				end
				return
			end
			bell.ReadyAt = now() + Config.Bells.Cooldown
			KillerService.Reveal(Config.Bells.RevealTime)
			TweenService:Create(
				bell.Bell,
				TweenInfo.new(0.15, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, 6, true),
				{ Size = bell.Bell.Size * 1.3 }
			):Play()
			local earned = DataService.AddTickets(ghost, Config.Rewards.BellReveal, true)
			Remotes.notify(ghost, "🔔 The killer is revealed to everyone! +" .. earned .. " 🎟️", "success")
			for _, survivor in Match.Survivors() do
				Remotes.notify(survivor, "🔔 " .. ghost.DisplayName .. "'s ghost rang a bell: the killer is revealed!", "info")
			end
			if Match.Killer then
				Remotes.notify(Match.Killer, "🔔 A ghost rang a bell. Everyone can see you!", "error")
			end
		end)
	end
end

function ObjectiveService.Reset()
	table.clear(pending)
	table.clear(nextCheck)
	workspace:SetAttribute("PumpkinsLit", 0)
	workspace:SetAttribute("PumpkinsNeeded", Config.Pumpkins.Needed)
	workspace:SetAttribute("GatesPowered", false)
	workspace:SetAttribute("CollapseEndsAt", nil)
	for _, pumpkin in Match.Map.Pumpkins do
		pumpkin.Progress = 0
		pumpkin.Lit = false
		pumpkin.Prompt.Enabled = true
		setPumpkinVisual(pumpkin)
	end
	for _, gate in Match.Map.Gates do
		gate.Open = false
		gate.Prompt.Enabled = false
		gate.Lamp.Color = Color3.fromRGB(255, 40, 40)
		gate.Light.Color = Color3.fromRGB(255, 40, 40)
		for _, door in gate.Doors do
			door.Part.CFrame = door.Closed
			door.Part.CanCollide = true
		end
	end
	for _, bell in Match.Map.Bells do
		bell.ReadyAt = 0
	end
end

function ObjectiveService.Init()
	setupPumpkins()
	setupGates()
	setupBells()
	ObjectiveService.Reset()
	Remotes.SkillCheck.OnServerEvent:Connect(function(player, id, result)
		local check = pending[player]
		if check and check.Id == id and (result == "great" or result == "good" or result == "miss") then
			resolveSkillCheck(player, result)
		end
	end)
	task.spawn(function()
		local last = os.clock()
		while true do
			task.wait(0.1)
			local current = os.clock()
			local ok, err = pcall(tick, current - last)
			last = current
			if not ok then
				warn("[ObjectiveService] tick error:", err)
			end
		end
	end)
end

return ObjectiveService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">Props</string>
          <string name="Source"><![CDATA[-- A library of carnival props, all built from parts so the game needs no uploaded assets.
-- Every builder takes a CFrame (position + facing) and a parent, and returns what it built.
local CollectionService = game:GetService("CollectionService")

local Props = {}

local rgb = Color3.fromRGB
Props.Colors = {
	red = rgb(190, 35, 45),
	cream = rgb(235, 225, 200),
	purple = rgb(95, 50, 130),
	teal = rgb(40, 140, 140),
	gold = rgb(230, 175, 60),
	wood = rgb(95, 65, 40),
	darkWood = rgb(55, 38, 28),
	iron = rgb(45, 45, 52),
	pumpkin = rgb(240, 120, 25),
}
local C = Props.Colors

local rng = Random.new(1031)

function Props.Part(props, parent)
	local part = Instance.new("Part")
	part.Anchored = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Material = Enum.Material.SmoothPlastic
	for key, value in props do
		part[key] = value
	end
	part.Parent = parent
	return part
end
local P = Props.Part

function Props.Model(name: string, parent)
	local model = Instance.new("Model")
	model.Name = name
	model.Parent = parent
	return model
end

function Props.Light(parent: BasePart, color: Color3, range: number, brightness: number?)
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = range
	light.Brightness = brightness or 1.5
	light.Shadows = false
	light.Parent = parent
	return light
end

function Props.Sign(part: BasePart, face: Enum.NormalId, text: string, color: Color3, font: Enum.Font?)
	local gui = Instance.new("SurfaceGui")
	gui.Face = face
	gui.LightInfluence = 0
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 30
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = font or Enum.Font.Creepster
	label.TextScaled = true
	label.TextColor3 = color
	label.Text = text
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 3
	stroke.Parent = label
	label.Parent = gui
	gui.Parent = part
	return label
end

function Props.Billboard(part: BasePart, text: string, color: Color3, height: number, maxDistance: number?)
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(180, 40)
	gui.StudsOffsetWorldSpace = Vector3.new(0, height, 0)
	gui.MaxDistance = maxDistance or 50
	gui.LightInfluence = 0
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.Oswald
	label.TextScaled = true
	label.TextColor3 = color
	label.Text = text
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2
	stroke.Parent = label
	label.Parent = gui
	gui.Parent = part
	return label
end

-- Makes a model spin on the client (cheap and smooth). Axis is in the model's own space.
function Props.MakeSpin(model: Model, axis: string, speed: number)
	model:SetAttribute("SpinAxis", axis)
	model:SetAttribute("SpinSpeed", speed)
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			d.CanCollide = false
			d.CanQuery = false
		end
	end
	CollectionService:AddTag(model, "Spin")
end

-- Small props ------------------------------------------------------------

function Props.Crate(cf: CFrame, parent, size: number?)
	size = size or 4
	local crate = P({
		Name = "Crate",
		Size = Vector3.one * size,
		CFrame = cf * CFrame.new(0, size / 2, 0),
		Color = C.wood,
		Material = Enum.Material.WoodPlanks,
	}, parent)
	return crate
end

function Props.CrateStack(cf: CFrame, parent)
	local model = Props.Model("Crates", parent)
	Props.Crate(cf * CFrame.new(-2.1, 0, 0), model)
	Props.Crate(cf * CFrame.new(2.1, 0, 0) * CFrame.Angles(0, 0.2, 0), model)
	Props.Crate(cf * CFrame.new(0, 4, 0) * CFrame.Angles(0, -0.3, 0), model)
	return model
end

function Props.Barrel(cf: CFrame, parent)
	local barrel = P({
		Name = "Barrel",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(4.4, 3.2, 3.2),
		CFrame = cf * CFrame.new(0, 2.2, 0) * CFrame.Angles(0, 0, math.rad(90)),
		Color = C.darkWood,
		Material = Enum.Material.Wood,
	}, parent)
	for _, y in { -1.3, 1.3 } do
		P({
			Name = "Hoop",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.3, 3.35, 3.35),
			CFrame = cf * CFrame.new(0, 2.2 + y, 0) * CFrame.Angles(0, 0, math.rad(90)),
			Color = C.iron,
			Material = Enum.Material.Metal,
			CanCollide = false,
		}, parent)
	end
	return barrel
end

function Props.HayBale(cf: CFrame, parent)
	return P({
		Name = "HayBale",
		Size = Vector3.new(5, 2.6, 3),
		CFrame = cf * CFrame.new(0, 1.3, 0),
		Color = rgb(205, 170, 80),
		Material = Enum.Material.Fabric,
	}, parent)
end

function Props.PumpkinPile(cf: CFrame, parent)
	local model = Props.Model("PumpkinPile", parent)
	for i = 1, 5 do
		local s = rng:NextNumber(1.4, 2.6)
		local p = P({
			Name = "Pumpkin",
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * s,
			CFrame = cf * CFrame.new(rng:NextNumber(-2.5, 2.5), s / 2, rng:NextNumber(-2.5, 2.5)),
			Color = C.pumpkin,
			CanCollide = false,
		}, model)
		if i == 1 then
			P({
				Name = "Face",
				Size = Vector3.new(s * 0.5, s * 0.25, 0.1),
				CFrame = p.CFrame * CFrame.new(0, 0, -s * 0.48),
				Color = rgb(255, 210, 80),
				Material = Enum.Material.Neon,
				CanCollide = false,
			}, model)
			Props.Light(p, rgb(255, 150, 40), 10, 1)
		end
	end
	return model
end

function Props.Scarecrow(cf: CFrame, parent)
	local model = Props.Model("Scarecrow", parent)
	P({
		Name = "Pole",
		Size = Vector3.new(0.5, 9, 0.5),
		CFrame = cf * CFrame.new(0, 4.5, 0),
		Color = C.darkWood,
		Material = Enum.Material.Wood,
	}, model)
	P({
		Name = "Arms",
		Size = Vector3.new(6, 0.4, 0.4),
		CFrame = cf * CFrame.new(0, 6.6, 0),
		Color = C.darkWood,
		Material = Enum.Material.Wood,
		CanCollide = false,
	}, model)
	P({
		Name = "Shirt",
		Size = Vector3.new(2.4, 3, 1.2),
		CFrame = cf * CFrame.new(0, 5.6, 0),
		Color = rgb(120, 70, 50),
		Material = Enum.Material.Fabric,
		CanCollide = false,
	}, model)
	local head = P({
		Name = "Head",
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * 2,
		CFrame = cf * CFrame.new(0, 8.1, 0),
		Color = rgb(200, 180, 140),
		Material = Enum.Material.Fabric,
		CanCollide = false,
	}, model)
	for _, x in { -0.35, 0.35 } do
		P({
			Name = "Eye",
			Size = Vector3.new(0.3, 0.3, 0.1),
			CFrame = head.CFrame * CFrame.new(x, 0.15, -0.95),
			Color = rgb(255, 40, 40),
			Material = Enum.Material.Neon,
			CanCollide = false,
		}, model)
	end
	P({
		Name = "Hat",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.3, 3.2, 3.2),
		CFrame = cf * CFrame.new(0, 9, 0) * CFrame.Angles(0, 0, math.rad(90)),
		Color = rgb(50, 40, 30),
		CanCollide = false,
	}, model)
	return model
end

