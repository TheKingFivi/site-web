      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">Format</string>
          <string name="Source"><![CDATA[local Format = {}

local SUFFIXES = { "", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc" }

function Format.Abbrev(n: number): string
	n = tonumber(n) or 0
	local negative = n < 0
	n = math.abs(n)
	if n < 1000 then
		local s = tostring(math.floor(n))
		return if negative then "-" .. s else s
	end
	local i = 1
	while n >= 1000 and i < #SUFFIXES do
		n /= 1000
		i += 1
	end
	local s
	if n >= 100 then
		s = string.format("%d", math.floor(n))
	elseif n >= 10 then
		s = string.format("%.1f", math.floor(n * 10) / 10)
	else
		s = string.format("%.2f", math.floor(n * 100) / 100)
	end
	if string.find(s, ".", 1, true) then
		s = (string.gsub(s, "0+$", ""))
		s = (string.gsub(s, "%.$", ""))
	end
	s ..= SUFFIXES[i]
	return if negative then "-" .. s else s
end

function Format.Cash(n: number): string
	return "$" .. Format.Abbrev(n)
end

function Format.Time(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	local h = seconds // 3600
	local m = (seconds % 3600) // 60
	local s = seconds % 60
	if h > 0 then
		return string.format("%d:%02d:%02d", h, m, s)
	end
	return string.format("%d:%02d", m, s)
end

return Format
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">Passengers</string>
          <string name="Source"><![CDATA[-- Generates tonight's rules and every passenger: their documents, luggage, skeleton, temperature,
-- fingerprints, eyes, interview answers, appearance, and (for anomalies) the hidden tells.
-- Shared by the server (which decides what's correct) and the client (which draws the inspection tools).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local Passengers = {}

Passengers.Today = { Month = 12, Year = 2026 }

local FIRST = {
	"Anya",
	"Boris",
	"Clara",
	"Dmitri",
	"Elsa",
	"Felix",
	"Greta",
	"Hugo",
	"Ida",
	"Jonas",
	"Katya",
	"Lev",
	"Mila",
	"Niko",
	"Olga",
	"Pavel",
	"Rosa",
	"Stefan",
	"Tilda",
	"Viktor",
	"Wren",
	"Yuri",
	"Zora",
	"Emil",
}
local LAST = {
	"Varga",
	"Holm",
	"Petrov",
	"Lind",
	"Novak",
	"Berg",
	"Kask",
	"Morrow",
	"Strand",
	"Volk",
	"Eklund",
	"Frost",
	"Hale",
	"Ivers",
	"Janek",
	"Korsa",
	"Lunde",
	"Marek",
	"Orlov",
	"Rask",
	"Sorel",
	"Tamm",
}

-- Luggage. Each item has an X-ray icon and a category used by tonight's rules.
Passengers.Items = {
	Clothes = { Icon = "👕", Name = "Folded clothes", Category = "Normal" },
	Book = { Icon = "📕", Name = "Book", Category = "Normal" },
	Shoes = { Icon = "👞", Name = "Shoes", Category = "Normal" },
	Camera = { Icon = "📷", Name = "Camera", Category = "Normal" },
	Laptop = { Icon = "💻", Name = "Laptop", Category = "Normal" },
	Toothbrush = { Icon = "🪥", Name = "Toothbrush", Category = "Normal" },
	Headphones = { Icon = "🎧", Name = "Headphones", Category = "Normal" },
	Teddy = { Icon = "🧸", Name = "Teddy bear", Category = "Normal" },
	Umbrella = { Icon = "☂️", Name = "Umbrella", Category = "Normal" },
	Gnome = { Icon = "🍄", Name = "Garden gnome", Category = "Normal" }, -- odd, but allowed
	Bottle = { Icon = "🍾", Name = "Sealed bottle", Category = "Liquids" },
	Perfume = { Icon = "🧴", Name = "Large perfume", Category = "Liquids" },
	Scissors = { Icon = "✂️", Name = "Scissors", Category = "Sharp" },
	Razor = { Icon = "🪒", Name = "Straight razor", Category = "Sharp" },
	Cat = { Icon = "🐈", Name = "Cat", Category = "Animals" },
	Bird = { Icon = "🐦", Name = "Bird", Category = "Animals" },
	Fireworks = { Icon = "🎆", Name = "Fireworks", Category = "Explosives" },
	-- Things only anomalies carry
	Teeth = { Icon = "🦷", Name = "Jar of teeth", Category = "Anomalous" },
	Ice = { Icon = "🧊", Name = "Ice that doesn't melt", Category = "Anomalous" },
	Heart = { Icon = "🫀", Name = "A beating heart", Category = "Anomalous" },
	Eye = { Icon = "👁️", Name = "Something watching", Category = "Anomalous" },
}
local NORMAL_ITEMS = { "Clothes", "Book", "Shoes", "Camera", "Laptop", "Toothbrush", "Headphones", "Teddy", "Umbrella", "Gnome" }
local CATEGORY_ITEMS = {
	Liquids = { "Bottle", "Perfume" },
	Sharp = { "Scissors", "Razor" },
	Animals = { "Cat", "Bird" },
	Explosives = { "Fireworks" },
}
local FORBIDDEN_ROTATION = { "Explosives", "Sharp", "Liquids", "Animals" }

-- Anomaly types: which tools can reveal them (at least one must be unlocked for it to appear).
Passengers.Anomalies = {
	Mimic = { Name = "Mimic", Tells = { "Passport", "Camera", "Interview", "Brain" } }, -- wrong photo, true face on camera
	Echo = { Name = "Echo", Tells = { "Ticket", "Camera", "Interview", "Brain" } }, -- name slightly wrong, repeats your words
	Stretcher = { Name = "Stretcher", Tells = { "XRay", "Skeleton", "Camera", "Brain" } }, -- too tall, long arms, teeth in bag
	Hollow = { Name = "Hollow", Tells = { "Skeleton", "Thermal", "Camera", "Fingerprint", "Brain" } }, -- no bones, no prints
	Frost = { Name = "Frost", Tells = { "Thermal", "XRay", "Camera", "Eyes", "Brain" } }, -- freezing cold, glowing eyes
}

local SKIN = {
	Color3.fromRGB(255, 220, 190),
	Color3.fromRGB(234, 192, 150),
	Color3.fromRGB(198, 145, 105),
	Color3.fromRGB(150, 100, 70),
	Color3.fromRGB(105, 70, 50),
	Color3.fromRGB(245, 205, 170),
}
local CLOTHES = {
	Color3.fromRGB(176, 40, 44),
	Color3.fromRGB(40, 90, 60),
	Color3.fromRGB(46, 70, 150),
	Color3.fromRGB(230, 200, 70),
	Color3.fromRGB(235, 235, 235),
	Color3.fromRGB(60, 60, 66),
	Color3.fromRGB(120, 80, 150),
	Color3.fromRGB(196, 120, 60),
}
local PANTS = { Color3.fromRGB(34, 40, 60), Color3.fromRGB(70, 60, 50), Color3.fromRGB(40, 40, 44), Color3.fromRGB(90, 96, 110) }
local HAIR_COLORS = {
	Color3.fromRGB(30, 22, 18),
	Color3.fromRGB(90, 56, 30),
	Color3.fromRGB(200, 160, 90),
	Color3.fromRGB(150, 60, 30),
	Color3.fromRGB(180, 180, 180),
}
local HAIR_STYLES = { "Short", "Long", "Bun", "Pigtails", "Spiky", "Bald", "Cap" }
local FINGERPRINTS = { "Whorl", "Loop", "Arch", "Double Loop", "Tented Arch", "Spiral" }

local function pick(rng: Random, list)
	return list[rng:NextInteger(1, #list)]
end

local function toolUnlocked(shift: number, key: string): boolean
	for _, tool in Config.Tools do
		if tool.Key == key then
			return shift >= tool.Shift
		end
	end
	return false
end
Passengers.ToolUnlocked = toolUnlocked

local function misspell(name: string, rng: Random): string
	local i = rng:NextInteger(2, #name)
	local swaps = { a = "e", e = "a", i = "y", o = "u", u = "o", n = "m", r = "l", l = "r", s = "z", k = "c" }
	local ch = string.sub(name, i, i)
	local new = swaps[string.lower(ch)] or "x"
	return string.sub(name, 1, i - 1) .. new .. string.sub(name, i + 1)
end

-- Tonight's rules. Each rule has text (shown in the rulebook) and data the checks use.
function Passengers.Rules(shift: number)
	local rng = Random.new(shift * 7919)
	local rules = {
		Destination = Config.Destinations[(shift - 1) % #Config.Destinations + 1],
		Night = shift,
		Forbidden = {},
		BannedCountry = nil,
		FeverDeny = shift >= 5,
		Lines = {},
	}
	table.insert(
		rules.Lines,
		"Passports must not be expired (today is " .. string.format("%02d/%d", Passengers.Today.Month, Passengers.Today.Year) .. ")."
	)
	table.insert(rules.Lines, "The photo must match the passenger, and the ticket name must match the passport exactly.")
	table.insert(rules.Lines, "Tonight's train goes to " .. rules.Destination .. ". Tickets must say NIGHT " .. shift .. ".")
	if shift >= 2 then
		local count = math.min(1 + math.floor((shift - 2) / 2), #FORBIDDEN_ROTATION)
		for i = 1, count do
			table.insert(rules.Forbidden, FORBIDDEN_ROTATION[(shift + i - 2) % #FORBIDDEN_ROTATION + 1])
		end
		table.insert(rules.Lines, "Forbidden in luggage tonight: " .. table.concat(rules.Forbidden, ", ") .. ".")
	end
	if shift >= 3 then
		table.insert(rules.Lines, "A human body has 1 skull, 2 arms, 2 legs and a full rib cage.")
	end
	if shift >= 4 then
		table.insert(rules.Lines, "Cameras see what your eyes miss. Compare them with the person in front of you.")
	end
	if rules.FeverDeny then
		table.insert(rules.Lines, "Humans are 36-37.5 °C. Deny fevers (38 °C or more). Much colder is NOT human.")
	end
	if shift >= 6 then
		table.insert(rules.Lines, "Interview: answers must match their documents. Watch the lie detector.")
	end
	if shift >= 7 then
		table.insert(rules.Lines, "Fingerprints must match the pattern printed in the passport.")
		rules.BannedCountry = pick(rng, Config.Countries)
		table.insert(rules.Lines, "No citizens of " .. rules.BannedCountry .. " may travel tonight.")
	end
	if shift >= 6 then
		table.insert(rules.Lines, "Suspicious? Press the red INTERROGATION phone and question them in the back room.")
	end
	if shift >= 8 then
		table.insert(rules.Lines, "Eye exam: human eyes have round pupils that react to light.")
	end
	if shift >= 9 then
		table.insert(rules.Lines, "Brain scan: a human brain shows two active halves. Flat, mirrored or static = NOT human.")
	end
	table.insert(rules.Lines, "Some passengers are NOT human. Never let them board.")
	return rules
end

-- Creates one passenger. The record is plain data so it can be sent to every client.
function Passengers.Generate(shift: number, seed: number, rules)
	local rng = Random.new(seed)
	local first, last = pick(rng, FIRST), pick(rng, LAST)
	local p = {
		Seed = seed,
		First = first,
		Last = last,
		Country = pick(rng, Config.Countries),
		Birth = string.format("%02d/%02d/%d", rng:NextInteger(1, 28), rng:NextInteger(1, 12), rng:NextInteger(1950, 2006)),
		PassportNo = string.upper(string.sub(first, 1, 1) .. string.sub(last, 1, 1)) .. "-" .. rng:NextInteger(10000, 99999),
		ExpiryMonth = rng:NextInteger(1, 12),
		ExpiryYear = rng:NextInteger(2027, 2031),
		Ticket = { Name = first .. " " .. last, Destination = rules.Destination, Night = shift },
		Bag = {},
		Skeleton = { Skull = 1, Arms = 2, Legs = 2, Ribs = "Normal", LongArms = false },
		Temperature = math.floor(rng:NextNumber(36.2, 37.3) * 10) / 10,
		Eyes = "Normal",
		Brain = "Normal", -- Normal | Flat (no activity) | Mirror | Static
		Fingerprint = pick(rng, FINGERPRINTS),
		Look = {
			Skin = rng:NextInteger(1, #SKIN),
			Shirt = rng:NextInteger(1, #CLOTHES),
			Pants = rng:NextInteger(1, #PANTS),
			Hair = pick(rng, HAIR_STYLES),
			HairColor = rng:NextInteger(1, #HAIR_COLORS),
			Height = rng:NextNumber(0.92, 1.06),
		},
		Photo = nil, -- nil = matches; otherwise how the passport photo differs
		TrueForm = false, -- shows its real face on camera
		Anomaly = nil,
		Violation = nil, -- the rule a human breaks (deny them, but they're harmless)
		Interview = {},
	}
	p.PrintedFingerprint = p.Fingerprint
	-- Luggage: 3-5 normal things
	for _ = 1, rng:NextInteger(3, 5) do
		table.insert(p.Bag, pick(rng, NORMAL_ITEMS))
	end

	-- Is this one human?
	local anomalyChance = Config.Shift.AnomalyChance + Config.Shift.AnomalyChancePerShift * (shift - 1)
	if rng:NextNumber() < anomalyChance then
		local options = {}
		for key, info in Passengers.Anomalies do
			for _, tell in info.Tells do
				if toolUnlocked(shift, tell) then
					table.insert(options, key)
					break
				end
			end
		end
		table.sort(options)
		if #options > 0 then
			p.Anomaly = pick(rng, options)
		end
	end

	local a = p.Anomaly
	if a then
		p.TrueForm = true
		p.Brain = if a == "Hollow" then "Flat" elseif a == "Mimic" or a == "Echo" then "Mirror" else "Static"
		if a == "Mimic" then
			p.Photo = pick(rng, { "BlackEyes", "WrongHair", "WideSmile" })
		elseif a == "Echo" then
			if rng:NextNumber() < 0.5 then
				p.Ticket.Name = misspell(first, rng) .. " " .. last
			else
				p.Ticket.Name = first .. " " .. misspell(last, rng)
			end
		elseif a == "Stretcher" then
			p.Look.Height = 1.18
			p.Skeleton.LongArms = true
			table.insert(p.Bag, "Teeth")
		elseif a == "Hollow" then
			p.Skeleton = { Skull = 0, Arms = 0, Legs = 0, Ribs = "None", LongArms = false }
			p.Temperature = math.floor(rng:NextNumber(24, 29) * 10) / 10
			p.Fingerprint = "None"
		elseif a == "Frost" then
			p.Temperature = math.floor(rng:NextNumber(2, 11) * 10) / 10
			table.insert(p.Bag, "Ice")
			p.Eyes = "Glowing"
		end
		-- Extra creepiness that later tools can catch for any anomaly
		if rng:NextNumber() < 0.4 then
			p.Skeleton.Ribs = if p.Skeleton.Ribs == "None" then "None" else "Extra"
		end
		if a ~= "Frost" and rng:NextNumber() < 0.5 then
			p.Eyes = pick(rng, { "NoPupils", "Slit" })
		end
		if a ~= "Hollow" and rng:NextNumber() < 0.5 then
			p.Fingerprint = pick(rng, FINGERPRINTS)
			if p.Fingerprint == p.PrintedFingerprint then
				p.Fingerprint = "Smudged"
			end
		end
	elseif rng:NextNumber() < Config.Shift.RuleBreakerChance then
		-- A human with a problem: deny them, but they're no threat
		local problems = { "Expired", "WrongDestination", "WrongNight", "NameTypo" }
		if #rules.Forbidden > 0 then
			table.insert(problems, "Contraband")
		end
		if rules.FeverDeny then
			table.insert(problems, "Fever")
		end
		if rules.BannedCountry then
			table.insert(problems, "BannedCountry")
		end
		if shift >= 7 then
			table.insert(problems, "WrongPrint")
		end
		local problem = pick(rng, problems)
		p.Violation = problem
		if problem == "Expired" then
			p.ExpiryYear = Passengers.Today.Year - rng:NextInteger(0, 2)
			p.ExpiryMonth = if p.ExpiryYear == Passengers.Today.Year
				then rng:NextInteger(1, Passengers.Today.Month - 1)
				else rng:NextInteger(1, 12)
		elseif problem == "WrongDestination" then
			local others = {}
			for _, d in Config.Destinations do
				if d ~= rules.Destination then
					table.insert(others, d)
				end
			end
			p.Ticket.Destination = pick(rng, others)
		elseif problem == "WrongNight" then
			p.Ticket.Night = shift + pick(rng, { -1, 1, 2 })
		elseif problem == "NameTypo" then
			p.Ticket.Name = first .. " " .. misspell(last, rng)
		elseif problem == "Contraband" then
			local category = pick(rng, rules.Forbidden)
			table.insert(p.Bag, pick(rng, CATEGORY_ITEMS[category]))
		elseif problem == "Fever" then
			p.Temperature = math.floor(rng:NextNumber(38.1, 39.6) * 10) / 10
		elseif problem == "BannedCountry" then
			p.Country = rules.BannedCountry
		elseif problem == "WrongPrint" then
			repeat
				p.Fingerprint = pick(rng, FINGERPRINTS)
			until p.Fingerprint ~= p.PrintedFingerprint
		end
	end
	-- Humans sometimes carry allowed-but-odd things, so the X-ray isn't a giveaway
	if rng:NextNumber() < 0.3 then
		local allowed = {}
		for category, items in CATEGORY_ITEMS do
			if not table.find(rules.Forbidden, category) then
				for _, item in items do
					table.insert(allowed, item)
				end
			end
		end
		table.sort(allowed)
		if #allowed > 0 and not p.Violation then
			table.insert(p.Bag, pick(rng, allowed))
		end
	end

	-- Interview answers (Q: destination, birthday, purpose)
	local purposes =
		{ "Visiting my sister.", "Work. I fix trains.", "Going home.", "A funeral, sadly.", "Holiday, finally.", "Moving to the city." }
	p.Interview = {
		{ Q = "Where are you travelling to?", A = p.Ticket.Destination .. ".", Spike = false },
		{ Q = "What is your date of birth?", A = p.Birth .. ".", Spike = false },
		{ Q = "Why are you travelling tonight?", A = pick(rng, purposes), Spike = false },
	}
	if a == "Echo" then
		p.Interview[1].A = "Where are you travelling to?"
		p.Interview[3].A = "Why are you... travelling... tonight?"
		p.Interview[1].Spike, p.Interview[3].Spike = true, true
	elseif a then
		local creepy =
			{ "Somewhere warm. Somewhere with people.", "I don't remember being born.", "The train is hungry.", "To see you again." }
		local i = rng:NextInteger(1, 3)
		p.Interview[i].A = pick(rng, creepy)
		p.Interview[i].Spike = true
	end
	return p
end

-- What the right call is, and why. Returns (shouldApprove, reasonText).
function Passengers.Judge(p, _rules)
	if p.Anomaly then
		return false, "It wasn't human (" .. Passengers.Anomalies[p.Anomaly].Name .. ")."
	end
	local reasons = {
		Expired = "Their passport was expired.",
		WrongDestination = "Their ticket was for the wrong destination.",
		WrongNight = "Their ticket was for another night.",
		NameTypo = "The ticket name didn't match the passport.",
		Contraband = "They carried forbidden items.",
		Fever = "They had a fever.",
		BannedCountry = "Their country is banned tonight.",
		WrongPrint = "Their fingerprints didn't match the passport.",
	}
	if p.Violation then
		return false, reasons[p.Violation]
	end
	return true, "They were a normal, honest traveller."
end

Passengers.SkinColors = SKIN
Passengers.ShirtColors = CLOTHES
Passengers.PantsColors = PANTS
Passengers.HairColors = HAIR_COLORS
Passengers.Fingerprints = FINGERPRINTS

return Passengers
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">Remotes</string>
          <string name="Source"><![CDATA[-- Creates the remotes on the server and waits for them on the client.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local EVENTS = {
	"Notify", -- server -> client: toast
	"Announce", -- server -> all: big banner
	"Speech", -- server -> all: an NPC speech bubble (head, text)
	"Objective", -- server -> client: { Title, Text, Step, Steps } or nil
	"ShiftState", -- server -> client: shift HUD (shift, strikes, remaining, rules...) or nil when you leave
	"OpenTool", -- server -> client: open an inspection panel (key, data)
	"CloseTools", -- server -> client: close all panels
	"Verdict", -- server -> client: result of a decision
	"Results", -- server -> client: end-of-shift summary
	"Blackout", -- server -> client: lights-out state for your station
	"Scare", -- server -> client: jumpscare
	"Sfx", -- server -> client(s): sound effect (name, position?)
	"PartyPrompt", -- server -> client: open the Create Party panel for a pad
	"OpenMenu", -- server -> client: open Shop / Skins / Rewards
	"Taser", -- client -> server: fire the taser toward a position
}
local FUNCTIONS = { "CreateParty", "Ask", "ClaimDaily", "BuySkin", "EquipSkin", "UseHint", "UseRadar", "Decide" }

local Remotes = {}

if RunService:IsServer() then
	local folder = ReplicatedStorage:FindFirstChild("Remotes") or Instance.new("Folder")
	folder.Name = "Remotes"
	folder.Parent = ReplicatedStorage
	for _, name in EVENTS do
		local remote = folder:FindFirstChild(name) or Instance.new("RemoteEvent")
		remote.Name = name
		remote.Parent = folder
		Remotes[name] = remote
	end
	for _, name in FUNCTIONS do
		local remote = folder:FindFirstChild(name) or Instance.new("RemoteFunction")
		remote.Name = name
		remote.Parent = folder
		Remotes[name] = remote
	end
else
	local folder = ReplicatedStorage:WaitForChild("Remotes")
	for _, name in EVENTS do
		Remotes[name] = folder:WaitForChild(name)
	end
	for _, name in FUNCTIONS do
		Remotes[name] = folder:WaitForChild(name)
	end
end

function Remotes.notify(player: Player, text: string, kind: string?)
	Remotes.Notify:FireClient(player, text, kind or "info")
end

function Remotes.announce(text: string, color: Color3?)
	Remotes.Announce:FireAllClients(text, if color then color:ToHex() else nil)
end

return Remotes
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="9">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="10">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">Build</string>
          <string name="Source"><![CDATA[-- Small helpers for building the world out of parts.
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Build = {}

export type Props = { [string]: any }

-- Build.part(parent, size, cframe, color, material, props?)
function Build.part(parent: Instance, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?, props: Props?): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if props then
		for key, value in props do
			(p :: any)[key] = value
		end
	end
	p.Parent = parent
	return p
end

function Build.wedge(parent: Instance, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?): WedgePart
	local p = Instance.new("WedgePart")
	p.Anchored = true
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.Parent = parent
	return p
end

function Build.cyl(parent: Instance, length: number, diameter: number, cf: CFrame, color: Color3, material: Enum.Material?): Part
	-- Cylinders run along their X axis.
	local p = Build.part(parent, Vector3.new(length, diameter, diameter), cf, color, material)
	p.Shape = Enum.PartType.Cylinder
	return p
end

function Build.ball(parent: Instance, diameter: number, cf: CFrame, color: Color3, material: Enum.Material?): Part
	local p = Build.part(parent, Vector3.new(diameter, diameter, diameter), cf, color, material)
	p.Shape = Enum.PartType.Ball
	return p
end

function Build.model(parent: Instance, name: string): Model
	local m = Instance.new("Model")
	m.Name = name
	m.Parent = parent
	return m
end

-- Text on a face of a part.
function Build.label(part: BasePart, face: Enum.NormalId, text: string, color: Color3?, font: Enum.Font?, background: Color3?): TextLabel
	local gui = Instance.new("SurfaceGui")
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.LightInfluence = 0.2
	gui.Parent = part
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = if background then 0 else 1
	label.BackgroundColor3 = background or Color3.new()
	label.Text = text
	label.TextScaled = true
	label.Font = font or Enum.Font.GothamBlack
	label.TextColor3 = color or Color3.new(1, 1, 1)
	label.Parent = gui
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0.04, 0)
	pad.PaddingRight = UDim.new(0.04, 0)
	pad.PaddingTop = UDim.new(0.08, 0)
	pad.PaddingBottom = UDim.new(0.08, 0)
	pad.Parent = label
	return label
end

function Build.pointLight(part: BasePart, color: Color3, range: number, brightness: number, shadows: boolean?): PointLight
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = range
	light.Brightness = brightness
	light.Shadows = shadows == true
	light.Parent = part
	return light
end

function Build.spotLight(part: BasePart, face: Enum.NormalId, color: Color3, range: number, brightness: number, angle: number): SpotLight
	local light = Instance.new("SpotLight")
	light.Face = face
	light.Color = color
	light.Range = range
	light.Brightness = brightness
	light.Angle = angle
	light.Shadows = true
	light.Parent = part
	return light
end

-- A ProximityPrompt. `only` limits it to one player (other clients hide it).
function Build.prompt(parent: Instance, action: string, object: string?, hold: number?, distance: number?): ProximityPrompt
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = action
	prompt.ObjectText = object or ""
	prompt.HoldDuration = hold or 0
	prompt.MaxActivationDistance = distance or 8
	prompt.RequiresLineOfSight = false
	prompt.Style = Enum.ProximityPromptStyle.Custom
	prompt.Parent = parent
	CollectionService:AddTag(prompt, "GamePrompt")
	return prompt
end

-- Fluorescent ceiling panel with a light that can be switched off in a blackout.
function Build.ceilingLight(parent: Instance, cf: CFrame, range: number?): Part
	local panel = Build.part(parent, Vector3.new(4, 0.3, 1.6), cf, Color3.fromRGB(235, 240, 255), Enum.Material.Neon)
	local light = Instance.new("SurfaceLight")
	light.Face = Enum.NormalId.Bottom
	light.Range = range or 22
	light.Brightness = 1.6
	light.Angle = 120
	light.Color = Color3.fromRGB(232, 240, 255)
	light.Shadows = true
	light.Parent = panel
	CollectionService:AddTag(panel, "PowerLight")
	return panel
end

-- Wall slab between two points on the floor (y = floor height).
function Build.wall(
	parent: Instance,
	a: Vector3,
	b: Vector3,
	height: number,
	thickness: number,
	color: Color3,
	material: Enum.Material?
): Part
	local mid = (a + b) / 2
	local length = (b - a).Magnitude
	local cf = CFrame.lookAt(mid, b) * CFrame.Angles(0, math.pi / 2, 0)
	return Build.part(parent, Vector3.new(length, height, thickness), cf + Vector3.new(0, height / 2, 0), color, material)
end

-- PRO MODELS: if ReplicatedStorage.ProModels has a model with this name (e.g. a free Creator Store
-- X-ray machine renamed "XRayMachine"), place a copy here instead of the part-built version.
-- `size` is the box it must fit in (studs); it's scaled to fit and stood on the floor at `cf`.
-- Returns the placed model, or nil so the caller builds its own version.
function Build.swap(parent: Instance, name: string, cf: CFrame, size: Vector3): Model?
	local folder = ReplicatedStorage:FindFirstChild("ProModels")
	local source = folder and folder:FindFirstChild(name)
	if not source then
		return nil
	end
	local model: Model
	if source:IsA("Model") then
		model = source:Clone()
	elseif source:IsA("BasePart") then
		model = Instance.new("Model")
		source:Clone().Parent = model
	else
		return nil
	end
	-- Optional fixes the owner can set on the source model
	local turn = source:GetAttribute("Turn") or 0 -- degrees, if the model faces the wrong way
	local extraScale = source:GetAttribute("Scale") or 1
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			d.Anchored = true
		elseif d:IsA("Script") or d:IsA("LocalScript") then
			d:Destroy() -- free models sometimes carry scripts; never run them
		end
	end
	model:PivotTo(CFrame.new() * CFrame.Angles(0, math.rad(turn), 0))
	local _, extents = model:GetBoundingBox()
	local fit = math.min(size.X / extents.X, size.Y / extents.Y, size.Z / extents.Z) * extraScale
	pcall(function()
		model:ScaleTo(model:GetScale() * fit)
	end)
	local boxCf, boxSize = model:GetBoundingBox()
	-- Stand it on the floor, centred on cf
	local offset = model:GetPivot():ToObjectSpace(boxCf)
	local target = cf * CFrame.new(0, boxSize.Y / 2, 0)
	model:PivotTo(target * offset:Inverse())
	model.Name = name
	model.Parent = parent
	return model
end

-- An invisible box that carries prompts/labels when a pro model replaces the visible version.
function Build.ghost(parent: Instance, size: Vector3, cf: CFrame): Part
	local p = Build.part(parent, size, cf, Color3.new(), Enum.Material.SmoothPlastic)
	p.Transparency = 1
	p.CanCollide = false
	return p
end

return Build
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">DataService</string>
          <string name="Source"><![CDATA[-- Loads/saves player data with retries, session locking and autosave.
local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)

local DataService = {}

local SESSION_TIMEOUT = 300 -- a lock older than this is considered stale
local profiles = {} -- [Player] = { Data = table, CanSave = boolean }

local store
pcall(function()
	store = DataStoreService:GetDataStore(Config.DataStoreName)
end)

local function defaultData()
	return {
		Cash = 0,
		NextShift = 1, -- the night you're on
		BestShift = 0,
		PerfectShifts = 0,
		Correct = 0,
		Candy = 0,
		Skin = "Standard",
		OwnedSkins = { Standard = true },
		DailyStreak = 0,
		DailyLast = 0, -- day number (os.time() // 86400) of the last claim
		ReceiptIds = {},
	}
end

local function reconcile(data)
	for key, value in defaultData() do
		if data[key] == nil then
			data[key] = value
		end
	end
	data.OwnedSkins.Standard = true
	return data
end

local function keyFor(player: Player)
	return "Player_" .. player.UserId
end

local function setupLeaderstats(player: Player)
	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	for _, name in { "Shift", "Cash", "Perfect" } do
		local value = Instance.new("IntValue")
		value.Name = name
		value.Parent = stats
	end
	stats.Parent = player
end

function DataService.Load(player: Player)
	local data, canSave = nil, false
	if store then
		for attempt = 1, 8 do
			local lockedElsewhere = false
			local ok, err = pcall(function()
				data = store:UpdateAsync(keyFor(player), function(old)
					old = old or defaultData()
					local session = old.Session
					if session and session.Job ~= game.JobId and os.time() - session.Time < SESSION_TIMEOUT and attempt < 8 then
						lockedElsewhere = true
						return nil -- cancel the write, another server still owns this data
					end
					old.Session = { Job = game.JobId, Time = os.time() }
					return old
				end)
			end)
			if ok and not lockedElsewhere and data then
				canSave = true
				break
			end
			if not ok then
				warn("[DataService] Load failed for", player.Name, err)
			end
			if not player.Parent then
				return nil
			end
			task.wait(if lockedElsewhere then 5 else attempt)
		end
	end

	if not canSave then
		warn("[DataService] Could not load data for " .. player.Name .. "; progress will NOT be saved this session.")
		data = nil
	end
	data = reconcile(if type(data) == "table" then data else defaultData())

	if not player.Parent then
		if canSave then
			pcall(function()
				store:UpdateAsync(keyFor(player), function(old)
					if old then
						old.Session = nil
					end
					return old
				end)
			end)
		end
		return nil
	end

	profiles[player] = { Data = data, CanSave = canSave }
	setupLeaderstats(player)
	DataService.Sync(player)
	return data
end

function DataService.Get(player: Player)
	local profile = profiles[player]
	return if profile then profile.Data else nil
end

function DataService.Save(player: Player, release: boolean?): boolean
	local profile = profiles[player]
	if not profile then
		return false
	end
	if not profile.CanSave then
		-- In Studio without API access we can't save; treat as success so purchases still work.
		return RunService:IsStudio()
	end
	local data = profile.Data
	data.Session = if release then nil else { Job = game.JobId, Time = os.time() }
	for attempt = 1, 3 do
		local ok, err = pcall(function()
			store:UpdateAsync(keyFor(player), function()
				return data
			end)
		end)
		if ok then
			return true
		end
		warn("[DataService] Save failed for", player.Name, err)
		task.wait(attempt)
	end
	return false
end

function DataService.Release(player: Player)
	if profiles[player] then
		DataService.Save(player, true)
		profiles[player] = nil
	end
end

function DataService.Sync(player: Player)
	local data = DataService.Get(player)
	if not data then
		return
	end
	player:SetAttribute("Cash", data.Cash)
	player:SetAttribute("NextShift", data.NextShift)
	player:SetAttribute("Candy", data.Candy)
	player:SetAttribute("Skin", data.Skin)
	player:SetAttribute("DailyStreak", data.DailyStreak)
	player:SetAttribute("DailyReady", data.DailyLast < os.time() // 86400)
	for _, skin in Config.Skins do
		player:SetAttribute("OwnedSkin_" .. skin.Key, data.OwnedSkins[skin.Key] == true)
	end
	local rank = Config.Ranks[1].Name
	for _, r in Config.Ranks do
		if data.NextShift >= r.Shift then
			rank = r.Name
		end
	end
	player:SetAttribute("Rank", rank)
	local stats = player:FindFirstChild("leaderstats")
	if stats then
		stats.Shift.Value = data.NextShift
		stats.Cash.Value = data.Cash
		stats.Perfect.Value = data.PerfectShifts
	end
end

function DataService.PayMultiplier(player: Player): number
	local mult = 1
	if player:GetAttribute("Pass_DoublePay") then
		mult *= Config.Multipliers.DoublePay
	end
	if player:GetAttribute("Pass_VIP") then
		mult *= Config.Multipliers.VIP
	end
	return mult
end

-- Gives cash. `boosted` applies pass multipliers (gameplay pay, not purchases).
function DataService.AddCash(player: Player, amount: number, boosted: boolean?): number
	local data = DataService.Get(player)
	if not data then
		return 0
	end
	if boosted then
		amount *= DataService.PayMultiplier(player)
	end
	amount = math.floor(amount)
	data.Cash += amount
	DataService.Sync(player)
	return amount
end

function DataService.AddCandy(player: Player, amount: number, boosted: boolean?): number
	local data = DataService.Get(player)
	if not data then
		return 0
	end
	if boosted and player:GetAttribute("Pass_VIP") then
		amount *= Config.Multipliers.VIP
	end
	amount = math.floor(amount)
	data.Candy += amount
	DataService.Sync(player)
	return amount
end

function DataService.Spend(player: Player, currency: string, amount: number): boolean
	local data = DataService.Get(player)
	if not data or (data[currency] or 0) < amount then
		return false
	end
	data[currency] -= amount
	DataService.Sync(player)
	return true
end

function DataService.SpendCash(player: Player, amount: number): boolean
	local data = DataService.Get(player)
	if not data or data.Cash < amount then
		return false
	end
	data.Cash -= amount
	DataService.Sync(player)
	return true
end

function DataService.Init()
	task.spawn(function()
		while true do
			task.wait(Config.AutoSaveInterval)
			for player in profiles do
				task.spawn(DataService.Save, player)
			end
		end
	end)

	game:BindToClose(function()
		local pending = 0
		for player in profiles do
			pending += 1
			task.spawn(function()
				DataService.Save(player, true)
				pending -= 1
			end)
		end
		local started = os.clock()
		while pending > 0 and os.clock() - started < 25 do
			task.wait(0.1)
		end
	end)
end

return DataService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">LobbyBuilder</string>
          <string name="Source"><![CDATA[-- The snowy lobby outside Frostline Central: party pads, skin pedestals, shop, daily rewards.
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Build = require(script.Parent.Build)
local SkinLook = require(script.Parent.SkinLook)

local LobbyBuilder = {}

local SNOW = Color3.fromRGB(236, 242, 250)
local ROAD = Color3.fromRGB(44, 46, 54)
local WALL = Color3.fromRGB(206, 200, 186)
local NAVY = Color3.fromRGB(30, 46, 100)
local ORANGE = Color3.fromRGB(255, 130, 20)
local PAD_COLORS =
	{ Color3.fromRGB(255, 220, 40), Color3.fromRGB(40, 230, 255), Color3.fromRGB(255, 220, 40), Color3.fromRGB(40, 230, 255) }

local function billboard(parent: BasePart, size: UDim2, offset: Vector3, distance: number?): BillboardGui
	local gui = Instance.new("BillboardGui")
	gui.Size = size
	gui.StudsOffsetWorldSpace = offset
	gui.MaxDistance = distance or 160
	gui.LightInfluence = 0
	gui.AlwaysOnTop = false
	gui.Parent = parent
	return gui
end

local function lamp(parent: Instance, cf: CFrame)
	local pro = Build.swap(parent, "StreetLamp", cf, Vector3.new(6, 17, 6))
	if pro then
		local glow = Build.ghost(parent, Vector3.new(1, 1, 1), cf * CFrame.new(0, 15, -2))
		Build.spotLight(glow, Enum.NormalId.Bottom, Color3.fromRGB(255, 226, 190), 40, 2.6, 110)
		return
	end
	Build.part(parent, Vector3.new(0.7, 16, 0.7), cf * CFrame.new(0, 8, 0), Color3.fromRGB(30, 32, 38), Enum.Material.Metal)
	Build.part(parent, Vector3.new(0.4, 0.4, 5), cf * CFrame.new(0, 16, -2.4), Color3.fromRGB(30, 32, 38), Enum.Material.Metal)
	local head =
		Build.part(parent, Vector3.new(1.6, 0.5, 2.6), cf * CFrame.new(0, 15.7, -4.6), Color3.fromRGB(255, 236, 200), Enum.Material.Neon)
	Build.spotLight(head, Enum.NormalId.Bottom, Color3.fromRGB(255, 226, 190), 40, 2.6, 110)
end

local function pine(parent: Instance, cf: CFrame, h: number, rng: Random)
	if Build.swap(parent, "PineTree", cf * CFrame.Angles(0, rng:NextNumber(0, 6), 0), Vector3.new(h * 0.6, h, h * 0.6)) then
		return
	end
	Build.part(parent, Vector3.new(1.4, h * 0.3, 1.4), cf * CFrame.new(0, h * 0.15, 0), Color3.fromRGB(70, 50, 36), Enum.Material.Wood)
	for tier = 0, 2 do
		local size = h * (0.55 - tier * 0.15)
		local cone = Build.ball(
			parent,
			size,
			cf * CFrame.new(0, h * (0.3 + tier * 0.22), 0) * CFrame.Angles(0, rng:NextNumber(0, 3), 0),
			Color3.fromRGB(30, 62, 44),
			Enum.Material.Grass
		)
		cone.Size = Vector3.new(size, h * 0.3, size)
		local cap = Build.part(
			parent,
			Vector3.new(h * 0.08, size * 0.75, size * 0.75),
			cf * CFrame.new(0, h * (0.3 + tier * 0.22) + h * 0.11, 0) * CFrame.Angles(0, 0, math.pi / 2),
			SNOW,
			Enum.Material.Snow
		)
		cap.Shape = Enum.PartType.Cylinder
	end
end

local function jackOLantern(parent: Instance, cf: CFrame, size: number)
	if Build.swap(parent, "Pumpkin", cf, Vector3.new(size * 1.3, size * 1.3, size * 1.3)) then
		return
	end
	local body = Build.ball(parent, size, cf * CFrame.new(0, size * 0.4, 0), ORANGE)
	body.Size = Vector3.new(size * 1.2, size * 0.85, size * 1.2)
	Build.part(parent, Vector3.new(0.2, 0.5, 0.2) * size, cf * CFrame.new(0, size * 0.9, 0), Color3.fromRGB(60, 90, 30))
	for _, x in { -0.22, 0.22 } do
		local eye = Build.wedge(
			parent,
			Vector3.new(0.05, 0.2, 0.22) * size,
			cf * CFrame.new(x * size, size * 0.5, -size * 0.58) * CFrame.Angles(0, math.pi / 2, 0),
			Color3.fromRGB(255, 220, 90),
			Enum.Material.Neon
		)
		eye.CanCollide = false
	end
	local mouth = Build.part(
		parent,
		Vector3.new(0.6, 0.14, 0.05) * size,
		cf * CFrame.new(0, size * 0.3, -size * 0.6),
		Color3.fromRGB(255, 220, 90),
		Enum.Material.Neon
	)
	mouth.CanCollide = false
	Build.pointLight(mouth, Color3.fromRGB(255, 150, 40), 10 + size * 2, 1.6)
end

local function candle(parent: Instance, cf: CFrame, h: number)
	Build.cyl(parent, h, 0.6, cf * CFrame.new(0, h / 2, 0) * CFrame.Angles(0, 0, math.pi / 2), Color3.fromRGB(245, 240, 220))
	local flame = Build.ball(parent, 0.35, cf * CFrame.new(0, h + 0.25, 0), Color3.fromRGB(255, 200, 80), Enum.Material.Neon)
	flame.CanCollide = false
	flame.Size = Vector3.new(0.25, 0.45, 0.25)
	Build.pointLight(flame, Color3.fromRGB(255, 170, 70), 7, 0.9)
end

local function facade(parent: Instance)
	local f = Build.model(parent, "Facade")
	local z = -78
	Build.part(f, Vector3.new(170, 34, 16), CFrame.new(0, 17, z), WALL, Enum.Material.Plaster)
	Build.part(f, Vector3.new(172, 2, 18), CFrame.new(0, 35, z), Color3.fromRGB(60, 64, 74), Enum.Material.Slate)
	Build.part(f, Vector3.new(170.4, 2, 0.4), CFrame.new(0, 8, z + 8.1), NAVY)
	-- Clock tower
	Build.part(f, Vector3.new(22, 56, 18), CFrame.new(0, 28, z - 2), WALL, Enum.Material.Plaster)
	Build.wedge(f, Vector3.new(24, 10, 10), CFrame.new(0, 61, z + 3), Color3.fromRGB(60, 64, 74), Enum.Material.Slate)
	Build.wedge(
		f,
		Vector3.new(24, 10, 10),
		CFrame.new(0, 61, z - 7) * CFrame.Angles(0, math.pi, 0),
		Color3.fromRGB(60, 64, 74),
		Enum.Material.Slate
	)
	local clock = Build.cyl(
		f,
		1,
		13,
		CFrame.new(0, 44, z + 7.3) * CFrame.Angles(0, math.pi / 2, 0),
		Color3.fromRGB(250, 246, 230),
		Enum.Material.SmoothPlastic
	)
	Build.label(clock, Enum.NormalId.Left, "XII", Color3.fromRGB(20, 20, 20), Enum.Font.Antique)
	Build.pointLight(clock, Color3.fromRGB(255, 240, 200), 30, 1.5)
	Build.part(f, Vector3.new(0.4, 5, 0.3), CFrame.new(0, 45.8, z + 8), Color3.fromRGB(20, 20, 20))
	Build.part(f, Vector3.new(3.8, 0.4, 0.3), CFrame.new(1.6, 44, z + 8), Color3.fromRGB(20, 20, 20))
	-- Name sign
	local sign = Build.part(f, Vector3.new(60, 6, 1), CFrame.new(0, 28, z + 8.6), Color3.fromRGB(150, 24, 30))
	Build.label(sign, Enum.NormalId.Back, "FROSTLINE CENTRAL", Color3.fromRGB(255, 244, 230), Enum.Font.GothamBlack)
	Build.label(sign, Enum.NormalId.Front, "FROSTLINE CENTRAL", Color3.fromRGB(255, 244, 230), Enum.Font.GothamBlack)
	Build.pointLight(sign, Color3.fromRGB(255, 120, 100), 24, 1)
	-- Tall arched windows
	for _, x in { -70, -55, -40, 40, 55, 70 } do
		local w = Build.part(f, Vector3.new(8, 16, 0.6), CFrame.new(x, 18, z + 8.1), Color3.fromRGB(255, 214, 140), Enum.Material.Neon)
		w.Transparency = 0.15
		local top = Build.cyl(
			f,
			0.6,
			8,
			CFrame.new(x, 26, z + 8.1) * CFrame.Angles(0, math.pi / 2, 0),
			Color3.fromRGB(255, 214, 140),
			Enum.Material.Neon
		)
		top.Transparency = 0.15
		for k = -1, 1 do
			Build.part(f, Vector3.new(0.3, 16, 0.7), CFrame.new(x + k * 2.6, 18, z + 8.2), Color3.fromRGB(40, 40, 44))
		end
		Build.part(f, Vector3.new(8, 0.3, 0.7), CFrame.new(x, 18, z + 8.2), Color3.fromRGB(40, 40, 44))
	end
	-- Main doors, one per party pad
	for i, x in { -48, -16, 16, 48 } do
		Build.part(f, Vector3.new(12, 14, 0.8), CFrame.new(x, 7, z + 8.2), Color3.fromRGB(34, 38, 48), Enum.Material.Metal)
		for _, dx in { -3, 3 } do
			local glass =
				Build.part(f, Vector3.new(4.6, 11, 0.9), CFrame.new(x + dx, 6, z + 8.3), Color3.fromRGB(120, 160, 200), Enum.Material.Glass)
			glass.Transparency = 0.4
		end
		local num = Build.part(f, Vector3.new(6, 2.4, 0.5), CFrame.new(x, 15.6, z + 8.5), Color3.fromRGB(20, 20, 24))
		Build.label(num, Enum.NormalId.Back, "GATE " .. i, PAD_COLORS[i], Enum.Font.GothamBlack)
	end
	-- Halloween bunting along the roof
	for i = 0, 40 do
		local x = -84 + i * 4.2
		local flag = Build.wedge(
			f,
			Vector3.new(0.1, 2, 2),
			CFrame.new(x, 32, z + 8.6) * CFrame.Angles(0, math.pi / 2, math.pi),
			if i % 2 == 0 then ORANGE else Color3.fromRGB(110, 50, 170)
		)
		flag.CanCollide = false
	end
end

local function partyPad(parent: Instance, index: number, center: Vector3)
	local m = Build.model(parent, "PartyPad" .. index)
	local color = PAD_COLORS[index]
	local size = Vector3.new(22, 0, 16)
	Build.part(
		m,
		Vector3.new(size.X, 0.2, size.Z),
		CFrame.new(center + Vector3.new(0, 0.1, 0)),
		Color3.fromRGB(28, 30, 36),
		Enum.Material.SmoothPlastic
	)
	-- Glowing outline + light
	for _, side in
		{
			{ Vector3.new(size.X, 0.25, 0.6), Vector3.new(0, 0.2, size.Z / 2) },
			{ Vector3.new(size.X, 0.25, 0.6), Vector3.new(0, 0.2, -size.Z / 2) },
			{ Vector3.new(0.6, 0.25, size.Z), Vector3.new(size.X / 2, 0.2, 0) },
			{ Vector3.new(0.6, 0.25, size.Z), Vector3.new(-size.X / 2, 0.2, 0) },
		}
	do
		local edge = Build.part(m, side[1], CFrame.new(center + side[2]), color, Enum.Material.Neon)
		edge.CanCollide = false
	end
	local glow = Build.part(m, Vector3.new(1, 1, 1), CFrame.new(center + Vector3.new(0, 1, 0)), color)
	glow.Transparency = 1
	glow.CanCollide = false
	Build.pointLight(glow, color, 22, 1.4)
	-- Translucent glow walls
	for _, side in
		{
			{ Vector3.new(size.X, 3, 0.1), Vector3.new(0, 1.6, size.Z / 2) },
			{ Vector3.new(size.X, 3, 0.1), Vector3.new(0, 1.6, -size.Z / 2) },
			{ Vector3.new(0.1, 3, size.Z), Vector3.new(size.X / 2, 1.6, 0) },
			{ Vector3.new(0.1, 3, size.Z), Vector3.new(-size.X / 2, 1.6, 0) },
		}
	do
		local wall = Build.part(m, side[1], CFrame.new(center + side[2]), color, Enum.Material.Neon)
		wall.Transparency = 0.82
		wall.CanCollide = false
		wall.CanQuery = false
	end
	-- Board on a post: "0/4 · STEP IN"
	local post = Build.part(
		m,
		Vector3.new(0.6, 12, 0.6),
		CFrame.new(center + Vector3.new(0, 6, -size.Z / 2 - 1)),
		Color3.fromRGB(30, 30, 36),
		Enum.Material.Metal
	)
	local gui = billboard(post, UDim2.fromOffset(240, 120), Vector3.new(0, 8.5, 0), 220)
	local frame = Instance.new("Frame")
	frame.Size = UDim2.fromScale(1, 1)
	frame.BackgroundColor3 = Color3.fromRGB(245, 247, 252)
	frame.Parent = gui
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 14)
	corner.Parent = frame
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 4
	stroke.Color = Color3.fromRGB(20, 26, 48)
	stroke.Parent = frame
	local count = Instance.new("TextLabel")
	count.Name = "Count"
	count.Size = UDim2.fromScale(1, 0.62)
	count.BackgroundTransparency = 1
	count.Font = Enum.Font.FredokaOne
	count.TextScaled = true
	count.TextColor3 = Color3.fromRGB(20, 26, 48)
	count.Text = "0/4"
	count.Parent = frame
	local status = Instance.new("TextLabel")
	status.Name = "Status"
	status.Size = UDim2.fromScale(1, 0.32)
	status.Position = UDim2.fromScale(0, 0.62)
	status.BackgroundTransparency = 1
	status.Font = Enum.Font.FredokaOne
	status.TextScaled = true
	status.TextColor3 = Color3.fromRGB(20, 26, 48)
	status.Text = "STEP IN"
	status.Parent = frame
	-- Bouncing arrow (animated on clients)
	local arrow = Build.wedge(
		m,
		Vector3.new(1.2, 3, 3),
		CFrame.new(center + Vector3.new(0, 9, 0)) * CFrame.Angles(math.pi, 0, 0),
		Color3.fromRGB(40, 140, 255),
		Enum.Material.Neon
	)
	arrow.CanCollide = false
	local shaft = Build.part(
		m,
		Vector3.new(1.2, 2.4, 1.2),
		CFrame.new(center + Vector3.new(0, 11.6, 0.6)),
		Color3.fromRGB(40, 140, 255),
		Enum.Material.Neon
	)
	shaft.CanCollide = false
	CollectionService:AddTag(arrow, "BounceArrow")
	CollectionService:AddTag(shaft, "BounceArrow")
	return { Index = index, Center = center, Size = size, Count = count, Status = status, Model = m }
end

local function pedestal(parent: Instance, cf: CFrame, skin, color: Color3)
	local m = Build.model(parent, "Pedestal_" .. skin.Key)
	Build.cyl(m, 1.4, 7, cf * CFrame.new(0, 0.7, 0) * CFrame.Angles(0, 0, math.pi / 2), Color3.fromRGB(34, 34, 40), Enum.Material.Slate)
	local ring = Build.cyl(m, 0.3, 7.3, cf * CFrame.new(0, 1.3, 0) * CFrame.Angles(0, 0, math.pi / 2), color, Enum.Material.Neon)
	ring.CanCollide = false
	Build.pointLight(ring, color, 12, 1.4)
	local man = SkinLook.Mannequin(m, cf * CFrame.new(0, 1.45, 0), skin.Key)
	local _ = man
	local tagPart = Build.part(
		m,
		Vector3.new(2.6, 1, 0.3),
		cf * CFrame.new(0, 1.2, -3.6) * CFrame.Angles(math.rad(-25), 0, 0),
		Color3.fromRGB(16, 16, 20)
	)
	local price = if skin.Price == 0 then "FREE" else (if skin.Currency == "Candy" then "🍬 " else "$") .. skin.Price
	Build.label(
		tagPart,
		Enum.NormalId.Front,
		price,
		if skin.Currency == "Candy" then ORANGE else Color3.fromRGB(110, 255, 140),
		Enum.Font.GothamBlack
	)
	local base = m:FindFirstChildWhichIsA("BasePart") :: BasePart
	local nameGui = billboard(base, UDim2.fromOffset(200, 40), Vector3.new(0, 9.4, 0), 90)
	local name = Instance.new("TextLabel")
	name.Size = UDim2.fromScale(1, 1)
	name.BackgroundTransparency = 1
	name.Font = Enum.Font.FredokaOne
	name.TextScaled = true
	name.TextColor3 = if skin.Halloween then Color3.fromRGB(255, 190, 60) else Color3.fromRGB(150, 230, 255)
	name.TextStrokeTransparency = 0.3
	name.Text = skin.Name
	name.Parent = nameGui
	local prompt = Build.prompt(base, "View Skins", skin.Name, 0, 10)
	prompt:SetAttribute("Skin", skin.Key)
	return m
end

function LobbyBuilder.Build(parent: Instance)
	local lobby = Build.model(parent, "Lobby")
	local markers = { Pads = {} }
	-- Ground: snow with a cleared road and plaza
	Build.part(lobby, Vector3.new(420, 2, 420), CFrame.new(0, -1, 0), SNOW, Enum.Material.Snow)
	Build.part(lobby, Vector3.new(170, 0.2, 60), CFrame.new(0, 0.1, -40), ROAD, Enum.Material.Asphalt)
	Build.part(lobby, Vector3.new(30, 0.2, 110), CFrame.new(0, 0.1, 25), ROAD, Enum.Material.Asphalt)
	for z = -5, 75, 10 do
		Build.part(lobby, Vector3.new(0.6, 0.22, 5), CFrame.new(0, 0.12, z), Color3.fromRGB(240, 240, 240))
	end
	-- Sidewalk curbs with snow banks
	for _, x in { -16, 16 } do
		Build.part(lobby, Vector3.new(2, 1.2, 110), CFrame.new(x, 0.6, 25), Color3.fromRGB(160, 162, 170), Enum.Material.Concrete)
	end
	facade(lobby)
	for i, x in { -48, -16, 16, 48 } do
		markers.Pads[i] = partyPad(lobby, i, Vector3.new(x, 0.2, -50))
	end

	-- HALLOWEEN SKINS row (west) with a bat-wing arch
	local skins = Build.model(lobby, "Skins")
	local halloween, standard = {}, {}
	for _, skin in Config.Skins do
		table.insert(if skin.Halloween then halloween else standard, skin)
	end
	for i, skin in halloween do
		pedestal(skins, CFrame.new(-60, 0, -12 + i * 12) * CFrame.Angles(0, -math.pi / 2, 0), skin, ORANGE)
		jackOLantern(skins, CFrame.new(-52, 0, -6 + i * 12), 2)
		candle(skins, CFrame.new(-53, 0, -9 + i * 12), 1.6)
		candle(skins, CFrame.new(-52.2, 0, -10 + i * 12), 1)
	end
	local arch = Build.part(skins, Vector3.new(1, 7, 40), CFrame.new(-66, 18, 24), Color3.fromRGB(26, 14, 10))
	Build.label(arch, Enum.NormalId.Right, "🎃 Halloween Skins\nCollect Candy · Unlock Skins", ORANGE, Enum.Font.Creepster)
	Build.pointLight(arch, ORANGE, 30, 1.4)
	for _, dz in { -22, 22 } do
		Build.wedge(
			skins,
			Vector3.new(1, 8, 12),
			CFrame.new(-66, 20, 24 + dz) * CFrame.Angles(0, if dz > 0 then 0 else math.pi, 0),
			Color3.fromRGB(26, 14, 10)
		)
	end
	for _, z in { 2, 46 } do
		Build.part(skins, Vector3.new(1.2, 22, 1.2), CFrame.new(-66, 11, z), Color3.fromRGB(26, 14, 10), Enum.Material.Wood)
	end
	-- UNIFORMS row (east)
	for i, skin in standard do
		pedestal(skins, CFrame.new(60, 0, -12 + i * 12) * CFrame.Angles(0, math.pi / 2, 0), skin, Color3.fromRGB(40, 200, 255))
	end
	local uniSign = Build.part(skins, Vector3.new(1, 5, 30), CFrame.new(66, 16, 24), NAVY)
	Build.label(uniSign, Enum.NormalId.Left, "OFFICER UNIFORMS", Color3.fromRGB(150, 230, 255), Enum.Font.GothamBlack)
	for _, z in { 10, 38 } do
		Build.part(skins, Vector3.new(1, 18, 1), CFrame.new(66, 9, z), Color3.fromRGB(30, 30, 36), Enum.Material.Metal)
	end

	-- Shop kiosk
	local shop = Build.model(lobby, "Shop")
	Build.part(shop, Vector3.new(16, 9, 10), CFrame.new(34, 4.5, 40), Color3.fromRGB(30, 40, 80), Enum.Material.SmoothPlastic)
	Build.part(shop, Vector3.new(18, 1, 12), CFrame.new(34, 9.5, 40), Color3.fromRGB(240, 240, 250))
	local window = Build.part(shop, Vector3.new(12, 4, 0.3), CFrame.new(34, 5, 45.1), Color3.fromRGB(120, 230, 255), Enum.Material.Neon)
	window.Transparency = 0.2
	local shopSign = Build.part(shop, Vector3.new(14, 3, 0.4), CFrame.new(34, 12, 45), Color3.fromRGB(20, 20, 24))
	Build.label(shopSign, Enum.NormalId.Back, "🛒 STATION SHOP", Color3.fromRGB(120, 230, 255), Enum.Font.GothamBlack)
	Build.pointLight(window, Color3.fromRGB(120, 230, 255), 22, 1.6)
	markers.ShopPrompt = Build.prompt(window, "Shop", "Station Shop", 0, 12)

	-- Daily rewards board
	local daily = Build.model(lobby, "Daily")
	Build.part(daily, Vector3.new(14, 9, 1), CFrame.new(-34, 6.5, 40) * CFrame.Angles(0, math.rad(200), 0), Color3.fromRGB(20, 20, 24))
	local dailyFace = Build.part(
		daily,
		Vector3.new(13, 8, 0.2),
		CFrame.new(-34, 6.5, 40) * CFrame.Angles(0, math.rad(200), 0) * CFrame.new(0, 0, -0.6),
		Color3.fromRGB(255, 196, 40),
		Enum.Material.Neon
	)
	Build.label(dailyFace, Enum.NormalId.Front, "🎁 DAILY\nREWARDS", Color3.fromRGB(30, 20, 10), Enum.Font.GothamBlack)
	for _, x in { -5.5, 5.5 } do
		Build.part(
			daily,
			Vector3.new(0.6, 6, 0.6),
			CFrame.new(-34, 0, 40) * CFrame.Angles(0, math.rad(200), 0) * CFrame.new(x, 1, 0),
			Color3.fromRGB(30, 30, 36)
		)
	end
	markers.DailyPrompt = Build.prompt(dailyFace, "Claim", "Daily Reward", 0, 12)

	-- Street lamps, trees, fences, pumpkins
	for z = -20, 70, 18 do
		lamp(lobby, CFrame.new(-18, 0, z) * CFrame.Angles(0, -math.pi / 2, 0))
		lamp(lobby, CFrame.new(18, 0, z) * CFrame.Angles(0, math.pi / 2, 0))
	end
	local rng = Random.new(7)
	for _ = 1, 90 do
		local x = rng:NextNumber(-200, 200)
		local z = rng:NextNumber(-200, 200)
		if math.abs(x) > 80 or z > 90 or z < -95 then
			pine(lobby, CFrame.new(x, 0, z), rng:NextNumber(18, 36), rng)
		end
	end
	for z = -60, 85, 6 do
		for _, x in { -80, 80 } do
			Build.part(lobby, Vector3.new(0.5, 5, 0.5), CFrame.new(x, 2.5, z), Color3.fromRGB(30, 30, 34), Enum.Material.Metal)
			Build.part(lobby, Vector3.new(0.3, 0.3, 6), CFrame.new(x, 4.6, z + 3), Color3.fromRGB(30, 30, 34), Enum.Material.Metal)
			Build.part(lobby, Vector3.new(0.3, 0.3, 6), CFrame.new(x, 1.4, z + 3), Color3.fromRGB(30, 30, 34), Enum.Material.Metal)
		end
	end
	for _, pos in
		{
			Vector3.new(-22, 0, -20),
			Vector3.new(22, 0, -20),
			Vector3.new(-24, 0, 10),
			Vector3.new(24, 0, 10),
			Vector3.new(-12, 0, 62),
			Vector3.new(12, 0, 62),
		}
	do
		jackOLantern(lobby, CFrame.new(pos), 2.6)
	end
	-- Snow particles over the lobby
	local emitterPart = Build.part(lobby, Vector3.new(260, 1, 260), CFrame.new(0, 70, 0), Color3.new(1, 1, 1))
	emitterPart.Transparency = 1
	emitterPart.CanCollide = false
	emitterPart.CanQuery = false
	local snow = Instance.new("ParticleEmitter")
	snow.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	snow.Rate = 260
	snow.Lifetime = NumberRange.new(14, 18)
	snow.Speed = NumberRange.new(4, 6)
	snow.Size = NumberSequence.new(0.35)
	snow.EmissionDirection = Enum.NormalId.Bottom
	snow.Acceleration = Vector3.new(1.5, 0, 1)
	snow.LightEmission = 0.3
	snow.Parent = emitterPart

	-- Spawn
	local spawn = Instance.new("SpawnLocation")
	spawn.Size = Vector3.new(12, 0.4, 12)
	spawn.CFrame = CFrame.new(0, 0.3, 60)
	spawn.Anchored = true
	spawn.Transparency = 1
	spawn.CanCollide = false
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Parent = lobby
	markers.Spawn = CFrame.new(0, 3, 60) * CFrame.Angles(0, 0, 0)
	return markers
end

return LobbyBuilder
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="14">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- Frostline Checkpoint server entry point.
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterPlayer = game:GetService("StarterPlayer")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)

local DataService = require(script.Parent.DataService)
local LobbyBuilder = require(script.Parent.LobbyBuilder)
local MonetizationService = require(script.Parent.MonetizationService)
local NPC = require(script.Parent.NPC)
local PartyService = require(script.Parent.PartyService)
local PlayerService = require(script.Parent.PlayerService)
local Run = require(script.Parent.Run)

-- Moonlit winter night: dark sky, but bright enough to see everything
Lighting.ClockTime = 1.5
Lighting.Brightness = 2
Lighting.Ambient = Color3.fromRGB(70, 78, 100)
Lighting.OutdoorAmbient = Color3.fromRGB(110, 120, 150)
Lighting.EnvironmentDiffuseScale = 0.6
Lighting.EnvironmentSpecularScale = 0.6
Lighting.ExposureCompensation = 0.3
Lighting.GlobalShadows = true
local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere") or Instance.new("Atmosphere")
atmosphere.Density = 0.32
atmosphere.Offset = 0.1
atmosphere.Color = Color3.fromRGB(150, 165, 200)
atmosphere.Decay = Color3.fromRGB(60, 70, 100)
atmosphere.Glare = 0
atmosphere.Haze = 1.4
atmosphere.Parent = Lighting
local bloom = Lighting:FindFirstChildOfClass("BloomEffect") or Instance.new("BloomEffect")
bloom.Intensity = 0.6
bloom.Size = 30
bloom.Threshold = 1.4
bloom.Parent = Lighting
local grade = Lighting:FindFirstChild("Grade") or Instance.new("ColorCorrectionEffect")
grade.Name = "Grade"
grade.Contrast = 0.08
grade.Saturation = 0.05
grade.TintColor = Color3.fromRGB(240, 244, 255)
grade.Parent = Lighting

StarterPlayer.CameraMaxZoomDistance = 40
StarterPlayer.CharacterWalkSpeed = 16

local lobby = LobbyBuilder.Build(workspace)

-- Supervisor model for the "NEXT OBJECTIVE" portrait
local portraits = Instance.new("Folder")
portraits.Name = "Portraits"
portraits.Parent = ReplicatedStorage
NPC.Supervisor(portraits)

DataService.Init()
MonetizationService.Init()
PlayerService.Init(lobby)
PartyService.Init(lobby)

local function onPlayer(player: Player)
	DataService.Load(player)
	if not player.Parent then
		return
	end
	MonetizationService.LoadPasses(player)
	player:SetAttribute("StoredHints", (DataService.Get(player) or {}).StoredHints or 0)
	player:GetAttributeChangedSignal("KnockedOut"):Connect(function()
		if player:GetAttribute("KnockedOut") then
			task.delay(1.5, function()
				local run = Run.ForPlayer(player)
				if run and run.Blackout and player:GetAttribute("KnockedOut") and MonetizationService.AutoRevive(player) then
					run:WakeUp(player)
					Remotes.notify(player, "⚡ Wake Up used! RUN!", "success")
				end
			end)
		end
	end)
	if player:GetAttribute("DailyReady") then
		task.delay(4, function()
			Remotes.OpenMenu:FireClient(player, "Rewards")
		end)
	end
end
Players.PlayerAdded:Connect(onPlayer)
for _, player in Players:GetPlayers() do
	task.spawn(onPlayer, player)
end
Players.PlayerRemoving:Connect(function(player)
	DataService.Release(player)
end)

-- Lie detector questions (interrogation room)
Remotes.Ask.OnServerInvoke = function(player, index)
	local _, lane = Run.ForPlayer(player)
	local current = lane and lane.Current
	if not current or current.Stage ~= "Room" or type(index) ~= "number" then
		return nil
	end
	local entry = current.Record.Interview[index]
	if not entry then
		return nil
	end
	NPC.Say(current.Model, entry.A)
	if entry.Spike then
		Run.AddStress(player, Config.Stress.CreepyAnswer)
	end
	return { Answer = entry.A, Spike = entry.Spike }
end

-- APPROVE / DENY from the on-screen buttons
Remotes.Decide.OnServerInvoke = function(player, approve)
	local run, lane = Run.ForPlayer(player)
	if run and lane and type(approve) == "boolean" then
		run:Decide(lane, approve)
		return true
	end
	return false
end

Remotes.Taser.OnServerEvent:Connect(function(player, aim)
	local run = Run.ForPlayer(player)
	if run then
		run:Taser(player, aim)
	end
end)

print("[Frostline] Server ready.")
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">MonetizationService</string>
          <string name="Source"><![CDATA[-- Game passes and developer products (safe, idempotent receipts).
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)

local DataService = require(script.Parent.DataService)
local Run = require(script.Parent.Run)

local MonetizationService = {}

local MAX_RECEIPTS = 100

function MonetizationService.LoadPasses(player: Player)
	for key, pass in Config.GamePasses do
		local owned = false
		if pass.Id ~= 0 then
			local ok, result = pcall(MarketplaceService.UserOwnsGamePassAsync, MarketplaceService, player.UserId, pass.Id)
			owned = ok and result == true
		end
		if RunService:IsStudio() and Config.StudioGrantAllPasses then
			owned = true
		end
		player:SetAttribute("Pass_" .. key, owned)
	end
	DataService.Sync(player)
end

-- Tells the player whether the passenger in front of them is human.
function MonetizationService.Hint(player: Player): (boolean, string)
	local _, lane = Run.ForPlayer(player)
	local current = lane and lane.Current
	if not current or not current.Record then
		return false, "No passenger at your desk right now."
	end
	if current.Record.Anomaly then
		return true, "🔍 Your gut screams: this passenger is NOT HUMAN."
	end
	return true, "🔍 This passenger is human." .. (if current.Record.Violation then " (But check their papers...)" else "")
end

local productHandlers = {
	Hint = function(player: Player)
		local ok, text = MonetizationService.Hint(player)
		if not ok then
			-- No passenger: save it as a stored hint
			local data = DataService.Get(player)
			if data then
				data.StoredHints = (data.StoredHints or 0) + 1
				player:SetAttribute("StoredHints", data.StoredHints)
			end
			Remotes.notify(player, "🔍 Hint saved! Use it from the shop during a shift.", "success")
			return
		end
		Remotes.notify(player, text, "info")
	end,
	Revive = function(player: Player)
		local run = Run.ForPlayer(player)
		if run and player:GetAttribute("KnockedOut") then
			run:WakeUp(player)
			Remotes.notify(player, "⚡ You're back up! RUN!", "success")
		else
			local data = DataService.Get(player)
			if data then
				data.StoredRevives = (data.StoredRevives or 0) + 1
			end
			Remotes.notify(player, "⚡ Wake Up saved for later. It triggers automatically when you're caught.", "success")
		end
	end,
	PowerSurge = function(player: Player)
		local run = Run.ForPlayer(player)
		if not (run and run:SurgeBreaker(player)) then
			DataService.AddCash(player, 250, false)
			Remotes.notify(player, "No blackout right now, so here's $250 instead.", "info")
		end
	end,
	CashSmall = function(player: Player)
		local amount = DataService.AddCash(player, Config.CashPacks.CashSmall, false)
		Remotes.notify(player, "💵 +$" .. amount .. "! Thanks for your support!", "success")
	end,
	CashLarge = function(player: Player)
		local amount = DataService.AddCash(player, Config.CashPacks.CashLarge, false)
		Remotes.notify(player, "💵 +$" .. amount .. "! Thanks for your support!", "success")
	end,
	CandySmall = function(player: Player)
		local amount = DataService.AddCandy(player, Config.CandyPacks.CandySmall, false)
		Remotes.notify(player, "🍬 +" .. amount .. " Candy! Happy Halloween!", "success")
	end,
	CandyLarge = function(player: Player)
		local amount = DataService.AddCandy(player, Config.CandyPacks.CandyLarge, false)
		Remotes.notify(player, "🍬 +" .. amount .. " Candy! Happy Halloween!", "success")
	end,
}

local handlerById = {}
for key, product in Config.Products do
	if product.Id ~= 0 and productHandlers[key] then
		handlerById[product.Id] = productHandlers[key]
	end
end

local function processReceipt(info)
	local player = Players:GetPlayerByUserId(info.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local data = DataService.Get(player)
	if not data then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if data.ReceiptIds[info.PurchaseId] then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	local handler = handlerById[info.ProductId]
	if not handler then
		warn("[Monetization] No handler for product", info.ProductId)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local ok, err = pcall(handler, player, data)
	if not ok then
		warn("[Monetization] Handler error:", err)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	data.ReceiptIds[info.PurchaseId] = os.time()
	local count, oldestId, oldestTime = 0, nil, math.huge
	for id, time in data.ReceiptIds do
		count += 1
		if time < oldestTime then
			oldestId, oldestTime = id, time
		end
	end
	if count > MAX_RECEIPTS and oldestId then
		data.ReceiptIds[oldestId] = nil
	end

	if not DataService.Save(player) then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

function MonetizationService.Init()
	MarketplaceService.ProcessReceipt = processReceipt

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		if not purchased then
			return
		end
		for key, pass in Config.GamePasses do
			if pass.Id ~= 0 and pass.Id == passId then
				player:SetAttribute("Pass_" .. key, true)
				DataService.Sync(player)
				Remotes.notify(player, "Thanks for buying " .. pass.Name .. "!", "success")
			end
		end
	end)

	Remotes.UseHint.OnServerInvoke = function(player)
		local data = DataService.Get(player)
		if not data or (data.StoredHints or 0) <= 0 then
			return false, "You have no saved hints."
		end
		local ok, text = MonetizationService.Hint(player)
		if ok then
			data.StoredHints -= 1
			player:SetAttribute("StoredHints", data.StoredHints)
		end
		return ok, text
	end

	-- Anomaly Radar pass: points at the tool that will expose this passenger.
	Remotes.UseRadar.OnServerInvoke = function(player)
		local run, lane = Run.ForPlayer(player)
		if not run or not lane then
			return false, "Only during a shift."
		end
		if not player:GetAttribute("Pass_AnomalyRadar") then
			return false, "You need the 📡 Anomaly Radar pass."
		end
		if lane.RadarLeft <= 0 then
			return false, "No radar charges left this shift."
		end
		local record = lane.Current and lane.Current.Record
		if not record then
			return false, "No passenger at your desk."
		end
		lane.RadarLeft -= 1
		run:SendState(lane)
		local Passengers = require(Shared.Passengers)
		if record.Anomaly then
			for _, tell in Passengers.Anomalies[record.Anomaly].Tells do
				if Passengers.ToolUnlocked(run.Shift, tell) then
					return true, "📡 Radar: check the " .. tell .. " carefully."
				end
			end
		end
		if record.Violation then
			return true, "📡 Radar: something on their papers or bag breaks tonight's rules."
		end
		return true, "📡 Radar: nothing unusual detected."
	end
end

-- Spend a saved Wake Up automatically when knocked out.
function MonetizationService.AutoRevive(player: Player): boolean
	local data = DataService.Get(player)
	if data and (data.StoredRevives or 0) > 0 then
		data.StoredRevives -= 1
		return true
	end
	return false
end

return MonetizationService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">NPC</string>
          <string name="Source"><![CDATA[-- Real R15 characters for passengers and monsters, with animations, poses and speech.
local PhysicsService = game:GetService("PhysicsService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Passengers = require(Shared.Passengers)
local Remotes = require(Shared.Remotes)

local NPC = {}

-- Roblox's default R15 animations (used when Config.Animations is 0)
local DEFAULT_ANIMS = {
	Walk = 507777826,
	Idle = 507766388,
	Run = 507767714,
}

pcall(function()
	PhysicsService:RegisterCollisionGroup("NPC")
	PhysicsService:RegisterCollisionGroup("Players")
	PhysicsService:CollisionGroupSetCollidable("NPC", "NPC", false)
	PhysicsService:CollisionGroupSetCollidable("NPC", "Players", false)
end)

local function setGroup(model: Model, group: string)
	for _, p in model:GetDescendants() do
		if p:IsA("BasePart") then
			p.CollisionGroup = group
		end
	end
end
NPC.SetGroup = setGroup

local function animation(id: number): Animation
	local anim = Instance.new("Animation")
	anim.AnimationId = "rbxassetid://" .. id
	return anim
end

-- Loads walk/idle tracks and switches between them while the NPC moves.
local function animate(model: Model, walkId: number, idleId: number, runSpeed: number?)
	local humanoid = model:FindFirstChildOfClass("Humanoid") :: Humanoid
	local animator = humanoid:FindFirstChildOfClass("Animator") or Instance.new("Animator")
	animator.Parent = humanoid
	local walk = animator:LoadAnimation(animation(walkId))
	local idle = animator:LoadAnimation(animation(idleId))
	walk.Priority = Enum.AnimationPriority.Movement
	idle.Priority = Enum.AnimationPriority.Idle
	walk.Looped = true
	idle.Looped = true
	idle:Play()
	local moving = false
	humanoid.Running:Connect(function(speed)
		if speed > 0.6 and not moving then
			moving = true
			walk:Play(0.2)
			walk:AdjustSpeed(speed / (runSpeed or 12))
		elseif speed <= 0.6 and moving then
			moving = false
			walk:Stop(0.25)
		elseif moving then
			walk:AdjustSpeed(speed / (runSpeed or 12))
		end
	end)
	return animator
end

local function weld(part: BasePart, to: BasePart, offset: CFrame)
	part.Anchored = false
	part.CanCollide = false
	part.Massless = true
	part.CFrame = to.CFrame * offset
	local w = Instance.new("WeldConstraint")
	w.Part0 = to
	w.Part1 = part
	w.Parent = part
end

local function add(
	model: Instance,
	to: BasePart?,
	size: Vector3,
	offset: CFrame,
	color: Color3,
	material: Enum.Material?,
	shape: Enum.PartType?
): Part?
	if not to then
		return nil
	end
	local p = Instance.new("Part")
	p.Size = size
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	if shape then
		p.Shape = shape
	end
	p.Parent = model
	weld(p, to, offset)
	return p
end

-- Hair built from parts (used when no Marketplace hair IDs are configured).
local function buildHair(model: Model, style: string, color: Color3)
	local head = model:FindFirstChild("Head") :: BasePart?
	if not head then
		return
	end
	local folder = Instance.new("Folder")
	folder.Name = "Hair"
	folder.Parent = model
	local s = head.Size
	if style == "Bald" then
		return
	end
	if style == "Cap" then
		add(
			folder,
			head,
			Vector3.new(s.X * 1.08, s.Y * 0.35, s.Z * 1.08),
			CFrame.new(0, s.Y * 0.38, 0),
			color:Lerp(Color3.fromRGB(40, 60, 120), 0.6),
			Enum.Material.Fabric
		)
		add(
			folder,
			head,
			Vector3.new(s.X, 0.1, s.Z * 0.5),
			CFrame.new(0, s.Y * 0.22, -s.Z * 0.65),
			Color3.fromRGB(30, 40, 80),
			Enum.Material.Fabric
		)
		return
	end
	add(folder, head, Vector3.new(s.X * 1.08, s.Y * 0.4, s.Z * 1.1), CFrame.new(0, s.Y * 0.36, 0.05), color, Enum.Material.Fabric)
	add(folder, head, Vector3.new(s.X * 1.08, s.Y * 0.7, s.Z * 0.3), CFrame.new(0, s.Y * 0.1, s.Z * 0.45), color, Enum.Material.Fabric)
	if style == "Long" then
		add(folder, head, Vector3.new(s.X * 1.1, s.Y * 1.3, s.Z * 0.35), CFrame.new(0, -s.Y * 0.25, s.Z * 0.5), color, Enum.Material.Fabric)
		for _, x in { -1, 1 } do
			add(
				folder,
				head,
				Vector3.new(s.X * 0.18, s.Y * 1.1, s.Z * 0.8),
				CFrame.new(x * s.X * 0.52, -s.Y * 0.1, 0.1),
				color,
				Enum.Material.Fabric
			)
		end
	elseif style == "Bun" then
		add(folder, head, Vector3.new(0.7, 0.7, 0.7), CFrame.new(0, s.Y * 0.6, s.Z * 0.45), color, Enum.Material.Fabric, Enum.PartType.Ball)
	elseif style == "Pigtails" then
		for _, x in { -1, 1 } do
			add(folder, head, Vector3.new(0.45, 1.1, 0.45), CFrame.new(x * s.X * 0.62, -s.Y * 0.15, s.Z * 0.2), color, Enum.Material.Fabric)
		end
	elseif style == "Spiky" then
		for i = -2, 2 do
			local spike = Instance.new("WedgePart")
			spike.Size = Vector3.new(0.3, 0.6, 0.5)
			spike.Color = color
			spike.Material = Enum.Material.Fabric
			spike.Parent = folder
			weld(spike, head, CFrame.new(i * 0.24, s.Y * 0.7, 0.05) * CFrame.Angles(0, 0, math.rad(i * 10)))
		end
	end
end

local function suitcase(model: Model, color: Color3): Model
	local bag = Instance.new("Model")
	bag.Name = "Suitcase"
	local body = Instance.new("Part")
	body.Name = "Body"
	body.Size = Vector3.new(0.7, 1.9, 2.4)
	body.Color = color
	body.Material = Enum.Material.SmoothPlastic
	body.Parent = bag
	local handle = Instance.new("Part")
	handle.Size = Vector3.new(0.2, 0.5, 0.8)
	handle.Color = Color3.fromRGB(30, 30, 30)
	handle.Parent = bag
	local stripe = Instance.new("Part")
	stripe.Size = Vector3.new(0.75, 0.2, 2.45)
	stripe.Color = Color3.fromRGB(30, 30, 34)
	stripe.Parent = bag
	bag.PrimaryPart = body
	local hand = model:FindFirstChild("RightHand") :: BasePart?
	if hand then
		weld(body, hand, CFrame.new(0.2, -1.1, 0))
		weld(handle, body, CFrame.new(0, 1.1, 0))
		weld(stripe, body, CFrame.new(0, 0.3, 0))
	end
	bag.Parent = model
	return bag
end

-- Detaches the suitcase from the hand and returns it as a loose, anchored model at `cf`.
function NPC.DropBag(model: Model, cf: CFrame): Model?
	local bag = model:FindFirstChild("Suitcase") :: Model?
	if not bag or not bag.PrimaryPart then
		return nil
	end
	for _, w in bag:GetDescendants() do
		if w:IsA("WeldConstraint") and w.Part0 and not w.Part0:IsDescendantOf(bag) then
			w:Destroy()
		end
	end
	for _, p in bag:GetDescendants() do
		if p:IsA("BasePart") then
			p.Anchored = true
			p.CollisionGroup = "NPC"
		end
	end
	bag.Parent = model.Parent
	bag:PivotTo(cf * CFrame.Angles(0, 0, math.pi / 2))
	return bag
end

function NPC.Passenger(record, cf: CFrame, parent: Instance): Model
	local desc = Instance.new("HumanoidDescription")
	local skin = Passengers.SkinColors[record.Look.Skin]
	local shirt = Passengers.ShirtColors[record.Look.Shirt]
	local pants = Passengers.PantsColors[record.Look.Pants]
	desc.HeadColor = skin
	desc.LeftArmColor = skin
	desc.RightArmColor = skin
	desc.TorsoColor = shirt
	desc.LeftLegColor = pants
	desc.RightLegColor = pants
	local rng = Random.new(record.Seed)
	local looks = Config.PassengerLooks
	local function pickId(list)
		if #list == 0 then
			return nil
		end
		return tonumber(list[rng:NextInteger(1, #list)])
	end
	local hairId, shirtId, pantsId, faceId = pickId(looks.Hair), pickId(looks.Shirts), pickId(looks.Pants), pickId(looks.Faces)
	if hairId then
		desc.HairAccessory = tostring(hairId)
	end
	if shirtId then
		desc.Shirt = shirtId
	end
	if pantsId then
		desc.Pants = pantsId
	end
	if faceId then
		desc.Face = faceId
	end
	local model: Model
	local ok, result = pcall(function()
		return Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
	end)
	if ok and result then
		model = result
	else
		warn("[NPC] Could not create passenger:", result)
		model = Instance.new("Model")
	end
	model.Name = record.First .. " " .. record.Last
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	local animateScript = model:FindFirstChild("Animate")
	if animateScript then
		animateScript:Destroy()
	end
	if humanoid then
		humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		humanoid.WalkSpeed = 9
		humanoid.BreakJointsOnDeath = false
	end
	if not hairId then
		buildHair(model, record.Look.Hair, Passengers.HairColors[record.Look.HairColor])
	end
	-- Shirt sleeves (part-built) so clothes read clearly without catalog items
	if not shirtId then
		for _, name in { "LeftUpperArm", "RightUpperArm" } do
			local arm = model:FindFirstChild(name) :: BasePart?
			if arm then
				add(model, arm, arm.Size + Vector3.new(0.06, -0.2, 0.06), CFrame.new(0, 0.1, 0), shirt, Enum.Material.Fabric)
			end
		end
	end
	local bagColors = {
		Color3.fromRGB(40, 40, 46),
		Color3.fromRGB(120, 30, 30),
		Color3.fromRGB(30, 60, 120),
		Color3.fromRGB(150, 120, 70),
		Color3.fromRGB(60, 90, 60),
	}
	suitcase(model, bagColors[rng:NextInteger(1, #bagColors)])
	pcall(function()
		model:ScaleTo(record.Look.Height)
	end)
	model:PivotTo(cf + Vector3.new(0, 3, 0))
	model.Parent = parent
	setGroup(model, "NPC")
	local hrp = model:FindFirstChild("HumanoidRootPart") :: BasePart?
	if hrp then
		hrp:SetNetworkOwner(nil)
	end
	if humanoid then
		animate(
			model,
			if Config.Animations.PassengerWalk ~= 0 then Config.Animations.PassengerWalk else DEFAULT_ANIMS.Walk,
			if Config.Animations.PassengerIdle ~= 0 then Config.Animations.PassengerIdle else DEFAULT_ANIMS.Idle,
			12
		)
	end
	model:SetAttribute("Passenger", true)
	return model
end

-- Walk to a point; returns when there (or after a timeout).
function NPC.WalkTo(model: Model, target: Vector3, timeout: number?): boolean
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	local hrp = model:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not humanoid or not hrp then
		return false
	end
	local deadline = os.clock() + (timeout or 20)
	while model.Parent and os.clock() < deadline do
		humanoid:MoveTo(target)
		local flat = Vector3.new(hrp.Position.X - target.X, 0, hrp.Position.Z - target.Z)
		if flat.Magnitude < 1.6 then
			return true
		end
		task.wait(0.25)
	end
	return false
end

function NPC.Face(model: Model, lookAt: Vector3)
	local hrp = model:FindFirstChild("HumanoidRootPart") :: BasePart?
	if hrp then
		local pos = hrp.Position
		hrp.CFrame = CFrame.lookAt(pos, Vector3.new(lookAt.X, pos.Y, lookAt.Z))
	end
end

-- Procedural poses using the shoulder joints (or uploaded animations when configured).
local poses = {}
local function motor(model: Model, partName: string, motorName: string): Motor6D?
	local part = model:FindFirstChild(partName)
	return part and part:FindFirstChild(motorName) :: Motor6D?
end

function NPC.Pose(model: Model, pose: string?)
	local right = motor(model, "RightUpperArm", "RightShoulder")
	local left = motor(model, "LeftUpperArm", "LeftShoulder")
	if not right or not left then
		return
	end
	local base = poses[model]
	if not base then
		base = { R = right.C0, L = left.C0 }
		poses[model] = base
		model.Destroying:Connect(function()
			poses[model] = nil
		end)
	end
	local animKey = if pose == "ArmsUp"
		then "PassengerScanPose"
		elseif pose == "HandOver" then "PassengerHandOver"
		elseif pose == "PlaceBag" then "PassengerPlaceBag"
		else nil
	if animKey and Config.Animations[animKey] ~= 0 then
		local humanoid = model:FindFirstChildOfClass("Humanoid")
		local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")
		if animator then
			local track = animator:LoadAnimation(animation(Config.Animations[animKey]))
			track.Priority = Enum.AnimationPriority.Action
			track:Play()
			return
		end
	end
	if pose == "ArmsUp" then
		right.C0 = base.R * CFrame.Angles(math.rad(170), 0, math.rad(-10))
		left.C0 = base.L * CFrame.Angles(math.rad(170), 0, math.rad(10))
	elseif pose == "HandOver" then
		right.C0 = base.R * CFrame.Angles(math.rad(75), 0, math.rad(10))
		left.C0 = base.L
	elseif pose == "PlaceBag" then
		right.C0 = base.R * CFrame.Angles(math.rad(50), 0, 0)
		left.C0 = base.L
	else
		right.C0 = base.R
		left.C0 = base.L
	end
end

function NPC.Say(model: Model, text: string)
	local head = model:FindFirstChild("Head")
	if head then
		Remotes.Speech:FireAllClients(head, text)
	end
end

-- The thing that comes out when the lights go out.
function NPC.Monster(cf: CFrame, parent: Instance): Model
	local desc = Instance.new("HumanoidDescription")
	local black = Color3.fromRGB(14, 14, 18)
	desc.HeadColor = Color3.fromRGB(200, 200, 205)
	desc.LeftArmColor = black
	desc.RightArmColor = black
	desc.TorsoColor = black
	desc.LeftLegColor = black
	desc.RightLegColor = black
	local ok, model = pcall(function()
		return Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
	end)
	if not ok or not model then
		model = Instance.new("Model")
	end
	model.Name = "TheThing"
	local animateScript = model:FindFirstChild("Animate")
	if animateScript then
		animateScript:Destroy()
	end
	local head = model:FindFirstChild("Head") :: BasePart?
	local face = head and head:FindFirstChildOfClass("Decal")
	if face then
		face:Destroy()
	end
	-- Hollow eyes, a stretched mouth, claws and spines
	if head then
		for _, x in { -0.22, 0.22 } do
			local eye = add(
				model,
				head,
				Vector3.new(0.28, 0.36, 0.08),
				CFrame.new(x, 0.15, -0.58),
				Color3.fromRGB(255, 255, 255),
				Enum.Material.Neon
			)
			if eye then
				local light = Instance.new("PointLight")
				light.Color = Color3.fromRGB(255, 255, 255)
				light.Range = 7
				light.Brightness = 1.5
				light.Parent = eye
			end
		end
		add(model, head, Vector3.new(0.75, 0.6, 0.08), CFrame.new(0, -0.32, -0.58), Color3.fromRGB(30, 0, 0), Enum.Material.SmoothPlastic)
		for i = -3, 3 do
			add(model, head, Vector3.new(0.06, 0.16, 0.05), CFrame.new(i * 0.1, -0.08, -0.62), Color3.fromRGB(240, 236, 220))
			add(model, head, Vector3.new(0.06, 0.16, 0.05), CFrame.new(i * 0.1, -0.56, -0.62), Color3.fromRGB(240, 236, 220))
		end
	end
	for _, handName in { "LeftHand", "RightHand" } do
		local hand = model:FindFirstChild(handName) :: BasePart?
		for k = -1, 1 do
			if hand then
				local claw = Instance.new("WedgePart")
				claw.Size = Vector3.new(0.1, 1.1, 0.25)
				claw.Color = Color3.fromRGB(230, 226, 210)
				claw.Parent = model
				weld(claw, hand, CFrame.new(k * 0.15, -0.8, -0.1) * CFrame.Angles(math.rad(-10), 0, 0))
			end
		end
	end
	local upper = model:FindFirstChild("UpperTorso") :: BasePart?
	for i = 0, 4 do
		if upper then
			local spine = Instance.new("WedgePart")
			spine.Size = Vector3.new(0.12, 0.5, 0.45)
			spine.Color = Color3.fromRGB(200, 196, 186)
			spine.Parent = model
			weld(spine, upper, CFrame.new(0, 0.7 - i * 0.35, 0.6))
		end
	end
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		humanoid.WalkSpeed = Config.LightsOut.MonsterSpeed
		humanoid.BreakJointsOnDeath = false
	end
	pcall(function()
		model:ScaleTo(1.45)
	end)
	model:PivotTo(cf + Vector3.new(0, 4, 0))
	model.Parent = parent
	setGroup(model, "NPC")
	local hrp = model:FindFirstChild("HumanoidRootPart") :: BasePart?
	if hrp then
		hrp:SetNetworkOwner(nil)
	end
	if humanoid then
		animate(
			model,
			if Config.Animations.MonsterRun ~= 0 then Config.Animations.MonsterRun else DEFAULT_ANIMS.Run,
			if Config.Animations.MonsterIdle ~= 0 then Config.Animations.MonsterIdle else DEFAULT_ANIMS.Idle,
			16
		)
	end
	model:SetAttribute("Monster", true)
	game:GetService("CollectionService"):AddTag(model, "Monster")
	return model
end

-- An NPC for the supervisor portrait (cloned into ViewportFrames on clients).
function NPC.Supervisor(parent: Instance): Model?
	local desc = Instance.new("HumanoidDescription")
	desc.HeadColor = Color3.fromRGB(234, 196, 164)
	desc.TorsoColor = Color3.fromRGB(30, 46, 100)
	desc.LeftArmColor = Color3.fromRGB(30, 46, 100)
	desc.RightArmColor = Color3.fromRGB(30, 46, 100)
	local ok, model = pcall(function()
		return Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
	end)
	if not ok or not model then
		return nil
	end
	model.Name = "Supervisor"
	local head = model:FindFirstChild("Head") :: BasePart?
	if head then
		add(model, head, Vector3.new(1.35, 0.45, 1.35), CFrame.new(0, 0.62, 0), Color3.fromRGB(20, 26, 50), Enum.Material.Fabric)
		add(model, head, Vector3.new(1.3, 0.1, 0.7), CFrame.new(0, 0.42, -0.75), Color3.fromRGB(10, 10, 14))
		add(model, head, Vector3.new(0.5, 0.3, 0.05), CFrame.new(0, 0.66, -0.68), Color3.fromRGB(230, 190, 60), Enum.Material.Metal)
	end
	for _, p in model:GetDescendants() do
		if p:IsA("BasePart") then
			p.Anchored = true
		end
	end
	model.Parent = parent
	return model
end

return NPC
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">PartyService</string>
          <string name="Source"><![CDATA[-- Lobby party pads: step in, create a party (1-4, friends only), count down, start a shift.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)

local DataService = require(script.Parent.DataService)
local Run = require(script.Parent.Run)
local StationBuilder = require(script.Parent.StationBuilder)

local PartyService = {}

local pads = {}
local stations = {}
local lobbyMarkers
local friendCache = {} -- ["a:b"] = bool

local function isFriend(a: Player, b: Player): boolean
	if a == b then
		return true
	end
	local key = math.min(a.UserId, b.UserId) .. ":" .. math.max(a.UserId, b.UserId)
	if friendCache[key] == nil then
		local ok, result = pcall(a.IsFriendsWith, a, b.UserId)
		friendCache[key] = ok and result == true
	end
	return friendCache[key]
end

local function stationFor(index: number)
	if not stations[index] then
		local folder = workspace:FindFirstChild("Stations") or Instance.new("Folder")
		folder.Name = "Stations"
		folder.Parent = workspace
		stations[index] = StationBuilder.Build(folder, CFrame.new(1400 * index, 0, 0), "Station" .. index)
	end
	return stations[index]
end

local function onPad(pad, player: Player): boolean
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not hrp then
		return false
	end
	local rel = hrp.Position - pad.Center
	return math.abs(rel.X) <= pad.Size.X / 2 and math.abs(rel.Z) <= pad.Size.Z / 2 and rel.Y < 12 and rel.Y > -4
end

local function refresh(pad)
	if pad.State == "InShift" then
		pad.Count.Text = "IN SHIFT"
		pad.Status.Text = "SHIFT " .. (pad.Shift or 1) .. " RUNNING"
	elseif pad.State == "Waiting" then
		pad.Count.Text = #pad.Members .. "/" .. pad.MaxSize
		pad.Status.Text = if pad.Countdown <= 0 then "LAUNCHING..." else "STARTING IN " .. pad.Countdown
		if pad.FriendsOnly then
			pad.Status.Text ..= "  ·  👥"
		end
	else
		pad.Count.Text = "0/" .. Config.Party.MaxSize
		pad.Status.Text = if pad.Pending then "CREATING PARTY..." else "STEP IN"
	end
end

local function reset(pad)
	pad.State = "Idle"
	pad.Members = {}
	pad.Leader = nil
	pad.Pending = nil
	pad.MaxSize = Config.Party.MaxSize
	pad.FriendsOnly = false
	pad.Countdown = 0
	refresh(pad)
end

local function launch(pad)
	pad.State = "InShift"
	local members = {}
	for _, p in pad.Members do
		if p.Parent and onPad(pad, p) then
			table.insert(members, p)
		end
	end
	if #members == 0 then
		reset(pad)
		return
	end
	local leaderData = DataService.Get(pad.Leader or members[1])
	local shift = if leaderData then leaderData.NextShift else 1
	pad.Shift = shift
	refresh(pad)
	for _, p in members do
		Remotes.Announce:FireClient(p, "SHIFT " .. shift, nil)
	end
	local station = stationFor(pad.Index)
	local run = Run.new(station, members, shift, function()
		reset(pad)
	end)
	run.OnReturn = function(player: Player)
		local char = player.Character
		if char and lobbyMarkers then
			char:PivotTo(lobbyMarkers.Spawn * CFrame.new(math.random(-6, 6), 0, math.random(-4, 4)))
		end
	end
	run:Start()
end

function PartyService.Init(markers)
	lobbyMarkers = markers
	for i, pad in markers.Pads do
		pad.Index = i
		pads[i] = pad
		reset(pad)
	end

	Remotes.CreateParty.OnServerInvoke = function(player, index, size, friendsOnly)
		local pad = pads[index]
		if not pad or type(size) ~= "number" or size ~= size or player:GetAttribute("InShift") then
			return false, "Can't create a party here."
		end
		if pad.State ~= "Idle" or (pad.Pending and pad.Pending ~= player) then
			return false, "Someone else is already creating a party here."
		end
		if not onPad(pad, player) then
			return false, "Step into the zone first."
		end
		size = math.clamp(math.floor(size), 1, Config.Party.MaxSize)
		pad.State = "Waiting"
		pad.Pending = nil
		pad.Leader = player
		pad.Members = { player }
		pad.MaxSize = size
		pad.FriendsOnly = friendsOnly == true
		pad.Countdown = if size == 1 then 3 else Config.Party.Countdown
		refresh(pad)
		return true, "Party created!"
	end

	task.spawn(function()
		local tick = 0
		while true do
			task.wait(0.25)
			tick += 1
			for _, pad in pads do
				if pad.State == "Idle" then
					-- Someone stepped in: they get to create the party
					if pad.Pending and (not pad.Pending.Parent or not onPad(pad, pad.Pending)) then
						pad.Pending = nil
						refresh(pad)
					end
					-- Still standing there without creating? Ask again every 12 seconds.
					if pad.Pending and os.clock() - (pad.PendingAt or 0) > 12 then
						pad.PendingAt = os.clock()
						Remotes.PartyPrompt:FireClient(pad.Pending, pad.Index)
					end
					if not pad.Pending then
						for _, player in Players:GetPlayers() do
							if not player:GetAttribute("InShift") and onPad(pad, player) then
								pad.Pending = player
								pad.PendingAt = os.clock()
								Remotes.PartyPrompt:FireClient(player, pad.Index)
								refresh(pad)
								break
							end
						end
					end
				elseif pad.State == "Waiting" then
					-- Drop players who left the zone
					for i = #pad.Members, 1, -1 do
						local member = pad.Members[i]
						if not member.Parent or not onPad(pad, member) then
							table.remove(pad.Members, i)
						end
					end
					if #pad.Members == 0 then
						reset(pad)
						continue
					end
					if not table.find(pad.Members, pad.Leader) then
						pad.Leader = pad.Members[1]
					end
					-- New players join
					for _, player in Players:GetPlayers() do
						if not table.find(pad.Members, player) and not player:GetAttribute("InShift") and onPad(pad, player) then
							if #pad.Members >= pad.MaxSize then
								if not player:GetAttribute("ToldFull") then
									player:SetAttribute("ToldFull", true)
									Remotes.notify(player, "This party is full. Try another zone!", "warn")
								end
							elseif pad.FriendsOnly and not isFriend(pad.Leader, player) then
								if not player:GetAttribute("ToldFull") then
									player:SetAttribute("ToldFull", true)
									Remotes.notify(player, "👥 Friends only party.", "warn")
								end
							else
								table.insert(pad.Members, player)
								Remotes.notify(player, "Joined " .. pad.Leader.DisplayName .. "'s party!", "success")
							end
						elseif player:GetAttribute("ToldFull") and not onPad(pad, player) then
							player:SetAttribute("ToldFull", nil)
						end
					end
					if #pad.Members >= pad.MaxSize then
						pad.Countdown = math.min(pad.Countdown, 3)
					end
					if tick % 4 == 0 then
						pad.Countdown -= 1
						if pad.Countdown <= 0 then
							refresh(pad)
							launch(pad)
							continue
						end
					end
					refresh(pad)
				end
			end
		end
	end)
end

return PartyService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">PlayerService</string>
          <string name="Source"><![CDATA[-- Name tags, skins, daily rewards, locker hiding, and lobby prompts.
local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)

local DataService = require(script.Parent.DataService)
local SkinLook = require(script.Parent.SkinLook)

local PlayerService = {}

-- "Shift 5" tag with the player's headshot, like a badge over their head.
local function nameTag(player: Player, char: Model)
	local head = char:WaitForChild("Head", 10) :: BasePart?
	if not head then
		return
	end
	local humanoid = char:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	end
	local gui = Instance.new("BillboardGui")
	gui.Name = "ShiftTag"
	gui.Size = UDim2.fromOffset(190, 64)
	gui.StudsOffset = Vector3.new(0, 3, 0)
	gui.MaxDistance = 90
	gui.LightInfluence = 0
	gui.Parent = head
	local avatar = Instance.new("ImageLabel")
	avatar.Size = UDim2.fromOffset(40, 40)
	avatar.BackgroundColor3 = Color3.new(1, 1, 1)
	avatar.Image = "rbxthumb://type=AvatarHeadShot&id=" .. player.UserId .. "&w=150&h=150"
	avatar.Parent = gui
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(1, 0)
	corner.Parent = avatar
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2
	stroke.Color = Color3.new(1, 1, 1)
	stroke.Parent = avatar
	local shift = Instance.new("TextLabel")
	shift.Name = "Shift"
	shift.Position = UDim2.fromOffset(46, 0)
	shift.Size = UDim2.new(1, -46, 0, 40)
	shift.BackgroundTransparency = 1
	shift.Font = Enum.Font.FredokaOne
	shift.TextScaled = true
	shift.TextXAlignment = Enum.TextXAlignment.Left
	shift.TextColor3 = Color3.new(1, 1, 1)
	shift.TextStrokeTransparency = 0.2
	shift.Parent = gui
	local name = Instance.new("TextLabel")
	name.Position = UDim2.fromOffset(0, 42)
	name.Size = UDim2.new(1, 0, 0, 20)
	name.BackgroundTransparency = 1
	name.Font = Enum.Font.GothamBold
	name.TextScaled = true
	name.TextColor3 = Color3.fromRGB(230, 230, 230)
	name.TextStrokeTransparency = 0.3
	name.Text = player.DisplayName
	name.Parent = gui
	local function update()
		shift.Text = "Shift " .. (player:GetAttribute("NextShift") or 1)
		if player:GetAttribute("Pass_VIP") then
			name.Text = "👑 " .. player.DisplayName
			name.TextColor3 = Color3.fromRGB(255, 210, 80)
		end
	end
	update()
	player:GetAttributeChangedSignal("NextShift"):Connect(update)
	player:GetAttributeChangedSignal("Pass_VIP"):Connect(update)
end

-- Lockers: hold E to hide; the monster can't see you inside.
local occupied = {} -- [locker Model] = Player
local hiddenIn = {} -- [Player] = { Locker, Return CFrame }

local function unhide(player: Player)
	local info = hiddenIn[player]
	if not info then
		return
	end
	hiddenIn[player] = nil
	occupied[info.Locker] = nil
	player:SetAttribute("Hidden", nil)
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if hrp then
		hrp.Anchored = false
		char:PivotTo(info.Return)
	end
	Remotes.Sfx:FireClient(player, "Locker")
end
PlayerService.Unhide = unhide

local function hide(player: Player, locker: Model)
	if hiddenIn[player] then
		unhide(player)
		return
	end
	if occupied[locker] then
		Remotes.notify(player, "Someone is already hiding in there!", "warn")
		return
	end
	local body = locker.PrimaryPart
	local point = body and body:FindFirstChild("HidePoint") :: Attachment?
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not point or not hrp or player:GetAttribute("KnockedOut") then
		return
	end
	occupied[locker] = player
	hiddenIn[player] = { Locker = locker, Return = body.CFrame * CFrame.new(0, -0.6, -3.2) }
	hrp.Anchored = true
	char:PivotTo(point.WorldCFrame)
	player:SetAttribute("Hidden", true)
	Remotes.Sfx:FireClient(player, "Locker")
end

local function wireLocker(locker: Instance)
	if not locker:IsA("Model") then
		return
	end
	local body = locker.PrimaryPart or locker:WaitForChild("Body", 5)
	local prompt = body and body:FindFirstChildOfClass("ProximityPrompt")
	if prompt then
		prompt.ActionText = "Hide / Leave"
		prompt.Triggered:Connect(function(player)
			if hiddenIn[player] and hiddenIn[player].Locker ~= locker then
				return
			end
			hide(player, locker)
		end)
	end
end

local function findSkin(key)
	for _, skin in Config.Skins do
		if skin.Key == key then
			return skin
		end
	end
	return nil
end

function PlayerService.Init(lobby)
	local function onPlayer(player: Player)
		player.CharacterAdded:Connect(function(char)
			task.spawn(nameTag, player, char)
			local info = hiddenIn[player]
			if info then
				occupied[info.Locker] = nil
			end
			hiddenIn[player] = nil
			player:SetAttribute("Hidden", nil)
		end)
		if player.Character then
			task.spawn(nameTag, player, player.Character)
		end
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayer, player)
	end
	Players.PlayerRemoving:Connect(function(player)
		unhide(player)
	end)

	for _, locker in CollectionService:GetTagged("HideLocker") do
		task.spawn(wireLocker, locker)
	end
	CollectionService:GetInstanceAddedSignal("HideLocker"):Connect(function(locker)
		task.spawn(wireLocker, locker)
	end)

	-- Lobby prompts open menus
	lobby.ShopPrompt.Triggered:Connect(function(player)
		Remotes.OpenMenu:FireClient(player, "Shop")
	end)
	lobby.DailyPrompt.Triggered:Connect(function(player)
		Remotes.OpenMenu:FireClient(player, "Rewards")
	end)
	for _, prompt in CollectionService:GetTagged("GamePrompt") do
		local key = prompt:GetAttribute("Skin")
		if key then
			prompt.Triggered:Connect(function(player)
				Remotes.OpenMenu:FireClient(player, "Skins", key)
			end)
		end
	end

	Remotes.BuySkin.OnServerInvoke = function(player, key)
		local data = DataService.Get(player)
		local skin = findSkin(key)
		if not data or not skin then
			return false, "Unknown skin."
		end
		if data.OwnedSkins[key] then
			return false, "You already own it."
		end
		if not DataService.Spend(player, skin.Currency, skin.Price) then
			return false, "Not enough " .. (if skin.Currency == "Candy" then "🍬 Candy" else "💵 Cash") .. "."
		end
		data.OwnedSkins[key] = true
		data.Skin = key
		DataService.Sync(player)
		return true, "Unlocked " .. skin.Name .. "! It's equipped for your next shift."
	end

	Remotes.EquipSkin.OnServerInvoke = function(player, key)
		local data = DataService.Get(player)
		if not data or not findSkin(key) or not data.OwnedSkins[key] then
			return false, "You don't own that skin."
		end
		data.Skin = key
		DataService.Sync(player)
		if player:GetAttribute("InShift") and player.Character then
			SkinLook.Apply(player.Character, key)
		end
		return true, "Equipped!"
	end

	Remotes.ClaimDaily.OnServerInvoke = function(player)
		local data = DataService.Get(player)
		if not data then
			return false, "Data not loaded yet."
		end
		local today = os.time() // 86400
		if data.DailyLast >= today then
			return false, "Come back tomorrow!"
		end
		data.DailyStreak = if data.DailyLast == today - 1 then data.DailyStreak + 1 else 1
		data.DailyLast = today
		local day = (data.DailyStreak - 1) % #Config.DailyRewards + 1
		local reward = Config.DailyRewards[day]
		local vip = if player:GetAttribute("Pass_VIP") then 2 else 1
		local parts = {}
		if reward.Cash then
			DataService.AddCash(player, reward.Cash * vip, false)
			table.insert(parts, "$" .. reward.Cash * vip)
		end
		if reward.Candy then
			DataService.AddCandy(player, reward.Candy * vip, false)
			table.insert(parts, reward.Candy * vip .. " 🍬")
		end
		DataService.Sync(player)
		return true, "Day " .. data.DailyStreak .. " reward: " .. table.concat(parts, " + ")
	end
end

return PlayerService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">Run</string>
          <string name="Source"><![CDATA[-- One shift at one station for one party: lanes, passengers, tools, interrogation, verdicts,
-- and the blackout when something gets through.
local CollectionService = game:GetService("CollectionService")
local PathfindingService = game:GetService("PathfindingService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Passengers = require(Shared.Passengers)
local Remotes = require(Shared.Remotes)

local DataService = require(script.Parent.DataService)
local NPC = require(script.Parent.NPC)
local PlayerService = require(script.Parent.PlayerService)
local SkinLook = require(script.Parent.SkinLook)

local Run = {}
Run.__index = Run

Run.ByPlayer = {} :: { [Player]: any }

local STEPS = 6
local GREETINGS = {
	"Evening, officer.",
	"I need to get on this train before midnight.",
	"Cold night, isn't it?",
	"Here are my papers.",
	"Please be quick, my kids are waiting.",
	"Is the train on time?",
	"Long queue tonight...",
}
local CREEPY_GREETINGS = {
	"Hello... officer.",
	"I am a normal traveller. Normal.",
	"Let me through. Please. Let me through.",
	"Your face looks so warm.",
	"I have papers. Papers papers papers.",
}

local function stamp(prompt: ProximityPrompt, players: { Player }?)
	if players then
		local ids = {}
		for _, p in players do
			table.insert(ids, tostring(p.UserId))
		end
		prompt:SetAttribute("ForUsers", "," .. table.concat(ids, ",") .. ",")
	else
		prompt:SetAttribute("ForUsers", nil)
	end
end

local function canUse(prompt: ProximityPrompt, player: Player): boolean
	local list = prompt:GetAttribute("ForUsers")
	return list == nil or string.find(list, "," .. player.UserId .. ",", 1, true) ~= nil
end

local function character(player: Player): (Model?, Humanoid?, BasePart?)
	local char = player.Character
	if not char then
		return nil, nil, nil
	end
	return char, char:FindFirstChildOfClass("Humanoid"), char:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function teleport(player: Player, cf: CFrame)
	local char = player.Character
	if char then
		char:PivotTo(cf)
	end
end

function Run.AddStress(player: Player, amount: number)
	local stress = math.clamp((player:GetAttribute("Stress") or 0) + amount, 0, 100)
	player:SetAttribute("Stress", stress)
end

local function giveTaser(player: Player)
	local backpack = player:FindFirstChildOfClass("Backpack")
	if not backpack or backpack:FindFirstChild("Taser") then
		return
	end
	local tool = Instance.new("Tool")
	tool.Name = "Taser"
	tool.ToolTip = "Stun monsters (and coworkers)"
	tool.CanBeDropped = false
	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = Vector3.new(0.4, 0.8, 1.4)
	handle.Color = Color3.fromRGB(250, 210, 40)
	handle.Parent = tool
	local tip = Instance.new("Part")
	tip.Size = Vector3.new(0.3, 0.3, 0.3)
	tip.Color = Color3.fromRGB(80, 200, 255)
	tip.Material = Enum.Material.Neon
	tip.CanCollide = false
	tip.Massless = true
	tip.CFrame = handle.CFrame * CFrame.new(0, 0.1, -0.8)
	local w = Instance.new("WeldConstraint")
	w.Part0 = handle
	w.Part1 = tip
	w.Parent = tip
	tip.Parent = tool
	tool.Parent = backpack
end

local function removeTaser(player: Player)
	for _, container in { player:FindFirstChildOfClass("Backpack"), player.Character } do
		local tool = container and container:FindFirstChild("Taser")
		if tool then
			tool:Destroy()
		end
	end
end

function Run.new(station, members: { Player }, shift: number, onEnd: (any) -> ())
	local self = setmetatable({}, Run)
	self.Station = station
	self.Shift = shift
	self.Rules = Passengers.Rules(shift)
	self.Members = table.clone(members)
	self.Lanes = {}
	self.Connections = {}
	self.Escaped = {} -- anomalies that boarded the train
	self.Monsters = {}
	self.Ended = false
	self.Blackout = false
	self.OnEnd = onEnd
	self.Folder = Instance.new("Folder")
	self.Folder.Name = "RunNPCs"
	self.Folder.Parent = station.Model
	self.PassengersPerLane =
		math.min(Config.Shift.BasePassengers + (shift - 1) * Config.Shift.PassengersPerShift, Config.Shift.MaxPassengers)
	return self
end

function Run:Connect(signal: RBXScriptSignal, fn)
	table.insert(self.Connections, signal:Connect(fn))
end

function Run:Objective(lane, step: number, title: string, text: string)
	Remotes.Objective:FireClient(lane.Player, { Title = title, Text = text, Step = step, Steps = STEPS })
end

function Run:SendState(lane)
	local maxStrikes = Config.Shift.MaxStrikes + (if lane.Player:GetAttribute("Pass_ExtraStrike") then 1 else 0)
	Remotes.ShiftState:FireClient(lane.Player, {
		Shift = self.Shift,
		Lane = lane.Index,
		Strikes = lane.Strikes,
		MaxStrikes = maxStrikes,
		Remaining = lane.Remaining,
		Total = self.PassengersPerLane,
		Correct = lane.Correct,
		Rules = self.Rules.Lines,
		RadarLeft = lane.RadarLeft,
	})
	local left = string.format("%02d", lane.Remaining)
	lane.Markers.SignLabel.Text = "LANE " .. lane.Index .. "  ·  " .. left .. " CHECK-INS LEFT"
end

function Run:Start()
	for i, player in self.Members do
		local markers = self.Station.Lanes[i]
		local room = self.Station.Interrogation[i]
		local lane = {
			Index = i,
			Player = player,
			Markers = markers,
			Room = room,
			Remaining = self.PassengersPerLane,
			Strikes = 0,
			Correct = 0,
			Wrong = 0,
			Pay = 0,
			Current = nil,
			Fired = false,
			Done = false,
			RadarLeft = if player:GetAttribute("Pass_AnomalyRadar") then 3 else 0,
			Log = {},
		}
		self.Lanes[i] = lane
		Run.ByPlayer[player] = self
		player:SetAttribute("InShift", true)
		player:SetAttribute("Lane", i)
		player:SetAttribute("Stress", player:GetAttribute("Stress") or 0)
		for _, prompt in markers.Prompts do
			stamp(prompt, { player })
			prompt.Enabled = false
		end
		for _, prompt in room.Prompts do
			stamp(prompt, { player })
			prompt.Enabled = false
		end
		markers.Prompts.Rulebook.Enabled = true
		local char = player.Character
		if char then
			SkinLook.Apply(char, player:GetAttribute("Skin") or "Standard")
			for _, p in char:GetDescendants() do
				if p:IsA("BasePart") then
					p.CollisionGroup = "Players"
				end
			end
		end
		pcall(player.RequestStreamAroundAsync, player, markers.OfficerSpawn.Position)
		teleport(player, markers.OfficerSpawn)
		giveTaser(player)
		-- Respawned (reset / fell): put them back at work
		self:Connect(player.CharacterAdded, function(newChar)
			task.wait()
			if Run.ByPlayer[player] ~= self or self.Ended then
				return
			end
			player:SetAttribute("KnockedOut", nil)
			player:SetAttribute("Hidden", nil)
			newChar:PivotTo(if self.Blackout then self.Station.BreakRoomSpawn else markers.OfficerSpawn)
			SkinLook.Apply(newChar, player:GetAttribute("Skin") or "Standard")
			for _, p in newChar:GetDescendants() do
				if p:IsA("BasePart") then
					p.CollisionGroup = "Players"
				end
			end
			giveTaser(player)
		end)
		self:SendState(lane)
		self:Objective(lane, 1, "Check in the passenger", "Your first passenger is on the way. Meet them at the check-in desk.")
		self:WirePrompts(lane)
	end
	-- Breakers, lockers and coffee belong to the whole party
	for _, breaker in self.Station.Breakers do
		stamp(breaker.Prompt, self.Members)
		breaker.Prompt.Enabled = false
		self:Connect(breaker.Prompt.Triggered, function(player)
			self:FlipBreaker(player, breaker)
		end)
	end
	self:Connect(self.Station.Coffee.Triggered, function(player)
		if Run.ByPlayer[player] == self then
			Run.AddStress(player, Config.Stress.Coffee)
			Remotes.Sfx:FireClient(player, "Coffee")
			Remotes.notify(player, "☕ Hot coffee. You feel calmer.", "success")
		end
	end)
	-- Close any lanes past the party size
	for i = #self.Members + 1, #self.Station.Lanes do
		self.Station.Lanes[i].SignLabel.Text = "LANE " .. i .. "  ·  CLOSED"
	end
	for _, lane in self.Lanes do
		Remotes.Sfx:FireClient(lane.Player, "TrainHorn")
		task.delay(3, function()
			self:NextPassenger(lane)
		end)
	end
	self:Connect(Players.PlayerRemoving, function(player)
		for _, lane in self.Lanes do
			if lane.Player == player then
				lane.Fired = true
				lane.Done = true
				if lane.Current and lane.Current.Model then
					lane.Current.Model:Destroy()
				end
				lane.Current = nil
			end
		end
		Run.ByPlayer[player] = nil
		self:CheckAllDone()
	end)
end

function Run:LanePrompts(lane, enabled: boolean, room: boolean?)
	local unlocked = function(key)
		return Passengers.ToolUnlocked(self.Shift, key)
	end
	local prompts = lane.Markers.Prompts
	prompts.Approve.Enabled = enabled and not room
	prompts.Deny.Enabled = enabled and not room
	for _, key in { "XRay", "Skeleton", "Camera", "Thermal" } do
		prompts[key].Enabled = enabled and not room and unlocked(key)
	end
	prompts.Interrogate.Enabled = enabled and not room and unlocked("Interview")
	for _, key in { "Interview", "Fingerprint", "Eyes", "Brain" } do
		lane.Room.Prompts[key].Enabled = enabled and room == true and unlocked(key)
	end
	lane.Room.Prompts.Approve.Enabled = enabled and room == true
	lane.Room.Prompts.Deny.Enabled = enabled and room == true
end

-- What each tool shows.
function Run:ToolData(lane, key: string)
	local current = lane.Current
	local p = current and current.Record
	if key == "Rulebook" then
		return { Lines = self.Rules.Lines, Shift = self.Shift }
	end
	if not p then
		return nil
	end
	if key == "Passport" then
		return {
			First = p.First,
			Last = p.Last,
			Country = p.Country,
			Birth = p.Birth,
			PassportNo = p.PassportNo,
			Expiry = string.format("%02d/%d", p.ExpiryMonth, p.ExpiryYear),
			Print = if Passengers.ToolUnlocked(self.Shift, "Fingerprint") then p.PrintedFingerprint else nil,
			Photo = p.Photo,
			Model = current.Model,
			Ticket = p.Ticket,
			Today = string.format("%02d/%d", Passengers.Today.Month, Passengers.Today.Year),
		}
	elseif key == "XRay" then
		local items = {}
		for _, itemKey in p.Bag do
			local item = Passengers.Items[itemKey]
			table.insert(items, { Icon = item.Icon, Name = item.Name, Category = item.Category })
		end
		return { Items = items, Forbidden = self.Rules.Forbidden }
	elseif key == "Skeleton" then
		return { Skeleton = p.Skeleton, Height = p.Look.Height }
	elseif key == "Camera" then
		return { Model = current.Model, TrueForm = p.TrueForm, Lane = lane.Index }
	elseif key == "Thermal" then
		return { Temperature = p.Temperature }
	elseif key == "Interview" then
		local qs = {}
		for i, entry in p.Interview do
			qs[i] = entry.Q
		end
		return { Questions = qs, Name = p.First }
	elseif key == "Fingerprint" then
		return { Scanned = p.Fingerprint, Printed = p.PrintedFingerprint }
	elseif key == "Eyes" then
		return { Eyes = p.Eyes }
	elseif key == "Brain" then
		return { Brain = p.Brain }
	end
	return nil
end

function Run:OpenTool(lane, key: string)
	local data = self:ToolData(lane, key)
	if data then
		Remotes.OpenTool:FireClient(lane.Player, key, data)
		Remotes.Sfx:FireClient(lane.Player, if key == "Rulebook" or key == "Passport" then "Paper" else "Scanner")
	end
end

function Run:WirePrompts(lane)
	local prompts = lane.Markers.Prompts
	local function guard(fn)
		return function(player)
			if player ~= lane.Player or self.Ended or lane.Done then
				return
			end
			fn(player)
		end
	end
	self:Connect(
		prompts.Rulebook.Triggered,
		guard(function()
			self:OpenTool(lane, "Rulebook")
		end)
	)
	self:Connect(
		prompts.TakeID.Triggered,
		guard(function()
			local current = lane.Current
			if not current or current.Stage ~= "Desk" then
				return
			end
			current.Stage = "Inspect"
			prompts.TakeID.Enabled = false
			lane.Markers.PassportProp.Transparency = 1
			NPC.Pose(current.Model, nil)
			self:LanePrompts(lane, true, false)
			self:OpenTool(lane, "Passport")
			self:Objective(
				lane,
				3,
				"Inspect the passenger",
				"Check the passport, ticket and tonight's rules (R). Use the monitors and tools on your desk."
			)
		end)
	)
	for _, key in { "XRay", "Skeleton", "Camera", "Thermal" } do
		self:Connect(
			prompts[key].Triggered,
			guard(function()
				if lane.Current and lane.Current.Stage == "Inspect" then
					self:OpenTool(lane, key)
				end
			end)
		)
	end
	self:Connect(
		prompts.Approve.Triggered,
		guard(function()
			self:Decide(lane, true)
		end)
	)
	self:Connect(
		prompts.Deny.Triggered,
		guard(function()
			self:Decide(lane, false)
		end)
	)
	self:Connect(
		prompts.Interrogate.Triggered,
		guard(function()
			self:SendToRoom(lane)
		end)
	)
	local room = lane.Room.Prompts
	for _, key in { "Interview", "Fingerprint", "Eyes", "Brain" } do
		self:Connect(
			room[key].Triggered,
			guard(function()
				if lane.Current and lane.Current.Stage == "Room" then
					self:OpenTool(lane, key)
					if key == "Brain" then
						lane.Room.BrainLabel.Text = "NEURO-SCAN\nRUNNING..."
						task.delay(1.5, function()
							if lane.Current and lane.Current.Record then
								lane.Room.BrainLabel.Text = "NEURO-SCAN\nCOMPLETE"
							end
						end)
					end
				end
			end)
		)
	end
	self:Connect(
		room.Approve.Triggered,
		guard(function()
			self:Decide(lane, true)
		end)
	)
	self:Connect(
		room.Deny.Triggered,
		guard(function()
			self:Decide(lane, false)
		end)
	)
end

-- Moves a bag model along the X-ray belt.
local function slideBag(bag: Model, from: CFrame, to: CFrame, duration: number)
	local start = os.clock()
	while bag.Parent and os.clock() - start < duration do
		local t = (os.clock() - start) / duration
		bag:PivotTo(from:Lerp(to, t) * CFrame.Angles(0, 0, math.pi / 2))
		task.wait()
	end
	if bag.Parent then
		bag:PivotTo(to * CFrame.Angles(0, 0, math.pi / 2))
	end
end

function Run:NextPassenger(lane)
	if self.Ended or lane.Done or self.Blackout then
		return
	end
	if lane.Remaining <= 0 then
		lane.Done = true
		self:LanePrompts(lane, false)
		self:Objective(lane, STEPS, "Lane clear!", "Great work. Wait for the others to finish their lanes.")
		self:CheckAllDone()
		return
	end
	local seed = math.floor((os.clock() * 1000) % 1e6) + lane.Index * 7919 + lane.Remaining * 104729
	local record = Passengers.Generate(self.Shift, seed, self.Rules)
	local points = lane.Markers.Points
	local model = NPC.Passenger(record, self.Station.Outside * CFrame.new(math.random(-4, 4), 0, 0), self.Folder)
	local current = { Record = record, Model = model, Stage = "Walking", Location = "Desk" }
	lane.Current = current
	self:Objective(lane, 1, "Check in the passenger", "Your next passenger is on the way. Meet them at the check-in desk.")
	lane.Markers.XRayLabel.Text = "X-RAY\nWAITING"
	lane.Markers.ScanLabel.Text = "BODY SCAN\nWAITING"
	task.spawn(function()
		local alive = function()
			return lane.Current == current and model.Parent ~= nil and not self.Ended
		end
		NPC.WalkTo(model, self.Station.HallDoorIn.Position)
		NPC.WalkTo(model, points.Entry.Position)
		NPC.WalkTo(model, points.Queue.Position)
		if not alive() then
			return
		end
		-- Bag on the X-ray belt
		NPC.WalkTo(model, points.Bag.Position)
		NPC.Face(model, lane.Markers.BagStart.Position)
		NPC.Pose(model, "PlaceBag")
		task.wait(0.6)
		if not alive() then
			return
		end
		local bag = NPC.DropBag(model, lane.Markers.BagStart)
		current.Bag = bag
		NPC.Pose(model, nil)
		if bag then
			task.spawn(function()
				slideBag(bag, lane.Markers.BagStart, lane.Markers.BagEnd, 6)
				if lane.Current == current then
					lane.Markers.XRayLabel.Text = if Passengers.ToolUnlocked(self.Shift, "XRay")
						then "X-RAY\nREADY ✓"
						else "X-RAY\nLOCKED"
				end
			end)
		end
		-- Body scanner
		NPC.WalkTo(model, points.ScanWait.Position)
		NPC.WalkTo(model, points.Scan.Position)
		NPC.Face(model, points.Counter.Position)
		NPC.Pose(model, "ArmsUp")
		Remotes.Sfx:FireClient(lane.Player, "Scanner", points.Scan.Position)
		local light = lane.Markers.ScanLight
		for _ = 1, 4 do
			light.Color = Color3.fromRGB(255, 255, 255)
			task.wait(0.25)
			light.Color = Color3.fromRGB(90, 200, 255)
			task.wait(0.25)
		end
		NPC.Pose(model, nil)
		if not alive() then
			return
		end
		lane.Markers.ScanLabel.Text = if Passengers.ToolUnlocked(self.Shift, "Skeleton")
			then "BODY SCAN\nREADY ✓"
			else "BODY SCAN\nLOCKED"
		-- To the counter
		NPC.WalkTo(model, points.Counter.Position)
		NPC.Face(model, points.Counter.Position - Vector3.new(0, 0, 10))
		local hrp = model:FindFirstChild("HumanoidRootPart") :: BasePart?
		if hrp then
			NPC.Face(model, hrp.Position + (lane.Markers.OfficerSpawn.Position - hrp.Position) * Vector3.new(1, 0, 1))
		end
		if not alive() then
			return
		end
		NPC.Pose(model, "HandOver")
		lane.Markers.PassportProp.Transparency = 0
		current.Stage = "Desk"
		lane.Markers.Prompts.TakeID.Enabled = true
		local rng = Random.new(record.Seed + 1)
		local line = if record.Anomaly and rng:NextNumber() < 0.45
			then CREEPY_GREETINGS[rng:NextInteger(1, #CREEPY_GREETINGS)]
			else GREETINGS[rng:NextInteger(1, #GREETINGS)]
		NPC.Say(model, line)
		Remotes.Sfx:FireClient(lane.Player, "Bell")
		self:Objective(lane, 2, "Check in the passenger", "Grab their ID card off the tray.")
	end)
end

local function aisle(lane)
	return lane.Markers.Points.Back.Position + Vector3.new(0, 0, 7)
end

local function walk(model: Model, points: { Vector3 }, still: () -> boolean)
	for _, point in points do
		if not still() then
			return false
		end
		NPC.WalkTo(model, point, 25)
	end
	return still()
end

-- Waypoints out of the desk area or the interrogation room, ending in the main hall aisle.
function Run:PathToHall(lane, location: string): { Vector3 }
	local points = lane.Markers.Points
	if location == "Room" then
		local room = lane.Room
		local doorZ = room.Door.Position.Z
		local corridorX = self.Station.WingCorridorTop.Position.X
		return {
			Vector3.new(room.Door.Position.X - 7, 0, doorZ),
			room.Door.Position,
			Vector3.new(corridorX, 0, doorZ),
			self.Station.WingCorridorTop.Position,
			self.Station.WingHallDoor.Position,
			self.Station.WingHallDoor.Position + Vector3.new(3, 0, 3),
		}
	end
	return { points.Scan.Position, points.Back.Position, aisle(lane) }
end

-- Walk the passenger to this lane's interrogation room.
function Run:SendToRoom(lane)
	local current = lane.Current
	if not current or current.Stage ~= "Inspect" then
		return
	end
	current.Stage = "ToRoom"
	self:LanePrompts(lane, false)
	lane.Markers.Prompts.Rulebook.Enabled = true
	Remotes.CloseTools:FireClient(lane.Player)
	NPC.Say(current.Model, "W-what? Why me?")
	self:Objective(
		lane,
		4,
		"Interrogation",
		"Go to INTERROGATION ROOM " .. lane.Index .. " (back corridor, west wing). Your suspect is being escorted."
	)
	lane.Player:SetAttribute("Waypoint", lane.Room.OfficerSpot.Position)
	local model = current.Model
	local room = lane.Room
	task.spawn(function()
		local path = self:PathToHall(lane, "Desk")
		local wingDoor = self.Station.WingHallDoor.Position
		for _, point in
			{
				wingDoor + Vector3.new(3, 0, 3),
				wingDoor,
				self.Station.WingCorridorTop.Position,
				Vector3.new(self.Station.WingCorridorTop.Position.X, 0, room.Door.Position.Z),
				room.Door.Position,
				room.Door.Position - Vector3.new(7, 0, 0),
				room.Seat.Position,
			}
		do
			table.insert(path, point)
		end
		if not walk(model, path, function()
			return lane.Current == current
		end) then
			return
		end
		current.Location = "Room"
		local humanoid = model:FindFirstChildOfClass("Humanoid")
		if humanoid and room.SeatPart then
			room.SeatPart:Sit(humanoid)
		end
		current.Stage = "Room"
		self:LanePrompts(lane, true, true)
		NPC.Say(model, "...")
		self:Objective(
			lane,
			4,
			"Interrogation",
			"Question them. Lie detector, fingerprints, eye exam and brain scan are on the table. Then stamp."
		)
	end)
end

function Run:Decide(lane, approve: boolean)
	local current = lane.Current
	if not current or (current.Stage ~= "Inspect" and current.Stage ~= "Room") then
		return
	end
	local player = lane.Player
	current.Stage = "Leaving"
	self:LanePrompts(lane, false)
	lane.Markers.Prompts.Rulebook.Enabled = true
	player:SetAttribute("Waypoint", nil)
	Remotes.CloseTools:FireClient(player)
	Remotes.Sfx:FireClient(player, "Stamp")
	local record = current.Record
	local shouldApprove, reason = Passengers.Judge(record, self.Rules)
	local correct = approve == shouldApprove
	lane.Remaining -= 1
	table.insert(
		lane.Log,
		{ Name = record.First .. " " .. record.Last, Approved = approve, Correct = correct, Reason = reason, Anomaly = record.Anomaly }
	)
	if correct then
		lane.Correct += 1
		Run.AddStress(player, Config.Stress.PerfectCall)
		Remotes.Verdict:FireClient(
			player,
			{ Correct = true, Approved = approve, Text = if approve then "Approved ✓" else "Denied ✓ " .. reason }
		)
		Remotes.Sfx:FireClient(player, "Correct")
	elseif approve and record.Anomaly then
		-- Something boarded the train. Nobody tells you... yet.
		lane.Wrong += 1
		table.insert(self.Escaped, record)
		Remotes.Verdict:FireClient(player, { Correct = true, Approved = true, Text = "Approved ✓", Uneasy = true })
		Remotes.Sfx:FireClient(player, "Whispers")
	else
		lane.Wrong += 1
		lane.Strikes += 1
		Run.AddStress(player, Config.Stress.WrongCall)
		Remotes.Verdict:FireClient(player, { Correct = false, Approved = approve, Text = "WRONG ✗  " .. reason })
		Remotes.Sfx:FireClient(player, "Buzzer")
	end
	self:SendState(lane)
	-- Passenger leaves
	local model = current.Model
	local points = lane.Markers.Points
	if approve then
		NPC.Say(model, if record.Anomaly then "Thank you... officer." else "Thank you! Have a good night.")
	else
		NPC.Say(model, if record.Anomaly then "You will regret this." else "What?! This is ridiculous!")
	end
	task.spawn(function()
		local bag = current.Bag
		if bag then
			bag:Destroy()
		end
		local humanoid = model:FindFirstChildOfClass("Humanoid")
		if humanoid and humanoid.Sit then
			humanoid.Sit = false
			humanoid.Jump = true
			task.wait(0.5)
		end
		local path = self:PathToHall(lane, current.Location)
		if approve then
			for _, point in { self.Station.HallSide.Position, self.Station.PlatformDoor.Position, self.Station.TrainDoor.Position } do
				table.insert(path, point)
			end
		else
			local entry = if current.Location == "Room"
				then self.Station.WingHallDoor.Position + Vector3.new(7, 0, 17)
				else points.Entry.Position
			for _, point in { entry, self.Station.HallDoorIn.Position, self.Station.Outside.Position } do
				table.insert(path, point)
			end
		end
		walk(model, path, function()
			return model.Parent ~= nil and not self.Ended
		end)
		model:Destroy()
	end)
	lane.Current = nil
	local maxStrikes = Config.Shift.MaxStrikes + (if player:GetAttribute("Pass_ExtraStrike") then 1 else 0)
	if lane.Strikes >= maxStrikes then
		lane.Fired = true
		lane.Done = true
		self:LanePrompts(lane, false)
		Remotes.Announce:FireClient(player, "YOU'RE FIRED", Color3.fromRGB(220, 40, 40):ToHex())
		self:Objective(lane, STEPS, "Fired", "Too many mistakes. Clocking you out...")
		task.delay(3, function()
			self:FinishPlayer(lane, false, "fired")
			self:CheckAllDone()
		end)
		return
	end
	self:Objective(lane, 5, if correct then "Good call" else "Mistake", "Next passenger coming up...")
	task.delay(2.5, function()
		self:NextPassenger(lane)
	end)
end

function Run:CheckAllDone()
	if self.Ended or self.Blackout then
		return
	end
	for _, lane in self.Lanes do
		if not lane.Done then
			return
		end
	end
	local active = false
	for _, lane in self.Lanes do
		if not lane.Fired and lane.Player.Parent then
			active = true
		end
	end
	if not active then
		self:End(false)
	elseif #self.Escaped > 0 then
		task.delay(4, function()
			self:StartBlackout()
		end)
	else
		self:End(true)
	end
end

function Run:ActivePlayers(): { Player }
	local list = {}
	for _, lane in self.Lanes do
		if not lane.Fired and lane.Player.Parent and Run.ByPlayer[lane.Player] == self then
			table.insert(list, lane.Player)
		end
	end
	return list
end

-- POWER FAILURE: lights die, the things that boarded the train come back for you.
function Run:SetPower(on: boolean)
	local model = self.Station.Model
	for _, part in CollectionService:GetTagged("PowerLight") do
		if part:IsDescendantOf(model) then
			part.Material = if on then Enum.Material.Neon else Enum.Material.SmoothPlastic
			for _, light in part:GetChildren() do
				if light:IsA("Light") then
					light.Enabled = on
				end
			end
		end
	end
	for _, part in CollectionService:GetTagged("PowerScreen") do
		if part:IsDescendantOf(model) then
			part.Material = if on then Enum.Material.Neon else Enum.Material.SmoothPlastic
			part.Color = if on then part:GetAttribute("OnColor") or part.Color else Color3.fromRGB(10, 10, 12)
			for _, gui in part:GetChildren() do
				if gui:IsA("SurfaceGui") then
					gui.Enabled = on
				end
			end
		end
	end
	for _, part in CollectionService:GetTagged("EmergencyLight") do
		if part:IsDescendantOf(model) then
			local light = part:FindFirstChild("Emergency") :: PointLight?
			if light then
				light.Brightness = if on then 0 else 1.6
			end
			part.Material = if on then Enum.Material.SmoothPlastic else Enum.Material.Neon
			part.Color = if on then Color3.fromRGB(90, 0, 0) else Color3.fromRGB(255, 30, 20)
		end
	end
end

function Run:StartBlackout()
	if self.Ended or self.Blackout then
		return
	end
	self.Blackout = true
	self.BreakersOn = 0
	local players = self:ActivePlayers()
	for _, part in CollectionService:GetTagged("PowerScreen") do
		if part:IsDescendantOf(self.Station.Model) and not part:GetAttribute("OnColor") then
			part:SetAttribute("OnColor", part.Color)
		end
	end
	self:SetPower(false)
	self.Deadline = os.time() + Config.LightsOut.Duration
	for _, player in players do
		Remotes.Sfx:FireClient(player, "PowerDown")
		Remotes.Blackout:FireClient(
			player,
			{ Active = true, Deadline = self.Deadline, Breakers = 0, Total = #self.Station.Breakers, Count = #self.Escaped }
		)
		Remotes.CloseTools:FireClient(player)
		Remotes.Objective:FireClient(player, {
			Title = "RESTORE THE POWER",
			Text = #self.Escaped .. " of the passengers you approved were NOT human. Flip all 3 breakers. Hide in lockers. Tase it.",
			Step = STEPS,
			Steps = STEPS,
		})
	end
	for _, breaker in self.Station.Breakers do
		breaker.Prompt.Enabled = true
		breaker.Light.Color = Color3.fromRGB(255, 40, 40)
		breaker.Lever.CFrame = breaker.Base * CFrame.new(0, 4.6, -0.6) * CFrame.Angles(math.rad(40), 0, 0)
	end
	-- The things come out of the train
	local count = math.min(3, #self.Escaped)
	task.delay(4, function()
		for i = 1, count do
			if self.Ended or not self.Blackout then
				return
			end
			local monster = NPC.Monster(self.Station.MonsterSpawn * CFrame.new(0, 0, (i - 1) * 4), self.Folder)
			table.insert(self.Monsters, monster)
			for _, player in self:ActivePlayers() do
				Remotes.Sfx:FireClient(player, "MonsterScreech", self.Station.MonsterSpawn.Position)
			end
			task.spawn(function()
				self:MonsterBrain(monster)
			end)
			task.wait(6)
		end
	end)
	task.spawn(function()
		while self.Blackout and not self.Ended do
			task.wait(1)
			if os.time() >= self.Deadline then
				self:EndBlackout(false)
				return
			end
			local active = self:ActivePlayers()
			if #active == 0 then
				self:EndBlackout(false)
				return
			end
			local standing = 0
			for _, player in active do
				if not player:GetAttribute("KnockedOut") then
					standing += 1
				end
			end
			-- Everyone down for longer than a knockout = the station is lost
			if standing == 0 then
				self.AllDownAt = self.AllDownAt or os.clock()
				if os.clock() - self.AllDownAt > Config.LightsOut.KnockoutTime + 2 then
					self:EndBlackout(false)
					return
				end
			else
				self.AllDownAt = nil
			end
		end
	end)
end

function Run:FlipBreaker(player: Player, breaker)
	if not self.Blackout or self.Ended or not breaker.Prompt.Enabled or Run.ByPlayer[player] ~= self then
		return
	end
	breaker.Prompt.Enabled = false
	breaker.Light.Color = Color3.fromRGB(40, 255, 80)
	breaker.Lever.CFrame = breaker.Base * CFrame.new(0, 5.4, -0.6) * CFrame.Angles(math.rad(-40), 0, 0)
	self.BreakersOn += 1
	for _, p in self:ActivePlayers() do
		Remotes.Sfx:FireClient(p, "Breaker")
		Remotes.Blackout:FireClient(
			p,
			{ Active = true, Deadline = self.Deadline, Breakers = self.BreakersOn, Total = #self.Station.Breakers }
		)
		Remotes.notify(
			p,
			"⚡ "
				.. player.DisplayName
				.. " restored breaker "
				.. breaker.Name
				.. " ("
				.. self.BreakersOn
				.. "/"
				.. #self.Station.Breakers
				.. ")",
			"success"
		)
	end
	if self.BreakersOn >= #self.Station.Breakers then
		self:EndBlackout(true)
	end
end

-- Used by the Power Surge product.
function Run:SurgeBreaker(player: Player): boolean
	if not self.Blackout then
		return false
	end
	for _, breaker in self.Station.Breakers do
		if breaker.Prompt.Enabled then
			self:FlipBreaker(player, breaker)
			return true
		end
	end
	return false
end

function Run:EndBlackout(won: boolean)
	if not self.Blackout then
		return
	end
	self.Blackout = false
	for _, breaker in self.Station.Breakers do
		breaker.Prompt.Enabled = false
	end
	for _, monster in self.Monsters do
		monster:Destroy()
	end
	self.Monsters = {}
	if won then
		self:SetPower(true)
	end
	for _, player in self:ActivePlayers() do
		Remotes.Blackout:FireClient(player, { Active = false, Won = won })
		player:SetAttribute("KnockedOut", nil)
		local _, humanoid = character(player)
		if humanoid then
			humanoid.PlatformStand = false
			humanoid.WalkSpeed = 16
		end
	end
	task.delay(if won then 2 else 3, function()
		self:End(won)
	end)
end

function Run:Knockout(player: Player, monster: Model)
	if player:GetAttribute("KnockedOut") then
		return
	end
	player:SetAttribute("KnockedOut", true)
	Run.AddStress(player, Config.Stress.Caught)
	Remotes.Scare:FireClient(player, monster)
	local _, humanoid = character(player)
	if humanoid then
		humanoid.WalkSpeed = 0
		humanoid.PlatformStand = true
	end
	task.delay(Config.LightsOut.KnockoutTime, function()
		self:WakeUp(player)
	end)
end

function Run:WakeUp(player: Player)
	if not player:GetAttribute("KnockedOut") then
		return
	end
	player:SetAttribute("KnockedOut", nil)
	local _, humanoid = character(player)
	if humanoid then
		humanoid.PlatformStand = false
		humanoid.WalkSpeed = 16
	end
	if self.Blackout then
		teleport(player, self.Station.BreakRoomSpawn)
		Remotes.notify(player, "You wake up in the break room. Your head is pounding.", "warn")
	end
end

-- Chase AI: pathfind to the nearest visible officer, catch them, ignore anyone hiding in a locker.
function Run:MonsterBrain(monster: Model)
	local humanoid = monster:FindFirstChildOfClass("Humanoid")
	local root = monster:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not humanoid or not root then
		return
	end
	local wanderPoints = { self.Station.BreakRoomSpawn.Position }
	for _, lane in self.Station.Lanes do
		table.insert(wanderPoints, lane.OfficerSpawn.Position)
		table.insert(wanderPoints, lane.Points.Queue.Position)
	end
	for _, breaker in self.Station.Breakers do
		table.insert(wanderPoints, (breaker.Base * CFrame.new(0, 0, -4)).Position)
	end
	local rng = Random.new()
	while monster.Parent and self.Blackout and not self.Ended do
		if (monster:GetAttribute("StunnedUntil") or 0) > os.clock() then
			humanoid:MoveTo(root.Position)
			task.wait(0.2)
			continue
		end
		-- Pick a target
		local target, best = nil, math.huge
		for _, player in self:ActivePlayers() do
			local _, _, hrp = character(player)
			if hrp and not player:GetAttribute("Hidden") and not player:GetAttribute("KnockedOut") then
				local d = (hrp.Position - root.Position).Magnitude
				if d < best then
					target, best = hrp, d
				end
			end
		end
		local goal = if target then target.Position else wanderPoints[rng:NextInteger(1, #wanderPoints)]
		humanoid.WalkSpeed = if target and best < 40 then Config.LightsOut.MonsterSpeed else Config.LightsOut.MonsterSpeed * 0.6
		local path = PathfindingService:CreatePath({ AgentRadius = 2.5, AgentHeight = 8, AgentCanJump = false })
		local ok = pcall(function()
			path:ComputeAsync(root.Position, goal)
		end)
		local waypoints = if ok and path.Status == Enum.PathStatus.Success then path:GetWaypoints() else {}
		local function tryCatch()
			for _, player in self:ActivePlayers() do
				local _, _, hrp = character(player)
				if
					hrp
					and not player:GetAttribute("Hidden")
					and not player:GetAttribute("KnockedOut")
					and (hrp.Position - root.Position).Magnitude < Config.LightsOut.CatchDistance * 1.45
				then
					self:Knockout(player, monster)
				end
			end
		end
		if #waypoints == 0 then
			humanoid:MoveTo(goal)
			for _ = 1, 4 do
				task.wait(0.1)
				tryCatch()
			end
		else
			local started = os.clock()
			for i = 2, math.min(#waypoints, 7) do
				if not monster.Parent or not self.Blackout then
					return
				end
				if (monster:GetAttribute("StunnedUntil") or 0) > os.clock() then
					break
				end
				humanoid:MoveTo(waypoints[i].Position)
				local reached = false
				local conn = humanoid.MoveToFinished:Once(function()
					reached = true
				end)
				local t0 = os.clock()
				while not reached and os.clock() - t0 < 1 do
					task.wait(0.1)
					tryCatch()
				end
				conn:Disconnect()
				-- Re-plan often when chasing
				if target and os.clock() - started > 1.2 then
					break
				end
			end
		end
	end
end

-- A player's taser shot.
function Run:Taser(player: Player, aim: Vector3)
	local _, _, hrp = character(player)
	if not hrp or typeof(aim) ~= "Vector3" then
		return
	end
	local last = player:GetAttribute("TaserAt") or 0
	if os.clock() - last < Config.LightsOut.TaserCooldown then
		return
	end
	player:SetAttribute("TaserAt", os.clock())
	local origin = hrp.Position + Vector3.new(0, 1.5, 0)
	local direction = (aim - origin)
	if direction.Magnitude < 0.1 then
		return
	end
	direction = direction.Unit * Config.LightsOut.TaserRange
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { player.Character :: Instance }
	local hit = workspace:Spherecast(origin, 1.2, direction, params)
	local endPos = if hit then hit.Position else origin + direction
	for _, p in self.Members do
		Remotes.Sfx:FireClient(p, "Taser", endPos, origin)
	end
	if not hit then
		return
	end
	local model = hit.Instance:FindFirstAncestorOfClass("Model")
	while model and model.Parent and model.Parent:IsA("Model") do
		model = model.Parent :: Model
	end
	if not model then
		return
	end
	if model:GetAttribute("Monster") then
		model:SetAttribute("StunnedUntil", os.clock() + Config.LightsOut.TaserStun)
		Remotes.notify(player, "⚡ Stunned it! RUN!", "success")
	else
		local victim = Players:GetPlayerFromCharacter(model)
		if victim and victim ~= player then
			local humanoid = model:FindFirstChildOfClass("Humanoid")
			if humanoid then
				humanoid.PlatformStand = true
				task.delay(2, function()
					if not victim:GetAttribute("KnockedOut") then
						humanoid.PlatformStand = false
					end
				end)
			end
			Remotes.notify(victim, "⚡ " .. player.DisplayName .. " tased you!", "warn")
		end
	end
end

-- Pays one player and sends them back to the lobby.
function Run:FinishPlayer(lane, survived: boolean, why: string?)
	if lane.Finished then
		return
	end
	lane.Finished = true
	local player = lane.Player
	if not player.Parent then
		return
	end
	local perfect = survived and lane.Wrong == 0 and lane.Correct > 0
	local pay = lane.Correct * Config.Shift.PayCorrect + (if perfect then Config.Shift.PayPerfectBonus else 0)
	if not survived then
		pay = math.floor(pay / 2)
	end
	local cashGiven = DataService.AddCash(player, pay, true)
	local candyGiven = 0
	local data = DataService.Get(player)
	if survived and data then
		candyGiven = DataService.AddCandy(player, Config.CandyPerShift + (if perfect then Config.CandyPerfectBonus else 0), true)
		data.NextShift = math.max(data.NextShift, self.Shift + 1)
		data.BestShift = math.max(data.BestShift, self.Shift)
		data.Correct += lane.Correct
		if perfect then
			data.PerfectShifts += 1
		end
		DataService.Sync(player)
	end
	Remotes.Results:FireClient(player, {
		Shift = self.Shift,
		Survived = survived,
		Why = why,
		Correct = lane.Correct,
		Wrong = lane.Wrong,
		Perfect = perfect,
		Cash = cashGiven,
		Candy = candyGiven,
		Escaped = #self.Escaped,
		Log = lane.Log,
		NextShift = if data then data.NextShift else self.Shift,
	})
	Remotes.ShiftState:FireClient(player, nil)
	Remotes.Objective:FireClient(player, nil)
	Remotes.Blackout:FireClient(player, { Active = false })
	Run.ByPlayer[player] = nil
	PlayerService.Unhide(player)
	player:SetAttribute("Stress", 0)
	player:SetAttribute("InShift", nil)
	player:SetAttribute("Lane", nil)
	player:SetAttribute("Hidden", nil)
	player:SetAttribute("KnockedOut", nil)
	player:SetAttribute("Waypoint", nil)
	removeTaser(player)
	local char, humanoid = character(player)
	if char then
		SkinLook.Clear(char)
	end
	if humanoid then
		humanoid.PlatformStand = false
		humanoid.WalkSpeed = 16
	end
	if self.OnReturn then
		self.OnReturn(player)
	end
end

function Run:End(survived: boolean)
	if self.Ended then
		return
	end
	self.Ended = true
	self.Blackout = false
	for _, lane in self.Lanes do
		self:FinishPlayer(lane, survived and not lane.Fired, if lane.Fired then "fired" elseif survived then nil else "blackout")
	end
	-- Reset the station for the next party
	for _, conn in self.Connections do
		conn:Disconnect()
	end
	self:SetPower(true)
	for _, lane in self.Station.Lanes do
		for _, prompt in lane.Prompts do
			prompt.Enabled = false
		end
		lane.PassportProp.Transparency = 1
		lane.SignLabel.Text = "LANE " .. lane.Index .. "  ·  CLOSED"
		lane.XRayLabel.Text = "X-RAY\nWAITING"
		lane.ScanLabel.Text = "BODY SCAN\nWAITING"
		lane.ScanLight.Color = Color3.fromRGB(90, 200, 255)
	end
	for _, room in self.Station.Interrogation do
		for _, prompt in room.Prompts do
			prompt.Enabled = false
		end
		room.BrainLabel.Text = "NEURO-SCAN\nIDLE"
	end
	for _, breaker in self.Station.Breakers do
		breaker.Prompt.Enabled = false
		breaker.Light.Color = Color3.fromRGB(255, 40, 40)
		breaker.Lever.CFrame = breaker.Base * CFrame.new(0, 4.6, -0.6) * CFrame.Angles(math.rad(40), 0, 0)
	end
	self.Folder:Destroy()
	if self.OnEnd then
		self.OnEnd(self)
	end
end

-- Remote helpers used by Main
function Run.ForPlayer(player: Player)
	local run = Run.ByPlayer[player]
	if not run then
		return nil, nil
	end
	for _, lane in run.Lanes do
		if lane.Player == player then
			return run, lane
		end
	end
	return run, nil
end

function Run.CanUse(prompt: ProximityPrompt, player: Player): boolean
	return canUse(prompt, player)
end

return Run
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">SkinLook</string>
          <string name="Source"><![CDATA[-- Dresses an R15 character (or a lobby mannequin with R15 part names) in an officer skin made of parts.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local SkinLook = {}

local function find(key: string)
	for _, skin in Config.Skins do
		if skin.Key == key then
			return skin
		end
	end
	return Config.Skins[1]
end
SkinLook.Find = find

local function weld(part: BasePart, to: BasePart, offset: CFrame)
	part.Anchored = false
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Massless = true
	part.CFrame = to.CFrame * offset
	local w = Instance.new("WeldConstraint")
	w.Part0 = to
	w.Part1 = part
	w.Parent = part
end

local function piece(
	folder: Instance,
	to: BasePart?,
	size: Vector3,
	offset: CFrame,
	color: Color3,
	material: Enum.Material?,
	shape: Enum.PartType?
)
	if not to then
		return nil
	end
	local p = Instance.new("Part")
	p.Size = size
	p.Color = color
	p.Material = material or Enum.Material.Fabric
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if shape then
		p.Shape = shape
	end
	p.Parent = folder
	weld(p, to, offset)
	return p
end

local HATS = {}
function HATS.Cap(f, head, skin)
	piece(f, head, Vector3.new(1.35, 0.45, 1.35), CFrame.new(0, 0.62, 0), skin.Coat)
	piece(f, head, Vector3.new(1.3, 0.1, 0.7), CFrame.new(0, 0.42, -0.75), skin.Coat:Lerp(Color3.new(), 0.4))
	piece(f, head, Vector3.new(0.35, 0.3, 0.05), CFrame.new(0, 0.66, -0.68), skin.Trim, Enum.Material.Metal)
end
function HATS.Peaked(f, head, skin)
	piece(
		f,
		head,
		Vector3.new(0.35, 1.7, 1.7),
		CFrame.new(0, 0.85, 0) * CFrame.Angles(0, 0, math.pi / 2),
		skin.Coat,
		nil,
		Enum.PartType.Cylinder
	)
	piece(f, head, Vector3.new(1.3, 0.3, 1.3), CFrame.new(0, 0.6, 0), skin.Coat)
	piece(f, head, Vector3.new(1.35, 0.12, 1.35), CFrame.new(0, 0.62, 0), skin.Trim, Enum.Material.Metal)
	piece(
		f,
		head,
		Vector3.new(1.3, 0.1, 0.6),
		CFrame.new(0, 0.45, -0.75) * CFrame.Angles(math.rad(-12), 0, 0),
		Color3.fromRGB(20, 20, 20),
		Enum.Material.SmoothPlastic
	)
end
function HATS.Ushanka(f, head, skin)
	piece(f, head, Vector3.new(1.5, 0.6, 1.5), CFrame.new(0, 0.6, 0.05), Color3.fromRGB(240, 240, 240), Enum.Material.Fabric)
	for _, x in { -0.78, 0.78 } do
		piece(f, head, Vector3.new(0.18, 0.8, 1), CFrame.new(x, 0.05, 0.05), Color3.fromRGB(240, 240, 240), Enum.Material.Fabric)
	end
	piece(f, head, Vector3.new(0.4, 0.4, 0.05), CFrame.new(0, 0.65, -0.73), skin.Trim, Enum.Material.Metal)
end
function HATS.PlagueMask(f, head, skin)
	piece(
		f,
		head,
		Vector3.new(1.25, 1.25, 1.25),
		CFrame.new(0, 0, 0),
		Color3.fromRGB(26, 24, 22),
		Enum.Material.Leather,
		Enum.PartType.Ball
	)
	local beak = Instance.new("WedgePart")
	beak.Size = Vector3.new(0.5, 0.6, 1.4)
	beak.Color = Color3.fromRGB(30, 28, 26)
	beak.Material = Enum.Material.Leather
	beak.Parent = f
	weld(beak, head, CFrame.new(0, -0.25, -1.1) * CFrame.Angles(0, math.pi, 0))
	for _, x in { -0.28, 0.28 } do
		piece(
			f,
			head,
			Vector3.new(0.35, 0.35, 0.1),
			CFrame.new(x, 0.12, -0.6),
			Color3.fromRGB(200, 230, 255),
			Enum.Material.Glass,
			Enum.PartType.Ball
		)
	end
	piece(
		f,
		head,
		Vector3.new(0.12, 2.4, 2.4),
		CFrame.new(0, 0.65, 0) * CFrame.Angles(0, 0, math.pi / 2),
		skin.Coat,
		Enum.Material.Leather,
		Enum.PartType.Cylinder
	)
	piece(f, head, Vector3.new(1.3, 0.8, 1.3), CFrame.new(0, 1.05, 0), skin.Coat, Enum.Material.Leather)
end
function HATS.Pumpkin(f, head, _skin)
	local p = piece(
		f,
		head,
		Vector3.new(1.9, 1.6, 1.9),
		CFrame.new(0, 0.1, 0),
		Color3.fromRGB(255, 130, 20),
		Enum.Material.SmoothPlastic,
		Enum.PartType.Ball
	)
	local _ = p
	piece(f, head, Vector3.new(0.2, 0.4, 0.2), CFrame.new(0, 1, 0), Color3.fromRGB(60, 90, 30))
	for _, x in { -0.35, 0.35 } do
		piece(f, head, Vector3.new(0.3, 0.3, 0.05), CFrame.new(x, 0.25, -0.92), Color3.fromRGB(255, 220, 80), Enum.Material.Neon)
	end
	piece(f, head, Vector3.new(0.9, 0.2, 0.05), CFrame.new(0, -0.25, -0.93), Color3.fromRGB(255, 220, 80), Enum.Material.Neon)
end
function HATS.Witch(f, head, skin)
	piece(
		f,
		head,
		Vector3.new(0.1, 2.6, 2.6),
		CFrame.new(0, 0.55, 0) * CFrame.Angles(0, 0, math.pi / 2),
		skin.Coat,
		Enum.Material.Fabric,
		Enum.PartType.Cylinder
	)
	for i = 0, 3 do
		local s = 1.25 - i * 0.28
		piece(f, head, Vector3.new(s, 0.45, s), CFrame.new(0, 0.85 + i * 0.4, 0.05 * i) * CFrame.Angles(math.rad(-6 * i), 0, 0), skin.Coat)
	end
	piece(f, head, Vector3.new(1.3, 0.18, 1.3), CFrame.new(0, 0.7, 0), skin.Trim, Enum.Material.Neon)
end
function HATS.Fangs(f, head, skin)
	-- Slicked hair and a tall collar
	piece(f, head, Vector3.new(1.25, 0.35, 1.25), CFrame.new(0, 0.58, 0.05), Color3.fromRGB(10, 10, 12), Enum.Material.SmoothPlastic)
	local spike = Instance.new("WedgePart")
	spike.Size = Vector3.new(0.3, 0.25, 0.4)
	spike.Color = Color3.fromRGB(10, 10, 12)
	spike.Parent = f
	weld(spike, head, CFrame.new(0, 0.45, -0.55) * CFrame.Angles(math.pi, 0, 0))
	for _, x in { -0.18, 0.18 } do
		piece(f, head, Vector3.new(0.08, 0.16, 0.05), CFrame.new(x, -0.3, -0.6), Color3.new(1, 1, 1), Enum.Material.SmoothPlastic)
	end
	piece(
		f,
		head,
		Vector3.new(2.2, 1.4, 0.15),
		CFrame.new(0, -0.3, 0.6) * CFrame.Angles(math.rad(-10), 0, 0),
		skin.Trim,
		Enum.Material.Fabric
	)
end
function HATS.Hood(f, head, skin)
	piece(f, head, Vector3.new(1.55, 1.6, 1.55), CFrame.new(0, 0.15, 0.12), skin.Coat, Enum.Material.Fabric, Enum.PartType.Ball)
	piece(f, head, Vector3.new(1.0, 1.0, 0.1), CFrame.new(0, -0.05, -0.58), Color3.fromRGB(5, 8, 14), Enum.Material.SmoothPlastic)
	for _, x in { -0.22, 0.22 } do
		piece(f, head, Vector3.new(0.18, 0.12, 0.05), CFrame.new(x, 0.08, -0.65), skin.Trim, Enum.Material.Neon)
	end
end

-- Remove any skin we added before.
function SkinLook.Clear(model: Model)
	local old = model:FindFirstChild("SkinParts")
	if old then
		old:Destroy()
	end
end

function SkinLook.Apply(model: Model, key: string)
	SkinLook.Clear(model)
	local skin = find(key)
	local folder = Instance.new("Folder")
	folder.Name = "SkinParts"
	folder.Parent = model
	local upper = model:FindFirstChild("UpperTorso") :: BasePart?
	local lower = model:FindFirstChild("LowerTorso") :: BasePart?
	local head = model:FindFirstChild("Head") :: BasePart?
	if not upper then
		return
	end
	local us = upper.Size
	-- Coat over the torso
	piece(folder, upper, us + Vector3.new(0.14, 0.1, 0.14), CFrame.new(0, 0, 0), skin.Coat)
	if lower then
		piece(folder, lower, lower.Size + Vector3.new(0.16, 0.2, 0.16), CFrame.new(0, 0.05, 0), skin.Coat)
		piece(
			folder,
			lower,
			Vector3.new(lower.Size.X + 0.2, 0.18, lower.Size.Z + 0.2),
			CFrame.new(0, 0.2, 0),
			Color3.fromRGB(26, 22, 20),
			Enum.Material.Leather
		)
		piece(folder, lower, Vector3.new(0.3, 0.22, 0.05), CFrame.new(0, 0.2, -lower.Size.Z / 2 - 0.11), skin.Trim, Enum.Material.Metal)
	end
	-- Collar, trim stripe, badge, shoulder boards
	piece(folder, upper, Vector3.new(us.X * 0.55, 0.22, us.Z + 0.2), CFrame.new(0, us.Y / 2, 0), skin.Coat:Lerp(Color3.new(), 0.3))
	piece(folder, upper, Vector3.new(0.12, us.Y, 0.05), CFrame.new(0, 0, -us.Z / 2 - 0.09), skin.Trim, Enum.Material.SmoothPlastic)
	piece(
		folder,
		upper,
		Vector3.new(0.32, 0.38, 0.05),
		CFrame.new(-us.X * 0.26, us.Y * 0.18, -us.Z / 2 - 0.1),
		skin.Trim,
		Enum.Material.Metal
	)
	for _, side in { -1, 1 } do
		piece(
			folder,
			upper,
			Vector3.new(0.5, 0.08, 0.6),
			CFrame.new(side * us.X * 0.42, us.Y / 2 + 0.06, 0),
			skin.Trim,
			Enum.Material.Metal
		)
	end
	for _, name in { "LeftUpperArm", "RightUpperArm", "LeftLowerArm", "RightLowerArm" } do
		local arm = model:FindFirstChild(name) :: BasePart?
		if arm then
			piece(folder, arm, arm.Size + Vector3.new(0.1, 0.02, 0.1), CFrame.new(), skin.Coat)
		end
	end
	local leftLower = model:FindFirstChild("LeftLowerArm") :: BasePart?
	if leftLower then
		piece(
			folder,
			leftLower,
			Vector3.new(leftLower.Size.X + 0.14, 0.12, leftLower.Size.Z + 0.14),
			CFrame.new(0, -leftLower.Size.Y * 0.3, 0),
			skin.Trim
		)
	end
	if head and HATS[skin.Hat] then
		HATS[skin.Hat](folder, head, skin)
	end
end

-- A standing mannequin with R15 part names (no Humanoid), so Apply works on it.
function SkinLook.Mannequin(parent: Instance, cf: CFrame, key: string): Model
	local m = Instance.new("Model")
	m.Name = "Mannequin"
	local skinTone = Color3.fromRGB(234, 196, 164)
	local function part(name, size, offset, color)
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size
		p.CFrame = cf * offset
		p.Color = color
		p.Anchored = true
		p.Material = Enum.Material.SmoothPlastic
		p.Parent = m
		return p
	end
	part("LeftLowerLeg", Vector3.new(0.9, 1.6, 0.9), CFrame.new(-0.5, 0.8, 0), Color3.fromRGB(30, 30, 36))
	part("RightLowerLeg", Vector3.new(0.9, 1.6, 0.9), CFrame.new(0.5, 0.8, 0), Color3.fromRGB(30, 30, 36))
	part("LeftUpperLeg", Vector3.new(0.9, 1.2, 0.9), CFrame.new(-0.5, 2.2, 0), Color3.fromRGB(34, 36, 44))
	part("RightUpperLeg", Vector3.new(0.9, 1.2, 0.9), CFrame.new(0.5, 2.2, 0), Color3.fromRGB(34, 36, 44))
	part("LowerTorso", Vector3.new(2, 0.6, 1), CFrame.new(0, 3.1, 0), Color3.fromRGB(34, 36, 44))
	part("UpperTorso", Vector3.new(2, 1.6, 1), CFrame.new(0, 4.2, 0), Color3.fromRGB(34, 36, 44))
	part("LeftUpperArm", Vector3.new(0.9, 1.2, 0.9), CFrame.new(-1.45, 4.35, 0), skinTone)
	part("RightUpperArm", Vector3.new(0.9, 1.2, 0.9), CFrame.new(1.45, 4.35, 0), skinTone)
	part("LeftLowerArm", Vector3.new(0.85, 1.1, 0.85), CFrame.new(-1.45, 3.2, 0), skinTone)
	part("RightLowerArm", Vector3.new(0.85, 1.1, 0.85), CFrame.new(1.45, 3.2, 0), skinTone)
	local head = part("Head", Vector3.new(1.2, 1.2, 1.2), CFrame.new(0, 5.65, 0), skinTone)
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Head
	mesh.Scale = Vector3.new(1.25, 1.25, 1.25)
	mesh.Parent = head
	local face = Instance.new("Decal")
	face.Texture = "rbxasset://textures/face.png"
	face.Face = Enum.NormalId.Front
	face.Parent = head
	m.PrimaryPart = head
	m.Parent = parent
	SkinLook.Apply(m, key)
	for _, p in m:GetDescendants() do
		if p:IsA("BasePart") then
			p.Anchored = true
		end
	end
	return m
end

return SkinLook
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">StationBuilder</string>
          <string name="Source"><![CDATA[-- Builds one Frostline checkpoint station: 4 inspection lanes, back rooms, and the snowy train platform.
-- Returns a table of markers (spawn points, passenger paths, prompts) used by the shift logic.
local CollectionService = game:GetService("CollectionService")

local Build = require(script.Parent.Build)

local StationBuilder = {}

local C = {
	Wall = Color3.fromRGB(206, 200, 186),
	WallDark = Color3.fromRGB(150, 146, 136),
	Stripe = Color3.fromRGB(32, 54, 120),
	Floor = Color3.fromRGB(70, 82, 112),
	FloorOfficer = Color3.fromRGB(96, 100, 110),
	Ceiling = Color3.fromRGB(214, 216, 222),
	Counter = Color3.fromRGB(116, 120, 138),
	CounterTop = Color3.fromRGB(176, 180, 192),
	Metal = Color3.fromRGB(160, 166, 176),
	DarkMetal = Color3.fromRGB(46, 48, 56),
	Glass = Color3.fromRGB(190, 220, 235),
	Screen = Color3.fromRGB(16, 30, 26),
	Wood = Color3.fromRGB(110, 78, 52),
	Snow = Color3.fromRGB(236, 242, 250),
	Locker = Color3.fromRGB(150, 40, 40),
	Seat = Color3.fromRGB(40, 90, 190),
	Orange = Color3.fromRGB(255, 130, 20),
	Purple = Color3.fromRGB(110, 50, 170),
}

local LANE_X = { -36, -12, 12, 36 }
local HALL = { X0 = -50, X1 = 50, Z0 = -42, Z1 = 54, H = 16 }

local function addPrompt(parent, action, object, hold, distance)
	local prompt = Build.prompt(parent, action, object, hold, distance or 7)
	prompt.Enabled = false
	return prompt
end

local function monitor(parent: Instance, cf: CFrame, width: number, height: number, title: string): (Part, TextLabel)
	Build.part(parent, Vector3.new(0.4, 1, 0.4), cf * CFrame.new(0, -height / 2 - 0.5, 0.2), C.DarkMetal)
	Build.part(parent, Vector3.new(1.4, 0.15, 0.9), cf * CFrame.new(0, -height / 2 - 1, 0.2), C.DarkMetal)
	Build.part(parent, Vector3.new(width + 0.3, height + 0.3, 0.3), cf * CFrame.new(0, 0, 0.12), C.DarkMetal)
	local screen = Build.part(parent, Vector3.new(width, height, 0.1), cf, C.Screen, Enum.Material.Neon)
	screen.Transparency = 0.05
	local label = Build.label(screen, Enum.NormalId.Front, title, Color3.fromRGB(90, 255, 160), Enum.Font.Code)
	CollectionService:AddTag(screen, "PowerScreen")
	return screen, label
end

local function locker(parent: Instance, cf: CFrame, color: Color3): (Model, ProximityPrompt)
	local m = Build.model(parent, "Locker")
	local pro = Build.swap(m, "Locker", cf, Vector3.new(3, 7.4, 2.6))
	local body
	if pro then
		body = Build.ghost(m, Vector3.new(3, 7.4, 2.6), cf * CFrame.new(0, 3.7, 0))
	else
		body = Build.part(m, Vector3.new(3, 7.4, 2.6), cf * CFrame.new(0, 3.7, 0), color, Enum.Material.Metal)
		body.CanCollide = true
		local door =
			Build.part(m, Vector3.new(2.7, 7, 0.12), cf * CFrame.new(0, 3.7, -1.32), color:Lerp(Color3.new(), 0.15), Enum.Material.Metal)
		door.Name = "Door"
		for i = 0, 4 do
			Build.part(m, Vector3.new(1.6, 0.12, 0.06), cf * CFrame.new(0, 6.4 - i * 0.28, -1.4), Color3.fromRGB(20, 20, 20))
		end
		Build.part(m, Vector3.new(0.12, 0.6, 0.12), cf * CFrame.new(1, 3.8, -1.42), C.Metal, Enum.Material.Metal)
	end
	local hide = Instance.new("Attachment")
	hide.Name = "HidePoint"
	hide.CFrame = CFrame.new(0, -0.6, 0.2) * CFrame.Angles(0, math.pi, 0)
	hide.Parent = body
	body.Name = "Body"
	m.PrimaryPart = body
	local prompt = Build.prompt(body, "Hide", "Locker", 0, 6)
	CollectionService:AddTag(m, "HideLocker")
	return m, prompt
end

local function chairRow(parent: Instance, cf: CFrame, seats: number)
	if Build.swap(parent, "WaitingChairs", cf, Vector3.new(seats * 2.4, 4.2, 2.4)) then
		return
	end
	for i = 0, seats - 1 do
		local s = cf * CFrame.new((i - (seats - 1) / 2) * 2.4, 0, 0)
		Build.part(parent, Vector3.new(2.1, 0.4, 2), s * CFrame.new(0, 1.8, 0), C.Seat)
		Build.part(parent, Vector3.new(2.1, 2.2, 0.35), s * CFrame.new(0, 3, 0.95) * CFrame.Angles(math.rad(-8), 0, 0), C.Seat)
	end
	local len = seats * 2.4
	Build.part(parent, Vector3.new(len, 0.3, 0.3), cf * CFrame.new(0, 1.4, 0), C.Metal, Enum.Material.Metal)
	for _, x in { -len / 2 + 0.6, len / 2 - 0.6 } do
		Build.part(parent, Vector3.new(0.3, 1.4, 1.6), cf * CFrame.new(x, 0.7, 0), C.Metal, Enum.Material.Metal)
	end
end

local function stanchion(parent: Instance, a: Vector3, b: Vector3)
	for _, p in { a, b } do
		if Build.swap(parent, "Stanchion", CFrame.new(p), Vector3.new(1, 3.2, 1)) then
			continue
		end
		Build.part(parent, Vector3.new(1, 0.2, 1), CFrame.new(p + Vector3.new(0, 0.1, 0)), C.Metal, Enum.Material.Metal)
		Build.cyl(parent, 3, 0.3, CFrame.new(p + Vector3.new(0, 1.6, 0)) * CFrame.Angles(0, 0, math.pi / 2), C.Metal, Enum.Material.Metal)
	end
	local mid = (a + b) / 2 + Vector3.new(0, 2.8, 0)
	local belt = Build.part(
		parent,
		Vector3.new(0.12, 0.25, (b - a).Magnitude),
		CFrame.lookAt(mid, b + Vector3.new(0, 2.8, 0)),
		Color3.fromRGB(30, 40, 90)
	)
	belt.CanCollide = false
end

local function poster(parent: Instance, cf: CFrame, size: Vector2, text: string, bg: Color3, fg: Color3)
	local p = Build.part(parent, Vector3.new(size.X, size.Y, 0.1), cf, bg)
	Build.label(p, Enum.NormalId.Front, text, fg, Enum.Font.GothamBold, bg)
	Build.part(parent, Vector3.new(size.X + 0.3, size.Y + 0.3, 0.08), cf * CFrame.new(0, 0, 0.06), Color3.fromRGB(30, 30, 30))
end

local function garland(parent: Instance, a: Vector3, b: Vector3, flags: number)
	local colors = { C.Orange, C.Purple, Color3.fromRGB(20, 20, 24) }
	for i = 1, flags do
		local t = (i - 0.5) / flags
		local sag = math.sin(t * math.pi) * 1.2
		local p = a:Lerp(b, t) - Vector3.new(0, sag, 0)
		local flag = Build.wedge(
			parent,
			Vector3.new(0.08, 1, 0.8),
			CFrame.lookAt(p, p + (b - a).Unit) * CFrame.Angles(0, math.pi / 2, math.pi),
			colors[i % 3 + 1]
		)
		flag.CanCollide = false
	end
end

local function pumpkin(parent: Instance, cf: CFrame, size: number)
	if Build.swap(parent, "Pumpkin", cf, Vector3.new(size * 1.3, size * 1.3, size * 1.3)) then
		return
	end
	local p = Build.ball(parent, size, cf * CFrame.new(0, size * 0.4, 0), C.Orange, Enum.Material.SmoothPlastic)
	p.Size = Vector3.new(size * 1.15, size * 0.85, size * 1.15)
	p.Shape = Enum.PartType.Ball
	Build.part(parent, Vector3.new(0.18, 0.4, 0.18) * size, cf * CFrame.new(0, size * 0.9, 0), Color3.fromRGB(60, 90, 30))
	local face = Build.part(
		parent,
		Vector3.new(size * 0.6, size * 0.25, 0.05),
		cf * CFrame.new(0, size * 0.38, -size * 0.56),
		Color3.fromRGB(255, 200, 60),
		Enum.Material.Neon
	)
	face.CanCollide = false
	Build.pointLight(face, Color3.fromRGB(255, 150, 40), 8, 1.2)
end

-- Builds the hall shell (floor, walls, ceiling, windows).
local function buildShell(m: Model, o: CFrame)
	local w = HALL.X1 - HALL.X0
	local d = HALL.Z1 - HALL.Z0
	local cx = (HALL.X0 + HALL.X1) / 2
	local cz = (HALL.Z0 + HALL.Z1) / 2
	-- Floors: passenger hall (blue carpet tiles), officer area and back rooms (grey)
	Build.part(m, Vector3.new(w, 1, HALL.Z1), o * CFrame.new(cx, -0.5, HALL.Z1 / 2), C.Floor, Enum.Material.Fabric)
	Build.part(m, Vector3.new(w, 1, -HALL.Z0), o * CFrame.new(cx, -0.5, HALL.Z0 / 2), C.FloorOfficer, Enum.Material.Concrete)
	local ceiling = Build.part(m, Vector3.new(w, 1, d), o * CFrame.new(cx, HALL.H + 0.5, cz), C.Ceiling, Enum.Material.SmoothPlastic)
	ceiling.Name = "Ceiling"
	-- Ceiling tile grid
	for x = HALL.X0 + 6, HALL.X1 - 6, 6 do
		Build.part(m, Vector3.new(0.15, 0.1, d), o * CFrame.new(x, HALL.H - 0.02, cz), C.WallDark)
	end
	for z = HALL.Z0 + 6, HALL.Z1 - 6, 6 do
		Build.part(m, Vector3.new(w, 0.1, 0.15), o * CFrame.new(cx, HALL.H - 0.02, z), C.WallDark)
	end
	-- Outer walls (front wall has the entrance; east wall has the platform door; windows on the east)
	local function wallRun(a: Vector3, b: Vector3, gaps)
		-- gaps: list of {from, to} distances along the wall that stay open (doorways, height 9)
		local dir = (b - a).Unit
		local len = (b - a).Magnitude
		local cursor = 0
		table.sort(gaps, function(g1, g2)
			return g1[1] < g2[1]
		end)
		for _, gap in gaps do
			if gap[1] > cursor then
				Build.wall(m, o * (a + dir * cursor), o * (a + dir * gap[1]), HALL.H, 1, C.Wall, Enum.Material.Plaster)
			end
			-- lintel above the doorway
			local la, lb = o * (a + dir * gap[1] + Vector3.new(0, 9, 0)), o * (a + dir * gap[2] + Vector3.new(0, 9, 0))
			local lintel = Build.wall(m, la, lb, HALL.H - 9, 1, C.Wall, Enum.Material.Plaster)
			lintel.Name = "Lintel"
			cursor = gap[2]
		end
		if cursor < len then
			Build.wall(m, o * (a + dir * cursor), o * b, HALL.H, 1, C.Wall, Enum.Material.Plaster)
		end
		-- Navy stripe and skirting
		local inward = Vector3.new(dir.Z, 0, -dir.X)
		for _, y in { 4.4 } do
			local s = Build.wall(
				m,
				o * (a + Vector3.new(0, y, 0) + inward * 0.55),
				o * (b + Vector3.new(0, y, 0) + inward * 0.55),
				0.8,
				0.1,
				C.Stripe
			)
			s.CanCollide = false
		end
	end
	wallRun(Vector3.new(HALL.X0, 0, HALL.Z1), Vector3.new(HALL.X1, 0, HALL.Z1), { { 44, 56 } }) -- entrance
	wallRun(Vector3.new(HALL.X1, 0, HALL.Z1), Vector3.new(HALL.X1, 0, HALL.Z0), { { 18, 26 }, { 58, 63 } }) -- platform door + staff door
	wallRun(Vector3.new(HALL.X1, 0, HALL.Z0), Vector3.new(HALL.X0, 0, HALL.Z0), {})
	wallRun(Vector3.new(HALL.X0, 0, HALL.Z0), Vector3.new(HALL.X0, 0, HALL.Z1), { { 24, 28 }, { 69, 75 } }) -- interrogation wing doors

	-- Entrance doors (glass, open frame) and canopy outside
	for _, x in { -6, 6 } do
		Build.part(m, Vector3.new(0.6, 9, 1.2), o * CFrame.new(x, 4.5, HALL.Z1), C.DarkMetal, Enum.Material.Metal)
	end
	local sign = Build.part(m, Vector3.new(26, 3, 0.4), o * CFrame.new(0, 12, HALL.Z1 + 0.8), Color3.fromRGB(20, 30, 70))
	Build.label(sign, Enum.NormalId.Back, "FROSTLINE BORDER CHECKPOINT", Color3.fromRGB(240, 245, 255), Enum.Font.GothamBlack)
	Build.label(sign, Enum.NormalId.Front, "SECURITY CHECK  ·  ALL PASSENGERS", Color3.fromRGB(240, 245, 255), Enum.Font.GothamBlack)

	-- East windows looking at the train
	for z = -6, 46, 13 do
		if not (z > 26 and z < 38) then
			local glass = Build.part(m, Vector3.new(1.2, 5, 8), o * CFrame.new(HALL.X1, 8, z), C.Glass, Enum.Material.Glass)
			glass.Transparency = 0.6
		end
	end
	-- Pillars
	for _, x in { -24, 0, 24 } do
		for _, z in { 36 } do
			Build.part(m, Vector3.new(2.2, HALL.H, 2.2), o * CFrame.new(x, HALL.H / 2, z), C.Wall, Enum.Material.Plaster)
			Build.part(m, Vector3.new(2.4, 0.8, 2.4), o * CFrame.new(x, 4.4, z), C.Stripe)
		end
	end
end

-- One inspection lane. Returns its markers.
local function buildLane(m: Model, o: CFrame, index: number, L: number)
	local lane = Build.model(m, "Lane" .. index)
	local function at(x, y, z)
		return o * CFrame.new(L + x, y, z)
	end
	local markers = { Index = index, Prompts = {} }

	-- Counter (full lane width) with glass and a service slot
	Build.part(lane, Vector3.new(24, 3.4, 2.4), at(0, 1.7, 0), C.Counter, Enum.Material.SmoothPlastic)
	Build.part(lane, Vector3.new(24.2, 0.25, 2.8), at(0, 3.5, 0), C.CounterTop, Enum.Material.Marble)
	Build.part(lane, Vector3.new(24, 0.6, 0.1), at(0, 2.2, 1.22), C.Stripe)
	for _, seg in { { -12, -3 }, { 1, 12 } } do
		local glass =
			Build.part(lane, Vector3.new(seg[2] - seg[1], 6.2, 0.2), at((seg[1] + seg[2]) / 2, 6.75, 0.4), C.Glass, Enum.Material.Glass)
		glass.Transparency = 0.75
	end
	local slotGlass = Build.part(lane, Vector3.new(4, 4.4, 0.2), at(-1, 7.65, 0.4), C.Glass, Enum.Material.Glass)
	slotGlass.Transparency = 0.75
	Build.part(lane, Vector3.new(24, 0.4, 0.5), at(0, 10, 0.4), C.DarkMetal, Enum.Material.Metal)
	-- Lane sign above the window: "LANE 2 · 05 PASSENGERS LEFT"
	local signPart = Build.part(lane, Vector3.new(9, 2.2, 0.4), at(-1, 11.6, 0.4), Color3.fromRGB(10, 14, 12))
	local signLabel =
		Build.label(signPart, Enum.NormalId.Back, "LANE " .. index .. "  ·  CLOSED", Color3.fromRGB(90, 255, 120), Enum.Font.Code)
	Build.label(signPart, Enum.NormalId.Front, "LANE " .. index, Color3.fromRGB(90, 255, 120), Enum.Font.Code)
	markers.SignLabel = signLabel
	CollectionService:AddTag(signPart, "PowerScreen")

	-- ID tray in the slot (passenger slides the passport here)
	local tray = Build.part(lane, Vector3.new(2.2, 0.25, 1.6), at(-1, 3.75, 0.1), C.Metal, Enum.Material.Metal)
	tray.Name = "Tray"
	local passport = Build.part(lane, Vector3.new(0.9, 0.08, 1.2), at(-1, 3.9, 0.1), Color3.fromRGB(110, 20, 30))
	passport.Transparency = 1
	passport.Name = "PassportProp"
	markers.PassportProp = passport
	markers.Prompts.TakeID = addPrompt(tray, "Take ID", "Tray", 0, 7)

	-- Service bell (passenger side)
	Build.cyl(lane, 0.25, 1, at(-3.6, 3.75, 0.8) * CFrame.Angles(0, 0, math.pi / 2), C.DarkMetal)
	Build.ball(lane, 0.8, at(-3.6, 3.95, 0.8), C.Metal, Enum.Material.Metal)

	-- Stamps: APPROVE (green) and DENY (red)
	local function stamp(x, color, text)
		local base = Build.part(lane, Vector3.new(1, 0.5, 1), at(x, 3.85, -0.6), color)
		Build.cyl(lane, 1, 0.35, at(x, 4.5, -0.6) * CFrame.Angles(0, 0, math.pi / 2), C.Wood, Enum.Material.Wood)
		Build.ball(lane, 0.6, at(x, 5.05, -0.6), C.Wood, Enum.Material.Wood)
		local tag = Build.part(lane, Vector3.new(1.6, 0.5, 0.05), at(x, 3.95, -1.25), Color3.fromRGB(20, 20, 20))
		Build.label(tag, Enum.NormalId.Front, text, color, Enum.Font.GothamBlack)
		return base
	end
	local approve = stamp(-5, Color3.fromRGB(40, 190, 80), "APPROVE")
	local deny = stamp(-7, Color3.fromRGB(210, 40, 40), "DENY")
	markers.Prompts.Approve = addPrompt(approve, "APPROVE", "Stamp", 0.4, 6)
	markers.Prompts.Deny = addPrompt(deny, "DENY", "Stamp", 0.4, 6)
	markers.Prompts.Approve.KeyboardKeyCode = Enum.KeyCode.F
	markers.Prompts.Deny.KeyboardKeyCode = Enum.KeyCode.G

	-- Rulebook clipboard
	local clip =
		Build.part(lane, Vector3.new(1.3, 0.1, 1.7), at(-9.5, 3.7, -0.5) * CFrame.Angles(0, math.rad(12), 0), C.Wood, Enum.Material.Wood)
	Build.part(lane, Vector3.new(1.1, 0.05, 1.4), at(-9.5, 3.78, -0.45) * CFrame.Angles(0, math.rad(12), 0), Color3.fromRGB(245, 245, 235))
	markers.Prompts.Rulebook = addPrompt(clip, "Rulebook", "Today's rules", 0, 6)
	markers.Prompts.Rulebook.KeyboardKeyCode = Enum.KeyCode.R

	-- Interrogation call button (red phone)
	local phone = Build.part(lane, Vector3.new(1.2, 0.5, 0.9), at(-11, 3.9, -0.6), Color3.fromRGB(170, 20, 24))
	Build.part(lane, Vector3.new(1.3, 0.3, 0.4), at(-11, 4.3, -0.6), Color3.fromRGB(120, 10, 14))
	local phoneTag = Build.part(lane, Vector3.new(1.8, 0.45, 0.05), at(-11, 3.9, -1.08), Color3.fromRGB(20, 20, 20))
	Build.label(phoneTag, Enum.NormalId.Front, "INTERROGATION", Color3.fromRGB(255, 80, 80), Enum.Font.GothamBlack)
	markers.Prompts.Interrogate = addPrompt(phone, "Interrogate", "Send to room " .. index, 0.6, 6)
	markers.Prompts.Interrogate.KeyboardKeyCode = Enum.KeyCode.Q

	-- Thermal camera on a stand
	local thermal = Build.part(lane, Vector3.new(0.7, 0.7, 1.3), at(-8.2, 4.6, -0.3), Color3.fromRGB(230, 200, 40))
	Build.cyl(lane, 0.3, 0.55, at(-8.2, 4.6, 0.4) * CFrame.Angles(0, math.pi / 2, 0), Color3.fromRGB(20, 20, 20))
	Build.part(lane, Vector3.new(0.2, 0.9, 0.2), at(-8.2, 4, -0.3), C.DarkMetal)
	markers.Prompts.Thermal = addPrompt(thermal, "Thermal", "Camera", 0, 6)
	markers.Prompts.Thermal.KeyboardKeyCode = Enum.KeyCode.T

	-- X-ray monitor and body-scan monitor (face the officer: -Z)
	local xrayScreen, xrayLabel = monitor(lane, at(6.5, 5.4, -0.5), 2.6, 1.7, "X-RAY\nWAITING")
	markers.Prompts.XRay = addPrompt(xrayScreen, "X-Ray", "Monitor", 0, 7)
	markers.Prompts.XRay.KeyboardKeyCode = Enum.KeyCode.X
	markers.XRayLabel = xrayLabel
	local scanScreen, scanLabel = monitor(lane, at(9.6, 5.4, -0.5), 2.6, 1.7, "BODY SCAN\nWAITING")
	markers.Prompts.Skeleton = addPrompt(scanScreen, "Body Scan", "Monitor", 0, 7)
	markers.Prompts.Skeleton.KeyboardKeyCode = Enum.KeyCode.B
	markers.ScanLabel = scanLabel

	-- CCTV wall screen (left partition)
	local cctv, cctvLabel = monitor(lane, at(-11.3, 7.5, -5) * CFrame.Angles(0, -math.pi / 2, 0), 5, 3, "CAM 0" .. index .. "\n● REC")
	markers.Prompts.Camera = addPrompt(cctv, "Cameras", "CCTV", 0, 9)
	markers.Prompts.Camera.KeyboardKeyCode = Enum.KeyCode.C
	markers.CctvLabel = cctvLabel
	-- Security camera pointing at the counter
	local camBody = Build.part(
		lane,
		Vector3.new(0.8, 0.8, 1.6),
		at(-6, 13, 8) * CFrame.Angles(math.rad(-25), math.rad(160), 0),
		Color3.fromRGB(235, 235, 235)
	)
	Build.part(lane, Vector3.new(0.2, 2.6, 0.2), at(-6, 14.6, 8.4), C.DarkMetal)
	local redLed = Build.ball(lane, 0.2, camBody.CFrame * CFrame.new(0.3, 0.3, -0.8), Color3.fromRGB(255, 40, 40), Enum.Material.Neon)
	redLed.CanCollide = false

	-- Officer desk behind (PC, phone, chair)
	if not Build.swap(lane, "OfficeDesk", at(4, 0, -5.5), Vector3.new(8, 3.25, 2.6)) then
		Build.part(lane, Vector3.new(8, 0.3, 2.6), at(4, 3.1, -5.5), C.Wood, Enum.Material.WoodPlanks)
		for _, x in { 0.4, 7.6 } do
			Build.part(lane, Vector3.new(0.3, 3, 2.4), at(x, 1.5, -5.5), C.DarkMetal, Enum.Material.Metal)
		end
	end
	monitor(lane, at(4, 4.7, -6) * CFrame.Angles(0, math.pi, 0), 2.2, 1.4, "FROSTLINE OS\nLOGGED IN")
	Build.part(lane, Vector3.new(2, 0.1, 0.7), at(4, 3.3, -5), Color3.fromRGB(30, 30, 30))
	Build.part(lane, Vector3.new(0.9, 0.4, 0.6), at(6.6, 3.45, -5.3), Color3.fromRGB(20, 20, 20))
	local mug = Build.cyl(lane, 0.5, 0.4, at(1.5, 3.5, -5.2) * CFrame.Angles(0, 0, math.pi / 2), Color3.fromRGB(250, 250, 250))
	mug.CanCollide = false
	-- Office chair
	if not Build.swap(lane, "OfficeChair", at(-1, 0, -3.8) * CFrame.Angles(0, math.pi, 0), Vector3.new(2.2, 4.4, 2.2)) then
		Build.part(lane, Vector3.new(1.8, 0.4, 1.8), at(-1, 2, -3.6), Color3.fromRGB(20, 20, 24))
		Build.part(lane, Vector3.new(1.8, 2, 0.3), at(-1, 3.2, -4.5), Color3.fromRGB(20, 20, 24))
		Build.cyl(lane, 1.6, 0.3, at(-1, 1, -3.6) * CFrame.Angles(0, 0, math.pi / 2), C.Metal, Enum.Material.Metal)
	end

	-- Partition walls between lanes (officer side), with a navy stripe
	for _, x in { -12, 12 } do
		if math.abs(L + x) < 50 then
			Build.part(lane, Vector3.new(0.6, 10, 12), at(x, 5, -6), C.Wall, Enum.Material.Plaster)
			Build.part(lane, Vector3.new(0.7, 0.8, 12), at(x, 4.4, -6), C.Stripe)
		end
	end
	-- Lane booth ceiling light + officer light
	Build.ceilingLight(lane, at(-1, HALL.H - 0.2, -4), 24)
	Build.ceilingLight(lane, at(-1, HALL.H - 0.2, 6), 26)
	Build.ceilingLight(lane, at(-1, HALL.H - 0.2, 18), 26)

	-- X-ray conveyor: along Z on the passenger side at x = +7.5, from z=22 to z=3
	local beltX = 7.5
	-- The machine faces the passenger (-Z of a pro model points at the queue). Fits a 3.6 x 6.5 x 19 box.
	if not Build.swap(lane, "XRayMachine", at(beltX, 0, 12.5) * CFrame.Angles(0, math.pi, 0), Vector3.new(3.8, 6.5, 19)) then
		Build.part(lane, Vector3.new(3, 2.6, 19), at(beltX, 1.3, 12.5), C.Counter)
		local belt = Build.part(lane, Vector3.new(2.6, 0.12, 19), at(beltX, 2.66, 12.5), Color3.fromRGB(26, 26, 28), Enum.Material.Fabric)
		belt.Name = "Belt"
		-- Rollers detail
		for z = 4, 21, 1.5 do
			Build.part(lane, Vector3.new(2.7, 0.05, 0.1), at(beltX, 2.73, z), Color3.fromRGB(60, 60, 64))
		end
		-- Tunnel housing with lead curtains
		Build.part(lane, Vector3.new(3.6, 3.6, 6), at(beltX, 4.5, 12), Color3.fromRGB(220, 222, 228))
		Build.part(lane, Vector3.new(0.3, 4.2, 6), at(beltX - 1.8, 2.4, 12), Color3.fromRGB(220, 222, 228))
		Build.part(lane, Vector3.new(0.3, 4.2, 6), at(beltX + 1.8, 2.4, 12), Color3.fromRGB(220, 222, 228))
		for _, z in { 9, 15 } do
			for i = -1, 1 do
				local strip = Build.part(lane, Vector3.new(0.75, 2, 0.05), at(beltX + i * 0.85, 3.7, z), Color3.fromRGB(40, 40, 46))
				strip.CanCollide = false
				strip.Transparency = 0.2
			end
		end
		local xlogo = Build.part(lane, Vector3.new(0.05, 1, 3), at(beltX - 1.83, 4.5, 12), Color3.fromRGB(240, 210, 40))
		Build.label(xlogo, Enum.NormalId.Left, "☢ X-RAY", Color3.fromRGB(20, 20, 20), Enum.Font.GothamBlack)
	end
	markers.BagStart = at(beltX, 3.3, 20.5)
	markers.BagMid = at(beltX, 3.3, 12)
	markers.BagEnd = at(beltX, 3.3, 4)

	-- Body scanner arch (passenger walks into it and raises their arms)
	local archZ = 11
	local proArch = Build.swap(lane, "BodyScanner", at(0, 0, archZ) * CFrame.Angles(0, math.pi, 0), Vector3.new(5.4, 9.4, 3))
	for _, x in if proArch then {} else { -2.2, 2.2 } do
		Build.part(lane, Vector3.new(0.9, 8.4, 2.4), at(x, 4.2, archZ), Color3.fromRGB(230, 232, 238))
		local strip = Build.part(lane, Vector3.new(0.1, 7, 0.3), at(x * 0.78, 4.4, archZ), Color3.fromRGB(90, 200, 255), Enum.Material.Neon)
		strip.CanCollide = false
		CollectionService:AddTag(strip, "PowerScreen")
	end
	if not proArch then
		Build.part(lane, Vector3.new(5.3, 1, 2.4), at(0, 8.9, archZ), Color3.fromRGB(230, 232, 238))
	end
	local scanLight = Build.part(lane, Vector3.new(3.4, 0.1, 0.4), at(0, 8.35, archZ), Color3.fromRGB(90, 200, 255), Enum.Material.Neon)
	scanLight.CanCollide = false
	if proArch then
		scanLight.Transparency = 1
	end
	markers.ScanLight = scanLight
	local pad = Build.part(lane, Vector3.new(3.4, 0.08, 2.2), at(0, 0.04, archZ), Color3.fromRGB(240, 200, 40))
	Build.label(pad, Enum.NormalId.Top, "STAND HERE", Color3.fromRGB(20, 20, 20), Enum.Font.GothamBlack)

	-- Queue stanchions
	stanchion(lane, (at(-3, 0, 16)).Position, (at(-3, 0, 30)).Position)
	stanchion(lane, (at(3.5, 0, 10)).Position, (at(3.5, 0, 16)).Position)
	stanchion(lane, (at(-8, 0, 30)).Position, (at(-3, 0, 30)).Position)

	-- Passenger path
	markers.Points = {
		Entry = at(-1, 0, 47),
		Back = at(0, 0, 26),
		Queue = at(-1, 0, 28),
		Bag = at(4.7, 0, 20.5),
		ScanWait = at(0, 0, 15),
		Scan = at(0, 0, archZ),
		Counter = at(-1, 0, 2.8),
	}
	markers.OfficerSpawn = at(-1, 3, -3.2) * CFrame.Angles(0, math.pi, 0)
	markers.Center = at(0, 0, 0).Position
	return markers
end

local function buildBackRooms(m: Model, o: CFrame, markers)
	local rooms = Build.model(m, "BackRooms")
	local function at(x, y, z)
		return o * CFrame.new(x, y, z)
	end
	-- Wall between officer area and corridor (z = -12) with a door per lane
	local doorsAt = { -37, -13, 11, 35 }
	local cursor = HALL.X0
	for _, dx in doorsAt do
		Build.wall(rooms, (at(cursor, 0, -12)).Position, (at(dx - 2.5, 0, -12)).Position, HALL.H, 0.8, C.Wall, Enum.Material.Plaster)
		Build.wall(rooms, (at(dx - 2.5, 9, -12)).Position, (at(dx + 2.5, 9, -12)).Position, HALL.H - 9, 0.8, C.Wall, Enum.Material.Plaster)
		cursor = dx + 2.5
	end
	Build.wall(rooms, (at(cursor, 0, -12)).Position, (at(HALL.X1, 0, -12)).Position, HALL.H, 0.8, C.Wall, Enum.Material.Plaster)
	-- Corridor lights
	for x = -44, 44, 11 do
		Build.ceilingLight(rooms, at(x, HALL.H - 0.2, -16), 20)
	end
	-- Wall between corridor and rooms (z = -20) with doors into each room, and room dividers
	local roomDoors = { -33, 0, 33 }
	cursor = HALL.X0
	for _, dx in roomDoors do
		Build.wall(rooms, (at(cursor, 0, -20)).Position, (at(dx - 3, 0, -20)).Position, HALL.H, 0.8, C.Wall, Enum.Material.Plaster)
		Build.wall(rooms, (at(dx - 3, 9, -20)).Position, (at(dx + 3, 9, -20)).Position, HALL.H - 9, 0.8, C.Wall, Enum.Material.Plaster)
		cursor = dx + 3
	end
	Build.wall(rooms, (at(cursor, 0, -20)).Position, (at(HALL.X1, 0, -20)).Position, HALL.H, 0.8, C.Wall, Enum.Material.Plaster)
	for _, x in { -17, 17 } do
		Build.wall(rooms, (at(x, 0, -20)).Position, (at(x, 0, HALL.Z0)).Position, HALL.H, 0.8, C.Wall, Enum.Material.Plaster)
	end
	local function roomSign(x, text, color)
		local s = Build.part(rooms, Vector3.new(6, 1.2, 0.2), at(x, 10, -19.5), color)
		Build.label(s, Enum.NormalId.Back, text, Color3.new(1, 1, 1), Enum.Font.GothamBlack)
	end
	roomSign(-33, "STORAGE", Color3.fromRGB(80, 80, 90))
	roomSign(0, "BREAK ROOM", C.Stripe)
	roomSign(33, "⚡ FUSE ROOM", Color3.fromRGB(170, 120, 20))

	markers.Lockers = {}
	markers.Breakers = {}

	-- BREAK ROOM (x -17..17): coffee machine, time clock, sofa, table, lockers, TV
	for x = -12, 12, 8 do
		Build.ceilingLight(rooms, at(x, HALL.H - 0.2, -31), 22)
	end
	local proCoffee = Build.swap(rooms, "CoffeeMachine", at(-13, 0, -40.5) * CFrame.Angles(0, math.pi, 0), Vector3.new(3.4, 6, 2.6))
	local machine = if proCoffee
		then Build.ghost(rooms, Vector3.new(3, 6, 2.4), at(-13, 3, -40.5))
		else Build.part(rooms, Vector3.new(3, 6, 2.4), at(-13, 3, -40.5), Color3.fromRGB(40, 40, 46), Enum.Material.Metal)
	local machineFront = Build.part(rooms, Vector3.new(2.4, 2, 0.1), at(-13, 4.4, -39.25), Color3.fromRGB(120, 60, 30), Enum.Material.Neon)
	Build.label(machineFront, Enum.NormalId.Back, "☕ HOT COFFEE", Color3.new(1, 1, 1), Enum.Font.GothamBlack)
	if proCoffee then
		machineFront:Destroy()
	end
	CollectionService:AddTag(machineFront, "PowerScreen")
	markers.Coffee = Build.prompt(machine, "Drink coffee", "Calms your nerves", 1.5, 7)
	local clock = Build.part(rooms, Vector3.new(2.6, 3.4, 1), at(-5, 5, -41.4), Color3.fromRGB(190, 190, 196), Enum.Material.Metal)
	Build.label(clock, Enum.NormalId.Back, "TIME CLOCK\n⏱", Color3.fromRGB(20, 20, 20), Enum.Font.GothamBlack)
	markers.TimeClock = clock
	-- Table and chairs
	Build.cyl(rooms, 0.3, 6, at(3, 3, -30) * CFrame.Angles(0, 0, math.pi / 2), Color3.fromRGB(230, 230, 230))
	Build.part(rooms, Vector3.new(0.6, 3, 0.6), at(3, 1.5, -30), C.Metal)
	for i = 0, 3 do
		local a = i * math.pi / 2
		local cf = at(3 + math.cos(a) * 4, 0, -30 + math.sin(a) * 4)
		Build.part(rooms, Vector3.new(1.8, 0.3, 1.8), cf * CFrame.new(0, 1.8, 0), C.Seat)
	end
	-- Sofa
	Build.part(rooms, Vector3.new(9, 1.6, 3), at(9, 0.8, -39.5), Color3.fromRGB(110, 40, 40), Enum.Material.Fabric)
	Build.part(rooms, Vector3.new(9, 3, 1), at(9, 2, -41), Color3.fromRGB(110, 40, 40), Enum.Material.Fabric)
	-- TV
	monitor(rooms, at(9, 9, -41.3) * CFrame.Angles(0, math.pi, 0), 6, 3.4, "📺 FROSTLINE NEWS\nBLIZZARD WARNING TONIGHT")
	-- Fridge
	Build.part(rooms, Vector3.new(3, 7, 3), at(15, 3.5, -38), Color3.fromRGB(235, 235, 240), Enum.Material.Metal)
	poster(
		rooms,
		at(-16.5, 6, -28) * CFrame.Angles(0, -math.pi / 2, 0),
		Vector2.new(4, 5),
		"TAKE A\nBREATH.\nOne shift at a time.",
		Color3.fromRGB(220, 235, 255),
		C.Stripe
	)
	for i = 0, 2 do
		local _, prompt = locker(rooms, at(-14 + i * 3.2, 0, -21.8) * CFrame.Angles(0, math.pi, 0), C.Locker)
		table.insert(markers.Lockers, prompt)
	end
	markers.BreakRoomSpawn = at(0, 3, -32)

	-- STORAGE (x -50..-17): shelves, boxes, lockers, breaker
	for x = -44, -22, 11 do
		Build.ceilingLight(rooms, at(x, HALL.H - 0.2, -31), 18)
	end
	for row = 0, 1 do
		local z = -28 - row * 8
		Build.part(rooms, Vector3.new(16, 0.3, 3), at(-36, 2, z), C.Metal, Enum.Material.Metal)
		Build.part(rooms, Vector3.new(16, 0.3, 3), at(-36, 5, z), C.Metal, Enum.Material.Metal)
		Build.part(rooms, Vector3.new(16, 0.3, 3), at(-36, 8, z), C.Metal, Enum.Material.Metal)
		for _, x in { -44, -28 } do
			Build.part(rooms, Vector3.new(0.3, 9, 3), at(x, 4.5, z), C.DarkMetal, Enum.Material.Metal)
		end
		for i = 0, 5 do
			local h = 1.4 + (i % 3) * 0.3
			Build.part(
				rooms,
				Vector3.new(2, h, 2),
				at(-42 + i * 2.6, 2.15 + h / 2, z),
				Color3.fromRGB(170, 130, 80),
				Enum.Material.Cardboard
			)
			Build.part(rooms, Vector3.new(1.8, 1.4, 2), at(-41.5 + i * 2.6, 5.85, z), Color3.fromRGB(160, 120, 74), Enum.Material.Cardboard)
		end
	end
	for i = 0, 3 do
		local _, prompt = locker(rooms, at(-48.5, 0, -38 + i * 3.2) * CFrame.Angles(0, math.pi / 2, 0), Color3.fromRGB(70, 80, 100))
		table.insert(markers.Lockers, prompt)
	end

	-- FUSE ROOM (x 17..50)
	for x = 22, 44, 11 do
		Build.ceilingLight(rooms, at(x, HALL.H - 0.2, -31), 18)
	end
	for i = 0, 4 do
		Build.part(rooms, Vector3.new(3.2, 7, 1.4), at(22 + i * 4, 3.5, -41), Color3.fromRGB(110, 116, 110), Enum.Material.Metal)
		Build.part(rooms, Vector3.new(0.3, 0.3, 0.1), at(23 + i * 4, 6, -40.25), Color3.fromRGB(40, 255, 80), Enum.Material.Neon)
	end
	for y = 12, 14, 1 do
		Build.cyl(rooms, 32, 0.6, at(33, y, -40), Color3.fromRGB(150, 110, 60), Enum.Material.Metal)
	end
	for i = 0, 1 do
		local _, prompt = locker(rooms, at(48.5, 0, -30 + i * 3.2) * CFrame.Angles(0, -math.pi / 2, 0), C.Locker)
		table.insert(markers.Lockers, prompt)
	end

	-- Breakers (power comes back when all three are flipped)
	local function breaker(cf: CFrame, name: string)
		local box =
			Build.part(rooms, Vector3.new(3, 4, 0.8), cf * CFrame.new(0, 5, 0), Color3.fromRGB(80, 84, 80), Enum.Material.DiamondPlate)
		local lever = Build.part(
			rooms,
			Vector3.new(0.4, 1.4, 0.4),
			cf * CFrame.new(0, 4.6, -0.6) * CFrame.Angles(math.rad(40), 0, 0),
			Color3.fromRGB(200, 30, 30)
		)
		local light =
			Build.part(rooms, Vector3.new(0.5, 0.5, 0.2), cf * CFrame.new(0.9, 6.4, -0.45), Color3.fromRGB(255, 40, 40), Enum.Material.Neon)
		local tag = Build.part(rooms, Vector3.new(2.8, 0.6, 0.05), cf * CFrame.new(0, 7.4, -0.42), Color3.fromRGB(240, 200, 40))
		Build.label(tag, Enum.NormalId.Front, "⚡ BREAKER " .. name, Color3.fromRGB(20, 20, 20), Enum.Font.GothamBlack)
		local prompt = Build.prompt(box, "Restore power", "Breaker " .. name, 3, 7)
		prompt.Enabled = false
		table.insert(markers.Breakers, { Box = box, Lever = lever, Light = light, Prompt = prompt, Name = name, Base = cf })
	end
	breaker(at(33, 0, -41.5) * CFrame.Angles(0, math.pi, 0), "A")
	breaker(at(-40, 0, -21), "B")
	breaker(at(49.4, 0, 46) * CFrame.Angles(0, math.pi / 2, 0), "C") -- out in the hall, near the platform

	-- Back-wall lockers in the officer corridor
	for i = 0, 1 do
		local _, prompt = locker(rooms, at(-49 + 0.5, 0, -16.5 + i * 3.2) * CFrame.Angles(0, math.pi / 2, 0), C.Locker)
		table.insert(markers.Lockers, prompt)
	end
end

local function buildHallDecor(m: Model, o: CFrame, markers)
	local decor = Build.model(m, "Decor")
	local function at(x, y, z)
		return o * CFrame.new(x, y, z)
	end
	-- Waiting seats near the entrance
	for _, x in { -24, 0, 24 } do
		chairRow(decor, at(x, 0, 43) * CFrame.Angles(0, math.pi, 0), 4)
	end
	-- Departure board
	local board = Build.part(decor, Vector3.new(18, 4.4, 0.6), at(-30, 11, HALL.Z1 - 0.8), Color3.fromRGB(10, 10, 12))
	Build.label(
		board,
		Enum.NormalId.Front,
		"NIGHT TRAIN   01:30   VARN CENTRAL   BOARDING\nNIGHT TRAIN   02:10   LUNMARK        DELAYED\nNIGHT TRAIN   03:00   ???            ???",
		Color3.fromRGB(255, 200, 60),
		Enum.Font.Code
	)
	CollectionService:AddTag(board, "PowerScreen")
	-- Wall clock
	local clock = Build.cyl(decor, 0.3, 3.4, at(26, 11, HALL.Z1 - 0.7) * CFrame.Angles(0, math.pi / 2, 0), Color3.fromRGB(250, 250, 250))
	Build.label(clock, Enum.NormalId.Right, "01:13", Color3.fromRGB(20, 20, 20), Enum.Font.GothamBlack)
	-- Posters
	poster(
		decor,
		at(-49.4, 7, 42) * CFrame.Angles(0, -math.pi / 2, 0),
		Vector2.new(5, 6.5),
		"REPORT\nANYTHING\nUNUSUAL",
		C.Stripe,
		Color3.new(1, 1, 1)
	)
	poster(
		decor,
		at(-49.4, 7, 14) * CFrame.Angles(0, -math.pi / 2, 0),
		Vector2.new(5, 6.5),
		"THEY\nLOOK\nLIKE US",
		Color3.fromRGB(240, 235, 225),
		Color3.fromRGB(150, 20, 20)
	)
	poster(decor, at(10, 7, HALL.Z1 - 0.6), Vector2.new(4.5, 6), "REST\nBETWEEN\nSHIFTS", Color3.fromRGB(240, 240, 245), C.Stripe)
	poster(
		decor,
		at(-10, 7, HALL.Z1 - 0.6),
		Vector2.new(4.5, 6),
		"NO SHARP\nOBJECTS\nNO ANIMALS",
		Color3.fromRGB(240, 200, 40),
		Color3.fromRGB(20, 20, 20)
	)
	-- Halloween garlands across the hall
	for _, x in { -36, -12, 12, 36 } do
		garland(decor, (at(x - 10, 13.5, 1)).Position, (at(x + 10, 13.5, 1)).Position, 12)
	end
	garland(decor, (at(-40, 13, HALL.Z1 - 1)).Position, (at(40, 13, HALL.Z1 - 1)).Position, 30)
	for _, x in { -46, -26, 26, 46 } do
		pumpkin(decor, at(x, 0, 50), 2)
	end
	-- Plants, bins, wet-floor sign, vending machine
	for _, x in { -48, 48 } do
		if Build.swap(decor, "Plant", at(x, 0, 39), Vector3.new(3.4, 6, 3.4)) then
			continue
		end
		Build.cyl(decor, 2, 2, at(x, 1, 39) * CFrame.Angles(0, 0, math.pi / 2), Color3.fromRGB(70, 60, 50))
		local leaves = Build.ball(decor, 3.4, at(x, 3.6, 39), Color3.fromRGB(40, 110, 50), Enum.Material.Grass)
		leaves.Size = Vector3.new(3, 4, 3)
	end
	if not Build.swap(decor, "VendingMachine", at(-46, 0, 50.5), Vector3.new(4, 7.5, 3)) then
		Build.part(decor, Vector3.new(4, 7.5, 3), at(-46, 3.75, 50.5), Color3.fromRGB(180, 30, 40))
		local vendFront = Build.part(decor, Vector3.new(2.6, 5, 0.1), at(-46.4, 4.4, 49), Color3.fromRGB(200, 230, 255), Enum.Material.Neon)
		vendFront.Transparency = 0.3
		CollectionService:AddTag(vendFront, "PowerScreen")
	end
	local wet = Build.wedge(decor, Vector3.new(1.4, 2.6, 1.2), at(-44, 1.3, 47), Color3.fromRGB(250, 210, 30))
	Build.label(wet, Enum.NormalId.Front, "⚠ WET", Color3.fromRGB(20, 20, 20), Enum.Font.GothamBlack)
	-- Platform door sign
	local exitSign = Build.part(decor, Vector3.new(0.3, 1.4, 6), at(49.3, 10.2, 31.5), Color3.fromRGB(20, 120, 50))
	Build.label(exitSign, Enum.NormalId.Left, "PLATFORM 3 →", Color3.new(1, 1, 1), Enum.Font.GothamBlack)
	-- Ceiling lights over the hall
	for x = -44, 44, 11 do
		for z = 26, 50, 12 do
			Build.ceilingLight(decor, at(x, HALL.H - 0.2, z), 24)
		end
	end
	-- Emergency lights (off until a blackout)
	for x = -40, 40, 20 do
		for _, z in { -16, 10, 40 } do
			local e =
				Build.part(decor, Vector3.new(1, 0.6, 1), at(x, HALL.H - 0.4, z), Color3.fromRGB(90, 0, 0), Enum.Material.SmoothPlastic)
			local light = Build.pointLight(e, Color3.fromRGB(255, 30, 20), 26, 0, false)
			light.Name = "Emergency"
			CollectionService:AddTag(e, "EmergencyLight")
		end
	end
	for _, z in { -30 } do
		for _, x in { -33, 0, 33 } do
			local e = Build.part(decor, Vector3.new(1, 0.6, 1), at(x, HALL.H - 0.4, z), Color3.fromRGB(90, 0, 0))
			local light = Build.pointLight(e, Color3.fromRGB(255, 30, 20), 24, 0, false)
			light.Name = "Emergency"
			CollectionService:AddTag(e, "EmergencyLight")
		end
	end
	markers.PlatformDoor = at(53, 0, 32)
	markers.HallSide = at(42, 0, 33) -- inside the hall, in front of the platform door
	markers.HallDoorIn = at(0, 0, 48) -- just inside the entrance
	markers.Outside = at(0, 0, 64) -- the street (passengers arrive and leave here)
end

local function buildPlatform(m: Model, o: CFrame, markers)
	local plat = Build.model(m, "Platform")
	local function at(x, y, z)
		return o * CFrame.new(x, y, z)
	end
	-- Snowy ground around the station
	Build.part(plat, Vector3.new(400, 2, 400), at(0, -1.5, 0), C.Snow, Enum.Material.Snow)
	-- Platform slab
	Build.part(plat, Vector3.new(16, 0.6, 120), at(58, 0.3, 6), Color3.fromRGB(120, 124, 130), Enum.Material.Concrete)
	Build.part(plat, Vector3.new(0.8, 0.05, 120), at(65.4, 0.63, 6), Color3.fromRGB(240, 200, 30))
	-- Canopy
	Build.part(plat, Vector3.new(18, 0.6, 120), at(58, 14, 6), Color3.fromRGB(60, 64, 72), Enum.Material.Metal)
	for z = -50, 60, 14 do
		Build.part(plat, Vector3.new(0.8, 13, 0.8), at(54, 7.5, z), C.DarkMetal, Enum.Material.Metal)
		local lamp = Build.part(plat, Vector3.new(1.6, 0.4, 1.6), at(58, 13.5, z), Color3.fromRGB(255, 220, 160), Enum.Material.Neon)
		Build.spotLight(lamp, Enum.NormalId.Bottom, Color3.fromRGB(255, 214, 160), 26, 2, 100)
		CollectionService:AddTag(lamp, "PowerLight")
	end
	-- Rails
	for _, x in { 70, 75 } do
		Build.part(plat, Vector3.new(0.5, 0.5, 300), at(x, 0.25, 6), C.Metal, Enum.Material.Metal)
	end
	for z = -140, 150, 3 do
		Build.part(plat, Vector3.new(9, 0.3, 1), at(72.5, 0.05, z), Color3.fromRGB(70, 50, 36), Enum.Material.Wood)
	end
	-- The night train: three carriages
	local train = Build.model(plat, "Train")
	for car = 0, 2 do
		local z = -40 + car * 44
		if Build.swap(train, "TrainCar", at(72.5, 0.6, z), Vector3.new(9.6, 12, 43)) then
			continue
		end
		local body = Build.part(train, Vector3.new(9.4, 10, 42), at(72.5, 6.4, z), Color3.fromRGB(26, 40, 64), Enum.Material.Metal)
		Build.part(train, Vector3.new(9.6, 1, 42.2), at(72.5, 4, z), Color3.fromRGB(150, 20, 26), Enum.Material.Metal)
		Build.part(train, Vector3.new(8.6, 1, 41), at(72.5, 11.8, z), Color3.fromRGB(60, 64, 70), Enum.Material.Metal)
		for w = -16, 16, 6 do
			local window =
				Build.part(train, Vector3.new(0.2, 2.6, 4), at(67.75, 8, z + w), Color3.fromRGB(255, 214, 140), Enum.Material.Neon)
			window.Transparency = 0.25
		end
		local door = Build.part(train, Vector3.new(0.2, 7, 3.6), at(67.75, 5, z + 20), Color3.fromRGB(80, 90, 100), Enum.Material.Metal)
		door.Name = "Door"
		for _, wz in { -15, 15 } do
			Build.cyl(train, 9.6, 2.4, at(72.5, 1.6, z + wz), Color3.fromRGB(20, 20, 20), Enum.Material.Metal)
		end
		local _ = body
	end
	local nose = Build.wedge(train, Vector3.new(9.4, 10, 8), at(72.5, 6.4, 86), Color3.fromRGB(26, 40, 64), Enum.Material.Metal)
	local _ = nose
	local headlight = Build.ball(train, 1.6, at(72.5, 4.5, 89.5), Color3.fromRGB(255, 250, 220), Enum.Material.Neon)
	Build.spotLight(headlight, Enum.NormalId.Front, Color3.fromRGB(255, 250, 220), 60, 3, 50)
	markers.TrainDoor = at(66, 1, 24)
	markers.MonsterSpawn = at(64, 1.5, 24)

	-- Snow falling around the station
	local emitterPart = Build.part(plat, Vector3.new(220, 1, 220), at(0, 60, 0), Color3.new(1, 1, 1))
	emitterPart.Transparency = 1
	emitterPart.CanCollide = false
	emitterPart.CanQuery = false
	local snow = Instance.new("ParticleEmitter")
	snow.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	snow.Rate = 220
	snow.Lifetime = NumberRange.new(12, 16)
	snow.Speed = NumberRange.new(4, 7)
	snow.SpreadAngle = Vector2.new(12, 12)
	snow.Size = NumberSequence.new(0.35)
	snow.Color = ColorSequence.new(Color3.new(1, 1, 1))
	snow.EmissionDirection = Enum.NormalId.Bottom
	snow.Acceleration = Vector3.new(2, 0, 1)
	snow.LightEmission = 0.3
	snow.Parent = emitterPart
	-- Pine trees
	local rng = Random.new(42)
	for _ = 1, 70 do
		local angle = rng:NextNumber(0, math.pi * 2)
		local dist = rng:NextNumber(95, 170)
		local x, z = math.cos(angle) * dist, math.sin(angle) * dist
		if not (x > 50 and x < 100) then
			local h = rng:NextNumber(18, 34)
			if Build.swap(plat, "PineTree", at(x, 0, z) * CFrame.Angles(0, rng:NextNumber(0, 6), 0), Vector3.new(h * 0.6, h, h * 0.6)) then
				continue
			end
			Build.part(plat, Vector3.new(1.4, h * 0.3, 1.4), at(x, h * 0.15, z), Color3.fromRGB(70, 50, 36), Enum.Material.Wood)
			for tier = 0, 2 do
				local size = h * (0.55 - tier * 0.15)
				local cone = Build.part(
					plat,
					Vector3.new(size, h * 0.3, size),
					at(x, h * (0.3 + tier * 0.22), z) * CFrame.Angles(0, rng:NextNumber(0, 3), 0),
					Color3.fromRGB(30, 60, 44),
					Enum.Material.Grass
				)
				cone.Shape = Enum.PartType.Ball
				Build.part(
					plat,
					Vector3.new(size * 0.7, 0.6, size * 0.7),
					at(x, h * (0.3 + tier * 0.22) + h * 0.12, z),
					C.Snow,
					Enum.Material.Snow
				).Shape =
					Enum.PartType.Cylinder
			end
		end
	end
	-- Street lamps at the entrance
	for _, x in { -14, 14 } do
		Build.part(plat, Vector3.new(0.6, 14, 0.6), at(x, 7, 62), C.DarkMetal, Enum.Material.Metal)
		local lamp = Build.part(plat, Vector3.new(2, 0.5, 1.2), at(x, 14, 61), Color3.fromRGB(255, 220, 170), Enum.Material.Neon)
		Build.spotLight(lamp, Enum.NormalId.Bottom, Color3.fromRGB(255, 210, 160), 30, 2.4, 90)
		CollectionService:AddTag(lamp, "PowerLight")
	end
end

-- Interrogation wing (west): a corridor and one room per lane. Passengers enter from the hall,
-- officers from the staff corridor.
local function buildInterrogation(m: Model, o: CFrame, markers)
	local wing = Build.model(m, "Interrogation")
	local function at(x, y, z)
		return o * CFrame.new(x, y, z)
	end
	local X0, X1, Z0, Z1 = -86, -50, -20, 42
	Build.part(
		wing,
		Vector3.new(X1 - X0, 1, Z1 - Z0),
		at((X0 + X1) / 2, -0.5, (Z0 + Z1) / 2),
		Color3.fromRGB(84, 86, 92),
		Enum.Material.Concrete
	)
	Build.part(
		wing,
		Vector3.new(X1 - X0, 1, Z1 - Z0),
		at((X0 + X1) / 2, 12.5, (Z0 + Z1) / 2),
		Color3.fromRGB(150, 150, 154),
		Enum.Material.Concrete
	)
	local wallColor = Color3.fromRGB(150, 154, 150)
	Build.wall(wing, (at(X0, 0, Z0)).Position, (at(X0, 0, Z1)).Position, 12, 1, wallColor, Enum.Material.Concrete)
	Build.wall(wing, (at(X0, 0, Z0)).Position, (at(X1, 0, Z0)).Position, 12, 1, wallColor, Enum.Material.Concrete)
	Build.wall(wing, (at(X0, 0, Z1)).Position, (at(X1, 0, Z1)).Position, 12, 1, wallColor, Enum.Material.Concrete)
	local sign = Build.part(wing, Vector3.new(0.3, 1.4, 8), at(-50.8, 10.4, 30), Color3.fromRGB(150, 20, 24))
	Build.label(sign, Enum.NormalId.Right, "← INTERROGATION", Color3.new(1, 1, 1), Enum.Font.GothamBlack)
	-- Corridor x -60..-50, lights
	for z = -14, 38, 10 do
		Build.ceilingLight(wing, at(-55, 11.8, z), 18)
	end
	-- Rooms x -86..-60, each 15 deep, doors on the corridor side
	markers.Interrogation = {}
	local roomDepth = 15
	for i = 1, 4 do
		local z0 = Z0 + 1 + (i - 1) * roomDepth
		local z1 = z0 + roomDepth
		local zc = (z0 + z1) / 2
		-- Corridor-side wall with a door, and a one-way mirror
		Build.wall(wing, (at(-60, 0, z0)).Position, (at(-60, 0, zc - 2.5)).Position, 12, 0.8, wallColor, Enum.Material.Concrete)
		Build.wall(wing, (at(-60, 0, zc + 2.5)).Position, (at(-60, 0, z1)).Position, 12, 0.8, wallColor, Enum.Material.Concrete)
		Build.wall(wing, (at(-60, 8.5, zc - 2.5)).Position, (at(-60, 8.5, zc + 2.5)).Position, 3.5, 0.8, wallColor, Enum.Material.Concrete)
		if i < 4 then
			Build.wall(wing, (at(X0, 0, z1)).Position, (at(-60, 0, z1)).Position, 12, 0.8, wallColor, Enum.Material.Concrete)
		end
		local mirror = Build.part(wing, Vector3.new(0.3, 3.6, 5), at(-60, 5.6, z0 + 3.2), Color3.fromRGB(40, 50, 60), Enum.Material.Glass)
		mirror.Reflectance = 0.5
		mirror.Transparency = 0.25
		local plate = Build.part(wing, Vector3.new(0.2, 1, 4), at(-59.5, 10, zc), Color3.fromRGB(20, 20, 20))
		Build.label(plate, Enum.NormalId.Right, "ROOM " .. i, Color3.fromRGB(255, 80, 80), Enum.Font.GothamBlack)
		-- Table, chairs, hanging lamp
		local tx = -73
		Build.part(wing, Vector3.new(4, 0.3, 7), at(tx, 3.2, zc), Color3.fromRGB(90, 92, 96), Enum.Material.Metal)
		for _, dz in { -3, 3 } do
			for _, dx in { -1.7, 1.7 } do
				Build.part(wing, Vector3.new(0.3, 3.1, 0.3), at(tx + dx, 1.55, zc + dz), C.DarkMetal, Enum.Material.Metal)
			end
		end
		local function chair(cf, isSeat: boolean?)
			local seatPart: BasePart =
				Build.part(wing, Vector3.new(2, 0.3, 2), cf * CFrame.new(0, 2, 0), Color3.fromRGB(60, 60, 64), Enum.Material.Metal)
			if isSeat then
				local seat = Instance.new("Seat")
				seat.Anchored = true
				seat.Size = seatPart.Size
				seat.CFrame = seatPart.CFrame
				seat.Color = seatPart.Color
				seat.Material = seatPart.Material
				seat.CanTouch = false -- players can't sit by touching it; the server seats suspects
				seat.Parent = wing
				seatPart:Destroy()
				seatPart = seat
			end
			Build.part(wing, Vector3.new(2, 2.4, 0.3), cf * CFrame.new(0, 3.3, 1), Color3.fromRGB(60, 60, 64), Enum.Material.Metal)
			for _, dx in { -0.8, 0.8 } do
				for _, dz in { -0.8, 0.8 } do
					Build.part(wing, Vector3.new(0.2, 2, 0.2), cf * CFrame.new(dx, 1, dz), C.DarkMetal, Enum.Material.Metal)
				end
			end
			return seatPart
		end
		local suspectSeat = chair(at(tx, 0, zc + 5), true) -- suspect (faces -Z)
		chair(at(tx, 0, zc - 5) * CFrame.Angles(0, math.pi, 0)) -- officer
		Build.part(wing, Vector3.new(0.1, 4, 0.1), at(tx, 10, zc), C.DarkMetal)
		local shade = Build.part(wing, Vector3.new(2.2, 0.8, 2.2), at(tx, 7.8, zc), Color3.fromRGB(40, 44, 40), Enum.Material.Metal)
		local bulb = Build.ball(wing, 0.7, at(tx, 7.3, zc), Color3.fromRGB(255, 240, 200), Enum.Material.Neon)
		Build.spotLight(bulb, Enum.NormalId.Bottom, Color3.fromRGB(255, 236, 190), 16, 3, 70)
		CollectionService:AddTag(bulb, "PowerLight")
		local _ = shade
		-- Devices on the table
		local room = { Index = i, Prompts = {} }
		local polygraph = Build.part(wing, Vector3.new(1.8, 0.8, 1.2), at(tx - 1, 3.75, zc - 2), C.DarkMetal, Enum.Material.Metal)
		local paper = Build.part(wing, Vector3.new(1.3, 0.05, 0.7), at(tx - 1, 4.17, zc - 2), Color3.fromRGB(240, 240, 230))
		paper.CanCollide = false
		for k = 0, 2 do
			Build.part(wing, Vector3.new(0.05, 0.05, 2.6), at(tx - 1.6 + k * 0.4, 3.4, zc + 0.6), Color3.fromRGB(200, 40, 40)).CanCollide =
				false
		end
		room.Prompts.Interview = addPrompt(polygraph, "Lie Detector", "Ask questions", 0, 7)
		local reader = Build.part(wing, Vector3.new(1.3, 0.35, 1.3), at(tx + 1.1, 3.55, zc + 1.6), C.DarkMetal, Enum.Material.Metal)
		Build.part(wing, Vector3.new(0.8, 0.05, 0.8), at(tx + 1.1, 3.75, zc + 1.6), Color3.fromRGB(80, 200, 255), Enum.Material.Neon).CanCollide =
			false
		room.Prompts.Fingerprint = addPrompt(reader, "Fingerprints", "Scanner", 0, 7)
		room.Prompts.Fingerprint.KeyboardKeyCode = Enum.KeyCode.T
		local lamp = Build.cyl(wing, 1, 0.45, at(tx + 1.2, 4.1, zc - 1.8) * CFrame.Angles(0, math.pi / 2, 0), C.Metal, Enum.Material.Metal)
		Build.part(wing, Vector3.new(0.6, 0.5, 0.6), at(tx + 1.2, 3.6, zc - 1.8), C.DarkMetal)
		room.Prompts.Eyes = addPrompt(lamp, "Eye Exam", "Lamp", 0, 7)
		room.Prompts.Eyes.KeyboardKeyCode = Enum.KeyCode.Y
		-- Brain scanner: a helmet on an arm above the suspect's chair + a screen on the wall
		Build.part(wing, Vector3.new(0.4, 9, 0.4), at(tx + 2.6, 4.5, zc + 6.6), C.Metal, Enum.Material.Metal)
		Build.part(wing, Vector3.new(2.8, 0.4, 0.4), at(tx + 1.3, 8.8, zc + 6.6), C.Metal, Enum.Material.Metal)
		local helmet = Build.ball(wing, 1.8, at(tx, 8.2, zc + 5.6), Color3.fromRGB(220, 224, 232), Enum.Material.SmoothPlastic)
		helmet.Size = Vector3.new(2, 1.4, 2)
		for k = 0, 5 do
			local a = k * math.pi / 3
			Build.ball(
				wing,
				0.25,
				at(tx + math.cos(a) * 0.85, 8.1, zc + 5.6 + math.sin(a) * 0.85),
				Color3.fromRGB(80, 200, 255),
				Enum.Material.Neon
			).CanCollide =
				false
		end
		local brainScreen, brainLabel =
			monitor(wing, at(X0 + 0.7, 6.5, zc) * CFrame.Angles(0, -math.pi / 2, 0), 4.4, 2.6, "NEURO-SCAN\nIDLE")
		room.Prompts.Brain = addPrompt(brainScreen, "Brain Scan", "Neuro-scanner", 0, 14)
		room.Prompts.Brain.KeyboardKeyCode = Enum.KeyCode.B
		room.BrainLabel = brainLabel
		local _ = helmet
		-- Verdict stamps in the room
		local function stamp(dz, color, text)
			local base = Build.part(wing, Vector3.new(1, 0.5, 1), at(tx - 1.2, 3.6, zc + dz), color)
			Build.cyl(wing, 1, 0.35, at(tx - 1.2, 4.25, zc + dz) * CFrame.Angles(0, 0, math.pi / 2), C.Wood, Enum.Material.Wood)
			local tag = Build.part(
				wing,
				Vector3.new(1.6, 0.5, 0.05),
				at(tx - 2.05, 3.45, zc + dz) * CFrame.Angles(0, math.pi / 2, 0),
				Color3.fromRGB(20, 20, 20)
			)
			Build.label(tag, Enum.NormalId.Back, text, color, Enum.Font.GothamBlack)
			return base
		end
		room.Prompts.Approve = addPrompt(stamp(-0.2, Color3.fromRGB(40, 190, 80), "APPROVE"), "APPROVE", "Stamp", 0.4, 6)
		room.Prompts.Deny = addPrompt(stamp(1.2, Color3.fromRGB(210, 40, 40), "DENY"), "DENY", "Stamp", 0.4, 6)
		room.Prompts.Approve.KeyboardKeyCode = Enum.KeyCode.F
		room.Prompts.Deny.KeyboardKeyCode = Enum.KeyCode.G
		room.Seat = at(tx + 4, 0, zc + 5) -- walk here, then get seated
		room.SeatPart = suspectSeat
		room.Door = at(-57, 0, zc)
		room.OfficerSpot = at(tx, 3, zc - 4.6)
		markers.Interrogation[i] = room
	end
	markers.WingHallDoor = at(-47, 0, 30)
	markers.WingCorridorTop = at(-55, 0, 30)
end

-- origin: where this station sits in the world. Returns markers.
function StationBuilder.Build(parent: Instance, origin: CFrame, name: string)
	local m = Build.model(parent, name)
	local markers = { Model = m, Origin = origin, Lanes = {} }
	buildShell(m, origin)
	for i, x in LANE_X do
		markers.Lanes[i] = buildLane(m, origin, i, x)
	end
	buildBackRooms(m, origin, markers)
	buildHallDecor(m, origin, markers)
	buildPlatform(m, origin, markers)
	buildInterrogation(m, origin, markers)
	markers.Bounds =
		{ Min = origin * Vector3.new(HALL.X0 - 30, -5, HALL.Z0 - 10), Max = origin * Vector3.new(HALL.X1 + 40, 30, HALL.Z1 + 20) }
	return markers
end

return StationBuilder
]]></string>
        </Properties>
      </Item>
    </Item>
