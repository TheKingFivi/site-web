		Material = Enum.Material.Metal,
	}, model)
	P({
		Name = "Arm",
		Size = Vector3.new(0.4, 0.4, 2.5),
		CFrame = cf * CFrame.new(0, 12.6, -1),
		Color = C.iron,
		Material = Enum.Material.Metal,
		CanCollide = false,
	}, model)
	local bulb = P({
		Name = "Bulb",
		Size = Vector3.new(1.4, 1.6, 1.4),
		CFrame = cf * CFrame.new(0, 11.9, -2),
		Color = rgb(255, 210, 140),
		Material = Enum.Material.Neon,
		CanCollide = false,
