				CFrame = cf * CFrame.new(x, 3.5, -4),
				Color = rgb(22, 22, 22),
				Material = Enum.Material.Rubber,
			},
			model
		)
		P(
			{
				Name = "RearWheel",
				Shape = Enum.PartType.Cylinder,
				Size = Vector3.new(1.2, 4, 4),
				CFrame = cf * CFrame.new(x, 2, 6),
				Color = rgb(22, 22, 22),
				Material = Enum.Material.Rubber,
