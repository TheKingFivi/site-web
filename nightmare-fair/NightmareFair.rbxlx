function Props.HayStack(cf: CFrame, parent)
	local model = Props.Model("HayStack", parent)
	for row = 0, 2 do
		for i = 0, 2 - row do
			Props.HayBale(cf * CFrame.new(-5 + i * 5 + row * 2.5, row * 2.6, 0), model)
		end
	end
	return model
end

-- Two-story farmhouse with stairs, rooms, a porch and hiding wardrobes. Returns the model plus
-- local spots (CFrames) where the caller places lockers and the upstairs Ritual Pumpkin.
function Props.Farmhouse(cf: CFrame, parent)
	local model = Props.Model("Farmhouse", parent)
	local W, D, H = 56, 40, 12 -- width (x), depth (z), storey height
	local wallColor = rgb(176, 166, 146)
	local trim = rgb(90, 76, 62)
	local function block(size, offset, color, material)
		return P(
			{ Name = "Wall", Size = size, CFrame = cf * offset, Color = color or wallColor, Material = material or Enum.Material.WoodPlanks },
			model
		)
	end
	-- A wall along X (at z) or Z (at x) from a to b, with door gaps {from, to}, for one storey starting at y0
	local function wallX(z, a, b, y0, gaps)
		local cursor = a
		table.sort(gaps, function(g1, g2)
			return g1[1] < g2[1]
		end)
		for _, g in gaps do
			if g[1] > cursor then
				block(Vector3.new(g[1] - cursor, H, 1), CFrame.new((cursor + g[1]) / 2, y0 + H / 2, z))
			end
			block(Vector3.new(g[2] - g[1], H - 8, 1), CFrame.new((g[1] + g[2]) / 2, y0 + 8 + (H - 8) / 2, z)) -- lintel
			cursor = g[2]
		end
		if b > cursor then
			block(Vector3.new(b - cursor, H, 1), CFrame.new((cursor + b) / 2, y0 + H / 2, z))
		end
	end
	local function wallZ(x, a, b, y0, gaps)
		local cursor = a
		table.sort(gaps, function(g1, g2)
			return g1[1] < g2[1]
		end)
		for _, g in gaps do
			if g[1] > cursor then
				block(Vector3.new(1, H, g[1] - cursor), CFrame.new(x, y0 + H / 2, (cursor + g[1]) / 2))
			end
			block(Vector3.new(1, H - 8, g[2] - g[1]), CFrame.new(x, y0 + 8 + (H - 8) / 2, (g[1] + g[2]) / 2))
			cursor = g[2]
		end
		if b > cursor then
			block(Vector3.new(1, H, b - cursor), CFrame.new(x, y0 + H / 2, (cursor + b) / 2))
		end
	end

	-- Foundation and ground floor
	block(Vector3.new(W + 2, 1, D + 2), CFrame.new(0, 0.5, 0), rgb(90, 86, 82), Enum.Material.Concrete)
	block(Vector3.new(W, 0.2, D), CFrame.new(0, 1.1, 0), rgb(98, 72, 50), Enum.Material.WoodPlanks)
	local y1 = 1
	wallX(-D / 2, -W / 2, W / 2, y1, { { -4, 4 }, { 16, 22 } })
	wallX(D / 2, -W / 2, W / 2, y1, { { 18, 26 } })
	wallZ(-W / 2, -D / 2, D / 2, y1, { { -4, 4 } })
	wallZ(W / 2, -D / 2, D / 2, y1, { { 4, 12 } })
	-- Ground floor rooms (kitchen / living room / hallway)
	wallZ(-8, -D / 2, D / 2, y1, { { -10, -4 }, { 8, 14 } })
	wallX(6, -W / 2, -8, y1, { { -20, -14 } })
	wallZ(12, -D / 2, 4, y1, { { -12, -6 } })

	-- Stairs (a ramp) up the east side, and the upper floor with a stairwell hole
	local stair = Instance.new("WedgePart")
	stair.Name = "Stairs"
	stair.Anchored = true
	stair.Size = Vector3.new(8, H, 22)
	stair.CFrame = cf * CFrame.new(22, y1 + H / 2, -3) * CFrame.Angles(0, math.pi, 0)
	stair.Color = rgb(86, 62, 44)
	stair.Material = Enum.Material.WoodPlanks
	stair.TopSurface = Enum.SurfaceType.Smooth
	stair.Parent = model
	local y2 = y1 + H
	block(Vector3.new(W - 18, 1, D), CFrame.new(-9, y2, 0), rgb(98, 72, 50))
	block(Vector3.new(18, 1, D - 22 - 4), CFrame.new(W / 2 - 9, y2, D / 2 - (D - 26) / 2), rgb(98, 72, 50))
	block(Vector3.new(10, 1, 4), CFrame.new(W / 2 - 5 - 8 - 5, y2, -D / 2 + 2), rgb(98, 72, 50))
	block(Vector3.new(0.4, 3, 22), CFrame.new(17.8, y2 + 2, -3), trim) -- stair railing

	-- Upper floor walls and rooms (bedrooms)
	wallX(-D / 2, -W / 2, W / 2, y2, {})
	wallX(D / 2, -W / 2, W / 2, y2, {})
	wallZ(-W / 2, -D / 2, D / 2, y2, {})
	wallZ(W / 2, -D / 2, D / 2, y2, {})
	wallZ(-6, -D / 2, D / 2, y2, { { -2, 4 } })
	wallX(2, -W / 2, -6, y2, { { -18, -12 } })

	-- Roof (gable) and ceiling
	local y3 = y2 + H
	block(Vector3.new(W + 2, 1, D + 2), CFrame.new(0, y3 + 0.5, 0), rgb(70, 60, 55))
	for _, side in { -1, 1 } do
		P({
			Name = "Roof",
			Size = Vector3.new(W + 6, 1, D / 2 + 6),
			CFrame = cf * CFrame.new(0, y3 + 6, side * (D / 4 + 1)) * CFrame.Angles(side * math.rad(-30), 0, 0),
			Color = rgb(58, 50, 50),
			Material = Enum.Material.Slate,
		}, model)
	end
	P(
		{
			Name = "Chimney",
			Size = Vector3.new(4, 14, 4),
			CFrame = cf * CFrame.new(-18, y3 + 8, 6),
			Color = rgb(110, 60, 50),
			Material = Enum.Material.Brick,
		},
		model
	)

	-- Porch along the front
	P(
		{
			Name = "Porch",
			Size = Vector3.new(W, 1, 8),
			CFrame = cf * CFrame.new(0, 0.5, -D / 2 - 4),
			Color = rgb(98, 72, 50),
			Material = Enum.Material.WoodPlanks,
		},
		model
	)
	P(
		{
			Name = "PorchRoof",
			Size = Vector3.new(W + 2, 0.6, 9),
			CFrame = cf * CFrame.new(0, 10, -D / 2 - 4.5) * CFrame.Angles(math.rad(8), 0, 0),
			Color = rgb(70, 60, 55),
			Material = Enum.Material.CorrodedMetal,
		},
		model
	)
	for x = -W / 2 + 1, W / 2 - 1, 11 do
		P(
			{
				Name = "PorchPost",
				Size = Vector3.new(0.8, 9, 0.8),
				CFrame = cf * CFrame.new(x, 5, -D / 2 - 8),
				Color = trim,
				Material = Enum.Material.Wood,
			},
			model
		)
	end

	-- Windows (dark glass, some with a dim lamp behind)
	for _, x in { -22, -12, 8, -2 } do
		for _, y in { y1 + 6, y2 + 6 } do
			local lit = rng:NextNumber() < 0.3
			P(
				{
					Name = "Window",
					Size = Vector3.new(4, 4.5, 0.2),
					CFrame = cf * CFrame.new(x, y, -D / 2 - 0.6),
					Color = if lit then rgb(255, 196, 120) else rgb(24, 26, 30),
					Material = if lit then Enum.Material.Neon else Enum.Material.Glass,
				},
				model
			)
			P(
				{
					Name = "Window",
					Size = Vector3.new(4, 4.5, 0.2),
					CFrame = cf * CFrame.new(x, y, D / 2 + 0.6),
					Color = rgb(24, 26, 30),
					Material = Enum.Material.Glass,
				},
				model
			)
		end
	end
	-- Ceiling lamps inside
	for _, spot in
		{ CFrame.new(-18, y2 - 1.5, -8), CFrame.new(4, y2 - 1.5, 8), CFrame.new(-16, y3 - 1.5, 10), CFrame.new(10, y3 - 1.5, -8) }
	do
		local bulb = P(
			{
				Name = "Lamp",
				Size = Vector3.new(1, 0.6, 1),
				CFrame = cf * spot,
				Color = rgb(255, 210, 150),
				Material = Enum.Material.Neon,
				CanCollide = false,
			},
			model
		)
		Props.Light(bulb, rgb(255, 200, 140), 22, 1)
	end

	return {
		Model = model,
		-- Where to put hiding wardrobes (facing into the rooms)
		Lockers = {
			cf * CFrame.new(-25, y1, -14) * CFrame.Angles(0, math.rad(90), 0),
			cf * CFrame.new(-4, y1, 17) * CFrame.Angles(0, math.pi, 0),
			cf * CFrame.new(-25, y2 + 0.5, 15) * CFrame.Angles(0, math.rad(90), 0),
			cf * CFrame.new(10, y2 + 0.5, 17) * CFrame.Angles(0, math.pi, 0),
		},
		Pumpkin = cf * CFrame.new(-16, y2 + 0.5, -9),
	}
end

-- Gameplay objects --------------------------------------------------------

function Props.RitualPumpkin(cf: CFrame, parent)
	local model = Props.Model("RitualPumpkin", parent)
	P({
		Name = "Altar",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(1.4, 8, 8),
		CFrame = cf * CFrame.new(0, 0.7, 0) * CFrame.Angles(0, 0, math.rad(90)),
		Color = rgb(70, 65, 75),
		Material = Enum.Material.Slate,
	}, model)
	for i = 0, 5 do
		local a = i / 6 * math.pi * 2
		local candle = P({
			Name = "Candle",
			Size = Vector3.new(0.5, 1.4, 0.5),
			CFrame = cf * CFrame.new(math.cos(a) * 3.4, 2.1, math.sin(a) * 3.4),
			Color = C.cream,
			CanCollide = false,
		}, model)
		P({
			Name = "Wick",
			Size = Vector3.new(0.25, 0.4, 0.25),
			CFrame = candle.CFrame * CFrame.new(0, 0.9, 0),
			Color = rgb(255, 170, 60),
			Material = Enum.Material.Neon,
			CanCollide = false,
		}, model)
	end
	local pumpkin = P({
		Name = "Pumpkin",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(5, 5, 5),
		CFrame = cf * CFrame.new(0, 3.6, 0),
		Color = rgb(150, 75, 25),
	}, model)
	P({
		Name = "Stem",
		Size = Vector3.new(0.6, 1.2, 0.6),
		CFrame = cf * CFrame.new(0, 6.5, 0),
		Color = rgb(60, 80, 30),
		CanCollide = false,
	}, model)
	local face = {}
	for _, x in { -0.9, 0.9 } do
		table.insert(
			face,
			P({
				Name = "Eye",
				Size = Vector3.new(1, 0.9, 0.2),
				CFrame = pumpkin.CFrame * CFrame.new(x, 0.6, -2.4),
				Color = rgb(30, 20, 15),
				Material = Enum.Material.SmoothPlastic,
				CanCollide = false,
			}, model)
		)
	end
	table.insert(
		face,
		P({
			Name = "Mouth",
			Size = Vector3.new(2.6, 0.6, 0.2),
			CFrame = pumpkin.CFrame * CFrame.new(0, -0.8, -2.35),
			Color = rgb(30, 20, 15),
			Material = Enum.Material.SmoothPlastic,
			CanCollide = false,
		}, model)
	)
	local light = Props.Light(pumpkin, rgb(255, 150, 40), 30, 0)
	return { Model = model, Pumpkin = pumpkin, Face = face, Light = light, Position = cf.Position }
end

function Props.CrowCage(cf: CFrame, parent)
	local model = Props.Model("CrowCage", parent)
	local radius, height = 3.6, 9
	P({
		Name = "Base",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(1, radius * 2 + 1, radius * 2 + 1),
		CFrame = cf * CFrame.new(0, 0.5, 0) * CFrame.Angles(0, 0, math.rad(90)),
		Color = C.iron,
		Material = Enum.Material.Metal,
	}, model)
	P({
		Name = "Top",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(radius * 2 + 1, 3, radius * 2 + 1),
		CFrame = cf * CFrame.new(0, height + 1, 0),
		Color = C.iron,
		Material = Enum.Material.Metal,
	}, model)
	for i = 0, 13 do
		local a = i / 14 * math.pi * 2
		-- Leave a gap in front so rescuers can reach in
		if i ~= 0 then
			P({
				Name = "Bar",
				Size = Vector3.new(0.3, height, 0.3),
				CFrame = cf * CFrame.new(math.cos(a) * radius, height / 2 + 1, math.sin(a) * radius),
				Color = rgb(80, 75, 70),
				Material = Enum.Material.Metal,
			}, model)
		end
	end
	P({
		Name = "Hook",
		Size = Vector3.new(0.6, 6, 0.6),
		CFrame = cf * CFrame.new(0, height + 5, 0),
		Color = C.iron,
		Material = Enum.Material.Metal,
		CanCollide = false,
	}, model)
	-- Crows perched on top
	for _, x in { -1.6, 1.4 } do
		local crow = P({
			Name = "Crow",
			Size = Vector3.new(0.8, 0.9, 1.6),
			CFrame = cf * CFrame.new(x, height + 2.8, 0) * CFrame.Angles(0, x, 0),
			Color = rgb(15, 15, 20),
			CanCollide = false,
		}, model)
		P({
			Name = "CrowEye",
			Size = Vector3.new(0.15, 0.15, 0.1),
			CFrame = crow.CFrame * CFrame.new(0.25, 0.25, -0.8),
			Color = rgb(255, 40, 40),
			Material = Enum.Material.Neon,
			CanCollide = false,
		}, model)
	end
	local glow = P(
		{ Name = "Glow", Size = Vector3.new(0.5, 0.5, 0.5), CFrame = cf * CFrame.new(0, height, 0), Transparency = 1, CanCollide = false },
		model
	)
	local light = Props.Light(glow, rgb(255, 40, 40), 16, 1)
	-- Invisible part the prompts attach to, at the cage door
	local door = P({
		Name = "DoorZone",
		Size = Vector3.new(3, 4, 1),
		CFrame = cf * CFrame.new(radius + 0.5, 3, 0),
		Transparency = 1,
		CanCollide = false,
	}, model)
	Props.Billboard(door, "🐦‍⬛ CROW CAGE", rgb(255, 90, 90), 4, 40)
	return { Model = model, Door = door, Light = light, Inside = cf * CFrame.new(0, 4.2, 0), Position = cf.Position }
end

-- A pallet in a gap between two crate stacks. Returns the pallet part and its standing/dropped CFrames.
function Props.PalletSpot(cf: CFrame, parent)
	local model = Props.Model("PalletSpot", parent)
	Props.CrateStack(cf * CFrame.new(-7.4, 0, 0), model)
	Props.CrateStack(cf * CFrame.new(7.4, 0, 0), model)
	local standing = cf * CFrame.new(-4.2, 3.2, 0) * CFrame.Angles(0, 0, math.rad(-20))
	local dropped = cf * CFrame.new(0, 3, 0)
	local pallet = P({
		Name = "Pallet",
		Size = Vector3.new(6.6, 6, 0.8),
		CFrame = standing,
		Color = rgb(150, 110, 70),
		Material = Enum.Material.WoodPlanks,
		CanCollide = false,
	}, model)
	for _, y in { -2, 0, 2 } do
		P({
			Name = "Slat",
			Size = Vector3.new(6.8, 0.6, 0.3),
			CFrame = pallet.CFrame * CFrame.new(0, y, -0.5),
			Color = rgb(110, 80, 50),
			Material = Enum.Material.Wood,
			CanCollide = false,
			CanQuery = false,
		}, model)
	end
	return { Model = model, Pallet = pallet, Standing = standing, Dropped = dropped, Position = cf.Position }
end

function Props.Bell(cf: CFrame, parent)
	local model = Props.Model("GhostBell", parent)
	P({
		Name = "Post",
		Size = Vector3.new(0.8, 10, 0.8),
		CFrame = cf * CFrame.new(-2, 5, 0),
		Color = C.darkWood,
		Material = Enum.Material.Wood,
	}, model)
	P({
		Name = "Post",
		Size = Vector3.new(0.8, 10, 0.8),
		CFrame = cf * CFrame.new(2, 5, 0),
		Color = C.darkWood,
		Material = Enum.Material.Wood,
	}, model)
	P({
		Name = "Beam",
		Size = Vector3.new(5, 0.8, 0.8),
		CFrame = cf * CFrame.new(0, 10, 0),
		Color = C.darkWood,
		Material = Enum.Material.Wood,
	}, model)
	local bell = P({
		Name = "Bell",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(2.6, 2.8, 2.6),
		CFrame = cf * CFrame.new(0, 8.2, 0),
		Color = rgb(170, 220, 255),
		Material = Enum.Material.Neon,
		Transparency = 0.2,
	}, model)
	Props.Light(bell, rgb(150, 200, 255), 14, 1)
	Props.Billboard(bell, "🔔 GHOST BELL", rgb(170, 220, 255), 3, 35)
	return { Model = model, Bell = bell }
end

function Props.ExitGate(cf: CFrame, parent)
	local model = Props.Model("ExitGate", parent)
	for _, x in { -9.5, 9.5 } do
		P({
			Name = "GatePost",
			Size = Vector3.new(3, 20, 3),
			CFrame = cf * CFrame.new(x, 10, 0),
			Color = C.iron,
			Material = Enum.Material.Metal,
		}, model)
	end
	local top = P({
		Name = "GateTop",
		Size = Vector3.new(22, 3, 3),
		CFrame = cf * CFrame.new(0, 21.5, 0),
		Color = C.iron,
		Material = Enum.Material.Metal,
	}, model)
	Props.Sign(top, Enum.NormalId.Front, "EXIT", rgb(255, 60, 60))
	local doors = {}
	for _, x in { -4, 4 } do
		local door = P({
			Name = "Door",
			Size = Vector3.new(8, 18, 0.8),
			CFrame = cf * CFrame.new(x, 9, 0),
			Color = rgb(70, 60, 55),
			Material = Enum.Material.DiamondPlate,
		}, model)
		table.insert(doors, { Part = door, Closed = door.CFrame, Open = door.CFrame * CFrame.new(x * 1.9, 0, 0) })
	end
	local box = P({
		Name = "SwitchBox",
		Size = Vector3.new(2.4, 3.4, 1.4),
		CFrame = cf * CFrame.new(13, 4, -1.5),
		Color = rgb(80, 80, 90),
		Material = Enum.Material.Metal,
	}, model)
	local lamp = P({
		Name = "Lamp",
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * 1.2,
		CFrame = cf * CFrame.new(13, 6.4, -1.5),
		Color = rgb(255, 40, 40),
		Material = Enum.Material.Neon,
	}, model)
	local light = Props.Light(lamp, rgb(255, 40, 40), 14, 1.5)
	-- Beyond the gate: the way out
	local escape = P(
		{ Name = "EscapeZone", Size = Vector3.new(18, 12, 10), CFrame = cf * CFrame.new(0, 6, 9), Transparency = 1, CanCollide = false },
		model
	)
	return { Model = model, Doors = doors, Switch = box, Lamp = lamp, Light = light, Escape = escape }
end

return Props
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">RoundService</string>
          <string name="Source"><![CDATA[-- The round loop: lobby -> pick a killer -> 7-minute match -> results -> back to the lobby.
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)

local BotKiller = require(script.Parent.BotKiller)
local CosmeticService = require(script.Parent.CosmeticService)
local DataService = require(script.Parent.DataService)
local HideService = require(script.Parent.HideService)
local KillerService = require(script.Parent.KillerService)
local Match = require(script.Parent.Match)
local ObjectiveService = require(script.Parent.ObjectiveService)
local SurvivorService = require(script.Parent.SurvivorService)

local RoundService = {}

local rng = Random.new()

local function now()
	return Match.Now()
end

local function setPhase(phase: string, duration: number)
	workspace:SetAttribute("Phase", phase)
	workspace:SetAttribute("PhaseEndsAt", now() + duration)
end

local function loadedPlayers()
	local list = {}
	for _, player in Players:GetPlayers() do
		if player:GetAttribute("Loaded") then
			table.insert(list, player)
		end
	end
	return list
end

local function pickKiller(players)
	local total = 0
	for _, player in players do
		total += math.max(1, player:GetAttribute("KillerChance") or 1)
	end
	local roll = rng:NextNumber() * total
	for _, player in players do
		roll -= math.max(1, player:GetAttribute("KillerChance") or 1)
		if roll <= 0 then
			return player
		end
	end
	return players[#players]
end

local function killerTypeFor(player: Player): string
	local preferred = player:GetAttribute("PreferredKiller")
	if preferred and Config.Killers[preferred] and player:GetAttribute("Unlocked_" .. preferred) then
		return preferred
	end
	return "Ringmaster"
end

local function shuffle(list)
	for i = #list, 2, -1 do
		local j = rng:NextInteger(1, i)
		list[i], list[j] = list[j], list[i]
	end
	return list
end

local function placeAsSurvivor(player: Player, spawnCFrame: CFrame)
	player:SetAttribute("Role", "Survivor")
	player:SetAttribute("CageCount", 0)
	player:SetAttribute("TrappedUntil", nil)
	player:SetAttribute("WorkingOn", nil)
	player:SetAttribute("Health", "Healthy")
	local character = player.Character
	if character then
		character:PivotTo(spawnCFrame)
	end
	SurvivorService.Setup(player)
end

local function placeAsKiller(player: Player)
	local character = player.Character
	if character then
		character:PivotTo(Match.Map.KillerSpawn)
	end
	KillerService.Setup(player, Match.KillerType)
	CosmeticService.Apply(player) -- killers keep their trail but not survivor hats
end

local function startMatch(players)
	-- Alone in the server? The AI Ringmaster hunts you instead of a real player.
	local solo = #players == 1
	local killer = if solo then nil else pickKiller(players)
	Match.Killer = killer
	Match.KillerType = if killer then killerTypeFor(killer) else "Ringmaster"
	Match.Active = true
	KillerService.Reset()
	ObjectiveService.Reset()

	-- Killer chance: the killer resets, everyone else goes up
	for _, player in players do
		local data = DataService.Get(player)
		if data then
			if player == killer then
				data.KillerChance = Config.KillerChance.Start
			else
				data.KillerChance += Config.KillerChance.PerRound + (if player:GetAttribute("Pass_VIP") then 1 else 0)
			end
			DataService.Sync(player)
		end
	end

	local spawns = shuffle(table.clone(Match.Map.SurvivorSpawns))
	local index = 0
	for _, player in players do
		if player == killer then
			placeAsKiller(player)
		else
			index += 1
			placeAsSurvivor(player, spawns[(index - 1) % #spawns + 1])
		end
	end
	workspace:SetAttribute("KillerType", Match.KillerType)
	workspace:SetAttribute("SurvivorCount", if killer then #players - 1 else #players)
	setPhase("Match", Config.MatchTime)
	if not killer then
		workspace:SetAttribute("KillerName", "AI")
		Match.KillerType = BotKiller.Start()
		workspace:SetAttribute("KillerType", Match.KillerType)
		local info = Config.Killers[Match.KillerType]
		Remotes.announce(info.Name .. " is hunting you. Light the pumpkins, hide in lockers, and escape.", info.Color)
		return
	end
	workspace:SetAttribute("KillerName", killer.DisplayName)
	KillerService.Freeze(10)
	Remotes.announce(
		"🔪 "
			.. killer.DisplayName
			.. " is "
			.. Config.Killers[Match.KillerType].Name
			.. "! Survivors: light "
			.. Config.Pumpkins.Needed
			.. " Ritual Pumpkins and escape!",
		Config.Killers[Match.KillerType].Color
	)
	Remotes.notify(killer, "You're the KILLER. You can move in 10 seconds. Click to attack, Q for your power.", "info")
end

local function eliminateRemaining(reason: string)
	for _, survivor in Match.Survivors() do
		SurvivorService.Eliminate(survivor, reason)
	end
end

local function runMatch(): string
	while true do
		task.wait(0.5)
		local killer = Match.Killer
		if not BotKiller.IsActive() and (not killer or not killer.Parent or Match.Role(killer) ~= "Killer") then
			return "KillerLeft"
		end
		if #Match.Survivors() == 0 then
			return "Done"
		end
		local collapse = workspace:GetAttribute("CollapseEndsAt")
		if collapse and now() > collapse then
			eliminateRemaining("the fair collapsed")
			return "Done"
		end
		if now() > workspace:GetAttribute("PhaseEndsAt") then
			eliminateRemaining("the fair closed")
			return "Done"
		end
	end
end

local function endMatch(result: string)
	Match.Active = false
	BotKiller.Stop()
	local escaped, eliminated, total = 0, 0, 0
	for _, player in Players:GetPlayers() do
		local role = Match.Role(player)
		if role == "Escaped" then
			escaped += 1
			total += 1
		elseif role == "Ghost" then
			eliminated += 1
			total += 1
		end
	end
	local killer = Match.Killer
	local killerWon = result ~= "KillerLeft" and total > 0 and eliminated >= math.ceil(total / 2)
	if killer and killer.Parent then
		DataService.AddTickets(killer, Config.Rewards.Participation, true)
		if killerWon then
			DataService.Increment(killer, "KillerWins")
			local earned = DataService.AddTickets(killer, Config.Rewards.KillerWin, true)
			Remotes.notify(killer, "🏆 The fair is yours! +" .. earned .. " 🎟️", "success")
		end
	end
	workspace:SetAttribute("ResultEscaped", escaped)
	workspace:SetAttribute("ResultEliminated", eliminated)
	workspace:SetAttribute("ResultKillerWon", killerWon)
	setPhase("Results", Config.ResultsTime)
	if result == "KillerLeft" then
		Remotes.announce("The killer fled the fair. Survivors win!", Color3.fromRGB(120, 255, 150))
	elseif killerWon then
		Remotes.announce("☠️ THE KILLER WINS: " .. eliminated .. " taken, " .. escaped .. " escaped.", Color3.fromRGB(255, 60, 60))
	else
		Remotes.announce("🏃 SURVIVORS WIN: " .. escaped .. " escaped, " .. eliminated .. " taken.", Color3.fromRGB(120, 255, 150))
	end
	task.wait(Config.ResultsTime)

	HideService.Reset()
	SurvivorService.ResetAll()
	KillerService.Reset()
	ObjectiveService.Reset()
	Match.Killer = nil
	Match.KillerType = nil
	workspace:SetAttribute("KillerName", nil)
	workspace:SetAttribute("KillerType", nil)
	for _, player in Players:GetPlayers() do
		player:SetAttribute("Role", "Lobby")
		player:SetAttribute("Health", nil)
		player:SetAttribute("WorkingOn", nil)
		player:SetAttribute("CageEndsAt", nil)
		player:SetAttribute("TrappedUntil", nil)
		player:SetAttribute("Vanished", nil)
		player:SetAttribute("Hiding", nil)
		if player:GetAttribute("Loaded") then
			player:LoadCharacter()
		end
	end
end

local function roundLoop()
	while true do
		workspace:SetAttribute("Phase", "Lobby")
		while #loadedPlayers() < Config.MinPlayers do
			setPhase("Waiting", 0)
			task.wait(1)
		end
		setPhase("Intermission", Config.IntermissionTime)
		local cancelled = false
		local endsAt = now() + Config.IntermissionTime
		while now() < endsAt do
			task.wait(0.5)
			if #loadedPlayers() < Config.MinPlayers then
				cancelled = true
				break
			end
		end
		if not cancelled then
			startMatch(loadedPlayers())
			endMatch(runMatch())
		end
	end
end

-- If someone respawns mid-match (reset, fell off the map), put them back where they belong.
function RoundService.OnCharacterAdded(player: Player, character: Model)
	if not Match.Active then
		return
	end
	character:WaitForChild("HumanoidRootPart", 5)
	task.wait(0.2)
	local role = Match.Role(player)
	if role == "Killer" and player == Match.Killer then
		placeAsKiller(player)
	elseif role == "Survivor" then
		character:PivotTo(Match.Map.SurvivorSpawns[1])
		SurvivorService.Setup(player)
		SurvivorService.Eliminate(player, "fell")
	elseif role == "Ghost" then
		character:PivotTo(Match.Map.SurvivorSpawns[rng:NextInteger(1, #Match.Map.SurvivorSpawns)])
		SurvivorService.MakeGhost(player)
	end
end

-- Rotten Fields at sunset: a low red-gold sun, long shadows, and dusty amber haze that hides the distance.
-- Bright enough to read the map, dark enough to be tense.
local function setupLighting()
	Lighting.ClockTime = 17.85
	Lighting.GeographicLatitude = 30
	Lighting.Brightness = 2.6
	Lighting.ExposureCompensation = 0.1
	Lighting.Ambient = Color3.fromRGB(86, 70, 62)
	Lighting.OutdoorAmbient = Color3.fromRGB(140, 116, 100)
	Lighting.ColorShift_Top = Color3.fromRGB(255, 170, 110)
	Lighting.ColorShift_Bottom = Color3.fromRGB(60, 40, 40)
	Lighting.EnvironmentDiffuseScale = 0.5
	Lighting.EnvironmentSpecularScale = 0.5
	Lighting.ShadowSoftness = 0.25
	Lighting.GlobalShadows = true

	local sky = Lighting:FindFirstChildOfClass("Sky") or Instance.new("Sky")
	sky.SunAngularSize = 14
	sky.MoonAngularSize = 8
	sky.StarCount = 600
	sky.Parent = Lighting

	local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere") or Instance.new("Atmosphere")
	atmosphere.Density = 0.36
	atmosphere.Offset = 0.1
	atmosphere.Color = Color3.fromRGB(196, 150, 104)
	atmosphere.Decay = Color3.fromRGB(110, 70, 52)
	atmosphere.Haze = 2.2
	atmosphere.Glare = 0.4
	atmosphere.Parent = Lighting

	local bloom = Lighting:FindFirstChildOfClass("BloomEffect") or Instance.new("BloomEffect")
	bloom.Intensity = 0.5
	bloom.Size = 30
	bloom.Threshold = 1.1
	bloom.Parent = Lighting

	local rays = Lighting:FindFirstChildOfClass("SunRaysEffect") or Instance.new("SunRaysEffect")
	rays.Intensity = 0.06
	rays.Spread = 0.6
	rays.Parent = Lighting

	local grade = Lighting:FindFirstChildOfClass("ColorCorrectionEffect") or Instance.new("ColorCorrectionEffect")
	grade.Brightness = 0
	grade.Contrast = 0.16
	grade.Saturation = -0.28
	grade.TintColor = Color3.fromRGB(255, 236, 214)
	grade.Parent = Lighting
end

function RoundService.Init()
	setupLighting()
	task.spawn(function()
		while true do
			local ok, err = pcall(roundLoop)
			if not ok then
				warn("[RoundService] round loop crashed, restarting:", err)
				Match.Active = false
				task.wait(2)
			end
		end
	end)
end

return RoundService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">SurvivorService</string>
          <string name="Source"><![CDATA[-- Survivors: health states, healing, being carried, Crow Cages, rescues, elimination, escape and ghosts.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)

local DataService = require(script.Parent.DataService)
local Match = require(script.Parent.Match)

local SurvivorService = {}
SurvivorService.OnCarryChanged = nil -- set by KillerService: function(killer)

local carried = {} -- [survivor] = { Killer, Weld, EndsAt, Saved }
local caged = {} -- [survivor] = cage
local boostToken = {}

local function now()
	return Match.Now()
end

-- The carrier is either the killer Player or the AI killer (a table with a Root part).
local function isPlayer(carrier): boolean
	return typeof(carrier) == "Instance" and carrier:IsA("Player")
end

local function carrierRoot(carrier): BasePart?
	if isPlayer(carrier) then
		return Match.Root(carrier)
	end
	return carrier and carrier.Root
end

local function prompt(player: Player, name: string)
	local root = Match.Root(player)
	return root and root:FindFirstChild(name)
end

local function refreshPrompts(player: Player)
	local health = Match.Health(player)
	local isSurvivor = Match.Role(player) == "Survivor"
	local heal = prompt(player, "HealPrompt")
	if heal then
		heal.Enabled = isSurvivor and (health == "Injured" or health == "Downed")
		heal.ActionText = if health == "Downed" then "Help up" else "Heal"
	end
	local pickup = prompt(player, "PickupPrompt")
	if pickup then
		pickup.Enabled = isSurvivor and health == "Downed"
	end
end

local function baseSpeed(player: Player): number
	local health = Match.Health(player)
	if health == "Downed" then
		return Config.Speeds.Crawl
	elseif health == "Injured" then
		return Config.Speeds.Injured
	end
	return Config.Speeds.Survivor
end

function SurvivorService.SetHealth(player: Player, health: string?)
	player:SetAttribute("Health", health)
	refreshPrompts(player)
	if health == "Healthy" or health == "Injured" or health == "Downed" then
		if not player:GetAttribute("TrappedUntil") or now() > player:GetAttribute("TrappedUntil") then
			Match.SetSpeed(player, baseSpeed(player))
		end
	end
end

-- Called when a character spawns into the match as a survivor.
function SurvivorService.Setup(player: Player)
	local root = Match.Root(player)
	if not root then
		return
	end
	for _, name in { "HealPrompt", "PickupPrompt" } do
		local old = root:FindFirstChild(name)
		if old then
			old:Destroy()
		end
	end
	local heal = Match.Prompt(root, "HealPrompt", "Survivor", "Heal", player.DisplayName, Config.Heal.HoldTime, 7)
	heal:SetAttribute("OwnerId", player.UserId)
	heal.Triggered:Connect(function(healer)
		if healer == player or not Match.IsStandingSurvivor(healer) then
			return
		end
		local health = Match.Health(player)
		if health == "Downed" then
			SurvivorService.SetHealth(player, "Injured")
		elseif health == "Injured" then
			SurvivorService.SetHealth(player, "Healthy")
		else
			return
		end
		local earned = DataService.AddTickets(healer, Config.Rewards.Heal, true)
		Remotes.notify(healer, "💉 You helped " .. player.DisplayName .. "! +" .. earned .. " 🎟️", "success")
		Remotes.notify(player, "💉 " .. healer.DisplayName .. " patched you up.", "success")
	end)

	local pickup = Match.Prompt(root, "PickupPrompt", "Killer", "Pick up", player.DisplayName, 0.4, 7)
	pickup:SetAttribute("OwnerId", player.UserId)
	pickup.Triggered:Connect(function(killer)
		if killer == Match.Killer and Match.Health(player) == "Downed" then
			SurvivorService.Pickup(killer, player)
		end
	end)

	local character = player.Character
	if character then
		Match.SetCollisionGroup(character, "Players")
	end
	SurvivorService.SetHealth(player, Match.Health(player) or "Healthy")
end

-- The killer landed a hit. Returns the new health state.
function SurvivorService.Hit(player: Player): string?
	local health = Match.Health(player)
	player:SetAttribute("WorkingOn", nil)
	local hitRoot = Match.Root(player)
	if hitRoot and (health == "Healthy" or health == "Injured") then
		Remotes.Sfx:FireAllClients("Hit", hitRoot.Position)
	end
	if health == "Healthy" then
		SurvivorService.SetHealth(player, "Injured")
		-- Burst of speed so the survivor can get away
		boostToken[player] = (boostToken[player] or 0) + 1
		local token = boostToken[player]
		Match.SetSpeed(player, Config.Speeds.HitBoost)
		task.delay(Config.Speeds.HitBoostTime, function()
			if boostToken[player] == token and Match.Health(player) == "Injured" then
				Match.SetSpeed(player, baseSpeed(player))
			end
		end)
		Remotes.Scare:FireClient(player, "hit")
		return "Injured"
	elseif health == "Injured" then
		SurvivorService.SetHealth(player, "Downed")
		Remotes.Scare:FireClient(player, "down")
		for _, other in Match.Survivors() do
			if other ~= player then
				Remotes.notify(other, "🆘 " .. player.DisplayName .. " is down!", "error")
			end
		end
		return "Downed"
	end
	return nil
end

local function setCarryPhysics(player: Player, on: boolean, saved)
	local character = player.Character
	if not character then
		return saved
	end
	saved = saved or {}
	for _, part in character:GetDescendants() do
		if part:IsA("BasePart") then
			if on then
				saved[part] = { part.Massless, part.CanCollide }
				part.Massless = true
				part.CanCollide = false
			elseif saved[part] then
				part.Massless = saved[part][1]
				part.CanCollide = saved[part][2]
			end
		end
	end
	local humanoid = Match.Humanoid(player)
	if humanoid then
		humanoid.PlatformStand = on
	end
	return saved
end

function SurvivorService.CarriedBy(killer: Player): Player?
	for survivor, info in carried do
		if info.Killer == killer then
			return survivor
		end
	end
	return nil
end

function SurvivorService.Pickup(killer: Player, survivor: Player)
	if SurvivorService.CarriedBy(killer) then
		return
	end
	local killerRoot, root = carrierRoot(killer), Match.Root(survivor)
	if not killerRoot or not root or (killerRoot.Position - root.Position).Magnitude > 10 then
		return
	end
	SurvivorService.SetHealth(survivor, "Carried")
	local saved = setCarryPhysics(survivor, true)
	root.CFrame = killerRoot.CFrame * CFrame.new(1.3, 1.6, 0.4) * CFrame.Angles(0, 0, math.rad(90))
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = killerRoot
	weld.Part1 = root
	weld.Parent = killerRoot
	carried[survivor] = { Killer = killer, Weld = weld, EndsAt = now() + Config.Cage.WiggleTime, Saved = saved }
	survivor:SetAttribute("WiggleEndsAt", now() + Config.Cage.WiggleTime)
	Remotes.notify(survivor, "😱 You're being carried! You'll wiggle free in " .. Config.Cage.WiggleTime .. "s...", "error")
	if isPlayer(killer) then
		Remotes.notify(killer, "Bring them to a 🐦‍⬛ Crow Cage!", "info")
	end
	if SurvivorService.OnCarryChanged then
		SurvivorService.OnCarryChanged(killer)
	end
end

-- Drops a carried survivor. newHealth is usually "Injured" (wiggled free / killer stunned).
function SurvivorService.Drop(survivor: Player, newHealth: string?)
	local info = carried[survivor]
	if not info then
		return
	end
	carried[survivor] = nil
	info.Weld:Destroy()
	setCarryPhysics(survivor, false, info.Saved)
	survivor:SetAttribute("WiggleEndsAt", nil)
	local root, killerRoot = Match.Root(survivor), carrierRoot(info.Killer)
	if root then
		if killerRoot then
			root.CFrame = killerRoot.CFrame * CFrame.new(0, 0, 3)
		end
		pcall(root.SetNetworkOwner, root, survivor)
	end
	if newHealth then
		SurvivorService.SetHealth(survivor, newHealth)
	end
	if SurvivorService.OnCarryChanged then
		SurvivorService.OnCarryChanged(info.Killer)
	end
end

local function cageFor(survivor: Player)
	return caged[survivor]
end

function SurvivorService.Eliminate(survivor: Player, reason: string?)
	if Match.Role(survivor) ~= "Survivor" then
		return
	end
	SurvivorService.Drop(survivor)
	local cage = cageFor(survivor)
	if cage then
		caged[survivor] = nil
		cage.Occupant = nil
		cage.RescuePrompt.Enabled = false
		cage.Light.Color = Color3.fromRGB(255, 40, 40)
	end
	survivor:SetAttribute("WorkingOn", nil)
	survivor:SetAttribute("CageEndsAt", nil)
	SurvivorService.SetHealth(survivor, nil)
	survivor:SetAttribute("Role", "Ghost")
	DataService.AddTickets(survivor, Config.Rewards.Participation, true)

	local killer = Match.Killer
	if killer and killer.Parent then
		local earned = DataService.AddTickets(killer, Config.Rewards.KillerElimination, true)
		DataService.Increment(killer, "Eliminations")
		Remotes.notify(killer, "☠️ " .. survivor.DisplayName .. " was taken by the crows! +" .. earned .. " 🎟️", "success")
	end
	Remotes.announce(
		"🐦‍⬛ " .. survivor.DisplayName .. " was taken by the crows" .. (if reason then " (" .. reason .. ")" else "") .. ".",
		Color3.fromRGB(255, 80, 80)
	)
	SurvivorService.MakeGhost(survivor)
end

function SurvivorService.MakeGhost(player: Player)
	local character = player.Character
	local root = Match.Root(player)
	if not character or not root then
		return
	end
	root.Anchored = false
	for _, part in character:GetDescendants() do
		if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
			part.Transparency = math.max(part.Transparency, 0.6)
		elseif part:IsA("Decal") then
			part.Transparency = 0.6
		end
	end
	Match.SetCollisionGroup(character, "Ghosts")
	local glow = Instance.new("Highlight")
	glow.Name = "GhostGlow"
	glow.FillColor = Color3.fromRGB(150, 200, 255)
	glow.FillTransparency = 0.6
	glow.OutlineTransparency = 1
	glow.DepthMode = Enum.HighlightDepthMode.Occluded
	glow.Parent = character
	Match.SetSpeed(player, Config.Speeds.Ghost)
	for _, name in { "HealPrompt", "PickupPrompt" } do
		local p = root:FindFirstChild(name)
		if p then
			p.Enabled = false
		end
	end
	Remotes.notify(player, "👻 You're a ghost now. Ring the 🔔 Ghost Bells to reveal the killer to your friends!", "info")
end

function SurvivorService.Escape(survivor: Player)
	if not Match.IsStandingSurvivor(survivor) then
		return
	end
	survivor:SetAttribute("WorkingOn", nil)
	SurvivorService.SetHealth(survivor, nil)
	survivor:SetAttribute("Role", "Escaped")
	DataService.Increment(survivor, "Escapes")
	local earned = DataService.AddTickets(survivor, Config.Rewards.Escape, true)
	Remotes.notify(survivor, "🏃 YOU ESCAPED THE FAIR! +" .. earned .. " 🎟️", "success")
	Remotes.announce("🏃 " .. survivor.DisplayName .. " escaped!", Color3.fromRGB(120, 255, 150))
	local character = survivor.Character
	if character and Match.Map then
		character:PivotTo(Match.Map.LobbySpawn)
	end
end

function SurvivorService.CageSurvivor(killer: Player, cage)
	local survivor = SurvivorService.CarriedBy(killer)
	if not survivor or cage.Occupant then
		return
	end
	SurvivorService.Drop(survivor)
	local root = Match.Root(survivor)
	if not root then
		return
	end
	local count = (survivor:GetAttribute("CageCount") or 0) + 1
	survivor:SetAttribute("CageCount", count)
	cage.Occupant = survivor
	caged[survivor] = cage
	root.CFrame = cage.Inside
	root.Anchored = true
	Remotes.Sfx:FireAllClients("CageScream", cage.Position)
	SurvivorService.SetHealth(survivor, "Caged")
	cage.Light.Color = Color3.fromRGB(255, 200, 60)

	if isPlayer(killer) then
		local earned = DataService.AddTickets(killer, Config.Rewards.KillerCage, true)
		Remotes.notify(killer, "🐦‍⬛ Caged " .. survivor.DisplayName .. "! +" .. earned .. " 🎟️", "success")
	end
	if count > #Config.Cage.Stages then
		SurvivorService.Eliminate(survivor, "caged 3 times")
		return
	end
	survivor:SetAttribute("CageEndsAt", now() + Config.Cage.Stages[count])
	cage.RescuePrompt.Enabled = true
	Remotes.Scare:FireClient(survivor, "cage")
	for _, other in Match.Survivors() do
		if other ~= survivor then
			Remotes.notify(other, "🐦‍⬛ " .. survivor.DisplayName .. " is in a Crow Cage! Rescue them!", "error")
			Remotes.Ping:FireClient(other, cage.Position, "rescue")
		end
	end
end

function SurvivorService.FreeFromCage(survivor: Player)
	local cage = caged[survivor]
	if not cage then
		return false
	end
	caged[survivor] = nil
	cage.Occupant = nil
	cage.RescuePrompt.Enabled = false
	cage.Light.Color = Color3.fromRGB(255, 40, 40)
	survivor:SetAttribute("CageEndsAt", nil)
	local root = Match.Root(survivor)
	if root then
		root.Anchored = false
		root.CFrame = cage.Door.CFrame * CFrame.new(3, 0, 0)
	end
	SurvivorService.SetHealth(survivor, "Injured")
	return true
end

function SurvivorService.IsCaged(survivor: Player): boolean
	return caged[survivor] ~= nil
end

function SurvivorService.SetupCages()
	for _, cage in Match.Map.Cages do
		cage.Occupant = nil
		local cagePrompt = Match.Prompt(cage.Door, "CagePrompt", "Killer", "Cage survivor", "Crow Cage", 0.6, 9)
		cagePrompt.Triggered:Connect(function(killer)
			if killer == Match.Killer then
				SurvivorService.CageSurvivor(killer, cage)
			end
		end)
		cage.RescuePrompt = Match.Prompt(cage.Door, "RescuePrompt", "Survivor", "Rescue", "Crow Cage", Config.Cage.RescueHold, 9)
		cage.RescuePrompt.Enabled = false
		cage.RescuePrompt.Triggered:Connect(function(rescuer)
			local survivor = cage.Occupant
			if not survivor or survivor == rescuer or not Match.IsStandingSurvivor(rescuer) then
				return
			end
			if SurvivorService.FreeFromCage(survivor) then
				DataService.Increment(rescuer, "Rescues")
				local earned = DataService.AddTickets(rescuer, Config.Rewards.Rescue, true)
				Remotes.notify(rescuer, "🗝️ You rescued " .. survivor.DisplayName .. "! +" .. earned .. " 🎟️", "success")
				Remotes.notify(survivor, "🗝️ " .. rescuer.DisplayName .. " got you out! RUN!", "success")
			end
		end)
	end
end

-- Clears all carry/cage state (between matches).
function SurvivorService.ResetAll()
	for survivor in carried do
		SurvivorService.Drop(survivor)
	end
	for survivor, cage in caged do
		cage.Occupant = nil
		cage.RescuePrompt.Enabled = false
		cage.Light.Color = Color3.fromRGB(255, 40, 40)
		local root = Match.Root(survivor)
		if root then
			root.Anchored = false
		end
	end
	table.clear(caged)
end

function SurvivorService.OnPlayerRemoving(player: Player)
	SurvivorService.Drop(player)
	local cage = caged[player]
	if cage then
		caged[player] = nil
		cage.Occupant = nil
		cage.RescuePrompt.Enabled = false
	end
	for survivor, info in carried do
		if info.Killer == player then
			SurvivorService.Drop(survivor, "Injured")
		end
	end
end

local function tick()
	local t = now()
	for survivor, info in carried do
		if t >= info.EndsAt then
			local killer = info.Killer
			SurvivorService.Drop(survivor, "Injured")
			Remotes.notify(survivor, "💪 You wiggled free!", "success")
			if isPlayer(killer) then
				Remotes.notify(killer, "They wiggled free!", "error")
			end
		end
	end
	for survivor in caged do
		local endsAt = survivor:GetAttribute("CageEndsAt")
		if endsAt and t >= endsAt then
			SurvivorService.Eliminate(survivor, "the crows came")
		end
	end
end

function SurvivorService.Init()
	task.spawn(function()
		while true do
			task.wait(0.2)
			local ok, err = pcall(tick)
			if not ok then
				warn("[SurvivorService] tick error:", err)
			end
		end
	end)
	Players.PlayerRemoving:Connect(SurvivorService.OnPlayerRemoving)
end

return SurvivorService
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="23">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="24">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="25">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">Audio</string>
            <string name="Source"><![CDATA[-- Music and sound, DBD-style:
--   lobby: broken music-box waltz
--   match: wind + drone ambience
--   survivors: heartbeat that grows as the killer gets closer, chase music when it's on top of you
--   killer: chase music when a survivor is close
--   one-shot effects, positioned in 3D where they happen
local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)

local player = Players.LocalPlayer

local Audio = {}

local loops = {}

local function soundId(key: string): string?
	local info = Config.Sounds[key]
	if info and info.Id ~= 0 then
		return "rbxassetid://" .. info.Id
	end
	return nil
end

local function makeLoop(key: string)
	local id = soundId(key)
	if not id then
		return
	end
	local sound = Instance.new("Sound")
	sound.Name = key
	sound.SoundId = id
	sound.Looped = true
	sound.Volume = 0
	sound.Parent = SoundService
	sound:Play()
	loops[key] = { Sound = sound, Target = 0, Max = Config.Sounds[key].Volume }
end

-- Plays a one-shot effect. With a position, it's heard in 3D from that spot.
function Audio.Play(key: string, position: Vector3?)
	local id = soundId(key)
	if not id then
		return
	end
	local sound = Instance.new("Sound")
	sound.SoundId = id
	sound.Volume = Config.Sounds[key].Volume
	if position then
		local anchor = Instance.new("Part")
		anchor.Anchored = true
		anchor.CanCollide = false
		anchor.CanQuery = false
		anchor.CanTouch = false
		anchor.Transparency = 1
		anchor.Size = Vector3.one
		anchor.Position = position
		anchor.Parent = workspace
		sound.RollOffMode = Enum.RollOffMode.InverseTapered
		sound.RollOffMinDistance = 15
		sound.RollOffMaxDistance = 220
		sound.Parent = anchor
		sound.Ended:Connect(function()
			anchor:Destroy()
		end)
	else
		sound.Parent = SoundService
		sound.Ended:Connect(function()
			sound:Destroy()
		end)
	end
	sound:Play()
end

local function killerRoot(): BasePart?
	for _, other in Players:GetPlayers() do
		if other:GetAttribute("Role") == "Killer" and not other:GetAttribute("Vanished") then
			local character = other.Character
			return character and character:FindFirstChild("HumanoidRootPart")
		end
	end
	for _, bot in CollectionService:GetTagged("KillerBot") do
		return bot:FindFirstChild("HumanoidRootPart")
	end
	return nil
end

local function nearestSurvivorDistance(from: Vector3): number
	local best = math.huge
	for _, other in Players:GetPlayers() do
		if other ~= player and other:GetAttribute("Role") == "Survivor" then
			local character = other.Character
			local root = character and character:FindFirstChild("HumanoidRootPart")
			if root then
				best = math.min(best, (root.Position - from).Magnitude)
			end
		end
	end
	return best
end

local function setTarget(key: string, fraction: number)
	local loop = loops[key]
	if loop then
		loop.Target = loop.Max * math.clamp(fraction, 0, 1)
	end
end

function Audio.Start()
	for _, key in { "LobbyMusic", "Ambience", "TerrorRadius", "ChaseMusic" } do
		makeLoop(key)
	end

	Remotes.Sfx.OnClientEvent:Connect(function(key, position)
		Audio.Play(key, position)
	end)
	Remotes.SkillCheck.OnClientEvent:Connect(function()
		Audio.Play("SkillCheck")
	end)

	RunService.Heartbeat:Connect(function(dt)
		local role = player:GetAttribute("Role") or "Lobby"
		local inMatch = workspace:GetAttribute("Phase") == "Match"
		local myRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")

		local terror, chase = 0, 0
		if inMatch and myRoot then
			if role == "Survivor" then
				local root = killerRoot()
				if root then
					local distance = (root.Position - myRoot.Position).Magnitude
					terror = 1 - distance / Config.TerrorRadius
					chase = if distance < Config.ChaseRadius then 1 else 0
				end
			elseif role == "Killer" then
				chase = if nearestSurvivorDistance(myRoot.Position) < Config.ChaseRadius then 1 else 0
			end
		end
		local inLobby = not inMatch or role == "Lobby" or role == "Escaped"
		setTarget("LobbyMusic", if inLobby then 1 else 0)
		setTarget("Ambience", if inMatch and not inLobby then 1 - chase * 0.6 else 0)
		setTarget("TerrorRadius", terror * (1 - chase * 0.5))
		setTarget("ChaseMusic", chase)

		-- Smooth fades
		for _, loop in loops do
			local speed = if loop.Target > loop.Sound.Volume then 1.5 else 0.6
			local step = speed * dt
			loop.Sound.Volume += math.clamp(loop.Target - loop.Sound.Volume, -step, step)
		end
		local heartbeat = loops.TerrorRadius
		if heartbeat then
			-- The heartbeat speeds up as the killer closes in
			heartbeat.Sound.PlaybackSpeed = 1 + math.clamp(terror, 0, 1) * 0.35
		end
	end)
end

return Audio
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">Controls</string>
            <string name="Source"><![CDATA[-- Killer input: click / ATTACK button to swing, Q / POWER button for the killer's power.
local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Remotes)

local player = Players.LocalPlayer

local Controls = {}

local bound = false

local function isKiller()
	return player:GetAttribute("Role") == "Killer"
end

function Controls.Attack()
	if isKiller() then
		Remotes.Attack:FireServer()
	end
end

function Controls.Ability()
	if isKiller() then
		Remotes.Ability:FireServer()
	end
end

local function refreshBindings()
	if isKiller() and not bound then
		bound = true
		ContextActionService:BindAction("KillerAttack", function(_, state)
			if state == Enum.UserInputState.Begin then
				Controls.Attack()
			end
			return Enum.ContextActionResult.Sink
		end, true, Enum.KeyCode.ButtonR2)
		ContextActionService:SetTitle("KillerAttack", "ATTACK")
		ContextActionService:SetPosition("KillerAttack", UDim2.new(1, -180, 1, -160))
		ContextActionService:BindAction("KillerAbility", function(_, state)
			if state == Enum.UserInputState.Begin then
				Controls.Ability()
			end
			return Enum.ContextActionResult.Sink
		end, true, Enum.KeyCode.Q, Enum.KeyCode.ButtonL2)
		ContextActionService:SetTitle("KillerAbility", "POWER")
		ContextActionService:SetPosition("KillerAbility", UDim2.new(1, -250, 1, -100))
	elseif not isKiller() and bound then
		bound = false
		ContextActionService:UnbindAction("KillerAttack")
		ContextActionService:UnbindAction("KillerAbility")
	end
end

function Controls.Start()
	UserInputService.InputBegan:Connect(function(input, processed)
		if not processed and input.UserInputType == Enum.UserInputType.MouseButton1 then
			Controls.Attack()
		end
	end)
	player:GetAttributeChangedSignal("Role"):Connect(refreshBindings)
	refreshBindings()
end

return Controls
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">Effects</string>
            <string name="Source"><![CDATA[-- World effects: spinning rides, role-based prompt visibility, killer swing trails,
-- noise pings for the killer, and the [VIP] chat tag.
local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TextChatService = game:GetService("TextChatService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Remotes)

local player = Players.LocalPlayer

local Effects = {}

-- Spinning rides (Ferris wheel, carousel): rotated locally every frame
local spinners = {}
local function addSpinner(model: Model)
	spinners[model] = model:GetPivot()
end

-- Prompts: only show the ones meant for your role, and never your own heal/pickup prompt
local function refreshPrompt(prompt: ProximityPrompt)
	local forRole = prompt:GetAttribute("For")
	local ownerId = prompt:GetAttribute("OwnerId")
	local role = player:GetAttribute("Role")
	local onlyUser = prompt:GetAttribute("OnlyUserId")
	local visible = forRole == role and ownerId ~= player.UserId and (onlyUser == nil or onlyUser == player.UserId)
	prompt.MaxActivationDistance = if visible then (prompt:GetAttribute("Range") or 8) else 0
end

local function refreshAllPrompts()
	for _, prompt in CollectionService:GetTagged("RolePrompt") do
		refreshPrompt(prompt)
	end
end

local function showPing(position: Vector3, kind: string?)
	local marker = Instance.new("Part")
	marker.Anchored = true
	marker.CanCollide = false
	marker.CanQuery = false
	marker.Transparency = 1
	marker.Position = position + Vector3.new(0, 6, 0)
	marker.Parent = workspace
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(60, 60)
	gui.AlwaysOnTop = true
	gui.LightInfluence = 0
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.TextScaled = true
	label.Font = Enum.Font.GothamBlack
	label.Text = if kind == "rescue" then "🐦‍⬛" elseif kind == "pumpkin" then "🎃" elseif kind == "trap" then "🪤" else "💥"
	label.Parent = gui
	gui.Parent = marker
	TweenService:Create(label, TweenInfo.new(4), { TextTransparency = 1 }):Play()
	task.delay(4, function()
		marker:Destroy()
	end)
end

-- `who` is the killer's UserId, or the AI killer's model.
local function swingEffect(who)
	local root
	if typeof(who) == "Instance" then
		root = who:FindFirstChild("HumanoidRootPart")
	else
		local killer = Players:GetPlayerByUserId(who)
		if killer and killer:GetAttribute("Vanished") then
			return
		end
		root = killer and killer.Character and killer.Character:FindFirstChild("HumanoidRootPart")
	end
	if not root then
		return
	end
	local slash = Instance.new("Part")
	slash.Anchored = true
	slash.CanCollide = false
	slash.CanQuery = false
	slash.CanTouch = false
	slash.Size = Vector3.new(6, 0.2, 3)
	slash.Material = Enum.Material.Neon
	slash.Color = Color3.fromRGB(255, 60, 60)
	slash.Transparency = 0.3
	slash.CFrame = root.CFrame * CFrame.new(0, 0.5, -3.5) * CFrame.Angles(0, 0, math.rad(-30))
	slash.Parent = workspace
	TweenService:Create(slash, TweenInfo.new(0.25), { Transparency = 1, CFrame = slash.CFrame * CFrame.Angles(0, 0, math.rad(60)) }):Play()
	task.delay(0.3, function()
		slash:Destroy()
	end)
end

function Effects.Start()
	CollectionService:GetInstanceAddedSignal("Spin"):Connect(addSpinner)
	for _, model in CollectionService:GetTagged("Spin") do
		addSpinner(model)
	end
	RunService.RenderStepped:Connect(function()
		local t = os.clock()
		for model, origin in spinners do
			if model.Parent then
				local speed = model:GetAttribute("SpinSpeed") or 0.2
				local axis = model:GetAttribute("SpinAxis")
				local rotation = if axis == "Z" then CFrame.Angles(0, 0, t * speed) else CFrame.Angles(0, t * speed, 0)
				model:PivotTo(origin * rotation)
			else
				spinners[model] = nil
			end
		end
	end)

	local function watchPrompt(prompt: ProximityPrompt)
		prompt:GetAttributeChangedSignal("OnlyUserId"):Connect(function()
			refreshPrompt(prompt)
		end)
		refreshPrompt(prompt)
	end
	CollectionService:GetInstanceAddedSignal("RolePrompt"):Connect(watchPrompt)
	for _, prompt in CollectionService:GetTagged("RolePrompt") do
		watchPrompt(prompt)
	end

	-- Inside a locker you look out through the vents in first person
	player:GetAttributeChangedSignal("Hiding"):Connect(function()
		player.CameraMode = if player:GetAttribute("Hiding") then Enum.CameraMode.LockFirstPerson else Enum.CameraMode.Classic
		if not player:GetAttribute("Hiding") then
			player.CameraMinZoomDistance = 0.5
		end
	end)
	player:GetAttributeChangedSignal("Role"):Connect(refreshAllPrompts)
	refreshAllPrompts()

	Remotes.Ping.OnClientEvent:Connect(showPing)
	Remotes.Swing.OnClientEvent:Connect(swingEffect)

	TextChatService.OnIncomingMessage = function(message: TextChatMessage)
		local properties = Instance.new("TextChatMessageProperties")
		local source = message.TextSource
		local speaker = source and Players:GetPlayerByUserId(source.UserId)
		if speaker and speaker:GetAttribute("Pass_VIP") then
			properties.PrefixText = "<font color='#FFC83C'>[VIP]</font> " .. message.PrefixText
		end
		return properties
	end
end

return Effects
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">HUD</string>
            <string name="Source"><![CDATA[-- All on-screen UI, built from code.
-- Lobby: killer picker, wardrobe, shop (bundles, Mystery Crate, passes, boosts).
-- Match: timer, pumpkins, survivor states, skill checks, heartbeat, cage/carry screens, killer power.
local CollectionService = game:GetService("CollectionService")
local ContextActionService = game:GetService("ContextActionService")
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Cosmetics = require(Shared.Cosmetics)
local Format = require(Shared.Format)
local Remotes = require(Shared.Remotes)

local player = Players.LocalPlayer

local HUD = {}

local SCARY = Enum.Font.SpecialElite
local FONT = Enum.Font.Oswald
local C = {
	panel = Color3.fromRGB(12, 11, 13),
	panel2 = Color3.fromRGB(26, 24, 28),
	red = Color3.fromRGB(150, 22, 30),
	gold = Color3.fromRGB(176, 140, 82),
	green = Color3.fromRGB(58, 64, 60),
	purple = Color3.fromRGB(70, 52, 78),
	bone = Color3.fromRGB(226, 220, 208),
	dim = Color3.fromRGB(150, 144, 140),
	grey = Color3.fromRGB(46, 44, 48),
}
local TOAST = { success = Color3.fromRGB(34, 48, 38), error = Color3.fromRGB(70, 16, 20), info = Color3.fromRGB(30, 28, 34) }
local HEALTH_ICON = { Healthy = "❤️", Injured = "🩸", Downed = "🆘", Carried = "😱", Caged = "🐦‍⬛" }

local function new(className: string, props, children)
	local inst = Instance.new(className)
	for key, value in props or {} do
		if key ~= "Parent" then
			inst[key] = value
		end
	end
	for _, child in children or {} do
		child.Parent = inst
	end
	if props and props.Parent then
		inst.Parent = props.Parent
	end
	return inst
end
local function corner(r: number?)
	return new("UICorner", { CornerRadius = UDim.new(0, math.min(r or 3, 3)) }) -- sharp, DBD-like
end
local function outline()
	return new("UIStroke", { Thickness = 2, Color = Color3.new(0, 0, 0), Transparency = 0.1 })
end
local function border(color: Color3, thickness: number?)
	return new("UIStroke", { Thickness = thickness or 2, Color = color, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
end
local function text(props)
	props.BackgroundTransparency = props.BackgroundTransparency or 1
	props.Font = props.Font or FONT
	props.TextColor3 = props.TextColor3 or C.bone
	props.TextScaled = if props.TextScaled == nil then true else props.TextScaled
	return new("TextLabel", props, { outline() })
end
local function button(props, color: Color3)
	props.BackgroundColor3 = color
	props.Font = props.Font or FONT
	props.TextColor3 = C.bone
	props.TextScaled = true
	props.AutoButtonColor = true
	return new("TextButton", props, {
		corner(8),
		outline(),
		new(
			"UIPadding",
			{ PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 6), PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4) }
		),
		border(color:Lerp(Color3.new(0, 0, 0), 0.4)),
	})
end
local function now()
	return workspace:GetServerTimeNow()
end
local function invoke(remote: RemoteFunction, ...)
	local ok, success, message, extra = pcall(remote.InvokeServer, remote, ...)
	if not ok then
		return false, "Something went wrong. Try again."
	end
	return success, message, extra
end

function HUD.Start(Audio)
	local gui = new("ScreenGui", {
		Name = "FairHUD",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = player:WaitForChild("PlayerGui"),
	})

	------------------------------------------------------------------ toasts / announcements
	local toastHolder = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -150),
		Size = UDim2.fromOffset(440, 220),
		BackgroundTransparency = 1,
		Parent = gui,
	}, {
		new("UIListLayout", {
			VerticalAlignment = Enum.VerticalAlignment.Bottom,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			Padding = UDim.new(0, 6),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	local toastCount = 0
	local function toast(message: string, kind: string?)
		toastCount += 1
		local frame = new("Frame", {
			Size = UDim2.new(1, 0, 0, 34),
			BackgroundColor3 = TOAST[kind or "info"] or TOAST.info,
			LayoutOrder = toastCount,
			Parent = toastHolder,
		}, { corner(8) })
		text({ Size = UDim2.new(1, -16, 1, -8), Position = UDim2.fromOffset(8, 4), Text = message, Parent = frame })
		task.delay(3.5, function()
			TweenService:Create(frame, TweenInfo.new(0.4), { BackgroundTransparency = 1 }):Play()
			task.wait(0.4)
			frame:Destroy()
		end)
		local frames = {}
		for _, child in toastHolder:GetChildren() do
			if child:IsA("Frame") then
				table.insert(frames, child)
			end
		end
		table.sort(frames, function(a, b)
			return a.LayoutOrder < b.LayoutOrder
		end)
		for i = 1, #frames - 5 do
			frames[i]:Destroy()
		end
	end
	local announceLabel = text({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 150),
		Size = UDim2.new(0.85, 0, 0, 34),
		Text = "",
		TextTransparency = 1,
		Parent = gui,
	})
	local announceStroke = announceLabel:FindFirstChildOfClass("UIStroke")
	local announceToken = 0
	local function announce(message: string, colorHex: string?)
		announceToken += 1
		local token = announceToken
		announceLabel.Text = message
		announceLabel.TextColor3 = if colorHex then Color3.fromHex(colorHex) else C.bone
		announceLabel.TextTransparency = 0
		announceStroke.Transparency = 0.1
		task.delay(5, function()
			if token == announceToken then
				TweenService:Create(announceLabel, TweenInfo.new(1), { TextTransparency = 1 }):Play()
				TweenService:Create(announceStroke, TweenInfo.new(1), { Transparency = 1 }):Play()
			end
		end)
	end
	Remotes.Notify.OnClientEvent:Connect(toast)
	Remotes.Announce.OnClientEvent:Connect(announce)

	------------------------------------------------------------------ red vignette + scare flash
	local vignette = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = gui })
	local edges = {}
	for _, spec in
		{
			{ UDim2.fromScale(1, 0.22), UDim2.fromScale(0, 0), 90 },
			{ UDim2.fromScale(1, 0.22), UDim2.fromScale(0, 0.78), -90 },
			{ UDim2.fromScale(0.18, 1), UDim2.fromScale(0, 0), 0 },
			{ UDim2.fromScale(0.18, 1), UDim2.fromScale(0.82, 0), 180 },
		}
	do
		table.insert(
			edges,
			new("Frame", {
				Size = spec[1],
				Position = spec[2],
				BackgroundColor3 = C.red,
				BorderSizePixel = 0,
				BackgroundTransparency = 1,
				Parent = vignette,
			}, { new("UIGradient", { Rotation = spec[3], Transparency = NumberSequence.new(0, 1) }) })
		)
	end
	local flash =
		new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = C.red, BackgroundTransparency = 1, ZIndex = 40, Parent = gui })
	Remotes.Scare.OnClientEvent:Connect(function(kind)
		flash.BackgroundColor3 = if kind == "trap" then Color3.fromRGB(120, 110, 100) else C.red
		flash.BackgroundTransparency = 0.25
		TweenService:Create(flash, TweenInfo.new(0.6), { BackgroundTransparency = 1 }):Play()
		local camera = workspace.CurrentCamera
		local started = os.clock()
		local connection
		connection = RunService.RenderStepped:Connect(function()
			if os.clock() - started > 0.35 then
				connection:Disconnect()
				return
			end
			camera.CFrame *= CFrame.Angles(math.rad(math.random(-2, 2)), math.rad(math.random(-2, 2)), 0)
		end)
	end)

	------------------------------------------------------------------ top bar
	local top = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 44),
		Size = UDim2.fromOffset(340, 96),
		BackgroundColor3 = C.panel,
		BackgroundTransparency = 0.2,
		Parent = gui,
	}, { corner(12), border(C.red) })
	local titleLabel = text({
		Size = UDim2.new(1, -16, 0, 40),
		Position = UDim2.fromOffset(8, 4),
		Font = SCARY,
		Text = "NIGHTMARE FAIR",
		TextColor3 = C.red,
		Parent = top,
	})
	local subLabel = text({ Size = UDim2.new(1, -16, 0, 22), Position = UDim2.fromOffset(8, 44), Text = "", Parent = top })
	local objectiveLabel =
		text({ Size = UDim2.new(1, -16, 0, 22), Position = UDim2.fromOffset(8, 68), Text = "", TextColor3 = C.gold, Parent = top })

	-- Currency (top-left)
	local wallet = text({
		Position = UDim2.fromOffset(16, 52),
		Size = UDim2.fromOffset(260, 30),
		Text = "",
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = C.gold,
		Parent = gui,
	})

	-- Survivor list (right side)
	local roster = new("Frame", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 150),
		Size = UDim2.fromOffset(220, 260),
		BackgroundTransparency = 1,
		Parent = gui,
	}, {
		new("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.Name }),
	})

	------------------------------------------------------------------ survivor widgets
	local center = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -40),
		Size = UDim2.fromOffset(380, 100),
		BackgroundTransparency = 1,
		Parent = gui,
	})
	local workFrame = new("Frame", {
		Position = UDim2.fromOffset(0, 70),
		Size = UDim2.new(1, 0, 0, 24),
		BackgroundColor3 = Color3.fromRGB(15, 10, 15),
		Visible = false,
		Parent = center,
	}, { corner(6), border(C.grey) })
	local workFill = new(
		"Frame",
		{ Size = UDim2.fromScale(0, 1), BackgroundColor3 = Color3.fromRGB(255, 140, 30), Parent = workFrame },
		{ corner(6) }
	)
	text({ Size = UDim2.new(1, 0, 1, -2), Text = "🎃 Lighting the pumpkin... (walk away to stop)", ZIndex = 2, Parent = workFrame })

	-- Skill check
	local skill = new(
		"Frame",
		{ Position = UDim2.fromOffset(0, 0), Size = UDim2.new(1, 0, 0, 60), BackgroundTransparency = 1, Visible = false, Parent = center }
	)
	local track = new("Frame", {
		Position = UDim2.fromOffset(0, 26),
		Size = UDim2.new(1, -90, 0, 26),
		BackgroundColor3 = Color3.fromRGB(20, 12, 20),
		Parent = skill,
	}, { corner(6), border(C.bone) })
	local goodZone = new(
		"Frame",
		{ Size = UDim2.fromScale(0.14, 1), BackgroundColor3 = Color3.fromRGB(240, 232, 220), BackgroundTransparency = 0.3, Parent = track }
	)
	local greatZone = new("Frame", { Size = UDim2.fromScale(0.035, 1), BackgroundColor3 = C.gold, Parent = track })
	local needle = new(
		"Frame",
		{ Size = UDim2.new(0, 4, 1, 8), Position = UDim2.new(0, 0, 0, -4), BackgroundColor3 = C.red, ZIndex = 3, Parent = track }
	)
	text({ Size = UDim2.new(1, 0, 0, 22), Text = "SKILL CHECK! Press SPACE in the zone", TextColor3 = C.gold, Parent = skill })
	local hitButton = button(
		{ AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 20), Size = UDim2.fromOffset(80, 38), Text = "HIT!" },
		C.gold
	)
	hitButton.Parent = skill

	local active = nil -- { Id, Start, ZoneStart }
	local SKILL_DURATION = 1.25
	local function finishSkill(result: string)
		if not active then
			return
		end
		local id = active.Id
		active = nil
		skill.Visible = false
		ContextActionService:UnbindAction("SkillCheckHit")
		Remotes.SkillCheck:FireServer(id, result)
		if result == "great" then
			Audio.Play("Great")
			toast("GREAT skill check", "success")
		elseif result == "miss" then
			toast("Missed!", "error")
		end
	end
	local function pressSkill()
		if not active then
			return
		end
		local pos = (os.clock() - active.Start) / SKILL_DURATION
		if pos >= active.ZoneStart and pos <= active.ZoneStart + 0.035 then
			finishSkill("great")
		elseif pos >= active.ZoneStart and pos <= active.ZoneStart + 0.14 then
			finishSkill("good")
		else
			finishSkill("miss")
		end
	end
	hitButton.Activated:Connect(pressSkill)
	Remotes.SkillCheck.OnClientEvent:Connect(function(id)
		local zoneStart = 0.45 + math.random() * 0.35
		active = { Id = id, Start = os.clock() + 0.35, ZoneStart = zoneStart }
		goodZone.Position = UDim2.fromScale(zoneStart, 0)
		greatZone.Position = UDim2.fromScale(zoneStart, 0)
		skill.Visible = true
		ContextActionService:BindActionAtPriority("SkillCheckHit", function(_, state)
			if state == Enum.UserInputState.Begin then
				pressSkill()
			end
			return Enum.ContextActionResult.Sink
		end, false, 3000, Enum.KeyCode.Space, Enum.KeyCode.ButtonA)
	end)

	-- Heartbeat (terror radius)
	local heart = text({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 1, -170),
		Size = UDim2.fromOffset(60, 60),
		Text = "❤",
		TextColor3 = C.red,
		Visible = false,
		Parent = gui,
	})

	-- Status overlay (downed / carried / caged / trapped / ghost / killer frozen)
	local status = text({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.36),
		Size = UDim2.fromOffset(620, 50),
		Font = SCARY,
		Text = "",
		Visible = false,
		Parent = gui,
	})
	local statusSub = text({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.36, 40),
		Size = UDim2.fromOffset(620, 26),
		Text = "",
		Visible = false,
		Parent = gui,
	})
	local cageButtons = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0.36, 64),
		Size = UDim2.fromOffset(420, 46),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = gui,
	}, {
		new("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			Padding = UDim.new(0, 10),
		}),
	})
	local useBreakOut = button({ Size = UDim2.fromOffset(200, 44), Text = "🗝️ USE BREAK OUT", Parent = cageButtons }, C.gold)
	local buyBreakOut = button(
		{ Size = UDim2.fromOffset(200, 44), Text = "🗝️ BREAK OUT  R$ " .. Config.Products.SelfRescue.Price, Parent = cageButtons },
		C.green
	)

	local function promptPurchase(item, isPass: boolean)
		if item.Id == 0 then
			toast("This item isn't set up yet (Id = 0 in Config).", "error")
			return
		end
		if isPass then
			MarketplaceService:PromptGamePassPurchase(player, item.Id)
		else
			MarketplaceService:PromptProductPurchase(player, item.Id)
		end
	end
	useBreakOut.Activated:Connect(function()
		local ok, message = invoke(Remotes.UseSelfRescue)
		toast(message, if ok then "success" else "error")
	end)
	buyBreakOut.Activated:Connect(function()
		promptPurchase(Config.Products.SelfRescue, false)
	end)

	-- Killer power widget
	local power = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -30),
		Size = UDim2.fromOffset(360, 60),
		BackgroundColor3 = C.panel,
		BackgroundTransparency = 0.2,
		Visible = false,
		Parent = gui,
	}, { corner(10), border(C.red) })
	local powerLabel = text({ Size = UDim2.new(1, -16, 0, 28), Position = UDim2.fromOffset(8, 4), Text = "", Parent = power })
	local attackLabel =
		text({ Size = UDim2.new(1, -16, 0, 22), Position = UDim2.fromOffset(8, 32), Text = "", TextColor3 = C.dim, Parent = power })

	------------------------------------------------------------------ lobby panels
	local panels = {}
	local function makePanel(name: string, title: string, size: Vector2)
		local panel = new("Frame", {
			Name = name,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.55),
			Size = UDim2.fromOffset(size.X, size.Y),
			BackgroundColor3 = C.panel,
			Visible = false,
			ZIndex = 10,
			Parent = gui,
		}, { corner(14), border(C.red, 3) })
		text({
			Size = UDim2.new(1, -80, 0, 40),
			Position = UDim2.fromOffset(16, 8),
			Font = SCARY,
			Text = title,
			TextColor3 = C.red,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = panel,
		})
		local close = button({ Size = UDim2.fromOffset(36, 36), Position = UDim2.new(1, -46, 0, 10), Text = "X", Parent = panel }, C.red)
		close.Activated:Connect(function()
			panel.Visible = false
		end)
		local scroll = new("ScrollingFrame", {
			Position = UDim2.fromOffset(12, 56),
			Size = UDim2.new(1, -24, 1, -68),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			CanvasSize = UDim2.new(),
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			ScrollBarThickness = 6,
			Parent = panel,
		}, {
			new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
		})
		panels[name] = panel
		return panel, scroll
	end
	local function togglePanel(name: string)
		for key, panel in panels do
			panel.Visible = key == name and not panel.Visible
		end
	end
	local function header(scroll, order: number, title: string, color: Color3?)
		return text({
			Size = UDim2.new(1, -10, 0, 26),
			Text = title,
			TextColor3 = color or C.gold,
			LayoutOrder = order,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = scroll,
		})
	end
	local function row(scroll, order: number, title: string, description: string, height: number?, accent: Color3?)
		local frame = new(
			"Frame",
			{ Size = UDim2.new(1, -10, 0, height or 66), BackgroundColor3 = C.panel2, LayoutOrder = order, Parent = scroll },
			{ corner(8) }
		)
		if accent then
			border(accent).Parent = frame
		end
		local titleLabel2 = text({
			Size = UDim2.new(1, -150, 0, 26),
			Position = UDim2.fromOffset(10, 6),
			Text = title,
			TextColor3 = accent or C.bone,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = frame,
		})
		local desc = text({
			Size = UDim2.new(1, -150, 1, -38),
			Position = UDim2.fromOffset(10, 32),
			Text = description,
			TextColor3 = C.dim,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
			TextWrapped = true,
			TextScaled = false,
			TextSize = 15,
			Parent = frame,
		})
		local buy = button(
			{ AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.fromOffset(124, 42), Text = "" },
			C.green
		)
		buy.Parent = frame
		return buy, desc, titleLabel2
	end

	-- Killers
	local _, killerScroll = makePanel("Killers", "CHOOSE YOUR KILLER", Vector2.new(500, 440))
	local killerRefreshers = {}
	for i, key in Config.KillerOrder do
		local info = Config.Killers[key]
		local buy = row(killerScroll, i, info.Name .. "  ·  " .. info.Ability, info.Description, 80, info.Color)
		local function refresh()
			local unlocked = player:GetAttribute("Unlocked_" .. key)
			if player:GetAttribute("PreferredKiller") == key and unlocked then
				buy.Text = "✅ SELECTED"
				buy.BackgroundColor3 = C.grey
			elseif unlocked then
				buy.Text = "SELECT"
				buy.BackgroundColor3 = C.green
			elseif info.PassKey then
				buy.Text = "🎟️ " .. Format.Abbrev(info.Price) .. " / R$"
				buy.BackgroundColor3 = C.purple
			else
				buy.Text = "🎟️ " .. Format.Abbrev(info.Price)
				buy.BackgroundColor3 = C.gold
			end
		end
		table.insert(killerRefreshers, refresh)
		buy.Activated:Connect(function()
			if player:GetAttribute("Unlocked_" .. key) then
				local ok, message = invoke(Remotes.SelectKiller, key)
				toast(message, if ok then "success" else "error")
			elseif info.PassKey and (player:GetAttribute("Tickets") or 0) < info.Price then
				promptPurchase(Config.GamePasses[info.PassKey], true)
			else
				local ok, message = invoke(Remotes.BuyKiller, key)
				toast(message, if ok then "success" else "error")
			end
		end)
		player:GetAttributeChangedSignal("Unlocked_" .. key):Connect(refresh)
	end
	player:GetAttributeChangedSignal("PreferredKiller"):Connect(function()
		for _, refresh in killerRefreshers do
			refresh()
		end
	end)
	for _, refresh in killerRefreshers do
		refresh()
	end

	-- Wardrobe
	local _, wardrobeScroll = makePanel("Wardrobe", "WARDROBE", Vector2.new(520, 480))
	local order = 0
	for _, section in { { "Hat", "🎭 HATS & MASKS (survivors)" }, { "Trail", "✨ TRAILS (everyone)" }, { "Skin", "🔪 KILLER SKINS" } } do
		order += 1
		header(wardrobeScroll, order, section[2])
		for _, item in Cosmetics.Items do
			if item.Type == section[1] then
				order += 1
				local rarity = Cosmetics.Rarities[item.Rarity]
				local detail = item.Rarity .. (if item.Killer then " · " .. Config.Killers[item.Killer].Name else "")
				local buy = row(wardrobeScroll, order, item.Name, detail, 58, rarity.Color)
				local slot = if item.Type == "Skin" then "Skin_" .. item.Killer else "Equip_" .. item.Type
				local function refresh()
					if player:GetAttribute("Owned_" .. item.Id) then
						local equipped = player:GetAttribute(slot) == item.Id
						buy.Text = if equipped then "✅ EQUIPPED" else "EQUIP"
						buy.BackgroundColor3 = if equipped then C.grey else C.green
					elseif item.Price then
						buy.Text = "🎟️ " .. Format.Abbrev(item.Price)
						buy.BackgroundColor3 = C.gold
					else
						buy.Text = "🎁 BUNDLE / CRATE"
						buy.BackgroundColor3 = C.purple
					end
				end
				player:GetAttributeChangedSignal("Owned_" .. item.Id):Connect(refresh)
				player:GetAttributeChangedSignal(slot):Connect(refresh)
				refresh()
				buy.Activated:Connect(function()
					if player:GetAttribute("Owned_" .. item.Id) then
						local ok, message = invoke(Remotes.Equip, item.Id)
						toast(message, if ok then "success" else "error")
					elseif item.Price then
						local ok, message = invoke(Remotes.BuyCosmetic, item.Id)
						toast(message, if ok then "success" else "error")
					else
						togglePanel("Shop")
					end
				end)
			end
		end
	end

	-- Shop
	local _, shopScroll = makePanel("Shop", "SHOP", Vector2.new(540, 500))
	order = 0
	order += 1
	header(shopScroll, order, "🎁 BUNDLES", C.gold)
	for _, key in Cosmetics.BundleOrder do
		local bundle = Cosmetics.Bundles[key]
		local product = Config.Products[key]
		order += 1
		local buy, desc = row(shopScroll, order, bundle.Name .. "   " .. bundle.Badge, product.Description, 74, C.gold)
		buy.Text = "R$ " .. product.Price
		if bundle.OneTime then
			local function refresh()
				if player:GetAttribute("StarterBought") then
					desc.Text = "Already claimed. Buying again gives " .. bundle.Tickets * 2 .. " 🎟️."
				end
			end
			player:GetAttributeChangedSignal("StarterBought"):Connect(refresh)
			refresh()
		end
		buy.Activated:Connect(function()
			promptPurchase(product, false)
		end)
	end
	order += 1
	header(shopScroll, order, "📦 MYSTERY CRATE", C.purple)
	order += 1
	local odds = Cosmetics.Crate.Odds
	local crateBuy = row(
		shopScroll,
		order,
		"Mystery Crate",
		string.format(
			"Random hat, trail or skin. Odds: Common %d%% · Rare %d%% · Epic %d%% · Legendary %d%%. Duplicates refund %d 🎟️.",
			odds.Common,
			odds.Rare,
			odds.Epic,
			odds.Legendary,
			Cosmetics.Crate.DuplicateRefund
		),
		84,
		C.purple
	)
	crateBuy.Text = "🎟️ " .. Cosmetics.Crate.Price
	crateBuy.BackgroundColor3 = C.purple
	crateBuy.Activated:Connect(function()
		local ok, message, id = invoke(Remotes.OpenCrate)
		if ok and id then
			local item = Cosmetics.ById[id]
			announce("📦 " .. message, Cosmetics.Rarities[item.Rarity].Color:ToHex())
		else
			toast(message, "error")
		end
	end)
	order += 1
	header(shopScroll, order, "⭐ GAME PASSES (forever)")
	for _, key in Config.PassOrder do
		local pass = Config.GamePasses[key]
		order += 1
		local buy = row(shopScroll, order, pass.Name, pass.Description)
		local function refresh()
			local owned = player:GetAttribute("Pass_" .. key)
			buy.Text = if owned then "OWNED" else "R$ " .. pass.Price
			buy.BackgroundColor3 = if owned then C.grey else C.green
		end
		player:GetAttributeChangedSignal("Pass_" .. key):Connect(refresh)
		refresh()
		buy.Activated:Connect(function()
			if not player:GetAttribute("Pass_" .. key) then
				promptPurchase(pass, true)
			end
		end)
	end
	order += 1
	header(shopScroll, order, "⚡ BOOSTS & TICKETS")
	for _, key in Config.ProductOrder do
		local product = Config.Products[key]
		order += 1
		local buy = row(shopScroll, order, product.Name, product.Description)
		buy.Text = "R$ " .. product.Price
		buy.Activated:Connect(function()
			promptPurchase(product, false)
		end)
	end

	-- Lobby buttons
	local side = new("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 12, 0.5, 0),
		Size = UDim2.fromOffset(150, 190),
		BackgroundTransparency = 1,
		Parent = gui,
	}, {
		new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	local killersButton = button({ Size = UDim2.fromOffset(150, 52), Text = "🔪 KILLERS", LayoutOrder = 1, Parent = side }, C.red)
	local wardrobeButton = button({ Size = UDim2.fromOffset(150, 52), Text = "🎭 WARDROBE", LayoutOrder = 2, Parent = side }, C.purple)
	local shopButton = button({ Size = UDim2.fromOffset(150, 52), Text = "🛒 SHOP", LayoutOrder = 3, Parent = side }, C.gold)
	killersButton.Activated:Connect(function()
		togglePanel("Killers")
	end)
	wardrobeButton.Activated:Connect(function()
		togglePanel("Wardrobe")
	end)
	shopButton.Activated:Connect(function()
		togglePanel("Shop")
	end)

	------------------------------------------------------------------ live updates
	local rosterRows = {}
	local elapsed = 0
	RunService.Heartbeat:Connect(function(dt)
		local t = now()
		local role = player:GetAttribute("Role") or "Lobby"
		local phase = workspace:GetAttribute("Phase") or "Waiting"
		local inMatch = phase == "Match"

		-- Skill check needle + timeout
		if active then
			local pos = (os.clock() - active.Start) / SKILL_DURATION
			needle.Position = UDim2.new(math.clamp(pos, 0, 1), -2, 0, -4)
			if pos > 1 then
				finishSkill("miss")
			end
		end

		-- Heartbeat & vignette for survivors
		local danger = 0
		if role == "Survivor" and inMatch then
			local myRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
			for _, other in Players:GetPlayers() do
				if other:GetAttribute("Role") == "Killer" and not other:GetAttribute("Vanished") then
					local root = other.Character and other.Character:FindFirstChild("HumanoidRootPart")
					if root and myRoot then
						danger = math.clamp(1 - (root.Position - myRoot.Position).Magnitude / 60, 0, 1)
					end
				end
			end
			for _, bot in CollectionService:GetTagged("KillerBot") do
				local root = bot:FindFirstChild("HumanoidRootPart")
				if root and myRoot then
					danger = math.max(danger, math.clamp(1 - (root.Position - myRoot.Position).Magnitude / 60, 0, 1))
				end
			end
		end
		heart.Visible = danger > 0
		if danger > 0 then
			local beat = math.abs(math.sin(os.clock() * (3 + danger * 7)))
			heart.Size = UDim2.fromOffset(44 + beat * 30 * danger, 44 + beat * 30 * danger)
		end
		for _, edge in edges do
			edge.BackgroundTransparency = 1 - danger * 0.7
		end

		elapsed += dt
		if elapsed < 0.1 then
			return
		end
		elapsed = 0

		wallet.Text = "🎟️ "
			.. Format.Abbrev(player:GetAttribute("Tickets") or 0)
			.. "    🔪 Killer Chance: "
			.. (player:GetAttribute("KillerChance") or 1)
		side.Visible = role == "Lobby" or role == "Escaped"
		if not side.Visible then
			for _, panel in panels do
				panel.Visible = false
			end
		end

		-- Top bar
		local remaining = Format.Time((workspace:GetAttribute("PhaseEndsAt") or t) - t)
		if inMatch then
			local killerType = workspace:GetAttribute("KillerType")
			titleLabel.Text = if killerType then string.upper(Config.Killers[killerType].Name) else "THE HUNT"
			subLabel.Text = "Fair closes in " .. remaining
			local collapse = workspace:GetAttribute("CollapseEndsAt")
			if workspace:GetAttribute("GatesPowered") and collapse then
				objectiveLabel.Text = "⚡ GATES POWERED · collapse in " .. Format.Time(collapse - t)
			else
				objectiveLabel.Text = "🎃 Pumpkins lit: "
					.. (workspace:GetAttribute("PumpkinsLit") or 0)
					.. " / "
					.. Config.Pumpkins.Needed
			end
		elseif phase == "Intermission" then
			titleLabel.Text = "NIGHTMARE FAIR"
			subLabel.Text = "The hunt begins in " .. remaining
			objectiveLabel.Text = "Higher Killer Chance = better odds to be the killer"
		elseif phase == "Results" then
			local killerWon = workspace:GetAttribute("ResultKillerWon")
			titleLabel.Text = if killerWon then "THE KILLER WINS" else "SURVIVORS WIN"
			subLabel.Text = (workspace:GetAttribute("ResultEscaped") or 0)
				.. " escaped · "
				.. (workspace:GetAttribute("ResultEliminated") or 0)
				.. " taken"
			objectiveLabel.Text = "Back to the lobby in " .. remaining
		else
			titleLabel.Text = "NIGHTMARE FAIR"
			subLabel.Text = "Waiting for players (" .. Config.MinPlayers .. " needed)..."
			objectiveLabel.Text = ""
		end

		-- Roster
		roster.Visible = inMatch
		local seen = {}
		if inMatch then
			for _, other in Players:GetPlayers() do
				local otherRole = other:GetAttribute("Role")
				if otherRole == "Survivor" or otherRole == "Ghost" or otherRole == "Escaped" then
					seen[other] = true
					local label = rosterRows[other]
					if not label then
						label = text({
							Name = other.Name,
							Size = UDim2.new(1, 0, 0, 24),
							TextXAlignment = Enum.TextXAlignment.Right,
							Parent = roster,
						})
						rosterRows[other] = label
					end
					local icon
					if otherRole == "Ghost" then
						icon = "👻"
					elseif otherRole == "Escaped" then
						icon = "🏃"
					else
						icon = HEALTH_ICON[other:GetAttribute("Health") or "Healthy"] or "❤️"
						local cageEnds = other:GetAttribute("CageEndsAt")
						if cageEnds then
							icon ..= " " .. math.max(0, math.floor(cageEnds - t)) .. "s"
						end
					end
					label.Text = other.DisplayName .. "  " .. icon
				end
			end
		end
		for other, label in rosterRows do
			if not seen[other] then
				label:Destroy()
				rosterRows[other] = nil
			end
		end

		-- Work bar
		local working = role == "Survivor" and player:GetAttribute("WorkingOn") ~= nil
		workFrame.Visible = working
		if working then
			workFill.Size = UDim2.fromScale(player:GetAttribute("WorkProgress") or 0, 1)
		elseif active then
			finishSkill("miss")
		end

		-- Status overlays
		local health = player:GetAttribute("Health")
		local statusText, subText, showCage = nil, nil, false
		if inMatch and role == "Survivor" then
			if player:GetAttribute("Hiding") then
				statusText, subText = "HIDING", "Hold still... The killer can search lockers. Press E to leave."
			elseif health == "Downed" then
				statusText, subText = "YOU'RE DOWN", "Crawl away! A teammate can help you up."
			elseif health == "Carried" then
				statusText = "YOU'RE BEING CARRIED"
				subText = "Wiggling free in "
					.. math.max(0, math.ceil((player:GetAttribute("WiggleEndsAt") or t) - t))
					.. "s... (pallet stuns drop you too)"
			elseif health == "Caged" then
				local count = player:GetAttribute("CageCount") or 1
				statusText = "CAUGHT IN A CROW CAGE"
				subText = "The crows come in "
					.. math.max(0, math.ceil((player:GetAttribute("CageEndsAt") or t) - t))
					.. "s · cage "
					.. count
					.. " of 3"
				showCage = true
			elseif (player:GetAttribute("TrappedUntil") or 0) > t then
				statusText, subText = "TRAPPED!", "Stuck in a bear trap..."
			end
		elseif inMatch and role == "Killer" then
			local frozen = (workspace:GetAttribute("PhaseEndsAt") or 0) - Config.MatchTime + 10 - t
			if frozen > 0 then
				statusText, subText = "YOU ARE THE KILLER", "The survivors are hiding. You can move in " .. math.ceil(frozen) .. "s"
			elseif (player:GetAttribute("StunnedUntil") or 0) > t then
				statusText = "STUNNED!"
			end
		elseif inMatch and role == "Ghost" then
			statusText, subText = "YOU ARE A GHOST", "Find the 🔔 Ghost Bells and ring them to reveal the killer to your friends."
		elseif role == "Escaped" and inMatch then
			statusText, subText = "YOU ESCAPED", "Waiting for the match to finish..."
		end
		status.Visible = statusText ~= nil
		statusSub.Visible = subText ~= nil
		status.Text = statusText or ""
		statusSub.Text = subText or ""
		status.TextColor3 = if role == "Ghost"
			then Color3.fromRGB(170, 220, 255)
			elseif role == "Escaped" then Color3.fromRGB(120, 255, 150)
			else C.red
		cageButtons.Visible = showCage
		useBreakOut.Visible = (player:GetAttribute("BreakOuts") or 0) > 0
		useBreakOut.Text = "🗝️ USE BREAK OUT (" .. (player:GetAttribute("BreakOuts") or 0) .. ")"

		-- Killer power
		power.Visible = inMatch and role == "Killer"
		if power.Visible then
			local killerType = player:GetAttribute("KillerType") or "Ringmaster"
			local info = Config.Killers[killerType]
			local abilityWait = (player:GetAttribute("AbilityReadyAt") or 0) - t
			powerLabel.Text = "[Q] "
				.. info.Ability
				.. (if abilityWait > 0 then "  ·  " .. math.ceil(abilityWait) .. "s" else "  ·  READY")
			powerLabel.TextColor3 = if abilityWait > 0 then C.dim else info.Color
			attackLabel.Text = if player:GetAttribute("Vanished")
				then "👻 Invisible (click to reveal)"
				else "[Click] Attack  ·  Pick up downed survivors and cage them"
		end
	end)
end

return HUD
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="30">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[-- Client entry point.
local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")

local Audio = require(script.Parent.Audio)
local Controls = require(script.Parent.Controls)
local Effects = require(script.Parent.Effects)
local HUD = require(script.Parent.HUD)

Audio.Start()
Effects.Start()
Controls.Start()
HUD.Start(Audio)

-- Rainbow trail cosmetic
RunService.RenderStepped:Connect(function()
	local hue = (os.clock() * 0.3) % 1
	for _, trail in CollectionService:GetTagged("RainbowTrail") do
		trail.Color = ColorSequence.new(Color3.fromHSV(hue, 0.9, 1), Color3.fromHSV((hue + 0.3) % 1, 0.9, 1))
	end
end)
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
</roblox>